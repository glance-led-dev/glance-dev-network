# CFP Predictor - projected committee Top 25 and 12-team bracket.
#
# Ratings blend Sagarin, ESPN FPI and a fit to this season's scores. The rest
# of the season (and the conference title games) is simulated many times;
# each simulated season is ranked by a committee model fit to every CFP
# ranking 2014-2025 (strength of record, power, losses, quality wins, bad
# losses, conference titles, Group of Six). Once the committee releases its
# own rankings, teams are nudged toward the committee's order.

FPI_URL = "https://site.web.api.espn.com/apis/fitt/v3/sports/football/college-football/powerindex"
SCORES_URL = "https://site.api.espn.com/apis/site/v2/sports/football/college-football/scoreboard"
