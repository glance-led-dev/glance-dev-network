# ---------- data ----------

def num(v, fallback):
    if type(v) == "float" or type(v) == "int":
        return float(v)
    return fallback

def load_fpi():
    """FPI rows by team id: rating, record and display fields."""
    out = {}
    for page in (1, 2):
        resp = http.get(FPI_URL, params = {"region": "us", "lang": "en", "limit": "70", "page": str(page)}, ttl_seconds = 3600)
        if resp["status_code"] != 200 or resp["json"] == None:
            return None
        d = resp["json"]
        names = {}
        for cat in d.get("categories", []):
            names[cat.get("name")] = cat.get("names") or []
        for t in d.get("teams", []):
            info = t.get("team") or {}
            row = {}
            for cat in t.get("categories", []):
                keys = names.get(cat.get("name"), [])
                vals = cat.get("values") or []
                for i in range(min(len(keys), len(vals))):
                    if keys[i] not in row:
                        row[keys[i]] = vals[i]
            tid = str(info.get("id", ""))
            colors = TEAMS.get(tid, ("#555555", "#FFFFFF", "", ""))
            out[tid] = {
                "id": tid,
                "abbr": str(info.get("abbreviation", "?")).upper()[:4],
                "team": str(info.get("shortDisplayName", "")).upper(),
                "conf": CONF.get(tid, str((info.get("group") or {}).get("id", ""))),
                "fpi": num(row.get("fpi"), None),
                "w": int(num(row.get("numwins"), 0.0)),
                "l": int(num(row.get("numlosses"), 0.0)),
                "color": colors[0],
                "alt": colors[1],
                "city": colors[2],
                "state": colors[3],
            }
    return out

def load_sagarin():
    """Sagarin ratings by team id, and his home-field edge."""
    resp = http.get(SAGARIN_URL, ttl_seconds = 21600)
    if resp["status_code"] != 200:
        return {}, None
    body = resp["body"]
    by_name = {}
    for line in body.split("\n"):
        if " = " not in line and "=  " not in line:
            continue
        left, right = line.split("=", 1)
        words = left.split()
        vals = right.split()
        if len(words) < 3 or not words[0].isdigit() or words[-1] not in ("A", "AA") or not vals:
            continue
        name = " ".join(words[1:-1])
        if name not in by_name:
            v = vals[0]
            if v.replace(".", "").replace("-", "").isdigit():
                by_name[name] = float(v)
    out = {}
    for tid in SAGARIN_NAME:
        v = by_name.get(SAGARIN_NAME[tid])
        if v != None:
            out[tid] = v
    home = None
    i = body.find("HOME ADVANTAGE=[")
    if i >= 0:
        j = body.find("]", i)
        s = body[i + 16:j].strip()
        if s.replace(".", "").isdigit():
            home = float(s)
    return out, home

def load_scoreboard(params, ttl):
    """ESPN scoreboard games keyed "home@away": score, status, line, note."""
    q = {"groups": "80", "limit": "300"}
    q.update(params)
    resp = http.get(SCORES_URL, params = q, ttl_seconds = ttl)
    if resp["status_code"] != 200 or resp["json"] == None:
        return {}
    out = {"week": (resp["json"].get("week") or {}).get("number")}
    for e in resp["json"].get("events", []):
        comps = e.get("competitions") or []
        if not comps:
            continue
        c = comps[0]
        side = {}
        for k in c.get("competitors") or []:
            side[k.get("homeAway")] = k
        if "home" not in side or "away" not in side:
            continue
        st = (c.get("status") or {}).get("type") or {}
        odds = (c.get("odds") or [{}])[0] or {}
        notes = c.get("notes") or [{}]
        hs = int(num(float(side["home"].get("score") or 0), 0.0))
        aws = int(num(float(side["away"].get("score") or 0), 0.0))
        h = str(side["home"]["team"]["id"])
        a = str(side["away"]["team"]["id"])
        info = {}
        for k in (side["home"], side["away"]):
            tm = k.get("team") or {}
            info[str(tm.get("id", ""))] = {
                "abbr": str(tm.get("abbreviation", "?")).upper()[:4],
                "team": str(tm.get("shortDisplayName", "")).upper(),
                "color": "#" + str(tm.get("color") or "555555"),
                "alt": "#" + str(tm.get("alternateColor") or "FFFFFF"),
                "rank": (k.get("curatedRank") or {}).get("current"),
            }
        out[h + "@" + a] = {
            "home": h,
            "away": a,
            "hs": hs,
            "as": aws,
            "margin": hs - aws,
            "done": st.get("completed") == True,
            "live": st.get("state") == "in",
            "period": (c.get("status") or {}).get("period", 0),
            "clock": (c.get("status") or {}).get("displayClock", ""),
            "spread": num(odds.get("spread"), None),
            "neutral": c.get("neutralSite") == True,
            "note": str((notes[0] or {}).get("headline", "")),
            "date": str(e.get("date", "")),
            "city": str(((c.get("venue") or {}).get("address") or {}).get("city", "")),
            "info": info,
        }
    return out

def games_in(board):
    return [board[k] for k in board if k != "week"]

def load_cfp(weeks):
    """The committee's latest Top 25 (team ids in order) and its release
    date: ESPN's rankings feed, else the core API's ranking 21."""
    resp = http.get(RANKINGS_URL, ttl_seconds = 3600)
    if resp["status_code"] == 200 and resp["json"] != None:
        for r in resp["json"].get("rankings", []):
            if r.get("type") == "cfp" or "Playoff" in str(r.get("name", "")):
                return [str((x.get("team") or {}).get("id", "")) for x in r.get("ranks", [])], str(r.get("date", ""))
    for w in weeks:
        resp = http.get(CFP_CORE_URL % (SEASON, w), headers = {"User-Agent": "curl/8.21.0"}, ttl_seconds = 3600)
        if resp["status_code"] != 200 or resp["json"] == None or not resp["json"].get("ranks"):
            continue
        out = []
        for x in resp["json"]["ranks"]:
            ref = str((x.get("team") or {}).get("$ref", ""))
            i = ref.find("/teams/")
            if i >= 0:
                out.append(ref[i + 7:].split("?")[0])
        return out, str(resp["json"].get("date", ""))
    return [], ""

# ---------- math ----------

def exp(x):
    return math.pow(2.718281828459045, max(-50.0, min(50.0, x)))

def phi(x):
    # Normal CDF via Abramowitz-Stegun 7.1.26.
    z = abs(x) / 1.4142135623730951
    t = 1.0 / (1.0 + 0.3275911 * z)
    y = 1.0 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-z * z)
    return 0.5 * (1.0 + y) if x >= 0 else 0.5 * (1.0 - y)

def win_prob(margin):
    return phi(margin / MARGIN_SD)

def cap(m):
    return max(-MARGIN_CAP, min(MARGIN_CAP, m))

def remaining_fraction(period, clock):
    parts = str(clock).split(":")
    left = 0.0
    if len(parts) == 2 and parts[0].isdigit():
        left = int(parts[0]) * 60 + num(float(parts[1]) if parts[1].replace(".", "").isdigit() else 0.0, 0.0)
    if period > 4:
        return 0.02
    return max(0.0, ((4 - period) * 900 + left) / 3600.0)

# ---------- ratings ----------

def pool(t):
    return t if t in CONF else FCS

def fit_ratings(games, prior, ridge, iters):
    """Least-squares point ratings from capped margins with a home edge,
    pulled toward the prior."""
    ids = list(CONF.keys()) + [FCS]
    r = {t: prior.get(t, 0.0) for t in ids}
    r[FCS] = -25.0
    home = HOME_EDGE
    by_team = {t: [] for t in ids}
    for g in games:
        if g["margin"] == None:
            continue
        h, a = pool(g["home"]), pool(g["away"])
        if h == a:
            continue
        m = cap(g["margin"])
        hfa = 0.0 if g["neutral"] else 1.0
        by_team[h].append((a, m, hfa))
        by_team[a].append((h, -m, -hfa))
    for _ in range(iters):
        for t in ids:
            gl = by_team[t]
            p = prior.get(t, -25.0 if t == FCS else 0.0)
            if not gl:
                r[t] = p
                continue
            s = 0.0
            for o, m, hf in gl:
                s += m + r[o] - hf * home
            r[t] = (s + ridge * p) / (len(gl) + ridge)
        n = 0.0
        d = 0.0
        for t in ids:
            for o, m, hf in by_team[t]:
                if hf > 0:
                    n += m - (r[t] - r[o])
                    d += 1
        if d:
            home = max(0.0, min(5.0, n / d))
        mean = total([r[t] for t in CONF]) / len(CONF)
        for t in ids:
            r[t] -= mean
    return r, home

def total(xs):
    s = 0.0
    for x in xs:
        s += x
    return s

def centered(src):
    vals = [src[t] for t in CONF if src.get(t) != None]
    if not vals:
        return {}
    mean = total(vals) / len(vals)
    return {t: src[t] - mean for t in CONF if src.get(t) != None}

def blend_ratings(games, fpi, sag, sag_home):
    """Sagarin and FPI as the prior, refit to this season's scores,
    then the three averaged."""
    sg = centered(sag)
    fp = centered({t: fpi[t]["fpi"] for t in fpi})
    prior = {}
    for t in CONF:
        xs = [x for x in (sg.get(t), fp.get(t)) if x != None]
        prior[t] = total(xs) / len(xs) if xs else -10.0
    own, home = fit_ratings(games, prior, 3.0, 40)
    out = {}
    for t in CONF:
        xs = [own.get(t, prior[t])] + [x for x in (sg.get(t), fp.get(t)) if x != None]
        out[t] = total(xs) / len(xs)
    out[FCS] = own[FCS]
    if sag_home != None:
        home = (home + sag_home) / 2.0
    return out, home

# ---------- the season ----------

def build_games(week):
    """Every game with its result (real, or inferred from ESPN's records
    for games played since the schedule was built) or home win chance."""
    games = []
    for row in GAMES:
        g = {"date": row[0], "home": row[1], "away": row[2], "neutral": row[3] & 1 == 1,
             "conf": row[3] & 2 == 2, "margin": row[4], "hw": None, "p": 0.5, "spread": None, "live": None}
        if g["margin"] != None:
            g["hw"] = g["margin"] > 0
        wk = week.get(g["home"] + "@" + g["away"])
        if wk:
            if wk["done"]:
                g["margin"] = wk["margin"]
                g["hw"] = wk["margin"] > 0
            else:
                g["spread"] = wk["spread"]
                if wk["live"]:
                    g["live"] = wk
        games.append(g)
    return games

def game_prob(g, pre):
    """Home win chance: the line when there is one, else `pre` (rating
    margin); in-game, the score and clock shrink the remaining doubt."""
    if g.get("spread") != None:
        pre = -g["spread"]
    lv = g.get("live")
    if lv:
        lv = g if lv == True else lv
        frac = remaining_fraction(lv["period"], lv["clock"])
        sd = MARGIN_SD * math.sqrt(max(frac, 0.002))
        return phi((lv["margin"] + pre * frac) / sd)
    return win_prob(pre)

def set_probs(games, r, home):
    for g in games:
        if g["hw"] != None:
            continue
        pre = r.get(pool(g["home"]), 0.0) - r.get(pool(g["away"]), 0.0) + (0.0 if g["neutral"] else home)
        g["p"] = game_prob(g, pre)

def title_games(boards, r):
    """Conference title games ESPN has scheduled: conference -> game with
    its result or home win chance."""
    out = {}
    for board in boards:
        for g in games_in(board):
            h, a = g["home"], g["away"]
            if not g["note"].endswith("Championship") or CONF.get(h) == None or CONF.get(h) != CONF.get(a) or CONF[h] == INDEPENDENT:
                continue
            t = dict(g)
            t["hw"] = (g["margin"] > 0) if g["done"] else None
            t["p"] = game_prob(g, r[h] - r[a])
            out[CONF[h]] = t
    return out

def infer_results(games, fpi):
    """ESPN's W-L counts reveal games finished since the schedule was
    built; give each team its wins in the games it was likeliest to win."""
    known = {}
    pending = {}
    for g in games:
        for side in ("home", "away"):
            t = g[side]
            if t not in fpi:
                continue
            k = known.setdefault(t, [0, 0])
            if g["hw"] != None:
                won = g["hw"] == (side == "home")
                k[0 if won else 1] += 1
            else:
                pending.setdefault(t, []).append(g)
    for t in pending:
        k = known.get(t, [0, 0])
        extra = fpi[t]["w"] + fpi[t]["l"] - k[0] - k[1]
        if extra <= 0:
            continue
        played = pending[t][:extra]
        wins = fpi[t]["w"] - k[0]
        todo = []
        for g in played:
            if g["hw"] == None:
                todo.append(g)
            elif g["hw"] == (g["home"] == t):
                wins -= 1
        wins = max(0, min(len(todo), wins))
        by_chance = sorted(todo, key = lambda g: -(g["p"] if g["home"] == t else 1.0 - g["p"]))
        for i, g in enumerate(by_chance):
            g["hw"] = (i < wins) == (g["home"] == t)

def cutoffs(r):
    vals = sorted([r[t] for t in CONF], reverse = True)
    return vals[11], vals[24], vals[69]

def feature_score(won, ro, pref, top25, bottom):
    """One game's contribution to the committee score."""
    s = -W["sor"] * pref
    if won:
        s += W["sor"]
        if ro >= top25:
            s += W["quality"] * (1.0 + (ro - top25) / 10.0)
    else:
        s += W["losses"]
        if ro < bottom:
            s += W["bad"]
    return s

def current_scores(games, titles, r, home, ref, top25, bottom):
    """Committee score of every team from finished games only."""
    sc = {t: W["power"] * r[t] + (W["g6"] if CONF[t] in GROUP6 else 0.0) for t in CONF}
    for g in games:
        if g["hw"] == None:
            continue
        for side in ("home", "away"):
            t = g[side]
            if t not in sc:
                continue
            opp = g["away"] if side == "home" else g["home"]
            ro = r.get(pool(opp), -25.0)
            edge = 0.0 if g["neutral"] else (home if side == "home" else -home)
            sc[t] += feature_score(g["hw"] == (side == "home"), ro, win_prob(ref - ro + edge), top25, bottom)
    for c in titles:
        g = titles[c]
        if g["hw"] == None:
            continue
        w, l = (g["home"], g["away"]) if g["hw"] else (g["away"], g["home"])
        sc[w] += feature_score(True, r[l], win_prob(ref - r[l]), top25, bottom) + W["champ"]
        sc[l] += feature_score(False, r[w], win_prob(ref - r[w]), top25, bottom)
    return sc

def committee_offsets(scores, ranked):
    """Nudge each team toward the slot the committee gave it."""
    slots = sorted(scores.values(), reverse = True)
    out = {}
    for i, t in enumerate(ranked):
        if t in scores:
            out[t] = CARRYOVER * (slots[i] - scores[t])
    cut = slots[min(len(ranked), len(slots) - 1)]
    for t in scores:
        if t not in out and scores[t] > cut:
            out[t] = CARRYOVER * (cut - scores[t])
    return out

def select_field(order, champs):
    """2026 rules: ACC/Big Ten/Big 12/SEC champions, the best-ranked team from
    the other six conferences, Notre Dame if top 12, then at-large; straight
    seeding by ranking."""
    rank = {}
    for i, t in enumerate(order):
        rank[t] = i
    auto = []
    for c in POWER4:
        best = None
        for t in champs:
            if CONF.get(t) == c and (best == None or rank.get(t, 999) < rank.get(best, 999)):
                best = t
        if best != None:
            auto.append(best)
    for t in order:
        if CONF.get(t) in GROUP6:
            auto.append(t)
            break
    if rank.get(NOTRE_DAME, 999) < 12 and NOTRE_DAME not in auto:
        auto.append(NOTRE_DAME)
    field = list(auto)
    for t in order:
        if len(field) >= 12:
            break
        if t not in field:
            field.append(t)
    # Automatic qualifiers can push out the last at-large teams.
    for _ in range(12):
        if len(field) <= 12:
            break
        worst = None
        for t in field:
            if t not in auto and (worst == None or rank.get(t, 999) > rank.get(worst, 999)):
                worst = t
        field.remove(worst)
    return sorted(field, key = lambda t: rank.get(t, 999))

def toi(x):
    """Committee-score points to integer thousandths (sims add whole numbers)."""
    return int(x * 1000.0 + (0.5 if x >= 0 else -0.5))

P_SCALE = 2147483646         # chances as integers on the random generator's range

def next_rand(seed):
    # Park-Miller minimal standard via Schrage's method: every intermediate
    # stays under 2^31, so nothing is allocated per draw.
    seed = 16807 * (seed % 127773) - 2836 * (seed // 127773)
    return seed + 2147483647 if seed <= 0 else seed

def ahead(i, j, w, l, rr):
    """Team i ahead of j: better conference win percentage, then rating."""
    a = w[i] * max(1, w[j] + l[j])
    b = w[j] * max(1, w[i] + l[i])
    return a > b or (a == b and rr[i] > rr[j])

def same_pct(i, j, w, l):
    return w[i] * max(1, w[j] + l[j]) == w[j] * max(1, w[i] + l[i])

def top_two(group, w, l, rr, met_done, met_open, hw):
    """Two leaders of a conference or division; a two-way tie on percentage
    goes to the head-to-head winner."""
    first, second = -1, -1
    for i in group:
        if first < 0 or ahead(i, first, w, l, rr):
            first, second = i, first
        elif second < 0 or ahead(i, second, w, l, rr):
            second = i
    if second >= 0 and same_pct(first, second, w, l):
        key = first * 1000 + second
        won = met_done.get(key)
        if won == None and key in met_open:
            k, home_i = met_open[key]
            won = home_i if hw[k] else (second if home_i == first else first)
        if won == second:
            first, second = second, first
    return first, second

def pick_field(order, champs, champ_conf, g6, nd):
    """12-team field by 2026 rules, as indices (see select_field)."""
    auto = []
    for c in POWER4:
        for i in champs:
            if champ_conf[i] == c:
                auto.append(i)
    for i in order:
        if g6[i]:
            auto.append(i)
            break
    if nd >= 0 and nd in order[:12] and nd not in auto:
        auto.append(nd)
    field = list(auto)
    for i in order:
        if len(field) >= 12:
            break
        if i not in field:
            field.append(i)
    return field

def simulate(games, titles, r, home, offsets):
    """Monte Carlo of the rest of the season, the conference title games
    and the committee's final order. Returns playoff %, average rank and
    title chances by team. Scores are integer thousandths and teams are
    list indices, so a simulated season allocates only a few small lists."""
    ref, top25, bottom = cutoffs(r)
    ids = sorted(CONF.keys())
    ix = {t: i for i, t in enumerate(ids)}
    n = len(ids)
    base = [toi(W["power"] * r[t] + (W["g6"] if CONF[t] in GROUP6 else 0.0) + offsets.get(t, 0.0)) for t in ids]
    w0 = [0] * n
    l0 = [0] * n
    open_games = []
    met_done = {}
    met_open = {}
    for g in games:
        d = {}
        for side in ("home", "away"):
            t = g[side]
            if t not in ix:
                continue
            opp = g["away"] if side == "home" else g["home"]
            ro = r.get(pool(opp), -25.0)
            edge = 0.0 if g["neutral"] else (home if side == "home" else -home)
            pref = win_prob(ref - ro + edge)
            if g["hw"] != None:
                base[ix[t]] += toi(feature_score(g["hw"] == (side == "home"), ro, pref, top25, bottom))
            else:
                d[side] = (toi(feature_score(True, ro, pref, top25, bottom)), toi(feature_score(False, ro, pref, top25, bottom)))
        hi, ai = ix.get(g["home"], -1), ix.get(g["away"], -1)
        conf = g["conf"] and hi >= 0 and ai >= 0
        if g["hw"] != None:
            if conf:
                wi, li = (hi, ai) if g["hw"] else (ai, hi)
                w0[wi] += 1
                l0[li] += 1
                met_done[hi * 1000 + ai] = wi
                met_done[ai * 1000 + hi] = wi
            continue
        dh = d.get("home", (0, 0))
        da = d.get("away", (0, 0))
        if conf:
            met_open[hi * 1000 + ai] = (len(open_games), hi)
            met_open[ai * 1000 + hi] = (len(open_games), hi)
        open_games.append((hi, ai, int(g["p"] * P_SCALE), dh[0], dh[1], da[0], da[1], conf))

    members = {}
    for t in ids:
        if CONF[t] != INDEPENDENT:
            members.setdefault(CONF[t], []).append(ix[t])
    confs = sorted(members.keys())
    divs = {}
    for c in confs:
        dv = {}
        for i in members[c]:
            if ids[i] in DIVISION:
                dv.setdefault(DIVISION[ids[i]], []).append(i)
        if len(dv) >= 2:
            divs[c] = [dv[k] for k in sorted(dv.keys())]
    by_rating = sorted(range(n), key = lambda i: r[ids[i]])
    rr = [0] * n
    for pos, i in enumerate(by_rating):
        rr[i] = pos
    tdata = {}
    for c in titles:
        tg = titles[c]
        if tg["home"] in ix and tg["away"] in ix:
            a, b = ix[tg["home"]], ix[tg["away"]]
            fixed = -1 if tg["hw"] == None else (a if tg["hw"] else b)
            tdata[c] = (a, b, fixed, int(tg["p"] * P_SCALE))
    pair = {}

    def title_pair(a, b):
        # Neutral-site chance a beats b; score changes for a win/loss by a, then by b.
        key = a * 1000 + b
        if key not in pair:
            ra, rb = r[ids[a]], r[ids[b]]
            pair[key] = (int(win_prob(ra - rb) * P_SCALE),
                         toi(feature_score(True, rb, win_prob(ref - rb), top25, bottom) + W["champ"]),
                         toi(feature_score(False, rb, win_prob(ref - rb), top25, bottom)),
                         toi(feature_score(True, ra, win_prob(ref - ra), top25, bottom) + W["champ"]),
                         toi(feature_score(False, ra, win_prob(ref - ra), top25, bottom)))
        return pair[key]

    champ_conf = [CONF[t] for t in ids]
    g6 = [CONF[t] in GROUP6 for t in ids]
    nd = ix.get(NOTRE_DAME, -1)
    make = [0] * n
    rank_sum = [0] * n
    champ = [0] * n
    seed = 20261206
    for _ in range(N_SIMS):
        score = list(base)
        w = list(w0)
        l = list(l0)
        hw = [False] * len(open_games)
        for k in range(len(open_games)):
            hi, ai, p, hwd, hld, awd, ald, conf = open_games[k]
            seed = next_rand(seed)
            if seed < p:
                hw[k] = True
                if hi >= 0:
                    score[hi] += hwd
                if ai >= 0:
                    score[ai] += ald
                if conf:
                    w[hi] += 1
                    l[ai] += 1
            else:
                if hi >= 0:
                    score[hi] += hld
                if ai >= 0:
                    score[ai] += awd
                if conf:
                    w[ai] += 1
                    l[hi] += 1
        champs = []
        for c in confs:
            if len(members[c]) < 2:
                continue
            tg = tdata.get(c)
            if tg:
                a, b = tg[0], tg[1]
            elif c in divs:
                a = top_two(divs[c][0], w, l, rr, met_done, met_open, hw)[0]
                b = top_two(divs[c][1], w, l, rr, met_done, met_open, hw)[0]
            else:
                a, b = top_two(members[c], w, l, rr, met_done, met_open, hw)
            p, a_win, a_lose, b_win, b_lose = title_pair(a, b)
            if tg and tg[2] >= 0:
                a_won = tg[2] == a
            else:
                if tg:
                    p = tg[3]
                seed = next_rand(seed)
                a_won = seed < p
            if a_won:
                score[a] += a_win
                score[b] += b_lose
                champs.append(a)
                champ[a] += 1
            else:
                score[b] += b_win
                score[a] += a_lose
                champs.append(b)
                champ[b] += 1
        order = sorted(range(n), key = lambda i: -score[i])
        for pos in range(n):
            rank_sum[order[pos]] += pos + 1 if pos < 40 else 41
        for i in pick_field(order, champs, champ_conf, g6, nd):
            make[i] += 1
    sims = float(N_SIMS)
    return {
        "make": {ids[i]: 100.0 * make[i] / sims for i in range(n) if make[i]},
        "avg_rank": {ids[i]: rank_sum[i] / sims for i in range(n)},
        "champ": {ids[i]: 100.0 * champ[i] / sims for i in range(n) if champ[i]},
        "members": {c: [ids[i] for i in members[c]] for c in members},
    }

def team_info(fpi, t):
    info = fpi.get(t)
    if info == None:
        colors = TEAMS.get(t, ("#555555", "#FFFFFF", "", ""))
        info = {"id": t, "abbr": "?", "team": "?", "conf": CONF[t], "w": 0, "l": 0,
                "color": colors[0], "alt": colors[1], "city": colors[2], "state": colors[3]}
    return dict(info)

def model(ctx):
    fpi = load_fpi()
    if not fpi:
        return None
    today = (ctx.now.year, ctx.now.month, ctx.now.day)
    december = today >= (SEASON, 12, 1)
    selected = today >= (int(SELECTION_DAY[:4]), int(SELECTION_DAY[5:7]), int(SELECTION_DAY[8:10]))
    sag, sag_home = load_sagarin()
    # At most 8 uncached requests: the regular week is over by Selection
    # Day, and the playoff games only exist after it.
    week = load_scoreboard({}, 600) if not selected else {}
    title_week = load_scoreboard({"dates": str(SEASON), "seasontype": "2", "week": str(TITLE_WEEK)}, 600) if december else {}
    playoff = load_scoreboard({"dates": str(SEASON), "seasontype": "3", "week": "999"}, 300) if selected else {}
    games = build_games(week)
    # Results inferred from W-L need win chances first.
    r, home = blend_ratings(games, fpi, sag, sag_home)
    set_probs(games, r, home)
    infer_results(games, fpi)
    set_probs(games, r, home)
    titles = title_games([title_week, week], r)
    ref, top25, bottom = cutoffs(r)
    official, released = [], ""
    if today >= CFP_FIRST:
        wk = week.get("week") or 0
        official, released = load_cfp((TITLE_WEEK + 1, TITLE_WEEK) if december else (wk + 1, wk))
    final = len(official) > 0 and released[:10] >= SELECTION_DAY
    by_id = {t: team_info(fpi, t) for t in CONF}
    # Playoff games ESPN has scheduled, keyed both ways round.
    po = {}
    for g in games_in(playoff):
        if "Playoff" in g["note"]:
            po[g["home"] + "@" + g["away"]] = g
            po[g["away"] + "@" + g["home"]] = g

    if final:
        # Selection Day: the committee's final ranking and the real champions.
        champs = {}
        for c in titles:
            g = titles[c]
            if g["hw"] != None:
                champs[g["home"] if g["hw"] else g["away"]] = c
        scores = current_scores(games, titles, r, home, ref, top25, bottom)
        order = official + sorted([t for t in CONF if t not in official], key = lambda t: -scores[t])
        field = select_field(order, list(champs.keys()))
        for t in by_id:
            by_id[t]["playoff"] = 100.0 if t in field else 0.0
    else:
        offsets = {}
        if official:
            offsets = committee_offsets(current_scores(games, titles, r, home, ref, top25, bottom), official)
        sim = simulate(games, titles, r, home, offsets)
        for t in by_id:
            by_id[t]["playoff"] = sim["make"].get(t, 0.0)
        order = sorted(CONF.keys(), key = lambda t: sim["avg_rank"].get(t, 99.0))
        champs = {}
        for c in sim["members"]:
            best = None
            for t in sim["members"][c]:
                if best == None or sim["champ"].get(t, 0.0) > sim["champ"].get(best, 0.0):
                    best = t
            champs[best] = c
        field = select_field(order, list(champs.keys()))
    rank = {t: i + 1 for i, t in enumerate(order)}
    in_field = {t: True for t in field}
    return {
        "r": r, "home": home, "final": final, "playoff_games": po,
        "cfp_rank": {t: i + 1 for i, t in enumerate(official)},
        "by_id": by_id, "order": order, "rank": rank, "field": field, "champs": champs,
        "in_field": in_field, "bowls": assign_bowls(field[:4], by_id, po),
        # Projected order until Selection Day (order is the official one after).
        "first_out": [t for t in order if t not in in_field][:6],
    }

def bowl_of(note):
    """Bowl named in an ESPN playoff note, from QF_BOWLS or SEMIS."""
    n = note.upper()
    for b in QF_BOWLS + SEMIS:
        if b[0].split(" ")[0] in n:
            return b
    return None

def assign_bowls(top4, by_id, po):
    """Top seeds take the closest remaining quarterfinal bowl, in seed order,
    until ESPN lists the real quarterfinal sites."""
    left = list(QF_BOWLS)
    out = {}
    for t in top4:
        for k in po:
            g = po[k]
            if k.startswith(t + "@") and "Quarterfinal" in g["note"] and bowl_of(g["note"]) != None:
                out[t] = bowl_of(g["note"])
        if out.get(t) in left:
            left.remove(out[t])
    for t in top4:
        if t in out:
            continue
        lat, lon = STATE_CENTER.get(by_id[t]["state"], (37.0, -95.0))
        best = None
        for b in left:
            d = (b[2] - lat) * (b[2] - lat) + ((b[3] - lon) * 0.8) * ((b[3] - lon) * 0.8)
            if best == None or d < best[0]:
                best = (d, b)
        out[t] = best[1]
        left.remove(best[1])
    return out


# ---------- drawing ----------

NAVY = "#06122B"
GOLD = "#F5C542"
DIM = "#8A93A6"
WHITE = "#FFFFFF"
GREEN = "#3DDC84"
RED = "#FF5A5A"

def header(c, left, right):
    c.gradient_rect(0, 0, 191, 6, "#0B2A5A", NAVY)
    c.text(left, 2, 1, font = "4x5", color = GOLD)
    if right:
        c.text(right, 189, 1, font = "4x5", color = WHITE, align = "right")

def chip(c, x, y, t, w, h):
    # Team-color block with a stripe of the alternate color.
    c.rect(x, y, x + w - 1, y + h - 1, fill = t["color"])
    c.rect(x, y + h - 1, x + w - 1, y + h - 1, fill = t["alt"])

def record(t):
    return str(t["w"]) + "-" + str(t["l"])

def pct(x):
    if x >= 99.5 and x < 100:
        return ">99%"
    if x > 0 and x < 0.5:
        return "<1%"
    return str(int(x + 0.5)) + "%"

def no_data(c):
    c.fill("#000000")
    header(c, "CFP PREDICTOR", "")
    c.text("ESPN DATA UNAVAILABLE", 96, 15, font = "5x7", color = DIM, align = "center")

def trophy(c, x, y):
    rows = [
        "..#########..",
        ".###########.",
        "#.#########.#",
        "#.####L####.#",
        ".#.###L###.#.",
        "...#######...",
        "....#####....",
        ".....###.....",
        "......#......",
        ".....###.....",
        "....DDDDD....",
        "...DDDDDDD...",
    ]
    c.sprite(rows, x, y, legend = {"#": "#E8B923", "L": "#FFE27A", "D": "#9C7310"})

# ---------- pages ----------

def intro(c, ctx):
    o = offseason(ctx)
    if o:
        off_intro(c, o)
        return
    c.fill("#000000")
    c.gradient_rect(0, 0, 191, 31, "#030A1A", "#0B2A5A", horizontal = False)
    # Bracket lines fanning toward the trophy.
    for y in [4, 10, 21, 27]:
        c.line(2, y, 14, y, "#2E4A7A")
    c.line(14, 4, 14, 10, "#2E4A7A")
    c.line(14, 21, 14, 27, "#2E4A7A")
    c.line(14, 7, 22, 7, "#2E4A7A")
    c.line(14, 24, 22, 24, "#2E4A7A")
    c.line(22, 7, 22, 24, "#2E4A7A")
    c.line(22, 15, 30, 15, GOLD)
    trophy(c, 32, 9)
    c.text_stroke("CFP", 52, 1, font = "10x16_bold", color = WHITE, stroke = NAVY)
    # The bold font has no apostrophe; a small gold tick stands in.
    ax = 52 + c.text_width("CFP ", "10x16_bold")
    c.rect(ax, 2, ax + 1, 6, fill = GOLD)
    c.text_stroke("26", ax + 4, 1, font = "10x16_bold", color = GOLD, stroke = NAVY)
    m = model(ctx)
    final = m != None and m["final"]
    label = "OFFICIAL BRACKET" if final else "PROJECTED BRACKET"
    c.rect(52, 20, 52 + c.text_width(label, "5x7") + 5, 28, fill = "#C8102E")
    c.text(label, 55, 21, font = "5x7", color = WHITE)
    c.text("TITLE GAME" if final else "SEL. DAY", 189, 3, font = "4x5", color = DIM, align = "right")
    c.text("JAN 25" if final else "DEC 6", 189, 10, font = "4x5", color = GOLD, align = "right")

def crown(c, x, y):
    c.sprite(["#.#.#", "#####", ".###."], x, y, legend = {"#": GOLD})

def seed_page(c, ctx, lo):
    m = model(ctx)
    if not m:
        no_data(c)
        return
    c.fill("#000000")
    seeds = "SEEDS " + str(lo) + "-" + str(lo + 5)
    # Between the first release and Selection Day, the committee's current
    # rank sits beside each projected seed.
    show_cfp = len(m["cfp_rank"]) > 0 and not m["final"]
    if m["final"]:
        header(c, "OFFICIAL BRACKET", seeds)
    elif show_cfp:
        header(c, "PROJECTED " + seeds, "")
        c.text("CFP RANK", 189, 1, font = "4x5", color = DIM, align = "right")
    else:
        header(c, "PROJECTED BRACKET", seeds)
    for i in range(6):
        s = lo + i
        tid = m["field"][s - 1]
        t = m["by_id"][tid]
        x = (i // 3) * 96 + 1
        y = 9 + (i % 3) * 8
        c.text(str(s), x + 10, y, font = "5x7", color = GOLD, align = "right")
        chip(c, x + 13, y, t, 3, 7)
        room = (65 if show_cfp else 69) - (6 if tid in m["champs"] else 0)
        name = t["team"] if c.text_width(t["team"], "5x7") <= room else t["abbr"]
        c.text(name, x + 18, y, font = "5x7", color = WHITE)
        if tid in m["champs"]:
            crown(c, x + 19 + c.text_width(name, "5x7"), y + 2)
        if show_cfp:
            cr = m["cfp_rank"].get(tid)
            c.text(str(cr) if cr else "NR", x + 93, y + 1, font = "4x5", color = DIM, align = "right")
    c.line(95, 9, 95, 31, "#1C2433")

def seeds_1(c, ctx):
    o = offseason(ctx)
    if o:
        off_champion(c, o)
        return
    seed_page(c, ctx, 1)

def seeds_2(c, ctx):
    o = offseason(ctx)
    if o:
        off_road(c, o)
        return
    seed_page(c, ctx, 7)

G6_BLUE = "#6FA8DC"

def first_out(c, ctx):
    o = offseason(ctx)
    if o:
        off_results_early(c, o)
        return
    m = model(ctx)
    if not m:
        no_data(c)
        return
    c.fill("#000000")
    if m["final"]:
        header(c, "FIRST SIX OUT", "")
        c.text("FINAL CFP RANKING", 189, 1, font = "4x5", color = DIM, align = "right")
        for i, tid in enumerate(m["first_out"][:6]):
            t = m["by_id"][tid]
            x = (i % 2) * 96 + 1
            y = 9 + (i // 2) * 8
            name = t["team"] if c.text_width(t["team"], "5x7") <= 56 else t["abbr"]
            c.text(str(m["rank"][tid]), x + 11, y + 1, font = "4x5", color = GOLD, align = "right")
            chip(c, x + 14, y, t, 3, 7)
            c.text(name, x + 19, y, font = "5x7", color = WHITE)
            c.text(record(t), x + 92, y + 1, font = "4x5", color = DIM, align = "right")
        c.line(95, 9, 95, 31, "#1C2433")
        return
    header(c, "FIRST FOUR OUT", "")
    c.text("+ NEXT G6", 189, 1, font = "4x5", color = G6_BLUE, align = "right")
    out = m["first_out"][:4]
    # The two Group of Six teams likeliest to take the bid behind its holder.
    g6 = [t for t in m["order"] if CONF.get(t) in GROUP6 and t not in m["in_field"] and t not in out]
    g6 = sorted(g6, key = lambda t: -m["by_id"][t]["playoff"])[:2]
    for i, tid in enumerate(out + g6):
        t = m["by_id"][tid]
        x = (i % 2) * 96 + 1
        y = 9 + (i // 2) * 8
        name = t["team"]
        if c.text_width(name, "5x7") > 56:
            name = t["abbr"]
        c.text(str(m["rank"][tid]), x + 11, y + 1, font = "4x5", color = DIM, align = "right")
        chip(c, x + 14, y, t, 3, 7)
        c.text(name, x + 19, y, font = "5x7", color = WHITE)
        c.text(pct(t["playoff"]), x + 92, y + 1, font = "4x5", color = RED if i < 4 else G6_BLUE, align = "right")
    c.line(95, 9, 95, 31, "#1C2433")

HEADER_NOTE = "PROJECTED"

def bracket_odds(m):
    """Exact odds for the 12-team bracket: each round's chances carried
    forward from the last; finished playoff games keep their real result.
    Returns, per team, the chance of reaching the quarterfinals,
    semifinals and title game and of winning it, plus the likeliest team
    in each slot."""
    seed = {i + 1: t for i, t in enumerate(m["field"])}
    r = m["r"]
    po = m["playoff_games"]
    pair_p = {}

    def p_win(x, y, edge):
        # Chance x beats y; edge = x's home field.
        key = x + "@" + y
        if key in pair_p:
            return pair_p[key]
        g = po.get(key)
        if g == None:
            p = win_prob(r[x] - r[y] + edge)
        elif g["done"]:
            p = 1.0 if (g["margin"] > 0) == (g["home"] == x) else 0.0
        else:
            ph = game_prob(g, r[g["home"]] - r[g["away"]] + (0.0 if g["neutral"] else m["home"]))
            p = ph if g["home"] == x else 1.0 - ph
        pair_p[key] = p
        return p

    def play(side_a, side_b, edge):
        # Winner of a game between two {team: chance} sides.
        out = {}
        for x in side_a:
            for y in side_b:
                both = side_a[x] * side_b[y]
                pw = p_win(x, y, edge)
                out[x] = out.get(x, 0.0) + both * pw
                out[y] = out.get(y, 0.0) + both * (1.0 - pw)
        return out

    fr_games = ((5, 12), (6, 11), (7, 10), (8, 9))
    fr_win = {}
    for a, b in fr_games:
        fr_win[a] = play({seed[a]: 1.0}, {seed[b]: 1.0}, m["home"])
    qf_win = {}
    for top, low in ((1, 8), (2, 7), (3, 6), (4, 5)):
        qf_win[top] = play({seed[top]: 1.0}, fr_win[low], 0.0)
    sf_win = [play(qf_win[1], qf_win[4], 0.0), play(qf_win[2], qf_win[3], 0.0)]
    title = play(sf_win[0], sf_win[1], 0.0)

    odds = {}
    for t in m["field"]:
        s = seed_of(m, t)
        qf = 1.0 if s <= 4 else fr_win[s if s <= 8 else 17 - s].get(t, 0.0)
        sf = 0.0
        for top in qf_win:
            sf += qf_win[top].get(t, 0.0)
        odds[t] = [100.0 * qf, 100.0 * sf, 100.0 * (sf_win[0].get(t, 0.0) + sf_win[1].get(t, 0.0)), 100.0 * title.get(t, 0.0)]

    def likelier(a, b, rnd):
        return a if odds[a][rnd] >= odds[b][rnd] else b

    fr = {a: likelier(seed[a], seed[b], 0) for a, b in fr_games}
    qf = {top: likelier(seed[top], fr[low], 1) for top, low in ((1, 8), (2, 7), (3, 6), (4, 5))}
    semis = [(qf[1], qf[4]), (qf[2], qf[3])]
    finalists = [likelier(a, b, 2) for a, b in semis]
    champ = likelier(finalists[0], finalists[1], 3)
    return seed, odds, fr, qf, semis, finalists, champ

def final_score(m, x, y):
    """'34-24' (winner first) if x and y have played, else None."""
    g = m["playoff_games"].get(x + "@" + y)
    if g == None or not g["done"]:
        return None
    hi, lo = max(g["hs"], g["as"]), min(g["hs"], g["as"])
    return str(hi) + "-" + str(lo)

def result_text(c, m, x, y, w, odds_pct, right, row):
    """Final score once played, else the sim chance; True if final."""
    s = final_score(m, x, y)
    if s:
        c.text(s, right, row, font = "4x5", color = WHITE, align = "right")
        return True
    c.text(pct(odds_pct), right, row, font = "4x5", color = GREEN, align = "right")
    return False

MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]

def et_day(iso):
    """ESPN's UTC kickoff as an Eastern calendar day, e.g. 'JAN 9'."""
    if len(iso) < 13 or not iso[5:7].isdigit() or not iso[8:10].isdigit() or not iso[11:13].isdigit():
        return ""
    mo, d, h = int(iso[5:7]), int(iso[8:10]), int(iso[11:13])
    if h < 5:
        d -= 1
        if d == 0:
            mo = 12 if mo == 1 else mo - 1
            d = 31 if mo in (1, 3, 5, 7, 8, 10, 12) else 30
    return MONTHS[mo - 1] + " " + str(d)

def seed_of(m, tid):
    return m["field"].index(tid) + 1

def full_matchup(c, m, x, y, a, b, winner):
    """'1 [chip] OHIO STATE  V  9 [chip] TEXAS'; winner green, loser dimmed.
    Names wider than 50 px fall back to the abbreviation."""
    for tid, cx in ((a, x), (b, x + 74)):
        t = m["by_id"][tid]
        name = t["team"] if c.text_width(t["team"], "4x5") <= 50 else t["abbr"]
        c.text(str(seed_of(m, tid)), cx + 9, y, font = "4x5", color = GOLD, align = "right")
        chip(c, cx + 11, y, t, 3, 5)
        c.text(name, cx + 16, y, font = "4x5", color = GREEN if tid == winner else DIM)
    c.text("V", x + 68, y, font = "4x5", color = DIM)

def sims_header(c, left, done):
    """Round header; PROJECTED until every game on the page is final."""
    header(c, left, "")
    c.text("FINAL" if done else HEADER_NOTE, 189, 1, font = "4x5", color = GOLD if done else "#FF9F43", align = "right")

def first_round(c, ctx):
    o = offseason(ctx)
    if o:
        off_results_late(c, o)
        return
    m = model(ctx)
    if not m:
        no_data(c)
        return
    c.fill("#000000")
    seed, odds, fr, _, _, _, _ = bracket_odds(m)
    done = 0
    # Lower seed visits the higher seed: "12 BOISE ST AT 5 INDIANA".
    for i, (a, b) in enumerate([(5, 12), (6, 11), (7, 10), (8, 9)]):
        y = 8 + i * 6
        w = fr[a]
        for s, x in ((b, 1), (a, 92)):
            t = m["by_id"][seed[s]]
            name = t["team"] if c.text_width(t["team"], "4x5") <= 58 else t["abbr"]
            c.text(str(s), x + 9, y, font = "4x5", color = GOLD, align = "right")
            chip(c, x + 11, y, t, 3, 5)
            c.text(name, x + 16, y, font = "4x5", color = GREEN if seed[s] == w else DIM)
        c.text("AT", 81, y, font = "4x5", color = DIM)
        if result_text(c, m, seed[a], seed[b], w, odds[w][0], 189, y):
            done += 1
    sims_header(c, "FIRST ROUND  DEC 18-19", done == 4)

def quarters(c, ctx):
    o = offseason(ctx)
    if o:
        off_ap(c, o)
        return
    m = model(ctx)
    if not m:
        no_data(c)
        return
    c.fill("#000000")
    seed, odds, fr, qf, _, _, _ = bracket_odds(m)
    done = 0
    for i, (top, low) in enumerate(((1, 8), (2, 7), (3, 6), (4, 5))):
        y = 8 + i * 6
        w = qf[top]
        full_matchup(c, m, 1, y, seed[top], fr[low], w)
        s = final_score(m, seed[top], fr[low])
        if s:
            done += 1
            c.text(s, 189, y, font = "4x5", color = WHITE, align = "right")
        else:
            c.text(pct(odds[w][1]), 156, y, font = "4x5", color = GREEN, align = "right")
            c.text(m["bowls"][seed[top]][0].replace(" BOWL", ""), 189, y, font = "4x5", color = "#6FA8DC", align = "right")
    sims_header(c, "QUARTERFINALS DEC 30-JAN 1", done == 4)

def semifinals(c, ctx):
    o = offseason(ctx)
    if o:
        off_conf_champs(c, o)
        return
    m = model(ctx)
    if not m:
        no_data(c)
        return
    c.fill("#000000")
    _, odds, _, _, semis, finalists, _ = bracket_odds(m)
    done = 0
    for i, (a, b) in enumerate(semis):
        y = 8 + i * 12
        bowl, day, city = SEMIS[i]
        g = m["playoff_games"].get(a + "@" + b)
        if g != None and bowl_of(g["note"]) != None:
            bowl, day, city = bowl_of(g["note"])[0], et_day(g["date"]), g["city"].upper()
        c.text(bowl, 1, y, font = "4x5", color = "#6FA8DC")
        c.text(day + "  " + city, 189, y, font = "4x5", color = DIM, align = "right")
        full_matchup(c, m, 1, y + 6, a, b, finalists[i])
        if result_text(c, m, a, b, finalists[i], odds[finalists[i]][2], 189, y + 6):
            done += 1
    sims_header(c, "SEMIFINALS", done == 2)

def final(c, ctx):
    o = offseason(ctx)
    if o:
        off_next_season(c, ctx)
        return
    m = model(ctx)
    if not m:
        no_data(c)
        return
    c.fill("#000000")
    _, odds, _, _, _, finalists, champ = bracket_odds(m)
    trophy(c, 2, 11)
    full_matchup(c, m, 20, 8, finalists[0], finalists[1], champ)
    t = m["by_id"][champ]
    s = final_score(m, finalists[0], finalists[1])
    note = ("CHAMPIONS " + s) if s else (pct(odds[champ][3]) + " TO WIN IT ALL")
    name = t["team"]
    if 20 + c.text_width(name, "5x7") + 5 + c.text_width(note, "4x5") > 189:
        name = t["abbr"]
    c.text(name, 20, 16, font = "5x7", color = GREEN)
    c.text(note, 25 + c.text_width(name, "5x7"), 17, font = "4x5", color = GOLD if s else GREEN)
    done = s != None
    sims_header(c, "NATIONAL CHAMPIONSHIP", done)
    c.text("JAN 25  ALLEGIANT STADIUM  LAS VEGAS", 20, 26, font = "4x5", color = DIM)

# ---------- offseason (after the title game) ----------
#
# A season recap read straight from ESPN's playoff games (seeds are each
# team's curatedRank there), the title games and the final AP poll: three
# requests, no season model.

OFF_CONFS = [("SEC", "8"), ("BIG TEN", "5"), ("BIG 12", "4"), ("ACC", "1"), ("AMER", "151"), ("MWC", "17"),
             ("SBC", "37"), ("C-USA", "12"), ("MAC", "15"), ("PAC-12", "9")]

def offseason(ctx):
    """Season recap once the national title game is final, else None."""
    if (ctx.now.year, ctx.now.month, ctx.now.day) < TITLE_DAY:
        return None
    board = load_scoreboard({"dates": str(SEASON), "seasontype": "3", "week": "999"}, 3600)
    rounds = {"fr": [], "qf": [], "sf": [], "f": []}
    teams = {}
    seed = {}
    for g in games_in(board):
        n = g["note"]
        key = "fr" if "First Round" in n else ("qf" if "Quarterfinal" in n else ("sf" if "Semifinal" in n else ("f" if "National Championship" in n else None)))
        if key == None:
            continue
        rounds[key].append(g)
        for tid in g["info"]:
            i = dict(g["info"][tid])
            if tid in TEAMS:
                i["color"], i["alt"] = TEAMS[tid][0], TEAMS[tid][1]
            teams[tid] = i
            if i["rank"]:
                seed[tid] = int(i["rank"])
    if len(rounds["f"]) != 1 or not rounds["f"][0]["done"]:
        return None
    f = rounds["f"][0]
    champ, runner = (f["home"], f["away"]) if f["margin"] > 0 else (f["away"], f["home"])
    # Conference champions from the title-game week.
    champs = {}
    week = load_scoreboard({"dates": str(SEASON), "seasontype": "2", "week": str(TITLE_WEEK)}, 86400)
    for g in games_in(week):
        if g["note"].endswith("Championship") and CONF.get(g["home"]) != None and CONF.get(g["home"]) == CONF.get(g["away"]) and g["done"]:
            w = g["home"] if g["margin"] > 0 else g["away"]
            champs[CONF[w]] = w
            for tid in g["info"]:
                if tid not in teams:
                    i = dict(g["info"][tid])
                    if tid in TEAMS:
                        i["color"], i["alt"] = TEAMS[tid][0], TEAMS[tid][1]
                    teams[tid] = i
    # Final AP poll.
    ap = []
    resp = http.get(RANKINGS_URL, ttl_seconds = 3600)
    if resp["status_code"] == 200 and resp["json"] != None:
        for r in resp["json"].get("rankings", []):
            if r.get("type") == "ap":
                for x in r.get("ranks", []):
                    tm = x.get("team") or {}
                    tid = str(tm.get("id", ""))
                    if tid not in teams:
                        colors = TEAMS.get(tid, ("#555555", "#FFFFFF", "", ""))
                        teams[tid] = {"abbr": str(tm.get("abbreviation", "?")).upper()[:4], "team": str(tm.get("shortDisplayName", tm.get("nickname", ""))).upper(),
                                      "color": colors[0], "alt": colors[1], "rank": None}
                    ap.append((tid, str(x.get("recordSummary", ""))))
                break
    for k in ("fr", "qf", "sf"):
        rounds[k] = sorted(rounds[k], key = lambda g: min(seed.get(g["home"], 99), seed.get(g["away"], 99)))
    return {"champ": champ, "runner": runner, "final": f, "rounds": rounds, "teams": teams, "seed": seed,
            "conf_champs": champs, "ap": ap}

def shade(hexc, f):
    """Hex color scaled toward black by factor f (0-1)."""
    digits = "0123456789ABCDEF"
    out = "#"
    for i in (1, 3, 5):
        v = int(int(hexc[i:i + 2], 16) * f)
        out += digits[v // 16] + digits[v % 16]
    return out

def ink_on(hexc):
    r = int(hexc[1:3], 16)
    g = int(hexc[3:5], 16)
    b = int(hexc[5:7], 16)
    return "#000000" if (r * 299 + g * 587 + b * 114) // 1000 > 160 else WHITE

def score_of(g):
    """'30-24', winner first."""
    return str(max(g["hs"], g["as"])) + "-" + str(min(g["hs"], g["as"]))

def winner_of(g):
    return g["home"] if g["margin"] > 0 else g["away"]

def off_intro(c, o):
    c.fill("#000000")
    c.gradient_rect(0, 0, 191, 31, "#030A1A", "#0B2A5A", horizontal = False)
    for y in [4, 10, 21, 27]:
        c.line(2, y, 14, y, "#2E4A7A")
    c.line(14, 4, 14, 10, "#2E4A7A")
    c.line(14, 21, 14, 27, "#2E4A7A")
    c.line(14, 7, 22, 7, "#2E4A7A")
    c.line(14, 24, 22, 24, "#2E4A7A")
    c.line(22, 7, 22, 24, "#2E4A7A")
    c.line(22, 15, 30, 15, GOLD)
    trophy(c, 32, 9)
    c.text_stroke("CFP", 52, 1, font = "10x16_bold", color = WHITE, stroke = NAVY)
    ax = 52 + c.text_width("CFP ", "10x16_bold")
    c.rect(ax, 2, ax + 1, 6, fill = GOLD)
    c.text_stroke(str(SEASON)[2:], ax + 4, 1, font = "10x16_bold", color = GOLD, stroke = NAVY)
    t = o["teams"][o["champ"]]
    # Banner in the champion's colors.
    w = c.text_width(t["team"], "5x7") + 6
    c.rect(52, 20, 52 + w, 28, fill = t["color"])
    c.rect(52, 28, 52 + w, 28, fill = t["alt"])
    c.text(t["team"], 55, 21, font = "5x7", color = ink_on(t["color"]))
    c.text("NATIONAL", 189, 3, font = "4x5", color = DIM, align = "right")
    c.text("CHAMPIONS", 189, 10, font = "4x5", color = GOLD, align = "right")
    c.text(score_of(o["final"]) + " V " + o["teams"][o["runner"]]["abbr"], 189, 22, font = "4x5", color = WHITE, align = "right")

def off_champion(c, o):
    t = o["teams"][o["champ"]]
    # The whole screen as the champion's banner.
    c.gradient_rect(0, 0, 191, 31, t["color"], shade(t["color"], 0.45), horizontal = True)
    c.rect(0, 0, 191, 1, fill = t["alt"])
    c.rect(0, 30, 191, 31, fill = t["alt"])
    trophy(c, 5, 10)
    c.text(str(SEASON) + " NATIONAL CHAMPIONS", 24, 4, font = "4x5", color = GOLD)
    name = t["team"]
    font = "10x16_bold" if c.text_width(name, "10x16_bold") <= 120 else "5x7"
    c.text_stroke(name, 24, 11 if font == "10x16_bold" else 15, font = font, color = WHITE, stroke = shade(t["color"], 0.3))
    c.text(score_of(o["final"]), 189, 12, font = "5x7", color = WHITE, align = "right")
    c.text("V " + o["teams"][o["runner"]]["team"], 189, 21, font = "4x5", color = ink_on(t["color"]), align = "right")

def off_road(c, o):
    """The champion's playoff run, game by game."""
    champ = o["champ"]
    t = o["teams"][champ]
    c.fill("#000000")
    c.gradient_rect(0, 0, 191, 6, t["color"], shade(t["color"], 0.4))
    c.text("ROAD TO THE TITLE", 2, 1, font = "4x5", color = GOLD)
    c.text(t["team"], 189, 1, font = "4x5", color = WHITE, align = "right")
    rows = []
    for key, label in (("fr", "FIRST RD"), ("qf", "QUARTERS"), ("sf", "SEMIS"), ("f", "TITLE")):
        mine = [g for g in o["rounds"][key] if champ in (g["home"], g["away"])]
        if mine:
            rows.append((label, mine[0]))
        elif key == "fr":
            rows.append((label, None))
    for i, (label, g) in enumerate(rows):
        y = 8 + i * 6
        c.text(label, 2, y, font = "4x5", color = GOLD if label == "TITLE" else DIM)
        if g == None:
            c.text("BYE AS A TOP-4 SEED", 46, y, font = "4x5", color = DIM)
            continue
        opp = g["away"] if g["home"] == champ else g["home"]
        ot = o["teams"][opp]
        if opp in o["seed"]:
            c.text(str(o["seed"][opp]), 55, y, font = "4x5", color = GOLD, align = "right")
        chip(c, 57, y, ot, 3, 5)
        name = ot["team"] if c.text_width(ot["team"], "4x5") <= 50 else ot["abbr"]
        c.text(name, 62, y, font = "4x5", color = WHITE)
        c.text(score_of(g), 139, y, font = "4x5", color = GREEN, align = "right")
        b = bowl_of(g["note"])
        where = b[0].replace(" BOWL", "") if b != None else g["city"].upper()
        if c.text_width(where, "4x5") <= 46:
            c.text(where, 189, y, font = "4x5", color = "#6FA8DC", align = "right")

def off_result(c, o, x, y, g):
    """'IU 42-18 BOIS': winner green, loser dimmed."""
    w = winner_of(g)
    l = g["away"] if w == g["home"] else g["home"]
    tw, tl = o["teams"][w], o["teams"][l]
    chip(c, x, y, tw, 3, 5)
    c.text(tw["abbr"], x + 5, y, font = "4x5", color = GREEN)
    c.text(score_of(g), x + 52, y, font = "4x5", color = WHITE, align = "right")
    chip(c, x + 56, y, tl, 3, 5)
    c.text(tl["abbr"], x + 61, y, font = "4x5", color = DIM)

def off_results_early(c, o):
    c.fill("#000000")
    c.gradient_rect(0, 0, 191, 6, "#0B2A5A", NAVY)
    c.text("FIRST ROUND", 2, 1, font = "4x5", color = GOLD)
    c.text("QUARTERFINALS", 98, 1, font = "4x5", color = GOLD)
    for i, g in enumerate(o["rounds"]["fr"][:4]):
        off_result(c, o, 2, 8 + i * 6, g)
    for i, g in enumerate(o["rounds"]["qf"][:4]):
        off_result(c, o, 98, 8 + i * 6, g)
    c.line(95, 8, 95, 31, "#1C2433")

def off_results_late(c, o):
    c.fill("#000000")
    header(c, "SEMIFINALS + TITLE GAME", "FINAL")
    rows = []
    for g in o["rounds"]["sf"][:2]:
        b = bowl_of(g["note"])
        rows.append((b[0] if b != None else "SEMIFINAL", g, "#6FA8DC"))
    rows.append(("TITLE GAME", o["final"], GOLD))
    for i, (label, g, col) in enumerate(rows):
        y = 9 + i * 8
        c.text(label, 2, y, font = "4x5", color = col)
        off_result(c, o, 70, y, g)
        c.text(et_day(g["date"]), 189, y, font = "4x5", color = DIM, align = "right")

def off_ap(c, o):
    c.fill("#000000")
    header(c, "FINAL AP TOP 12", "")
    for k, (tid, rec) in enumerate(o["ap"][:12]):
        t = o["teams"].get(tid)
        if t == None:
            continue
        x = (k // 4) * 64 + 1
        y = 8 + (k % 4) * 6
        c.text(str(k + 1), x + 9, y, font = "4x5", color = GOLD, align = "right")
        chip(c, x + 11, y, t, 3, 5)
        c.text(t["abbr"], x + 16, y, font = "4x5", color = GREEN if tid == o["champ"] else WHITE)
        c.text(rec, x + 60, y, font = "4x5", color = DIM, align = "right")
    for k in (1, 2):
        c.line(k * 64 - 1, 8, k * 64 - 1, 31, "#1C2433")

def off_conf_champs(c, o):
    c.fill("#000000")
    header(c, "CONFERENCE CHAMPIONS", "")
    for i, (label, cid) in enumerate(OFF_CONFS):
        tid = o["conf_champs"].get(cid)
        if tid == None or tid not in o["teams"]:
            continue
        t = o["teams"][tid]
        x = (i // 4) * 64 + 1
        y = 8 + (i % 4) * 6
        c.text(label, x + 1, y, font = "4x5", color = "#6FA8DC")
        chip(c, x + 37, y, t, 3, 5)
        c.text(t["abbr"], x + 42, y, font = "4x5", color = GREEN if tid == o["champ"] else WHITE)
        if tid == o["champ"]:
            crown(c, x + 43 + c.text_width(t["abbr"], "4x5"), y + 1)
    for k in (1, 2):
        c.line(k * 64 - 1, 8, k * 64 - 1, 31, "#1C2433")

def day_number(y, mo, d):
    """Days since 2000-01-01."""
    days_in = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    n = (y - 2000) * 365 + (y - 1997) // 4 + d
    for i in range(mo - 1):
        n += days_in[i]
    if y % 4 == 0 and mo > 2:
        n += 1
    return n

def off_next_season(c, ctx):
    c.fill("#000000")
    c.gradient_rect(0, 0, 191, 31, "#030A1A", "#0B2A5A", horizontal = False)
    ky, km, kd = NEXT_KICKOFF
    left = day_number(ky, km, kd) - day_number(ctx.now.year, ctx.now.month, ctx.now.day)
    c.text("SEE YOU IN " + str(ky), 4, 3, font = "4x5", color = GOLD)
    if left > 0:
        c.text_stroke(str(left), 4, 11, font = "10x16_bold", color = WHITE, stroke = NAVY)
        x = 8 + c.text_width(str(left), "10x16_bold")
        c.text("DAY TO" if left == 1 else "DAYS TO", x, 13, font = "4x5", color = DIM)
        c.text("KICKOFF", x, 20, font = "4x5", color = DIM)
    else:
        c.text("SEASON IS", 4, 12, font = "5x7", color = WHITE)
        c.text("UNDERWAY", 4, 21, font = "5x7", color = GREEN)
    c.line(104, 3, 104, 28, "#2E4A7A")
    c.text("WEEK 0", 110, 3, font = "4x5", color = DIM)
    c.text("SAT " + MONTHS[km - 1] + " " + str(kd), 110, 10, font = "5x7", color = WHITE)
    c.text("FIRST CFP RANKING", 110, 20, font = "4x5", color = DIM)
    c.text("EARLY NOVEMBER", 110, 26, font = "4x5", color = "#6FA8DC")
