REVIEW_THEMES = {'E613': 'elf', 'E491': 'music', 'E614': 'elf', 'E595': 'ship', 'E615': 'elf', 'E503': 'battle', 'E496': 'landscape', 'E616': 'hat', 'E522': 'elf', 'E617': 'elf', 'E527': 'prison', 'E618': 'water', 'E619': 'travel', 'E620': 'eagle', 'E531': 'elf', 'E536': 'ship', 'E555': 'gems', 'E604': 'battle', 'E564': 'death'}

def _art_kind(event_id, story_lines):
    # Editorially assigned from the entry's meaning, rather than keyword order.
    return REVIEW_THEMES.get(event_id, EVENT_THEMES.get(event_id, "landscape"))

def _accent(event_id, story_lines):
    kind = _art_kind(event_id, story_lines)
    return {"white_hand": "white", "tree": "amber", "horse": "green", "door": "green", "ring": "amber", "hat": "skyblue", "battle": "#FF7055", "mordor": "#FF3B20", "orc": "#FF3B20", "death": "#B896F4", "birth": "green", "elf": "green", "dwarf": "amber", "love": "#FF80AD", "water": "skyblue", "winter": "skyblue", "healing": "green", "ent": "green", "moon": "skyblue", "landscape": "skyblue"}.get(kind, "amber")

def _draw_scene(c, event_id, story_lines):
    art = PIXEL_ART[_art_kind(event_id, story_lines)]
    palette = ["black", "white", "amber", "green", "skyblue", "midgray", "#005A1E", "#FF3B20", "#B896F4", "#FF80AD"]
    for y in range(len(art)):
        for x in range(len(art[y])):
            value = art[y][x]
            if value:
                c.pixel(c.width - 42 + x, 3 + y, palette[value])

ARDA_MARK = [[0, 0, 0, 0, 2, 2, 2, 2, 2, 0, 0, 0, 0], [0, 0, 0, 2, 0, 0, 0, 0, 0, 2, 0, 0, 0], [0, 0, 2, 0, 0, 4, 0, 0, 0, 0, 2, 0, 0], [0, 2, 0, 0, 4, 1, 4, 0, 4, 0, 0, 2, 0], [0, 2, 0, 0, 4, 4, 4, 4, 1, 4, 0, 2, 0], [0, 2, 0, 4, 4, 4, 4, 4, 4, 4, 0, 2, 0], [0, 0, 4, 4, 4, 4, 4, 4, 4, 4, 4, 0, 0], [0, 0, 0, 2, 3, 3, 3, 3, 3, 2, 0, 0, 0], [0, 0, 0, 0, 2, 2, 2, 2, 2, 0, 0, 0, 0]]

def _draw_identity(c):
    palette = ["black", "white", "amber", "green", "skyblue"]
    for y in range(len(ARDA_MARK)):
        for x in range(len(ARDA_MARK[y])):
            value = ARDA_MARK[y][x]
            if value:
                c.pixel(10 + x, y, palette[value])

WEEK_SOURCE_DATES = {"E222":[1,13],"E359":[1,17],"E454":[1,25],"E379":[3,28],"E477":[4,6],"E252":[5,1],"E110":[5,1],"E390":[8,14],"E462":[8,22],"E461":[8,22],"E268":[10,11],"E332":[10,18]}

def _calendar_ordinal(y, m, d):
    previous = y - 1
    total = previous * 365 + previous // 4 - previous // 100 + previous // 400
    lengths = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    leap = y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)
    for i in range(m - 1):
        total += lengths[i]
        if i == 1 and leap:
            total += 1
    return total + d

def _selected(ctx):
    y, m, d = _new_york_date(ctx.now)
    key = ("0" if m < 10 else "") + str(m) + "-" + ("0" if d < 10 else "") + str(d)
    card = CARDS.get(key, ["NO CARD", "", "CHECK FEED", ["CHECK FEED"], "6x8"])
    source_date = WEEK_SOURCE_DATES.get(card[1])
    if card[0] == "THIS WEEK" and source_date:
        today_week = (_calendar_ordinal(y, m, d) - 1) // 7
        event_week = (_calendar_ordinal(y, source_date[0], source_date[1]) - 1) // 7
        if today_week != event_week:
            return ["THIS MONTH", card[1], card[2], card[3], card[4]]
    return card

