def _leap(y):
    return y % 4 == 0 and (y % 100 != 0 or y % 400 == 0)

def _previous_day(y, m, d):
    if d > 1:
        return (y, m, d - 1)
    if m == 1:
        return (y - 1, 12, 31)
    lengths = [31, 29 if _leap(y) else 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
    return (y, m - 1, lengths[m - 2])

def _days_from_civil(y, m, d):
    yy = y - 1 if m <= 2 else y
    era = (yy if yy >= 0 else yy - 399) // 400
    yoe = yy - era * 400
    mm = m + (-3 if m > 2 else 9)
    doy = (153 * mm + 2) // 5 + d - 1
    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    return era * 146097 + doe - 719468

def _sunday(y, m, occurrence):
    first_weekday = (_days_from_civil(y, m, 1) + 3) % 7
    return 1 + (6 - first_weekday) % 7 + (occurrence - 1) * 7

def _new_york_date(now):
    y = now.year
    march = _sunday(y, 3, 2)
    november = _sunday(y, 11, 1)
    start = _days_from_civil(y, 3, march) * 86400 + 7 * 3600
    end = _days_from_civil(y, 11, november) * 86400 + 6 * 3600
    offset = -4 if start <= now.unix and now.unix < end else -5
    local = now.unix + offset * 3600
    if local // 86400 < now.unix // 86400:
        return _previous_day(y, now.month, now.day)
    return (y, now.month, now.day)

