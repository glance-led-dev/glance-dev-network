def _heading(event_id):
    places = {"E489":"TIMELESS HALLS","E490":"TIMELESS HALLS","E491":"TIMELESS HALLS","E492":"TIMELESS HALLS","E493":"TIMELESS HALLS","E494":"TIMELESS HALLS","E495":"EÄ","E500":"EÄ","E523":"EÄ","E609":"EÄ","E501":"ARDA","E502":"ARDA","E504":"ARDA","E506":"ARDA","E507":"ARDA","E509":"ARDA","E510":"ARDA","E511":"ARDA","E512":"ARDA","E518":"ARDA","E521":"ARDA","E571":"ARDA","E600":"ARDA","E505":"ALMAREN","E513":"VALINOR","E514":"VALINOR","E529":"VALINOR","E537":"VALINOR","E547":"VALINOR","E548":"VALINOR","E549":"VALINOR","E554":"VALINOR","E556":"VALINOR","E557":"VALINOR","E558":"VALINOR","E562":"VALINOR","E563":"VALINOR","E568":"VALINOR","E567":"AMAN","E542":"TOL ERESSËA","E544":"TOL ERESSËA","E538":"TIRION","E539":"TIRION","E565":"TIRION","E545":"ALQUALONDË","E566":"ALQUALONDË","E559":"FORMENOS","E561":"AVATHAR","E573":"NÚMENOR","E574":"NÚMENOR","E575":"NÚMENOR","E579":"NÚMENOR","E580":"NÚMENOR","E581":"NÚMENOR","E583":"NÚMENOR","E596":"NÚMENOR","E597":"NÚMENOR","E599":"NÚMENOR","E611":"NÚMENOR","E195":"BELERIAND","E427":"BELERIAND","E497":"BELERIAND","E498":"BELERIAND","E540":"BELERIAND","E130":"DORIATH","E535":"DORIATH","E551":"DORIATH","E553":"OSSIRIAND","E134":"NARGOTHROND","E186":"NARGOTHROND","E189":"NARGOTHROND","E570":"LOSGAR","E526":"UTUMNO","E528":"UTUMNO","E572":"LINDON","E598":"UMBAR","E582":"MORDOR","E587":"MORDOR","E588":"MORDOR","E602":"MORDOR","E605":"MORDOR","E606":"MORDOR","E607":"MORDOR","E608":"MORDOR","E066":"GONDOR","E073":"GONDOR","E088":"GONDOR","E384":"GONDOR","E385":"GONDOR","E414":"GONDOR","E477":"GONDOR","E478":"GONDOR","E007":"MINAS TIRITH","E060":"MINAS TIRITH","E062":"MINAS TIRITH","E275":"MINAS TIRITH","E005":"OSGILIATH","E383":"OSGILIATH","E068":"DALE","E076":"DALE","E001":"THE SHIRE","E014":"THE SHIRE","E099":"THE SHIRE","E116":"THE SHIRE","E139":"THE SHIRE","E158":"THE SHIRE","E176":"THE SHIRE","E269":"THE SHIRE","E401":"THE SHIRE","E411":"THE SHIRE","E436":"THE SHIRE","E020":"BREE","E022":"BREE","E102":"BREE","E023":"WEATHERTOP","E024":"WEATHERTOP","E025":"WEATHERTOP","E321":"WEATHERTOP","E396":"WEATHERTOP","E026":"RIVENDELL","E031":"RIVENDELL","E034":"RIVENDELL","E100":"RIVENDELL","E157":"RIVENDELL","E163":"RIVENDELL","E219":"RIVENDELL","E221":"RIVENDELL","E252":"RIVENDELL","E322":"RIVENDELL","E370":"RIVENDELL","E394":"RIVENDELL","E045":"LOTHLÓRIEN","E046":"LOTHLÓRIEN","E082":"LOTHLÓRIEN","E083":"LOTHLÓRIEN","E249":"LOTHLÓRIEN","E342":"LOTHLÓRIEN","E486":"LOTHLÓRIEN","E038":"MORIA","E039":"MORIA","E270":"MORIA","E354":"MORIA","E356":"MORIA","E360":"MORIA","E346":"FANGORN","E392":"FANGORN","E051":"ROHAN","E061":"ROHAN","E338":"ROHAN","E391":"ROHAN","E409":"ROHAN","E010":"EDORAS","E084":"EDORAS","E085":"EDORAS","E090":"EDORAS","E095":"ISENGARD","E206":"ISENGARD","E255":"ISENGARD","E359":"ISENGARD","E461":"ISENGARD","E150":"MIRKWOOD","E168":"MIRKWOOD","E452":"MIRKWOOD","E576":"MITHLOND","E586":"EREGION"}
    if not event_id:
        return "EÄ"
    return REVIEW_PLACES.get(event_id, places.get(event_id, "MIDDLE-EARTH"))

def _draw_heading(c, label):
    plain = label.replace("Ä", "A").replace("Ë", "E").replace("Ú", "U").replace("Ó", "O").replace("É", "E")
    c.text(plain, 26, 3, font="4x5", color="gray")
    for i in range(len(label)):
        glyph = label[i]
        if glyph in ["Ä", "Ë", "Ú", "Ó", "É"]:
            x = 26 + c.text_width(plain[:i + 1], font="4x5") - c.text_width(plain[i], font="4x5")
            if glyph in ["Ä", "Ë"]:
                c.pixel(x, 1, "gray")
                c.pixel(x + 2, 1, "gray")
            else:
                c.pixel(x + 2, 1, "gray")
                c.pixel(x + 1, 2, "gray")

def _copy_width(c, text, font):
    return c.text_width(text, font=font) + 3 * (len(text.split("'")) - 1)

def _draw_copy(c, text, x, y, font, color):
    parts = text.split("'")
    for i in range(len(parts)):
        part = parts[i]
        if part:
            c.text(part, x, y, font=font, color=color)
            x += c.text_width(part, font=font) + 1
        if i < len(parts) - 1:
            c.pixel(x + 1, y, color)
            c.pixel(x, y + 1, color)
            x += 3

def _line_layout(c, lead, source, text):
    when_font = "5x7"
    when_width = max(c.text_width(lead, font=when_font), c.text_width(source, font="4x5"))
    story_x = 10 + when_width + 4 + 24 + 4
    if _copy_width(c, text, "3x7") > c.width - story_x - 10:
        when_font = "4x5"
        when_width = max(c.text_width(lead, font=when_font), c.text_width(source, font="4x5"))
        story_x = 10 + when_width + 4 + 24 + 4
    story_font = "3x7"
    for candidate in ["6x8", "5x7", "4x7", "3x7"]:
        if _copy_width(c, text, candidate) <= c.width - story_x - 10:
            story_font = candidate
            break
    return [when_font, when_width, story_x, story_font]

def _draw_inline_scene(c, event_id, story_lines, x):
    art = PIXEL_ART[_art_kind(event_id, story_lines)]
    palette = ["black", "white", "amber", "green", "skyblue", "midgray", "#005A1E", "#FF3B20", "#B896F4", "#FF80AD"]
    # Fit the existing sprite below the location band, preserving its aspect ratio.
    for y in range(20):
        for dx in range(24):
            value = art[y * 26 // 20][dx * 32 // 24]
            if value:
                c.pixel(x + dx, 10 + y, palette[value])

def main(c, ctx):
    lead, event_id, source, story_lines, font = _selected(ctx)
    text = " ".join(story_lines)
    when_font, when_width, story_x, story_font = _line_layout(c, lead, source, text)
    c.fill("black")
    c.vline(4, 3, 26, _accent(event_id, story_lines))
    _draw_identity(c)
    _draw_heading(c, _heading(event_id))
    c.text(lead, 10, 14, font=when_font, color="amber")
    if source:
        c.text(source, 10, 24, font="4x5", color="amber")
    _draw_inline_scene(c, event_id, story_lines, 10 + when_width + 4)
    _draw_copy(c, text, story_x, 14, story_font, "white")

