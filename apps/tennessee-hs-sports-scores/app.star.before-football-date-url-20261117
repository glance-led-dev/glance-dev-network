def main(c, ctx):
    c.clear()

    sport = str(ctx.inputs.get("sport", "FOOTBALL")).strip().upper()
    selected_region_raw = str(ctx.inputs.get("region", "ALL REGIONS")).strip()
    selected_region = selected_region_raw.upper()
    selected_school = str(ctx.inputs.get("school", "ALL SCHOOLS")).strip().upper()

    urls = {
        "FOOTBALL": "https://www.maxpreps.com/tn/football/scores/",
        "BOYS BASKETBALL": "https://www.maxpreps.com/tn/basketball/scores/",
        "GIRLS BASKETBALL": "https://www.maxpreps.com/tn/basketball/girls/scores/",
        "BASEBALL": "https://www.maxpreps.com/tn/baseball/scores/",
        "SOFTBALL": "https://www.maxpreps.com/tn/softball/scores/",
    }

    url = urls.get(sport, urls["FOOTBALL"])

    if selected_region != "ALL REGIONS":
        district = DISTRICTS.get(selected_region_raw)
        sport_prefixes = {
            "FOOTBALL": "FB",
            "BOYS BASKETBALL": "BBB",
            "GIRLS BASKETBALL": "GBB",
            "BASEBALL": "BASE",
            "SOFTBALL": "SB",
        }
        expected_prefix = sport_prefixes.get(sport, "FB")

        if district == None:
            c.text("DISTRICT NOT FOUND", 2, 12)
            c.text(sport, 2, 23, font="4x5")
            return

        if district["sport"] != expected_prefix:
            c.text("DISTRICT SPORT MISMATCH", 2, 12, font="4x5")
            c.text(sport, 2, 23, font="4x5")
            return

        url = (
            "https://www.maxpreps.com/tn/"
            + district["path"]
            + "/26-27/district/"
            + district["slug"]
            + "/scores/?leagueid="
            + district["id"]
        )

    response = http.get(
        url,
        headers={
            "User-Agent": "Mozilla/5.0",
            "Accept": "text/html",
        },
        ttl_seconds=300
    )

    if response["status_code"] != 200:
        c.text("MAXPREPS UNAVAILABLE", 2, 12)
        c.text(sport, 2, 23, font="4x5")
        return

    page_html = str(response["body"])
    cards = page_html.split('<li class="c"')
    games = []

    school_aliases = {
        "SHELBYVILLE CENTRAL": "SHELBYVILLE",
        "COFFEE CO. CENTRAL": "COFFEE CO.",
        "COLUMBIA CENTRAL": "COLUMBIA ACADEMY",
        "MIDDLE TENNESSEE CHRISTIAN": "MTCS",
        "JOHN OVERTON": "NASHVILLE OVERTON",
    }
    selected_school_match = school_aliases.get(selected_school, selected_school)

    for card_part in cards[1:]:
        card = '<li class="c"' + card_part

        status = ""
        status_pos = card.find('data-contest-state="')
        if status_pos >= 0:
            status_start = status_pos + len('data-contest-state="')
            status_end = card.find('"', status_start)
            if status_end > status_start:
                status = card[status_start:status_end].strip().lower()

        if status == "placeholder":
            continue

        link_pos = card.find('href="')
        if link_pos < 0:
            continue

        link_start = link_pos + len('href="')
        link_end = card.find('"', link_start)
        if link_end <= link_start:
            continue

        game_url = card[link_start:link_end]

        if "/game/" not in game_url:
            continue

        if "/inter-state/" in game_url:
            slug_start = game_url.find("/game/") + len("/game/")
            slug = game_url[slug_start:].split("/")[0]
            sides = slug.split("-vs-")
            if len(sides) != 2:
                continue
            if not sides[0].endswith("-tn") and not sides[1].endswith("-tn"):
                continue
        elif "/tn/" not in game_url:
            continue

        names = []
        name_parts = card.split('<div class="name"')

        for name_part in name_parts[1:]:
            tag_end = name_part.find(">")
            name_end = name_part.find("</div>")

            if tag_end < 0 or name_end < 0:
                continue

            raw_name = name_part[tag_end + 1:name_end]
            clean_name = ""
            parts = raw_name.split("<")

            for part in parts:
                if ">" in part:
                    clean_name += part.split(">", 1)[1]
                elif len(parts) == 1:
                    clean_name += part

            clean_name = clean_name.replace("&amp;", "&")
            clean_name = clean_name.replace("&#39;", "'")
            clean_name = clean_name.replace("&quot;", '"')
            clean_name = clean_name.strip()

            if clean_name.startswith("(#") and ")" in clean_name:
                clean_name = clean_name.split(")", 1)[1].strip()

            names.append(clean_name)

        if len(names) < 2:
            continue

        team1 = names[0]
        team2 = names[1]

        if team1 == "" or team2 == "":
            continue

        if team1.upper() in ("TBA", "VARSITY OPPONENT"):
            continue
        if team2.upper() in ("TBA", "VARSITY OPPONENT"):
            continue

        if selected_school != "ALL SCHOOLS":
            if selected_school_match != team1.strip().upper() and selected_school_match != team2.strip().upper():
                continue

        date_label = ""
        for part in game_url.split("/"):
            if part.count("-") == 2 and len(part) >= 8:
                date_label = part
                break

        details = ""
        details_pos = card.find('<div class="details"')
        if details_pos >= 0:
            details_tag_end = card.find(">", details_pos)
            details_end = card.find("</div>", details_tag_end)
            if details_tag_end >= 0 and details_end > details_tag_end:
                details = card[details_tag_end + 1:details_end]
                details = details.replace("<span>", "").replace("</span>", "")
                details = details.strip()

        games.append({
            "team1": team1,
            "team2": team2,
            "status": status,
            "date": date_label,
            "details": details,
        })


    local = central_datetime(ctx.now.unix)
    local_day = days_from_civil(local[0], local[1], local[2])

    if sport == "FOOTBALL":
        if show_upcoming_week(ctx.now.unix):
            week_start = local_day - weekday(local_day)
        else:
            week_start = local_day - weekday(local_day) - 7

        display_dates = []
        for offset in range(7):
            parts = civil_from_days(week_start + offset)
            date_text = ("0" + str(parts[1]))[-2:] + "-" + ("0" + str(parts[2]))[-2:] + "-" + str(parts[0])
            display_dates.append(date_text)
    else:
        display_day = local_day if local[3] >= 12 else local_day - 1
        parts = civil_from_days(display_day)
        display_date = ("0" + str(parts[1]))[-2:] + "-" + ("0" + str(parts[2]))[-2:] + "-" + str(parts[0])
        display_dates = [display_date]

    filtered_games = []
    for item in games:
        if item["date"] in display_dates:
            filtered_games.append(item)
    games = filtered_games

    if len(games) == 0:
        c.text("NO GAMES FOUND", 2, 12)
        c.text(sport, 2, 23, font="4x5")
        return

    page_index = int(ctx.now.unix // 60) % len(games)
    game = games[page_index]

    status = game["status"]
    color1 = "#FFFFFF"
    color2 = "#FFFFFF"

    _draw_team(c, game["team1"], 0, color1)
    _draw_team(c, game["team2"], 16, color2)

    sport_labels = {
        "FOOTBALL": "FB",
        "BOYS BASKETBALL": "BBB",
        "GIRLS BASKETBALL": "GBB",
        "BASEBALL": "BASE",
        "SOFTBALL": "SB",
    }
    sport_label = sport_labels.get(sport, sport)

    date_parts = game["date"].split("-")
    date_short = game["date"]
    if len(date_parts) == 3:
        date_short = date_parts[0] + "-" + date_parts[1]

    footer = sport_label + " " + date_short
    if game["details"] != "":
        footer = footer + " " + game["details"]

    if status == "final":
        footer = "FINAL " + sport_label + " " + date_short
    elif status == "in-progress":
        footer = "LIVE " + sport_label + " " + date_short

    c.text(footer[:28], 20, 27, font="4x5", color="#888888")

def days_from_civil(y, m, d):
    yy = y - 1 if m <= 2 else y
    era = (yy if yy >= 0 else yy - 399) // 400
    yoe = yy - era * 400
    doy = (153 * (m + (-3 if m > 2 else 9)) + 2) // 5 + d - 1
    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    return era * 146097 + doe - 719468


def civil_from_days(z):
    zz = z + 719468
    era = (zz if zz >= 0 else zz - 146096) // 146097
    doe = zz - era * 146097
    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    y = yoe + era * 400
    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    mp = (5 * doy + 2) // 153
    d = doy - (153 * mp + 2) // 5 + 1
    m = mp + (3 if mp < 10 else -9)
    return [y + 1 if m <= 2 else y, m, d]


def weekday(z):
    return (z + 3) % 7


def nth_sunday(y, m, n):
    first = 1 + ((6 - weekday(days_from_civil(y, m, 1))) % 7)
    return first + 7 * (n - 1)


def _utcmin(y, m, d, hh):
    return days_from_civil(y, m, d) * 1440 + hh * 60


def central_offset_minutes(unix_seconds):
    t = unix_seconds // 60
    y = civil_from_days(t // 1440)[0]
    standard = -360
    start = _utcmin(y, 3, nth_sunday(y, 3, 2), 2) - standard
    end = _utcmin(y, 11, nth_sunday(y, 11, 1), 2) - standard - 60
    return standard + 60 if start <= t and t < end else standard


def central_datetime(unix_seconds):
    local_minutes = unix_seconds // 60 + central_offset_minutes(unix_seconds)
    day = local_minutes // 1440
    year, month, date = civil_from_days(day)
    minute_of_day = local_minutes % 1440
    return [year, month, date, minute_of_day // 60, minute_of_day % 60, weekday(day)]



def show_upcoming_week(unix_seconds):
    local = central_datetime(unix_seconds)
    day = local[5]
    hour = local[3]

    return day > 2 or (day == 2 and hour >= 8)


def _tssaa_clean(raw):
    out = ""
    parts = raw.split("<")

    for i in range(len(parts)):
        part = parts[i]
        if i == 0:
            out += part
        else:
            gt = part.find(">")
            if gt >= 0:
                out += part[gt + 1:]

    out = out.replace("&nbsp;", " ")
    out = out.replace("&#160;", " ")
    out = out.replace("&amp;", "&")
    out = out.replace("&#39;", "'")
    out = out.replace("&#x27;", "'")
    return " ".join(out.lstrip(">").split()).strip()


def _tssaa_number(value):
    if value == "" or not value.isdigit():
        return None
    return int(value)


def _tssaa_team_score(raw):
    clean = _tssaa_clean(raw).replace("*", "")
    for day in ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"):
        clean = clean.replace("(" + day + ")", "")
    clean = " ".join(clean.split()).strip()
    parts = clean.split()
    if len(parts) < 2:
        return [clean, None]

    score = _tssaa_number(parts[-1])
    if score == None:
        return [clean, None]

    return [" ".join(parts[:-1]), score]


def _tssaa_parse_row(row, region):
    if "<strong" in row:
        start = row.find("<strong")
        tag_end = row.find(">", start)
        tag_close = row.find("</strong>", tag_end)

        if start < 0 or tag_end < 0 or tag_close < 0:
            return None

        first = _tssaa_team_score(row[tag_end + 1:tag_close])
        second = _tssaa_team_score(row[tag_close + 9:])

        if first[1] == None or second[1] == None:
            return None

        return {
            "region": region,
            "status": "FINAL",
            "team1": first[0],
            "score1": first[1],
            "team2": second[0].lstrip(", "),
            "score2": second[1],
        }

    clean = _tssaa_clean(row)
    lower = clean.lower()
    at = lower.find(" at ")

    if at < 0:
        return None

    away = clean[:at].strip()
    home = clean[at + 4:].strip()

    if away == "" or home == "":
        return None

    return {
        "region": region,
        "status": "UPCOMING",
        "team1": away,
        "team2": home,
        "score1": None,
        "score2": None,
    }


def _tssaa_parse_region(html, region):
    lower = html.lower()
    heading = ">" + region.lower() + "</h4>"
    heading_pos = lower.find(heading)

    if heading_pos < 0:
        return []

    table_start = lower.find("<table", heading_pos)
    if table_start < 0:
        return []

    table_end = lower.find("</table>", table_start)
    if table_end < 0:
        return []

    table = html[table_start:table_end]
    games = []

    for part in table.split("<tr")[1:]:
        row_end = part.lower().find("</tr>")
        if row_end < 0:
            continue

        row = part[:row_end]
        game = _tssaa_parse_row(row, region)

        if game != None:
            games.append(game)

    return games
