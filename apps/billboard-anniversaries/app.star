# Billboard Rewind for Glance LED Panels (192x32).
#
# Shows the Billboard Hot 100 #1 song from this week 10, 20, 30, 40, 50 and
# 60 years ago, with where it sat in its run at #1.
#
# Chart data comes from mhollingshead/billboard-hot-100
# (github.com/mhollingshead/billboard-hot-100), a community-maintained archive
# of every Hot 100 chart since 1958-08-04, served as static JSON from
# raw.githubusercontent.com. It's an unofficial dataset (not a Billboard API)
# with no uptime guarantee; the app shows "CHART DATA UNAVAILABLE" if a fetch
# fails.
#
# Billboard dates every chart by its magazine issue date, always a Saturday,
# so "N years ago" uses the issue dated nearest to today's date N years back
# (see anniversary_chart_date below).

def fetch_billboard_chart(date_str):
    # A past chart never changes once published, so it's cached for 30 days.
    return http.get(
        "https://raw.githubusercontent.com/mhollingshead/billboard-hot-100/main/date/" + date_str + ".json",
        ttl_seconds = 2592000,
    )

def civil_from_days(z):
    # Howard Hinnant's days-since-epoch -> (year, month, day). z = days since 1970-01-01.
    z = z + 719468
    era = (z // 146097) if z >= 0 else ((z - 146096) // 146097)
    doe = z - era * 146097
    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    y = yoe + era * 400
    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    mp = (5 * doy + 2) // 153
    d = doy - (153 * mp + 2) // 5 + 1
    m = (mp + 3) if mp < 10 else (mp - 9)
    if m <= 2:
        y = y + 1
    return (y, m, d)

def days_from_civil(y, m, d):
    # Howard Hinnant's (year, month, day) -> days-since-epoch (1970-01-01).
    yy = (y - 1) if m <= 2 else y
    era = (yy // 400) if yy >= 0 else ((yy - 399) // 400)
    yoe = yy - era * 400
    mm = (m + 9) if m <= 2 else (m - 3)
    doy = (153 * mm + 2) // 5 + d - 1
    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    return era * 146097 + doe - 719468

def pad2(n):
    s = str(n)
    if len(s) < 2:
        s = "0" + s
    return s

def nearest_saturday_days(days):
    # epoch day 0 (1970-01-01) was a Thursday, so weekday 0=SUN .. 6=SAT.
    weekday = (days + 4) % 7
    to_this_sat = 6 - weekday
    if to_this_sat <= 3:
        return days + to_this_sat
    return days + to_this_sat - 7

def anniversary_chart_date(ctx, years_ago):
    y = ctx.now.year - years_ago
    m = ctx.now.month
    d = ctx.now.day
    if m == 2 and d == 29:
        is_leap = (y % 4 == 0 and y % 100 != 0) or (y % 400 == 0)
        if not is_leap:
            d = 28
    target_days = days_from_civil(y, m, d)
    sat_days = nearest_saturday_days(target_days)
    sy, sm, sd = civil_from_days(sat_days)
    return str(sy) + "-" + pad2(sm) + "-" + pad2(sd)

def fit_text(c, text, font, maxw):
    # Truncates with "..." to fit maxw pixels.
    if c.text_width(text, font) <= maxw:
        return text
    for i in range(len(text), 0, -1):
        candidate = text[:i] + "..."
        if c.text_width(candidate, font) <= maxw:
            return candidate
    return "..."

def fit_font(c, text, options, maxw):
    # First (biggest) font in `options` that fits `text` within maxw,
    # else the last (smallest).
    for f in options:
        if c.text_width(text, f) <= maxw:
            return f
    return options[len(options) - 1]

def decade_color(year):
    # A loose era palette keyed to the chart's decade: orange 60s, gold 70s,
    # hot pink 80s, turquoise 90s, blue 2000s, orchid 2010s, green after.
    decade = (year // 10) * 10
    if decade <= 1960:
        return "#FFA500"
    elif decade == 1970:
        return "#FFD700"
    elif decade == 1980:
        return "#FF69B4"
    elif decade == 1990:
        return "#40E0D0"
    elif decade == 2000:
        return "#1E90FF"
    elif decade == 2010:
        return "#DA70D6"
    else:
        return "#00FF7F"

MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]

def draw_chart_unavailable(c):
    c.text("CHART DATA", 96, 14, font = "4x5", color = "#888888", align = "center")
    c.text("UNAVAILABLE", 96, 20, font = "4x5", color = "#888888", align = "center")

def chart_top(date_str):
    # Returns the chart's #1 entry, or None if the chart can't be fetched.
    resp = fetch_billboard_chart(date_str)
    if resp["status_code"] != 200:
        return None
    for entry in resp["json"].get("data", []):
        if entry.get("this_week", None) == 1:
            return entry
    return None

# Weeks-at-#1 table, built once from the same mhollingshead archive
# (all.json, every chart through 2026-10-03). One 10-char record per chart
# week: YYYYMMDD + this week's number in the song's run at #1 + the song's
# total weeks at #1, both base 36. Embedded because walking the neighboring
# weekly charts live would blow past GDN's 8-uncached-requests-per-render
# limit on long runs (up to 24 weeks). Past charts never change, so this only
# needs a refresh if the app ever shows charts newer than the table.
RUNS = ""

B36 = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"

def run_at_number_one(chart_date):
    # Returns (week, total) for the song at #1 that week, or None if the
    # date isn't in the table.
    key = chart_date.replace("-", "")
    i = RUNS.find(key)
    if i < 0 or i % 10 != 0:
        return None
    return (B36.find(RUNS[i + 8]), B36.find(RUNS[i + 9]))

def ordinal(n):
    if n % 100 in (11, 12, 13):
        return str(n) + "TH"
    return str(n) + {1: "ST", 2: "ND", 3: "RD"}.get(n % 10, "TH")

PANEL_X = 132
PANEL_W = 192 - PANEL_X - 2

def draw_stats_panel(c, top, run):
    # Right-hand panel: where the song sits in its run at #1, plus one
    # supporting line (how it got there, or how long it had charted).
    c.vline(PANEL_X - 3, 10, 22, "#333333")
    cx = PANEL_X + PANEL_W // 2
    last = top.get("last_week", None)
    if run != None:
        week, total = run
        if total == 1:
            line1 = "1 WEEK"
            line2 = "AT #1"
        else:
            line1 = ordinal(week) + " WEEK"
            line2 = "OF " + str(total) + " AT #1"
        c.text(line1, cx, 10, font = "5x7", color = "white", align = "center")
        c.text(line2, cx, 18, font = "4x5", color = "#BBBBBB", align = "center")
    else:
        c.text("#1", cx, 10, font = "5x7", color = "white", align = "center")
    if last == None:
        line3 = "DEBUT AT #1"
        color3 = "#00FF7F"
    elif last != 1 and run != None and run[0] > 1:
        # Not its first week at #1: the song fell off the top and came back.
        line3 = "BACK AT #1"
        color3 = "#00FF7F"
    elif last != 1:
        line3 = "UP FROM #" + str(last)
        color3 = "#00FF7F"
    else:
        line3 = "CHART WK " + str(top.get("weeks_on_chart", 0))
        color3 = "gray"
    f3 = fit_font(c, line3, ["4x5", "picopixel"], PANEL_W)
    c.text(line3, cx, 26, font = f3, color = color3, align = "center")

# Characters each font can't draw (c.text silently drops them). A font is
# only picked for a string it can draw completely, so "DON'T" never loses
# its apostrophe just to get a bigger size.
MISSING = {
    "8x12": "\"'*;",
    "6x8": "!\"&'*;?",
    "5x7": "\"#;?@",
    "4x5": "\"*;?@",
}

FONT_H = {"8x12": 12, "6x8": 8, "5x7": 7, "4x5": 5, "picopixel": 5}

# Song/artist size combos, best first: (song font, song lines, artist font,
# artist lines). A short title gets a bigger font; a short artist moves up to
# 5x7; a long artist under a one-line title wraps to 2 lines rather than
# getting cut off. The body is rows 10-31 (22px); every combo here fits it.
LAYOUTS = [
    ("8x12", 1, "5x7", 1),
    ("8x12", 1, "4x5", 1),
    ("6x8", 1, "5x7", 1),
    ("6x8", 1, "4x5", 1),
    ("8x12", 1, "picopixel", 1),
    ("6x8", 1, "picopixel", 1),
    ("5x7", 1, "5x7", 1),
    ("5x7", 1, "4x5", 1),
    ("5x7", 2, "4x5", 1),
    ("5x7", 1, "4x5", 2),
    ("5x7", 2, "picopixel", 1),
    # Very long titles (e.g. "I WANNA DANCE WITH SOMEBODY (WHO LOVES ME)")
    # drop to the small font rather than losing their last words.
    ("4x5", 2, "4x5", 1),
    ("4x5", 2, "picopixel", 1),
]

def can_draw(text, font):
    bad = MISSING.get(font, "")
    for i in range(len(bad)):
        if bad[i] in text:
            return False
    return True

def wrap_lines(c, text, font, maxw):
    # Same greedy word wrap as c.text_wrapped, but returns the lines so a
    # layout can be tested before anything is drawn.
    lines = []
    cur = ""
    for word in text.split(" "):
        cand = word if cur == "" else cur + " " + word
        if cur == "" or c.text_width(cand, font) <= maxw:
            cur = cand
        else:
            lines.append(cur)
            cur = word
    if cur != "":
        lines.append(cur)
    return lines

def fits(c, text, font, nlines, maxw):
    if not can_draw(text, font):
        return False
    lines = wrap_lines(c, text, font, maxw)
    if len(lines) > nlines:
        return False
    for ln in lines:
        if c.text_width(ln, font) > maxw:
            return False
    return True

def draw_block(c, lines, font, y, color):
    for ln in lines:
        c.text(ln, 2, y, font = font, color = color)
        y = y + FONT_H[font] + 1

def draw_song_and_artist(c, song, artist, artist_color, maxw):
    for sf, sl, af, al in LAYOUTS:
        if fits(c, song, sf, sl, maxw) and fits(c, artist, af, al, maxw):
            slines = wrap_lines(c, song, sf, maxw)
            alines = wrap_lines(c, artist, af, maxw)
            sh = len(slines) * (FONT_H[sf] + 1) - 1
            ah = len(alines) * (FONT_H[af] + 1) - 1
            # Most of the spare rows go between the two blocks, the rest
            # split above and below.
            free = 22 - sh - ah
            pad = free // 4
            draw_block(c, slines, sf, 10 + pad, "white")
            draw_block(c, alines, af, 32 - ah - pad, artist_color)
            return

    # Nothing fits whole: title wrapped to 2 lines, artist truncated.
    c.text_wrapped(song, 2, 10, maxw, font = "5x7", color = "white", line_gap = 1, max_lines = 2)
    af = fit_font(c, artist, ["4x5", "picopixel"], maxw)
    c.text(fit_text(c, artist, af, maxw), 2, 27, font = af, color = artist_color)

def render_chart_page(c, ctx, years_ago):
    c.clear()

    chart_date = anniversary_chart_date(ctx, years_ago)
    cy, cm, cd = int(chart_date[0:4]), int(chart_date[5:7]), int(chart_date[8:10])

    # Header bar in the chart's decade color: "N YEARS AGO" left, the
    # chart's issue date right. The color follows the chart's own year, which
    # can differ from "today minus N" around New Year's.
    bg = decade_color(cy)
    c.rect(0, 0, 191, 8, fill = bg)
    c.text(str(years_ago) + " YEARS AGO", 2, 1, font = "5x7", color = "black")
    c.text(MONTHS[cm - 1] + " " + str(cd) + ", " + str(cy), 189, 1, font = "5x7", color = "black", align = "right")

    top = chart_top(chart_date)
    if top == None:
        draw_chart_unavailable(c)
        return

    song_title = top.get("song", "").upper()

    # "FEATURING" alone eats ~45px; the common "FT." keeps duet/feature
    # credits whole instead of truncating the featured artist.
    artist_upper = top.get("artist", "").upper().replace(" FEATURING ", " FT. ")

    draw_song_and_artist(c, song_title, artist_upper, bg, PANEL_X - 6)

    run = run_at_number_one(chart_date)
    draw_stats_panel(c, top, run)

DECADES = [(1960, "60S"), (1970, "70S"), (1980, "80S"), (1990, "90S"), (2000, "00S"), (2010, "10S")]

def draw_record(c, cx, cy, r, label):
    # A vinyl record: near-black disc, alternating groove rings, a colored
    # center label and spindle hole, plus a highlight glint on the grooves.
    c.fill_circle(cx, cy, r, "#151515")
    for g in range(r - 1, 6, -2):
        c.circle(cx, cy, g, "#2C2C2C")
    c.line(cx + 4, cy - r + 3, cx + r - 4, cy - 4, "#555555")
    c.fill_circle(cx, cy, 5, label)
    c.circle(cx, cy, 5, "#AA5500")
    c.fill_circle(cx, cy, 1, "black")

def intro(c, ctx):
    # An original title card, not Billboard's trademarked logo - just this
    # app's own bitmap-font styling. The decade tiles match the colors of the
    # chart pages' header bars.
    c.clear()
    draw_record(c, 15, 16, 15, "#FFA500")
    tx = 34 + (158 - c.text_width("BILLBOARD", "16x20_bold")) // 2
    c.text("BILLBOARD", tx + 1, 1, font = "16x20_bold", color = "#7A3E00")
    c.text("BILLBOARD", tx, 0, font = "16x20_bold", color = "#FFC000")
    bw = 26
    for i in range(len(DECADES)):
        year, lbl = DECADES[i]
        x0 = 35 + i * bw
        c.rect(x0, 22, x0 + bw - 2, 31, fill = decade_color(year))
        c.text(lbl, x0 + (bw - 1) // 2, 24, font = "5x7", color = "black", align = "center")

def years_10(c, ctx):
    render_chart_page(c, ctx, 10)

def years_20(c, ctx):
    render_chart_page(c, ctx, 20)

def years_30(c, ctx):
    render_chart_page(c, ctx, 30)

def years_40(c, ctx):
    render_chart_page(c, ctx, 40)

def years_50(c, ctx):
    render_chart_page(c, ctx, 50)

def years_60(c, ctx):
    render_chart_page(c, ctx, 60)
