def main(c, ctx):
    area = ctx.inputs.get("area", "ALL")
    c.clear()

    url = "https://tssaasports.com/sports/scoreboard/"

    response = http.get(
        url,
        headers={
            "User-Agent": "Mozilla/5.0",
            "Accept": "text/html",
        },
        params={"sport": "football"},
        ttl_seconds=300
    )

    if response["status_code"] != 200:
        c.text("TSSAA UNAVAILABLE", 2, 12)
        return

    html = str(response["body"])
    selected_pos = html.find("selected")

    if selected_pos < 0:
        c.text("WEEK NOT FOUND", 2, 12)
        return

    value_pos = html.rfind('value="', 0, selected_pos)

    if value_pos < 0:
        c.text("WEEK NOT FOUND", 2, 12)
        return

    value_start = value_pos + 7
    value_end = html.find('"', value_start)
    selected_week = int(html[value_start:value_end])

    selected_week_input = str(ctx.inputs.get("week", "AUTO")).strip().upper()

    if selected_week_input == "AUTO":
        display_week = selected_week
        if not show_upcoming_week(ctx.now.unix) and selected_week > 1:
            display_week = selected_week - 1
    else:
        display_week = int(selected_week_input.replace("WEEK ", "").split("(")[0].strip())

    if display_week != selected_week:
        response = http.get(
            url,
            headers={
                "User-Agent": "Mozilla/5.0",
                "Accept": "text/html",
            },
            params={
                "sport": "football",
                "week": str(display_week),
            },
            ttl_seconds=300
        )

        if response["status_code"] != 200:
            c.text("TSSAA UNAVAILABLE", 2, 12)
            return

        html = str(response["body"])

    game_date = "WEEK " + str(display_week)
    option_marker = '<option value="' + str(display_week) + '"'
    option_pos = html.find(option_marker)
    if option_pos >= 0:
        text_start = html.find(">", option_pos) + 1
        text_end = html.find("</option>", text_start)
        if text_start > 0 and text_end > text_start:
            option_text = html[text_start:text_end]
            date_start = option_text.find("(")
            date_end = option_text.find(")", date_start)
            if date_start >= 0 and date_end > date_start:
                game_date = option_text[date_start + 1:date_end].replace(".", "").upper()

    games = []
    selected_area = str(ctx.inputs.get("area", "ALL")).strip().upper()
    selected_school = str(ctx.inputs.get("school", "ALL SCHOOLS")).strip().upper()
    school_aliases = {
        "SHELBYVILLE CENTRAL": "SHELBYVILLE",
        "COFFEE CO. CENTRAL": "COFFEE CO.",
        "COLUMBIA CENTRAL": "COLUMBIA ACADEMY",
        "MIDDLE TENNESSEE CHRISTIAN": "MTCS",
        "JOHN OVERTON": "NASHVILLE OVERTON",
    }
    selected_school_match = school_aliases.get(selected_school, selected_school)

    for region in ("East", "Middle", "West"):
        if selected_area != "ALL" and region.upper() != selected_area:
            continue

        region_games = _tssaa_parse_region(html, region)
        for game in region_games:
            if selected_school != "ALL SCHOOLS":
                team1 = str(game["team1"]).strip().upper()
                team2 = str(game["team2"]).strip().upper()
                if selected_school_match != team1 and selected_school_match != team2:
                    continue
            games.append(game)

    if len(games) == 0:
        c.text("NO GAMES FOUND", 2, 12)
        c.text("WEEK " + str(display_week), 2, 23)
        return

    page = int(ctx.now.unix // 60) % len(games)
    game = games[page]

    name1 = game["team1"]
    name2 = game["team2"]

    if game["status"] == "FINAL":
        color1 = "#39D353" if game["score1"] > game["score2"] else "#FFFFFF"
        color2 = "#39D353" if game["score2"] > game["score1"] else "#FFFFFF"

        _draw_team(c, name1, 0, color1)
        _draw_team(c, name2, 16, color2)
        c.text(str(game["score1"]), 100, 0, font="10x16_bold", color=color1)
        c.text(str(game["score2"]), 100, 16, font="10x16_bold", color=color2)
        footer = "F " + game["region"].upper() + " " + game_date
    else:
        _draw_team(c, name1, 0, "#FFFFFF")
        _draw_team(c, name2, 16, "#FFFFFF")
        footer = "UPCOMING " + game["region"].upper() + " " + game_date

    c.text(footer, 20, 27, font="4x5", color="#888888")


def days_from_civil(y, m, d):
    yy = y - 1 if m <= 2 else y
    era = (yy if yy >= 0 else yy - 399) // 400
    yoe = yy - era * 400
    doy = (153 * (m + (-3 if m > 2 else 9)) + 2) // 5 + d - 1
    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    return era * 146097 + doe - 719468


def civil_from_days(z):
    zz = z + 719468
    era = (zz if zz >= 0 else zz - 146096) // 146097
    doe = zz - era * 146097
    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    y = yoe + era * 400
    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    mp = (5 * doy + 2) // 153
    d = doy - (153 * mp + 2) // 5 + 1
    m = mp + (3 if mp < 10 else -9)
    return [y + 1 if m <= 2 else y, m, d]


def weekday(z):
    return (z + 3) % 7


def nth_sunday(y, m, n):
    first = 1 + ((6 - weekday(days_from_civil(y, m, 1))) % 7)
    return first + 7 * (n - 1)


def _utcmin(y, m, d, hh):
    return days_from_civil(y, m, d) * 1440 + hh * 60


def central_offset_minutes(unix_seconds):
    t = unix_seconds // 60
    y = civil_from_days(t // 1440)[0]
    standard = -360
    start = _utcmin(y, 3, nth_sunday(y, 3, 2), 2) - standard
    end = _utcmin(y, 11, nth_sunday(y, 11, 1), 2) - standard - 60
    return standard + 60 if start <= t and t < end else standard


def central_datetime(unix_seconds):
    local_minutes = unix_seconds // 60 + central_offset_minutes(unix_seconds)
    day = local_minutes // 1440
    year, month, date = civil_from_days(day)
    minute_of_day = local_minutes % 1440
    return [year, month, date, minute_of_day // 60, minute_of_day % 60, weekday(day)]



def show_upcoming_week(unix_seconds):
    local = central_datetime(unix_seconds)
    day = local[5]
    hour = local[3]

    if day == 2 and hour >= 8:
        return True
    if day == 3 or day == 4 or day == 5:
        return True
    return False


def _tssaa_clean(raw):
    out = ""
    parts = raw.split("<")

    for i in range(len(parts)):
        part = parts[i]
        if i == 0:
            out += part
        else:
            gt = part.find(">")
            if gt >= 0:
                out += part[gt + 1:]

    out = out.replace("&nbsp;", " ")
    out = out.replace("&#160;", " ")
    out = out.replace("&amp;", "&")
    out = out.replace("&#39;", "'")
    out = out.replace("&#x27;", "'")
    return " ".join(out.split()).strip()


def _tssaa_number(value):
    if value == "" or not value.isdigit():
        return None
    return int(value)


def _tssaa_team_score(raw):
    clean = _tssaa_clean(raw).replace("*", "")
    for day in ("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"):
        clean = clean.replace("(" + day + ")", "")
    clean = " ".join(clean.split()).strip()
    parts = clean.split()
    if len(parts) < 2:
        return [clean, None]

    score = _tssaa_number(parts[-1])
    if score == None:
        return [clean, None]

    return [" ".join(parts[:-1]), score]


def _tssaa_parse_row(row, region):
    if "<strong" in row:
        start = row.find("<strong")
        tag_end = row.find(">", start)
        tag_close = row.find("</strong>", tag_end)

        if start < 0 or tag_end < 0 or tag_close < 0:
            return None

        first = _tssaa_team_score(row[tag_end + 1:tag_close])
        second = _tssaa_team_score(row[tag_close + 9:])

        if first[1] == None or second[1] == None:
            return None

        return {
            "region": region,
            "status": "FINAL",
            "team1": first[0],
            "score1": first[1],
            "team2": second[0].lstrip(", "),
            "score2": second[1],
        }

    clean = _tssaa_clean(row)
    lower = clean.lower()
    at = lower.find(" at ")

    if at < 0:
        return None

    away = clean[:at].strip()
    home = clean[at + 4:].strip()

    if away == "" or home == "":
        return None

    return {
        "region": region,
        "status": "UPCOMING",
        "team1": away,
        "team2": home,
        "score1": None,
        "score2": None,
    }


def _tssaa_parse_region(html, region):
    lower = html.lower()
    heading = ">" + region.lower() + "</h4>"
    heading_pos = lower.find(heading)

    if heading_pos < 0:
        return []

    table_start = lower.find("<table", heading_pos)
    if table_start < 0:
        return []

    table_end = lower.find("</table>", table_start)
    if table_end < 0:
        return []

    table = html[table_start:table_end]
    games = []

    for part in table.split("<tr")[1:]:
        row_end = part.lower().find("</tr>")
        if row_end < 0:
            continue

        row = part[:row_end]
        game = _tssaa_parse_row(row, region)

        if game != None:
            games.append(game)

    return games
