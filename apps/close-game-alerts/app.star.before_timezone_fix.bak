def _endpoint(sport):
    if sport == "NFL":
        return "https://site.api.espn.com/apis/site/v2/sports/football/nfl/scoreboard"

    if sport == "NCAA FOOTBALL":
        return "https://site.api.espn.com/apis/site/v2/sports/football/college-football/scoreboard"

    if sport == "NCAA BASKETBALL":
              return "https://site.api.espn.com/apis/site/v2/sports/basketball/mens-college-basketball/scoreboard"

    if sport == "NBA":
        return "https://site.api.espn.com/apis/site/v2/sports/basketball/nba/scoreboard"

    if sport == "NHL":
        return "https://site.api.espn.com/apis/site/v2/sports/hockey/nhl/scoreboard"

    if sport == "MLB":
        return "https://site.api.espn.com/apis/site/v2/sports/baseball/mlb/scoreboard"

    return ""


def _sports_from_input(value):
    text = str(value).strip()

    if text == "":
        return []

    text = text.replace("[", "").replace("]", "")

    result = []

    for item in text.split(","):
        item = item.strip().strip("'").strip('"')

        if item != "":
            result.append(item)

    if len(result) == 1 and result[0] == "ALL SPORTS":
        return [
            "NFL",
            "NCAA FOOTBALL",
            "NCAA BASKETBALL",
            "NBA",
            "NHL",
            "MLB"
        ]

    return result


def _selection(value):
    return _sports_from_input(value)


def _normalize(value):
    text = str(value).upper()
    text = text.replace("&", "AND")
    text = text.replace(".", "")
    text = text.replace("'", "")
    text = text.replace("-", " ")
    text = text.replace("/", " ")

    return " ".join(text.split())


def _team_key(sport):
    if sport == "NFL":
        return "nfl_teams"
    if sport == "NCAA FOOTBALL":
        return "ncaa_football_teams"
    if sport == "NCAA BASKETBALL":
        return "ncaa_basketball_teams"
    if sport == "NBA":
        return "nba_teams"
    if sport == "NHL":
        return "nhl_teams"
    if sport == "MLB":
        return "mlb_teams"
    return ""

def _team_selected(ctx, sport, team):
    mode = str(ctx.inputs["team_mode"]).strip().upper()
    if mode == "ALL TEAMS":
        return True

    key = _team_key(sport)
    if key == "":
        return True

    selected = _selection(ctx.inputs[key])

    for choice in selected:
        if _normalize(str(choice)) == _normalize("All Teams"):
            return True

    if len(selected) == 0:
        sport_input = str(ctx.inputs["sport"]).strip().upper()

        if sport_input == "ALL SPORTS":
            keys = [
                "nfl_teams",
                "ncaa_football_teams",
                "ncaa_basketball_teams",
                "nba_teams",
                "nhl_teams",
                "mlb_teams"
            ]

            any_selected = False
            for other_key in keys:
                if len(_selection(ctx.inputs[other_key])) > 0:
                    any_selected = True
                    break

            if any_selected:
                return False

        return True

    values = [
        team.get("displayName", ""),
        team.get("location", ""),
        team.get("shortDisplayName", ""),
        team.get("name", ""),
        team.get("abbreviation", "")
    ]

    normalized_values = []
    for value in values:
        normalized_values.append(_normalize(value))

    for choice in selected:
        wanted = _normalize(str(choice))

        for value in normalized_values:
            if wanted == value:
                return True

    return False

def _clock_seconds(clock):
    text = str(clock)
    parts = text.split(":")

    if len(parts) != 2:
        return -1

    if not parts[0].isdigit():
        return -1

    if not parts[1].isdigit():
        return -1

    return (
        int(parts[0]) * 60
        + int(parts[1])
    )


def _qualifies(sport, comp):
    competitors = comp["competitors"]

    if len(competitors) < 2:
        return False

    status = comp["status"]
    status_type = status["type"]

    state = str(
        status_type.get("state", "")
    )

    if state != "in":
        return False

    away = competitors[0]
    home = competitors[1]

    away_score = int(
        away.get("score", "0")
    )

    home_score = int(
        home.get("score", "0")
    )

    margin = abs(
        away_score - home_score
    )

    period = int(
        status.get("period", 0)
    )

    clock = str(
        status.get("displayClock", "")
    )

    if sport == "MLB":
        return (
            period >= 8
            and margin <= 1
        )

    seconds = _clock_seconds(clock)

    is_overtime = (
            (sport == "NFL" and period > 4)
            or (sport == "NCAA FOOTBALL" and period > 4)
            or (sport == "NCAA BASKETBALL" and period > 2)
            or (sport == "NBA" and period > 4)
            or (sport == "NHL" and period > 3)
    )

    if seconds < 0 and not is_overtime:
            return False

    if seconds > 300:
        return False

    if sport == "NFL":
        return (
            period >= 4
            and margin <= 8
        )

    if sport == "NCAA FOOTBALL":
        return (
            period >= 4
            and margin <= 8
        )

    if sport == "NCAA BASKETBALL":
        return (
            period >= 2
            and margin <= 6
        )

    if sport == "NBA":
        return (
            period >= 4
            and margin <= 6
        )

    if sport == "NHL":
        return (
            period >= 3
            and margin <= 1
        )

    return False


def _date_from_unix(unix_seconds):
    days = unix_seconds // 86400 + 719468
    era = days // 146097
    day_of_era = days - era * 146097
    year_of_era = (day_of_era - day_of_era // 1460 + day_of_era // 36524 - day_of_era // 146096) // 365
    year = year_of_era + era * 400
    day_of_year = day_of_era - (365 * year_of_era + year_of_era // 4 - year_of_era // 100)
    month_part = (5 * day_of_year + 2) // 153
    day = day_of_year - (153 * month_part + 2) // 5 + 1
    month = month_part + (3 if month_part < 10 else -9)
    year += 1 if month <= 2 else 0
    month_text = ("0" if month < 10 else "") + str(month)
    day_text = ("0" if day < 10 else "") + str(day)
    return str(year) + month_text + day_text


def _find_alerts(ctx, sport):
        url = _endpoint(sport)
        if url == "":
                return []

        response = http.get(
                url,
                headers={},
                params={"dates": _date_from_unix(ctx.now.unix), "groups": "80"} if sport == "NCAA FOOTBALL" else {"dates": _date_from_unix(ctx.now.unix - 86400) + "-" + _date_from_unix(ctx.now.unix)},
                ttl_seconds=60
        )

        if response["status_code"] != 200:
                return []

        data = response["json"]
        events = data.get("events", [])
        alerts = []

        for event in events:
                competitions = event.get("competitions", [])
                if len(competitions) == 0:
                        continue

                comp = competitions[0]
                competitors = comp.get("competitors", [])
                if len(competitors) < 2:
                        continue

                if str(competitors[0].get("homeAway", "")).lower() == "home":
                        home = competitors[0]
                        away = competitors[1]
                else:
                        away = competitors[0]
                        home = competitors[1]

                away_team = away["team"]
                home_team = home["team"]

                if not _team_selected(ctx, sport, away_team):
                        if not _team_selected(ctx, sport, home_team):
                                continue

                if not _qualifies(sport, comp):
                        continue

                status = comp["status"]
                status_type = status.get("type", {})

                alerts.append({
                        "sport": sport,
                        "away_id": str(away_team.get("id", "")),
                        "home_id": str(home_team.get("id", "")),
                        "away": str(away_team.get("abbreviation", "AWY")),
                        "home": str(home_team.get("abbreviation", "HOME")),
                        "away_name": str(away_team.get("displayName", "")),
                        "home_name": str(home_team.get("displayName", "")),
                        "away_score": int(away.get("score", "0")),
                        "home_score": int(home.get("score", "0")),
                        "clock": str(status.get("displayClock", "")),
                        "period": int(status.get("period", 0)),
                        "detail": str(status_type.get("detail", ""))
                })

        return alerts


