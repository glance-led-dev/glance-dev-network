def _period_label(alert):
    sport = alert["sport"]
    period = alert["period"]

    if sport == "NFL":
        return "Q" + str(period)

    if sport == "NCAA FOOTBALL":
        return "Q" + str(period)

    if sport == "NCAA BASKETBALL":
        if period > 2:
            return "OT" if period == 3 else str(period - 2) + "OT"
        return "2H"

    if sport == "NBA":
        return "Q" + str(period)

    if sport == "NHL":
        return "P" + str(period)

    return ""

def _mlb_label(alert):
    period = alert["period"]
    if period >= 10:
        return str(period) + "TH INNING"
    if period == 9:
        return "9TH INNING"
    if period >= 8:
        return "8TH INNING"
    return str(period) + "TH INNING"

def _team_font(team):
    if len(str(team)) >= 4:
        return "4x5"
    return "5x7"

def _team_x(team):
    return 25




def _team_y(team):
 return 10


def _draw_alert(c, alert):
    c.clear()

    c.progress_bar(
        0,
        0,
        128,
        8,
        100,
        color="red"
    )

    c.text_center(
        "CLOSE GAME ALERT",
        0,
        font="6x8",
        color="white"
    )

    away_logo = _logo_asset(
        alert["sport"],
        alert["away_name"],
        alert["away_id"]
    )

    home_logo = _logo_asset(
        alert["sport"],
        alert["home_name"],
        alert["home_id"]
    )

    if away_logo != "":
        c.image(
            away_logo,
            2,
            8
        )

    if home_logo != "":
        c.image(
            home_logo,
            108,
            8
        )

    if alert["sport"] == "MLB":
        away_text = alert["away"]
        away_score = str(alert["away_score"])
        home_score = str(alert["home_score"])
        home_text = alert["home"]

        away_font = _team_font(away_text)
        home_font = _team_font(home_text)
        score_font = "6x8"
        dash_text = "-"

        away_w = c.text_width(away_text, font=away_font)
        away_score_w = c.text_width(away_score, font=score_font)
        dash_w = c.text_width(dash_text, font=score_font)
        home_score_w = c.text_width(home_score, font=score_font)
        home_w = c.text_width(home_text, font=home_font)

        gap = 5
        score_gap = 1
        total_w = away_w + gap + away_score_w + score_gap + dash_w + score_gap + home_score_w + gap + home_w
        x = (128 - total_w) // 2

        c.text(away_text, x, 12, font=away_font, color="white")
        x += away_w + gap

        c.text(away_score, x, 11, font=score_font, color="yellow")
        x += away_score_w + score_gap

        c.text(dash_text, x, 12, font=score_font, color="yellow")
        x += dash_w + score_gap

        c.text(home_score, x, 11, font=score_font, color="yellow")
        x += home_score_w + gap

        c.text(home_text, x, 12, font=home_font, color="white")
    elif alert["sport"] == "NCAA BASKETBALL":
        away_text = alert["away"]
        home_text = alert["home"]
        away_score = str(alert["away_score"])
        home_score = str(alert["home_score"])
        away_font = "4x7"
        home_font = "4x7"
        score_font = "6x8"
        gap = 3
        dash = "-"
        dash_font = "5x7" if alert["sport"] == "NCAA BASKETBALL" else score_font

        away_w = c.text_width(away_text, font=away_font)
        away_score_w = c.text_width(away_score, font=score_font)
        dash_w = c.text_width(dash, font=dash_font)
        home_score_w = c.text_width(home_score, font=score_font)
        home_w = c.text_width(home_text, font=home_font)

        total_w = away_w + gap + away_score_w + dash_w + home_score_w + gap + home_w
        x = (128 - total_w) // 2

        c.text(away_text, x, 10, font=away_font, color="white")
        x += away_w + gap
        c.text(away_score, x, 10, font=score_font, color="yellow")
        x += away_score_w
        c.text(dash, x, 10, font=dash_font, color="yellow")
        x += dash_w
        c.text(home_score, x, 10, font=score_font, color="yellow")
        x += home_score_w + gap
        c.text(home_text, x, 10, font=home_font, color="white")
    else:
                away_text = alert["away"]
                home_text = alert["home"]
                away_score = str(alert["away_score"])
                home_score = str(alert["home_score"])
                team_gap = 3
                score_gap = 2
                away_font = _team_font(away_text)
                home_font = _team_font(home_text)
                score_font = "6x8"
                dash = "-"
                dash_font = score_font

                away_w = c.text_width(away_text, font=away_font)
                away_score_w = c.text_width(away_score, font=score_font)
                dash_w = c.text_width(dash, font=dash_font)
                home_score_w = c.text_width(home_score, font=score_font)
                home_w = c.text_width(home_text, font=home_font)

                total_w = away_w + team_gap + away_score_w + score_gap + dash_w + score_gap + home_score_w + team_gap + home_w
                x = (128 - total_w) // 2

                c.text(away_text, x, 10, font=away_font, color="white")
                x += away_w + team_gap
                c.text(away_score, x, 10, font=score_font, color="yellow")
                x += away_score_w + score_gap
                c.text(dash, x, 10, font=dash_font, color="yellow")
                x += dash_w + score_gap
                c.text(home_score, x, 10, font=score_font, color="yellow")
                x += home_score_w + team_gap
                c.text(home_text, x, 10, font=home_font, color="white")
    if alert["sport"] == "MLB":
        status_text = _mlb_label(
            alert
        )

    else:
        status_text = (
            alert["clock"]
            + " "
            + _period_label(alert)
        )

    c.text_center(
        status_text,
        21,
        color="green"
    )


def _draw_empty(c):
    c.clear()

    c.progress_bar(
        0,
        0,
        128,
        8,
        100,
        color="red"
    )

    c.text_center(
        "CLOSE GAME ALERT",
        0,
        font="6x8",
        color="white"
    )

    c.text_center(
        "ALL CLEAR",
        13,
          font="6x8",
        color="white"
    )


def main(c, ctx):
    mode = str(ctx.inputs["mode"]).strip().upper()

    if "TEST" in mode:
        tests = [   {   'sport': 'NFL',
        'away_id': '26',
        'home_id': '7',
        'away_name': 'Seattle Seahawks',
        'home_name': 'Denver Broncos',
        'away': 'SEA',
        'home': 'DEN',
        'away_score': 14,
        'home_score': 17,
        'clock': '2:34',
        'period': 5},
    {   'sport': 'NCAA FOOTBALL',
        'away_id': '2534',
        'home_id': '55',
        'away_name': 'Sam Houston Bearkats',
        'home_name': 'Jacksonville State Gamecocks',
        'away': 'SHSU',
        'home': 'JVST',
        'away_score': 17,
        'home_score': 10,
        'clock': '2:34',
        'period': 5},
    {   'sport': 'NCAA BASKETBALL',
        'away_id': '2057',
        'home_id': '2752',
        'away_name': 'Belmont Bruins',
        'home_name': 'Xavier Musketeers',
        'away': 'BEL',
        'home': 'XAV',
        'away_score': 77,
        'home_score': 76,
        'clock': '2:34',
        'period': 3},
    {   'sport': 'NBA',
        'away_id': '24',
        'home_id': '25',
        'away_name': 'San Antonio Spurs',
        'home_name': 'Oklahoma City Thunder',
        'away': 'SAS',
        'home': 'OKC',
        'away_score': 108,
        'home_score': 111,
        'clock': '2:34',
        'period': 5},
    {   'sport': 'NHL',
        'away_id': '18',
        'home_id': '20',
        'away_name': 'Nashville Predators',
        'home_name': 'Tampa Bay Lightning',
        'away': 'NSH',
        'home': 'TB',
        'away_score': 2,
        'home_score': 1,
        'clock': '2:34',
        'period': 4},
    {   'sport': 'MLB',
        'away_id': '119',
        'home_id': '158',
        'away_name': 'Los Angeles Dodgers',
        'home_name': 'Milwaukee Brewers',
        'away': 'LAD',
        'home': 'MIL',
        'away_score': 7,
        'home_score': 5,
        'clock': '8TH',
        'period': 9}]

        test_sport = str(ctx.inputs["test_sport"]).strip().upper()

        if test_sport == "ALL SPORTS":
            index = int(ctx.now.unix // 60) % len(tests)
            _draw_alert(c, tests[index])
        else:
            selected = [test for test in tests if test["sport"] == test_sport]
            if len(selected) > 0:
                _draw_alert(c, selected[0])
            else:
                _draw_empty(c)
        return

    sports = _sports_from_input(ctx.inputs["sport"])
    if len(sports) == 0:
        _draw_empty(c)
        return

    alerts = []
    for sport in sports:
        sport_alerts = _find_alerts(
            ctx,
            sport
        )
        for alert in sport_alerts:
            alerts.append(alert)

    if len(alerts) == 0:
        _draw_empty(c)
        return

    index = (
        (ctx.now.unix // 60) % len(alerts)
    )

    _draw_alert(
        c,
        alerts[index]
    )
