def _period_label(alert):
    sport = alert["sport"]
    period = alert["period"]

    if sport == "NFL":
        return "Q" + str(period)

    if sport == "NCAA FOOTBALL":
        return "Q" + str(period)

    if sport == "NCAA BASKETBALL":
        return "2H"

    if sport == "NBA":
        return "Q" + str(period)

    if sport == "NHL":
        return "P" + str(period)

    return ""


def _mlb_label(alert):
    period = alert["period"]

    if period == 8:
        return "8TH INNING"

    if period == 9:
        return "9TH INNING"

    if period == 10:
        return "10TH INNING"

    if period == 11:
        return "11TH INNING"

    if period == 12:
        return "12TH INNING"

    if period == 13:
        return "13TH INNING"

    if period == 14:
        return "14TH INNING"

    if period == 15:
        return "15TH INNING"

    return str(period) + "TH INNING"


def _draw_alert(c, alert):
    c.clear()

    c.progress_bar(
        0,
        0,
        128,
        8,
        100,
        color="red"
    )

    c.text_center(
        "CLOSE GAME ALERT",
        0,
        font="5x7",
        color="white"
    )

    away_logo = _logo_asset(
        alert["away_name"]
    )

    home_logo = _logo_asset(
        alert["home_name"]
    )

    if away_logo != "":
        c.image(
            away_logo,
            2,
            8
        )

    if home_logo != "":
        c.image(
            home_logo,
            108,
            8
        )

    if alert["sport"] == "MLB":
        score_text = (
            alert["away"]
            + " "
            + str(alert["away_score"])
            + " - "
            + str(alert["home_score"])
            + " "
            + alert["home"]
        )

        c.text_center(
            score_text,
            9,
            font="5x7",
            color="white"
        )

    else:
        c.text(
            alert["away"],
            25,
            9,
            font="5x7",
            color="white"
        )

        c.text(
            str(alert["away_score"]),
            48,
            9,
            font="6x8",
            color="white"
        )

        c.text(
            "-",
            61,
            9,
            font="6x8",
            color="white"
        )

        c.text(
            str(alert["home_score"]),
            68,
            9,
            font="6x8",
            color="white"
        )

        c.text(
            alert["home"],
            88,
            9,
            font="5x7",
            color="white"
        )

    if alert["sport"] == "MLB":
        status_text = _mlb_label(
            alert
        )

    else:
        status_text = (
            alert["clock"]
            + " "
            + _period_label(alert)
        )

    c.text_center(
        status_text,
        21,
        font="6x8",
        color="green"
    )


def _draw_empty(c):
    c.clear()

    c.progress_bar(
        0,
        0,
        128,
        8,
        100,
        color="red"
    )

    c.text_center(
        "CLOSE GAME ALERT",
        0,
        font="5x7",
        color="white"
    )

    c.text_center(
        "ALL CLEAR",
        13,
        font="6x8",
        color="white"
    )


def main(c, ctx):
    mode = str(
        ctx.inputs["mode"]
    ).strip().upper()

    if "TEST" in mode:
        team_mode = str(ctx.inputs["team_mode"]).strip().upper()
        selected = _selection(ctx.inputs["teams"])
        if team_mode == "SELECT SPECIFIC TEAMS" and len(selected) > 0:
            if "Milwaukee Brewers" not in selected and "San Diego Padres" not in selected:
                _draw_empty(c)
                return
        test_alert = {
            "sport": "MLB",
            "away": "MIL",
            "home": "SD",
            "away_name": "Milwaukee Brewers",
            "home_name": "San Diego Padres",
            "away_score": 2,
            "home_score": 3,
            "clock": "",
            "period": 9,
            "detail": "B 9"
        }

        _draw_alert(
            c,
            test_alert
        )

        return

    sports = _sports_from_input(
        ctx.inputs["sport"]
    )

    if len(sports) == 0:
        _draw_empty(c)
        return

    alerts = []

    for sport in sports:
        sport_alerts = _find_alerts(
            ctx,
            sport
        )

        for alert in sport_alerts:
            alerts.append(alert)

    if len(alerts) == 0:
        _draw_empty(c)
        return

    index = (
        ctx.now.second // 10
    ) % len(alerts)

    _draw_alert(
        c,
        alerts[index]
    )
