# app.star — configurable high-school sports ticker
#
# MaxPreps has no public JSON API. Each user supplies their own Parse
# API key, and the app uses Parse's maintained MaxPreps endpoints to
# find schools and retrieve team schedules.
#
# Canvas: 192x32. Layout: [sport][date][status] boxes on top, then a
# [team name][score] box row per team, all inside one outer frame.
#
# Boxes use round_rect(left, top, right, bottom, corner_radius,
# outline=color) — NOT rect(x, y, w, h, color). Confirmed working from
# a real example: corner-coordinate args, dedicated outline= keyword
# for an unfilled border, corner_radius=0 for square corners.

PARSE_BASE = "https://api.parse.bot/scraper/e0a033cc-4c08-49d5-8417-81682c9b3dbf"
PARSE_LIVE_BASE = "https://api.parse.bot/scraper/e0a033cc-4c08-49d5-8417-81682c9b3dbf"
PARSE_SNAPSHOT_VERSION = "15"
GAMECHANGER_TEAM_BASE = "https://api.team-manager.gc.com/public/teams/"

SMALL_FONT = "4x5"   # defaults used when creating each box below
TEAM_FONT  = "6x8"   # — edit a box's own "font" key directly instead
VALUE_FONT = "7x12"  # of these constants to tune one box at a time

FILL_COLOR = "darkgray"
STATUS_BAR_FILL = "darkgray"
STATUS_BAR_TEXT = "white"
BOX_COLOR = "black"  # outline color
# Last-resort sample/error fallback. Real games first resolve both schools'
# colors below; this is deliberately a neutral gold instead of cyan.
TEAM_COLOR_FALLBACK = "#d8b04a"

SCHOOL_MASCOTS = {
    "GUILFORD": "VIKINGS",
    "BOYLAN CATHOLIC": "TITANS",
    "VIEWPOINT": "PATRIOTS",
    "CLAIREMONT": "CAPTAINS",
    "C CLAIREMONT": "CAPTAINS",
    "SPACE COAST": "VIPERS",
    "SATELLITE": "SCORPIONS",
    "ROSWELL": "HORNETS",
    "WALTON": "RAIDERS",
    "UNITY CHRISTIAN": "LIONS",
    "YOUNG AMERICANS CHRISTIAN": "EAGLES",
    "CHICAGO MT. CARMEL": "CARAVAN",
    "CHICAGO MT CARMEL": "CARAVAN",
    "MT. CARMEL": "CARAVAN",
    "MT CARMEL": "CARAVAN",
    "EAST ST. LOUIS": "FLYERS",
    "EAST ST LOUIS": "FLYERS",
}

# Verified identity fallbacks for schools whose normalized schedule payload
# omits colors. Exact names prevent one-word abbreviations from colliding.
SCHOOL_COLORS = {
    "GUILFORD": ["#6cb4ee", "#ffffff"],
    "BOYLAN CATHOLIC": ["#006747", "#ffffff"],
    "VIEWPOINT": ["#c8102e", "#14213d"],
    "CLAIREMONT": ["#1565c0", "#f58220"],
    "C CLAIREMONT": ["#1565c0", "#f58220"],
}

