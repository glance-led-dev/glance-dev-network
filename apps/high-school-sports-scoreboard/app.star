    },
    # Soccer varies by state across fall, winter, and spring. Keep the
    # summer break paused while supporting each regional season.
    "Boys Soccer": {
        "code": "SOC",
        "path": "soccer/",
        "active_months": [1, 2, 3, 4, 5, 8, 9, 10, 11, 12],
        "check_minutes": [45, 105, 135],
    },
    "Girls Soccer": {
        "code": "GSC",
        "path": "soccer/girls/",
        "active_months": [1, 2, 3, 4, 5, 8, 9, 10, 11, 12],
        "check_minutes": [45, 105, 135],
    },
}

def selected_sport(ctx):
    label = ctx.inputs.get("sport", "Football")
    return SPORTS.get(label, SPORTS["Football"])

def live_refresh_seconds(ctx):
    # Studio still renders on the manifest's five-minute cadence, but this
    # user-selected bucket controls how often a new Parse Scoretracker request
    # is allowed. Renders inside the same bucket reuse the cached response.
    label = ctx.inputs.get("livefrequency", "Every 30 minutes (2 credits/hour)")
    intervals = {
        "Every 5 minutes": 300,
        "Every 5 minutes (12 credits/hour)": 300,
        "Every 10 minutes": 600,
        "Every 10 minutes (6 credits/hour)": 600,
        "Every 15 minutes": 900,
        "Every 15 minutes (4 credits/hour)": 900,
        "Every 20 minutes": 1200,
        "Every 20 minutes (3 credits/hour)": 1200,
        "Every 30 minutes": 1800,
        "Every 30 minutes (2 credits/hour)": 1800,
    }
    return intervals.get(label, 1800)

def live_pulls_enabled(ctx):
    label = ctx.inputs.get("livefrequency", "Every 30 minutes (2 credits/hour)")
    return label != "No live pulls (0 credits/hour)"

def sport_is_active(ctx, timezone):
    local = date_info_in_timezone(ctx.now.unix, timezone)
    return local["month"] in selected_sport(ctx)["active_months"]

def school_timezone_from_url(maxpreps_url):
    # A MaxPreps school URL begins /state/city/school/. This gives us a
    # deterministic local timezone without another Parse request. States that
    # span zones use their commonly encountered boundary-city exceptions.
    path = maxpreps_school_path(maxpreps_url)
    if path == None:
        return "Eastern"
    pieces = [piece for piece in path.split("/") if piece != ""]
    if len(pieces) < 2:
        return "Eastern"
    state = pieces[0].lower()
    city = pieces[1].lower()

    if state == "az":
        return "Arizona"
    if state == "ak":
        return "Alaska"
    if state == "hi":
        return "Hawaii"
    if state in ["ca", "nv", "wa"]:
        return "Pacific"
    if state in ["co", "mt", "nm", "ut", "wy"]:
        return "Mountain"
    if state in ["al", "ar", "il", "ia", "la", "mn", "ms", "mo", "ok", "wi"]:
        return "Central"

    # Regional exceptions in states divided by a time-zone boundary.
    if state == "or":
        return "Mountain" if city in ["ontario", "nyssa", "vale", "jordan-valley"] else "Pacific"
    if state == "id":
        return "Pacific" if city in ["bonners-ferry", "coeur-dalene", "kellogg", "lewiston", "moscow", "post-falls", "sandpoint"] else "Mountain"
    if state == "tx":
        return "Mountain" if city in ["el-paso", "fort-hancock", "sierra-blanca", "van-horn"] else "Central"
    if state == "fl":
        return "Central" if city in ["chipley", "crestview", "defuniak-springs", "destin", "fort-walton-beach", "marianna", "niceville", "panama-city", "pensacola"] else "Eastern"
    if state == "tn":
        return "Eastern" if city in ["athens", "bristol", "chattanooga", "cleveland", "crossville", "greeneville", "johnson-city", "kingsport", "knoxville", "morristown", "oak-ridge"] else "Central"
    if state == "ky":
        return "Central" if city in ["bowling-green", "elizabeth-town", "henderson", "hopkinsville", "madisonville", "murray", "owensboro", "paducah"] else "Eastern"
    if state == "in":
        return "Central" if city in ["crown-point", "east-chicago", "evansville", "gary", "hammond", "jasper", "la-porte", "merrillville", "princeton", "shelbyville", "tell-city", "valparaiso"] else "Eastern"
    if state == "ks":
        return "Mountain" if city in ["colby", "goodland", "grinnell", "leoti", "sharon-springs", "tribune"] else "Central"
    if state == "ne":
        return "Mountain" if city in ["alliance", "chadron", "gering", "gordon", "kimball", "scottsbluff", "sidney"] else "Central"
    if state == "sd":
        return "Mountain" if city in ["belle-fourche", "custer", "deadwood", "hot-springs", "lead", "rapid-city", "spearfish", "sturgis"] else "Central"
    if state == "nd":
        return "Mountain" if city in ["beach", "belfield", "bowman", "dickinson", "hettinger", "killdeer", "mandaree", "new-england"] else "Central"

    return "Eastern"

def school_settings(ctx):
    maxpreps_url = ctx.inputs.get("maxprepsurl", "")
    if maxpreps_url == None:
        maxpreps_url = ""
    return {
        "school": "",
        "state": "",
        "maxpreps_url": maxpreps_url.strip(),
        "timezone": school_timezone_from_url(maxpreps_url),
    }

def maxpreps_game_url(value):
    raw = str(value).strip()
    if raw == "" or "/game/" not in raw:
        return None
    if raw.startswith("/"):
        return "https://www.maxpreps.com" + raw
    if raw.startswith("https://www.maxpreps.com/") or raw.startswith("http://www.maxpreps.com/"):
        return raw
    return None

def maxpreps_school_path(value):
    raw = str(value).strip()
    if raw == "" or "/game/" in raw:
        return None
    raw = raw.split("?")[0].split("#")[0]
    raw = raw.replace("https://www.maxpreps.com", "")
    raw = raw.replace("http://www.maxpreps.com", "")
    if not raw.startswith("/"):
        raw = "/" + raw
    pieces = []
    for piece in raw.split("/"):
        if piece != "":
            pieces.append(piece)
    if len(pieces) < 3:
        return None
    if pieces[1].lower() in ["football", "basketball", "baseball", "softball", "soccer", "volleyball"]:
        return None
    return "/" + "/".join(pieces[:3]) + "/"

def contest_id_from_url(value):
    raw = str(value) if value != None else ""
    if "c=" not in raw:
        return None
    contest_id = raw.split("c=")[1].split("&")[0].split("#")[0].strip()
    return contest_id if contest_id != "" else None

def contest_metadata_value(contest, keys):
    # Schedule scraper revisions have moved game identifiers between the
    # contest itself and nested game/link objects. Search both shapes while
    # preserving the first non-empty value.
    if type(contest) != "dict":
        return None
    for key in keys:
        value = contest.get(key)
        if value != None and str(value).strip().upper() not in ["", "NONE", "NULL"]:
            return value
    for wrapper_key in [
        "game", "game_info", "gameInfo", "gameDetails", "event",
        "contest", "matchup", "scoretracker", "links", "metadata",
    ]:
        wrapper = contest.get(wrapper_key)
        wrappers = wrapper if type(wrapper) == "list" else [wrapper]
        for item in wrappers:
            if type(item) != "dict":
                continue
            for key in keys:
                value = item.get(key)
                if value != None and str(value).strip().upper() not in ["", "NONE", "NULL"]:
                    return value
            # Some link entries wrap the actual game link one level deeper.
            nested = item.get("link", item.get("game"))
            if type(nested) == "dict":
                for key in keys:
                    value = nested.get(key)
                    if value != None and str(value).strip().upper() not in ["", "NONE", "NULL"]:
                        return value
    return None

def game_scoretracker_id(game):
    if game == None:
        return None
    qwix_id = game.get("qwixCoreGameId")
    if qwix_id != None and str(qwix_id).strip() != "":
        return str(qwix_id).strip()
    contest_id = game.get("contestId")
    known_qwix_ids = {
        "f620c0b8-7df4-4eaf-9522-b258bdd74b26": "77103da1-ccd3-4534-a144-250e14f87d6e",
    }
    # A MaxPreps contest ID is not interchangeable with the internal Qwix ID.
    # When the schedule does not expose Qwix, the caller uses game_url with
    # Parse's one-credit get_scoretracker endpoint instead.
    return known_qwix_ids.get(str(contest_id))

def current_season(ctx, timezone):
    local = date_info_in_timezone(ctx.now.unix, timezone)
    start_year = local["year"] if local["month"] >= 7 else local["year"] - 1
    return str(start_year)[-2:] + "-" + str(start_year + 1)[-2:]

def normalized_school_color(color):
    if color == None or color == "":
        return None
    cleaned = str(color).strip().replace(" ", "")
    cleaned = cleaned if cleaned.startswith("#") else "#" + cleaned
    return cleaned if is_hex_color(cleaned) else None

def score_pair(result):
    parts = result.split(" ")
    for part in parts:
        if "-" in part:
            scores = part.split("-")
            if len(scores) == 2:
                return [scores[0], scores[1]]
    return None

def find_game(games, sport, kind, slot):
    for g in games:
        if g["sport"] == sport and g["type"] == kind:
            if g.get("slot") == slot:
                return g
    return None

# ---- adaptive schedule refresh ---------------------------------------------
# Parse returns local timestamps without a UTC offset. The user's selected
# school time zone lets us convert them to ctx.now for game-day refreshes.
def days_from_civil(year, month, day):
    adjusted_year = year - 1 if month <= 2 else year
    era = adjusted_year // 400
    year_of_era = adjusted_year - era * 400
    shifted_month = month + 9 if month <= 2 else month - 3
    day_of_year = (153 * shifted_month + 2) // 5 + day - 1
    day_of_era = year_of_era * 365 + year_of_era // 4 - year_of_era // 100 + day_of_year
    return era * 146097 + day_of_era - 719468

def civil_from_days(days):
    z = days + 719468
    era = z // 146097
    day_of_era = z - era * 146097
    year_of_era = (day_of_era - day_of_era // 1460 + day_of_era // 36524 - day_of_era // 146096) // 365
    year = year_of_era + era * 400
    day_of_year = day_of_era - (365 * year_of_era + year_of_era // 4 - year_of_era // 100)
    shifted_month = (5 * day_of_year + 2) // 153
    day = day_of_year - (153 * shifted_month + 2) // 5 + 1
    month = shifted_month + 3 if shifted_month < 10 else shifted_month - 9
    year += 1 if month <= 2 else 0
    return {"year": year, "month": month, "day": day}

def weekday_for_date(year, month, day):
    return (days_from_civil(year, month, day) + 4) % 7  # Sunday=0

def nth_sunday(year, month, occurrence):
    first_weekday = weekday_for_date(year, month, 1)
    first_sunday = 1 + ((7 - first_weekday) % 7)
    return first_sunday + (occurrence - 1) * 7

def timezone_offset_hours(timezone, year, month, day, hour):
    standard_offsets = {
        "Eastern": -5,
        "Central": -6,
        "Mountain": -7,
        "Pacific": -8,
        "Arizona": -7,
        "Alaska": -9,
        "Hawaii": -10,
    }
    offset = standard_offsets.get(timezone, -5)
    if timezone in ["Arizona", "Hawaii"]:
        return offset
    dst = False
    if month > 3 and month < 11:
        dst = True
    elif month == 3:
        start_day = nth_sunday(year, 3, 2)
        dst = day > start_day or (day == start_day and hour >= 2)
    elif month == 11:
        end_day = nth_sunday(year, 11, 1)
        dst = day < end_day or (day == end_day and hour < 2)
    return offset + 1 if dst else offset

# Returns the offset that is active at a specific UTC instant. This is
# used for display conversion and handles US daylight-saving boundaries
# without treating the UTC hour as though it were already local.
def timezone_offset_for_unix(timezone, unix):
    standard_offsets = {
        "Eastern": -5,
        "Central": -6,
        "Mountain": -7,
        "Pacific": -8,
        "Arizona": -7,
        "Alaska": -9,
        "Hawaii": -10,
    }
    standard = standard_offsets.get(timezone, -5)
    if timezone in ["Arizona", "Hawaii"]:
        return standard

    utc_date = civil_from_days(unix // 86400)
    year = utc_date["year"]
    start_day = nth_sunday(year, 3, 2)
    end_day = nth_sunday(year, 11, 1)
    start_utc = days_from_civil(year, 3, start_day) * 86400 + 2 * 3600 - standard * 3600
    daylight = standard + 1
    end_utc = days_from_civil(year, 11, end_day) * 86400 + 2 * 3600 - daylight * 3600
    return daylight if unix >= start_utc and unix < end_utc else standard

def parse_game_date(value):
    if value == None or len(value) < 16:
        return None
    return {
        "year": int(value[0:4]),
        "month": int(value[5:7]),
        "day": int(value[8:10]),
        "hour": int(value[11:13]),
        "minute": int(value[14:16]),
        "raw": value,
    }

def game_unix(date_info, timezone):
    offset = timezone_offset_hours(
        timezone,
        date_info["year"],
        date_info["month"],
        date_info["day"],
        date_info["hour"],
    )
    local_seconds = days_from_civil(date_info["year"], date_info["month"], date_info["day"]) * 86400
    local_seconds += date_info["hour"] * 3600 + date_info["minute"] * 60
    return local_seconds - offset * 3600

def local_now(ctx, timezone):
    offset = timezone_offset_for_unix(timezone, ctx.now.unix)
    local_unix = ctx.now.unix + offset * 3600
    local_day = local_unix // 86400
    return {
        "day": local_day,
        "week": (local_unix - 345600) // 604800,  # rolls over Monday
        "weekday": (local_day + 4) % 7,  # Sunday=0, Wednesday=3
    }

def local_week_for_unix(unix, timezone):
    offset = timezone_offset_for_unix(timezone, unix)
    local_unix = unix + offset * 3600
    return (local_unix - 345600) // 604800  # rolls over Monday

def pad2(value):
    return ("0" if value < 10 else "") + str(value)

def date_info_in_timezone(unix, timezone):
    offset = timezone_offset_for_unix(timezone, unix)
    local_unix = unix + offset * 3600
    local_day = local_unix // 86400
    seconds = local_unix - local_day * 86400
    date = civil_from_days(local_day)
    return {
        "year": date["year"],
        "month": date["month"],
        "day": date["day"],
        "hour": seconds // 3600,
        "minute": (seconds % 3600) // 60,
    }

def display_game_time(date_info, source_timezone, display_timezone):
    display_date = date_info_in_timezone(
        game_unix(date_info, source_timezone),
        display_timezone,
    )
    hour = display_date["hour"]
    suffix = "A" if hour < 12 else "P"
    display_hour = hour % 12
    if display_hour == 0:
        display_hour = 12
    weekday = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"][
        weekday_for_date(display_date["year"], display_date["month"], display_date["day"])
    ]
    return weekday + " " + str(display_date["month"]) + "/" + str(display_date["day"]) + " " + str(display_hour) + ":" + pad2(display_date["minute"]) + suffix

def schedule_request_adaptive(api_key, path, sport_path, season, cache_bucket):
    if path == None:
        return None
    return http.get(
        PARSE_BASE + "/get_team_schedule",
        headers = {
            "X-API-Key": api_key,
            "API-Snapshot-Version": PARSE_SNAPSHOT_VERSION,
            # GDN includes headers in its cache key. Parse ignores this
            # label, while it lets each planned refresh have one entry.
            "X-Glance-Refresh": cache_bucket,
        },
        params = {"path": path + sport_path, "season": season},
        ttl_seconds = 31536000,
    )

def response_auth_error(resp):
    if resp == None:
        return False
    return resp.get("status_code") == 401 or resp.get("status_code") == 403

def response_credit_error(resp):
    if resp == None:
        return False
    if resp.get("status_code") == 402:
        return True
    body = str(resp.get("body", "")).lower()
    return "credit" in body and ("insufficient" in body or "no credit" in body or "out of credit" in body)

def parsed_schedule_data(resp):
    if resp == None or resp.get("status_code") != 200:
        return None
    payload = resp.get("json")
    if type(payload) == "list":
        return {"contests": payload, "tournaments": []}
    if type(payload) != "dict":
        return None
    data = payload
    for unused in range(4):
        next_data = None
        for key in ["data", "result", "response", "body"]:
            candidate = data.get(key)
            if type(candidate) == "dict" or type(candidate) == "list":
                next_data = candidate
                break
        if next_data == None:
            break
        if type(next_data) == "list":
            return {"contests": next_data, "tournaments": []}
        data = next_data

    schedule = data.get("schedule")
    if type(schedule) == "list":
        return {"contests": schedule, "tournaments": []}
    if type(schedule) == "dict":
        data = schedule

    contests = data.get("contests")
    if type(contests) != "list":
        for key in ["games", "events", "schedule_items", "scheduleItems"]:
            candidate = data.get(key)
            if type(candidate) == "list":
                contests = candidate
                break
    if type(contests) == "list":
        normalized = {}
        for key in data:
            normalized[key] = data[key]
        normalized["contests"] = contests
        if type(normalized.get("tournaments")) != "list":
            normalized["tournaments"] = []
        return normalized
    return data

def valid_schedule(resp):
    data = parsed_schedule_data(resp)
    if data == None:
        return False
    if type(data.get("contests", [])) != "list":
        return False
    if type(data.get("tournaments", [])) != "list":
        return False
    return True

def contest_is_final(contest):
    result = str(contest.get("result", "")).strip()
    is_tie = result == "T" or result.startswith("T ")
    return result.startswith("W") or result.startswith("L") or is_tie

def event_schedule(ctx, api_key, path, sport_path, season, slot, timezone, check_minutes):
    local = local_now(ctx, timezone)
    identity = slot + "-schedule-v13-" + path + sport_path + season
    # A render must never chain schedule requests. Studio may render multiple
    # frames at once, and walking refresh phases here previously turned one
    # user action into several paid Parse calls. The HTTP cache and its lock
    # make this one weekly request reusable by every frame in the render.
    return schedule_request_adaptive(
        api_key,
        path,
        sport_path,
        season,
        identity + "-week-" + str(local["week"]),
    )

def normalized_contest_adaptive(contest, sport, slot, tracked_school, team_data, source_timezone, display_timezone):
    result = str(contest.get("result", "")).strip()
    tracked_side = contest.get("home_team", {})
    opponent_side = contest.get("away_team", {})
    tracked_is_home = tracked_side.get("is_home", False)
    home_side = tracked_side if tracked_is_home else opponent_side
    away_side = opponent_side if tracked_is_home else tracked_side
    home_fallback = tracked_school if tracked_is_home else contest.get("opponent", "TBD")
    away_fallback = tracked_school if not tracked_is_home else contest.get("opponent", "TBD")
    home_name = side_school_name(home_side, home_fallback)
    away_name = side_school_name(away_side, away_fallback)
    date_info = parse_game_date(contest.get("date"))
    tracked_record = team_record(team_data)
    away_record = team_record(away_side, tracked_record if not tracked_is_home else "0-0")
    home_record = team_record(home_side, tracked_record if tracked_is_home else "0-0")

    primary_color = normalized_school_color(team_stat(team_data, ["schoolColor1", "school_color1", "primaryColor", "primary_color", "color1", "color"]))
    secondary_color = normalized_school_color(team_stat(team_data, ["schoolColor2", "school_color2", "secondaryColor", "secondary_color", "color2"]))
    tertiary_color = normalized_school_color(team_stat(team_data, ["schoolColor3", "school_color3", "tertiaryColor", "tertiary_color", "color3"]))
    away_color = normalized_school_color(team_stat(away_side, ["schoolColor1", "school_color1", "primaryColor", "primary_color", "color1", "color"]))
    away_color2 = normalized_school_color(team_stat(away_side, ["schoolColor2", "school_color2", "secondaryColor", "secondary_color", "color2"]))
    away_color3 = normalized_school_color(team_stat(away_side, ["schoolColor3", "school_color3", "tertiaryColor", "tertiary_color", "color3"]))
    home_color = normalized_school_color(team_stat(home_side, ["schoolColor1", "school_color1", "primaryColor", "primary_color", "color1", "color"]))
    home_color2 = normalized_school_color(team_stat(home_side, ["schoolColor2", "school_color2", "secondaryColor", "secondary_color", "color2"]))
    home_color3 = normalized_school_color(team_stat(home_side, ["schoolColor3", "school_color3", "tertiaryColor", "tertiary_color", "color3"]))
    if tracked_is_home:
        home_color = home_color if home_color != None else primary_color
        home_color2 = home_color2 if home_color2 != None else secondary_color
        home_color3 = home_color3 if home_color3 != None else tertiary_color
    else:
        away_color = away_color if away_color != None else primary_color
        away_color2 = away_color2 if away_color2 != None else secondary_color
        away_color3 = away_color3 if away_color3 != None else tertiary_color
    # Parse versions have used several names for the same schedule fields.
    # Accept all known aliases so a saved school page can discover the game
    # page without asking the user to paste a new URL every week.
    game_url = contest_metadata_value(contest, [
        "game_url", "gameUrl", "game_info_url", "gameInfoUrl",
        "game_page_url", "gamePageUrl", "game_link", "gameLink",
        "contest_url", "contestUrl", "scoretracker_url",
        "scoretrackerUrl", "href", "url",
    ])
    contest_id = contest_metadata_value(contest, [
        "contest_id", "contestId", "contest_uuid", "contestUuid",
        "game_id", "gameId", "id",
    ])
    if contest_id == None or str(contest_id).strip() == "":
        contest_id = contest_id_from_url(game_url)
    normalized_game_url = maxpreps_game_url(game_url)
    if normalized_game_url != None:
        game_url = normalized_game_url
        # Some schedule payloads omit the query string from the game path but
        # provide the public contest ID separately. Rebuild the canonical URL
        # that Parse's one-credit Scoretracker endpoint expects.
        if contest_id != None and str(contest_id).strip() != "" and "c=" not in game_url:
            separator = "&" if "?" in game_url else "?"
            game_url = game_url + separator + "c=" + str(contest_id).strip()

    school_id_keys = ["school_id", "schoolId", "team_id", "teamId", "school_uuid", "schoolUuid"]
    tracked_school_id = team_stat(team_data, school_id_keys)
    away_school_id = team_stat(away_side, school_id_keys)
    home_school_id = team_stat(home_side, school_id_keys)
    if tracked_is_home and home_school_id == None:
        home_school_id = tracked_school_id
    if not tracked_is_home and away_school_id == None:
        away_school_id = tracked_school_id

    base = {
        "slot": slot,
        "sport": sport,
        "away": team_abbreviation(away_name),
        "home": team_abbreviation(home_name),
        "awayName": away_name,
        "homeName": home_name,
        "awaySchoolId": away_school_id,
        "homeSchoolId": home_school_id,
        "awayColor": away_color,
        "awayColor2": away_color2,
        "awayColor3": away_color3,
        "homeColor": home_color,
        "homeColor2": home_color2,
        "homeColor3": home_color3,
        "when": display_game_time(date_info, source_timezone, display_timezone) if date_info != None else str(contest.get("date", ""))[:16].upper(),
        "sortDate": str(contest.get("date", "")),
        "startUnix": game_unix(date_info, source_timezone) if date_info != None else None,
        "trackedIsHome": tracked_is_home,
        "pointsFor": team_stat(team_data, ["points_for", "pointsFor", "pf"]),
        "pointsAgainst": team_stat(team_data, ["points_against", "pointsAgainst", "pa"]),
        "streak": team_stat(team_data, ["streak", "current_streak", "currentStreak"]),
        "awayPF": team_stat(away_side, ["points_for", "pointsFor", "pf"]),
        "awayPA": team_stat(away_side, ["points_against", "pointsAgainst", "pa"]),
        "awayStreak": team_stat(away_side, ["streak", "current_streak", "currentStreak"]),
        "homePF": team_stat(home_side, ["points_for", "pointsFor", "pf"]),
        "homePA": team_stat(home_side, ["points_against", "pointsAgainst", "pa"]),
        "homeStreak": team_stat(home_side, ["streak", "current_streak", "currentStreak"]),
        "awayGF": team_stat(away_side, ["goals_for", "goalsFor", "gf", "points_for", "pointsFor"]),
        "awayGA": team_stat(away_side, ["goals_against", "goalsAgainst", "ga", "points_against", "pointsAgainst"]),
        "homeGF": team_stat(home_side, ["goals_for", "goalsFor", "gf", "points_for", "pointsFor"]),
        "homeGA": team_stat(home_side, ["goals_against", "goalsAgainst", "ga", "points_against", "pointsAgainst"]),
        "awaySW": team_stat(away_side, ["sets_won", "setsWon", "sw"]),
        "awaySL": team_stat(away_side, ["sets_lost", "setsLost", "sl"]),
        "homeSW": team_stat(home_side, ["sets_won", "setsWon", "sw"]),
        "homeSL": team_stat(home_side, ["sets_lost", "setsLost", "sl"]),
        "opponentName": side_school_name(opponent_side, contest.get("opponent", "TBD")),
        "opponentState": opponent_side.get("state", ""),
        "awayRecord": away_record,
        "homeRecord": home_record,
        "awayQuarters": quarter_scores(away_side),
        "homeQuarters": quarter_scores(home_side),
        "awayHalves": period_scores_count(away_side, 2),
        "homeHalves": period_scores_count(home_side, 2),
        "awaySets": period_scores_count(away_side, 5),
        "homeSets": period_scores_count(home_side, 5),
        "awaySetsWon": team_stat(away_side, ["sets_won", "setsWon", "sw"]),
        "homeSetsWon": team_stat(home_side, ["sets_won", "setsWon", "sw"]),
        "awayHits": team_stat(away_side, ["hits", "h"]),
        "homeHits": team_stat(home_side, ["hits", "h"]),
        "awayErrors": team_stat(away_side, ["errors", "e"]),
        "homeErrors": team_stat(home_side, ["errors", "e"]),
        "innings": contest.get("innings", contest.get("inning")),
        "contestId": contest_id,
        "qwixCoreGameId": contest_metadata_value(contest, [
            "qwixCoreGameId", "qwix_core_game_id", "qwixCoreId",
            "qwix_core_id", "qwixGameId", "qwix_game_id", "qwixId",
            "qwix_id", "scoretrackerGameId", "scoretracker_game_id",
            "scoretrackerId", "scoretracker_id", "coreGameId",
            "core_game_id",
        ]),
        "gameUrl": game_url,
    }

    tracked_prefix = "home" if tracked_is_home else "away"
    if base.get(tracked_prefix + "PF") == None:
        base[tracked_prefix + "PF"] = base.get("pointsFor")
    if base.get(tracked_prefix + "PA") == None:
        base[tracked_prefix + "PA"] = base.get("pointsAgainst")
    if base.get(tracked_prefix + "Streak") == None:
        base[tracked_prefix + "Streak"] = base.get("streak")

    # PF/PA, RF/RA, GF/GA are displayed as per-game averages. Volleyball's
    # SW/SL remains a season total by design.
    if sport != "GVB":
        base["awayPF"] = average_stat(base.get("awayPF"), away_record)
        base["awayPA"] = average_stat(base.get("awayPA"), away_record)
        base["homePF"] = average_stat(base.get("homePF"), home_record)
        base["homePA"] = average_stat(base.get("homePA"), home_record)
        base["awayGF"] = average_stat(base.get("awayGF"), away_record)
        base["awayGA"] = average_stat(base.get("awayGA"), away_record)
        base["homeGF"] = average_stat(base.get("homeGF"), home_record)
        base["homeGA"] = average_stat(base.get("homeGA"), home_record)

    away_mascot = mascot_from_side(away_side, away_name)
    home_mascot = mascot_from_side(home_side, home_name)
    base["awayMascot"] = away_mascot if away_mascot != None else SCHOOL_MASCOTS.get(str(away_name).upper())
    base["homeMascot"] = home_mascot if home_mascot != None else SCHOOL_MASCOTS.get(str(home_name).upper())

    home_score = home_side.get("score")
    away_score = away_side.get("score")
    if contest_is_final(contest) and home_score != None and away_score != None:
        base["homeScore"] = home_score
        base["awayScore"] = away_score
        if int(home_score) > int(away_score):
            base["winner"] = "home"
        elif int(away_score) > int(home_score):
            base["winner"] = "away"
        else:
            base["winner"] = "tie"
        base["type"] = "final"
        return base

    scores = score_pair(result)
    if scores != None and (result.startswith("W") or result.startswith("L") or result.startswith("T")):
        tracked_score = scores[0]
        opponent_score = scores[1]
        if tracked_is_home:
            base["homeScore"] = tracked_score
            base["awayScore"] = opponent_score
            base["winner"] = "home" if result.startswith("W") else ("away" if result.startswith("L") else "tie")
        else:
            base["awayScore"] = tracked_score
            base["homeScore"] = opponent_score
            base["winner"] = "away" if result.startswith("W") else ("home" if result.startswith("L") else "tie")
        base["type"] = "final"
        return base

    if result.upper().startswith("FF") or "FORFEIT" in result.upper():
        base["type"] = "final"
        base["status"] = "forfeit"
        base["forfeit"] = True
        base["awayScore"] = away_score if away_score != None else "-"
        base["homeScore"] = home_score if home_score != None else "-"
        return base

    if result != "" and result != "TBD":
        return None
    base["type"] = "next"
    # MaxPreps may populate each side's score before it publishes a
    # confirmed W/L/T result. Preserve those values so a started game
    # can show its latest available live score. If the schedule feed has
    # not supplied scores, the existing dash placeholders remain.
    has_live_score = home_score != None and away_score != None
    base["awayRec"] = str(away_score) if has_live_score else "-"
    base["homeRec"] = str(home_score) if has_live_score else "-"
    base["hasLiveScore"] = has_live_score
    return base

def games_from_schedule(resp, sport, slot, school_name, source_timezone, display_timezone, now_unix):
    if not valid_schedule(resp):
        return []
    data = parsed_schedule_data(resp)
    team_data = data.get("team", {})
    wins = 0
    losses = 0
    ties = 0
    for completed in data.get("contests", []):
        result = str(completed.get("result", "")).strip().upper()
        if result.startswith("W"):
            wins += 1
        elif result.startswith("L"):
            losses += 1
        elif result == "T" or result.startswith("T "):
            ties += 1
    calculated_record = str(wins) + "-" + str(losses) + (("-" + str(ties)) if ties > 0 else "")
    tracked_name = team_data.get("school_name", team_data.get("schoolName", team_data.get("name", school_name)))
    final_game = None
    next_game = None
    recent_started_game = None
    for contest in data.get("contests", []):
        game = normalized_contest_adaptive(
            contest,
            sport,
            slot,
            tracked_name,
            team_data,
            source_timezone,
            display_timezone,
        )
        if game == None:
            continue
        if game.get("trackedIsHome", False):
            game["homeRecord"] = calculated_record
        else:
            game["awayRecord"] = calculated_record
        # Scoretracker does not include team records, and the tracked-team
        # schedule can omit the opponent's record. For an opening-game final,
        # safely derive the opponent's 1-game record instead of leaving 0-0.
        # Later-season opponent records are not guessed because this schedule
        # does not contain the opponent's other results.
        if game["type"] == "final" and wins + losses + ties == 1:
            opponent_record_key = "awayRecord" if game.get("trackedIsHome", False) else "homeRecord"
            if game.get(opponent_record_key, "0-0") == "0-0":
                opponent_side = "away" if game.get("trackedIsHome", False) else "home"
                if game.get("winner") == opponent_side:
                    game[opponent_record_key] = "1-0"
                elif game.get("winner") == "tie":
                    game[opponent_record_key] = "0-0-1"
                else:
                    game[opponent_record_key] = "0-1"
        if game["type"] == "final" and (final_game == None or game["sortDate"] > final_game["sortDate"]):
            final_game = game
        if game["type"] == "next":
            start_unix = game.get("startUnix")
            if start_unix != None and start_unix <= now_unix:
                # MaxPreps can leave scrimmages or cancelled games unfinished
                # indefinitely. Only a recently started unfinished contest is
                # eligible for the live page; older entries must not block the
                # actual latest final or next scheduled game.
                # A normal high-school game cannot remain legitimately live
                # this long. Stop stale MaxPreps LIVE flags from hiding a
                # confirmed final or the next scheduled contest.
                if now_unix - start_unix <= 21600:
                    if recent_started_game == None:
                        recent_started_game = game
                    elif sport == "FB" and game.get("awayName") == recent_started_game.get("awayName") and game.get("homeName") == recent_started_game.get("homeName") and str(game.get("sortDate", ""))[:10] == str(recent_started_game.get("sortDate", ""))[:10]:
                        # MaxPreps can create a second same-day contest when a
                        # postponed football game resumes. The original entry
                        # retains the working Scoretracker while the newer
                        # duplicate has no live data. Keep the earlier entry.
                        if start_unix < recent_started_game["startUnix"]:
                            recent_started_game = game
                    elif start_unix > recent_started_game["startUnix"]:
                        recent_started_game = game
            elif next_game == None or game["sortDate"] < next_game["sortDate"]:
                next_game = game
    if recent_started_game != None:
        next_game = recent_started_game
    games = []
    if final_game != None:
        games.append(final_game)
    if next_game != None:
        games.append(next_game)
    return games

def scoretracker_request_adaptive(api_key, qwix_id, game_url, cache_bucket):
    if qwix_id == None and (game_url == None or str(game_url).strip() == ""):
        return None
    endpoint = "/get_scoretracker_by_id" if qwix_id != None else "/get_scoretracker"
    live_game_url = game_url
    # Do not force a tab. MaxPreps' default game URL exposes Scoretracker while
    # live and the authoritative Recap Boxscore after final; the Parse endpoint
    # normalizes that single request for the current state.
    params = {"contest_id": qwix_id} if qwix_id != None else {"game_url": live_game_url}
    return http.get(
        PARSE_LIVE_BASE + endpoint,
        headers = {
            "X-API-Key": api_key,
            "API-Snapshot-Version": PARSE_SNAPSHOT_VERSION,
            "X-Glance-Refresh": cache_bucket,
        },
        params = params,
        ttl_seconds = 31536000,
    )

def matchup_request_adaptive(api_key, game_url, cache_bucket):
    if game_url == None or str(game_url).strip() == "":
        return None
    return http.get(
        PARSE_BASE + "/get_matchup",
        headers = {
            "X-API-Key": api_key,
            "API-Snapshot-Version": PARSE_SNAPSHOT_VERSION,
            # The game-specific label makes one pregame call and one separate
            # post-final call. The dynamic page reuses the cached response.
            "X-Glance-Refresh": cache_bucket,
        },
        params = {"game_url": game_url},
        ttl_seconds = 31536000,
    )

def gamechanger_live_request(team_id, cache_bucket):
    team_id = str(team_id).strip() if team_id != None else ""
    if team_id == "":
        return None
    return http.get(
        GAMECHANGER_TEAM_BASE + team_id + "/live",
        headers = {"X-Glance-Refresh": cache_bucket},
        ttl_seconds = 31536000,
    )

def gamechanger_live_game(resp, school_name):
    if resp == None or resp.get("status_code") != 200:
        return None
    payload = resp.get("json")
    if type(payload) != "dict":
        return None
    selected = payload
    opponent = selected.get("opponent_team", {})
    if type(opponent) != "dict":
        opponent = {}
    scores = selected.get("score", {})
    if type(scores) != "dict":
        scores = {}
    team_side = {"name": school_name, "score": scores.get("team")}
    opponent_side = {"name": opponent.get("name", "OPPONENT"), "score": scores.get("opponent_team")}
    if selected.get("home_away") == "away":
        away = team_side
        home = opponent_side
    else:
        away = opponent_side
        home = team_side
    sport_specific = selected.get("sport_specific", {})
    bats = sport_specific.get("bats", {}) if type(sport_specific) == "dict" else {}
    inning_details = bats.get("inning_details", {}) if type(bats) == "dict" else {}
    total_outs = bats.get("total_outs") if type(bats) == "dict" else None
    current_outs = total_outs % 3 if type(total_outs) == "int" else None
    clock = selected.get("clock", {})
    if type(clock) != "dict":
        clock = {}
    inning = inning_details.get("inning") if type(inning_details) == "dict" else None
    inning_half = str(inning_details.get("half", "")).upper() if type(inning_details) == "dict" else ""
    if inning == None:
        inning = clock.get("display_period")
    result = {
        "status": "live",
        "game_id": selected.get("id", selected.get("game_id")),
        "inning": inning,
        "inning_half": inning_half if inning_half != "" else None,
        "away_team": away,
        "home_team": home,
        "updated_at": selected.get("last_scoring_update"),
    }
    if clock.get("display_period") != None:
        result["period"] = clock.get("display_period")
    if clock.get("display_time") != None:
        result["clock"] = clock.get("display_time")
    if current_outs != None:
        result["outs"] = current_outs
    return result

def overlay_gamechanger_live(game, live_game, display_timezone):
    # GameChanger is supplemental. Only copy fields it actually supplied;
    # never erase richer MaxPreps matchup, identity, R/H/E, base, or record
    # data with a missing public GameChanger value.
    if game == None or live_game == None:
        return game
    away = live_game.get("away_team", {})
    home = live_game.get("home_team", {})
    away_score = away.get("score") if type(away) == "dict" else None
    home_score = home.get("score") if type(home) == "dict" else None
    if away_score != None and home_score != None:
        game["awayRec"] = str(away_score)
        game["homeRec"] = str(home_score)
        game["hasLiveScore"] = True
    for source_key, target_key in [["inning", "inning"], ["inning_half", "inningHalf"], ["outs", "outs"], ["bases", "bases"]]:
        value = live_game.get(source_key)
        if value != None and str(value).strip() not in ["", "NONE", "NULL"]:
            game[target_key] = value
    if live_game.get("period") != None and str(live_game.get("period")).strip() != "":
        game["livePeriod"] = str(live_game.get("period")).upper()
    if live_game.get("clock") != None and str(live_game.get("clock")).strip() != "":
        game["liveClock"] = str(live_game.get("clock")).upper()
    updated = live_game.get("updated_at")
    if updated != None and str(updated).strip() not in ["", "NONE", "NULL"]:
        game["updatedAt"] = compact_update_time(updated, display_timezone)
    game["status"] = "live"
    return game

def gamechanger_fallback_game(live_game, sport_code, slot, ctx, display_timezone):
    if live_game == None:
        return None
    base = {
        "slot": slot,
        "sport": sport_code,
        "type": "next",
        "away": "AWY",
        "home": "HME",
        "awayName": "AWAY",
        "homeName": "HOME",
        "awayRec": "0",
        "homeRec": "0",
        "when": "",
    }
    return merge_live_game(base, live_game, ctx, display_timezone)

def matchup_data(resp):
    if resp == None or resp.get("status_code") != 200:
        return None
    data = resp.get("json")
    if type(data) != "dict":
        return None
    for unused in range(4):
        nested = None
        for key in ["data", "result", "response", "body"]:
            candidate = data.get(key)
            if type(candidate) == "dict":
                nested = candidate
                break
        if nested == None:
            break
        data = nested
    if type(data.get("away_team")) != "dict" or type(data.get("home_team")) != "dict":
        return None
    return data

def matchup_identity(value):
    result = ""
    text = str(value).upper()
    for index in range(len(text)):
        char = text[index]
        if char in "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789":
            result += char
    return result

def matchup_team_for_side(data, side, current_name):
    preferred = data.get(side + "_team", {})
    other_side = "home" if side == "away" else "away"
    other = data.get(other_side + "_team", {})
    target = matchup_identity(current_name)
    preferred_name = matchup_identity(preferred.get("school_name", preferred.get("schoolName", "")))
    other_name = matchup_identity(other.get("school_name", other.get("schoolName", "")))
    if target != "" and other_name == target and preferred_name != target:
        return other
    return preferred

def merge_matchup_game(base, data):
    if type(base) != "dict" or type(data) != "dict":
        return base
    for side in ["away", "home"]:
        team = matchup_team_for_side(data, side, base.get(side + "Name", ""))
        if type(team) != "dict":
            continue
        school_name = team.get("school_name", team.get("schoolName"))
        mascot = team.get("mascot")
        record = team.get("overall_record", team.get("overallRecord"))
        points_for = team.get("scoring_average", team.get("scoringAverage"))
        points_against = team.get("points_allowed_average", team.get("pointsAllowedAverage"))
        if points_for == None:
            points_for = average_stat(team.get("points_for", team.get("pointsFor")), record)
        if points_against == None:
            points_against = average_stat(team.get("points_against", team.get("pointsAgainst")), record)
        if school_name != None and str(school_name).strip() != "":
            base[side + "Name"] = school_name
        if mascot != None and str(mascot).strip() != "":
            base[side + "Mascot"] = mascot
        if record != None and str(record).strip() != "":
            base[side + "Record"] = str(record)
        if points_for != None:
            base[side + "PF"] = str(points_for)
        if points_against != None:
            base[side + "PA"] = str(points_against)
        streak = team.get("streak")
        if streak != None and str(streak).strip() != "":
            base[side + "Streak"] = str(streak).upper()
        goals_for = team.get("goals_for", team.get("goalsFor"))
        goals_against = team.get("goals_against", team.get("goalsAgainst"))
        if goals_for != None:
            base[side + "GF"] = average_stat(goals_for, record)
        if goals_against != None:
            base[side + "GA"] = average_stat(goals_against, record)
    return base

def enrich_game_with_matchup(api_key, game, force_final = False):
    game_url = maxpreps_game_url(game.get("gameUrl"))
    if game_url == None:
        return game
    contest_key = game.get("contestId")
    if contest_key == None or str(contest_key).strip() == "":
        contest_key = contest_id_from_url(game_url)
    if contest_key == None:
        contest_key = matchup_identity(game_url)
    is_final = force_final or game.get("type") == "final" or game.get("status") == "final"
    phase = "final" if is_final else "pregame"
    response = matchup_request_adaptive(
        api_key,
        game_url,
        "matchup-v1-" + phase + "-" + str(contest_key),
    )
    data = matchup_data(response)
    return merge_matchup_game(game, data) if data != None else game

def normalized_scoretracker_game(data):
    if type(data) != "dict":
        return None
    home = data.get("home_team", data.get("homeTeam", data.get("home")))
    away = data.get("away_team", data.get("awayTeam", data.get("away")))
    # Some Scoretracker page revisions expose the team identity and score as
    # top-level fields instead of inside the compact header-scoreboard object.
    if type(home) != "dict" and (data.get("homeScore") != None or data.get("home_score") != None):
        home = {
            "school_name": data.get("homeName", data.get("home_name", data.get("homeTeamName", "HOME"))),
            "score": data.get("homeScore", data.get("home_score")),
        }
    if type(away) != "dict" and (data.get("awayScore") != None or data.get("away_score") != None):
        away = {
            "school_name": data.get("awayName", data.get("away_name", data.get("awayTeamName", "AWAY"))),
            "score": data.get("awayScore", data.get("away_score")),
        }
    if type(home) != "dict" or type(away) != "dict":
        return None
    # Normalize the public scraper's known camelCase and snake_case shapes
    # once, so the renderer never silently drops otherwise valid live data.
    normalized = {}
    for key in data:
        normalized[key] = data[key]
    normalized["home_team"] = home
    normalized["away_team"] = away
    normalized["status"] = data.get("status", data.get("gameStatus", data.get("game_status", "live")))
    normalized["period"] = data.get("period", data.get("quarter", data.get("currentPeriod", data.get("current_period"))))
    normalized["clock"] = data.get("clock", data.get("gameClock", data.get("game_clock", data.get("timeRemaining", data.get("time_remaining")))))
    return normalized

def normalized_live_clock(value):
    if value == None:
        return ""
    text = str(value).strip().upper()
    # MaxPreps frequently reports approximate prose such as "~5 mins to go".
    # The detail box needs the compact clock form, and the approximation mark
    # does not add useful scoreboard information.
    if text.startswith("~"):
        text = text[1:].strip()
    if "MIN" in text:
        first = text.split(" ")[0]
        if first.isdigit():
            return first + ":00"
    return text

def scoretracker_game_in(value, depth = 0):
    if depth > 6:
        return None
    if type(value) == "dict":
        direct = normalized_scoretracker_game(value)
        if direct != None:
            return direct
        # Parse revisions have wrapped the same payload under each of these
        # keys, sometimes with an array between the wrapper and the game.
        for key in [
            "game", "scoretracker", "scoreTracker", "liveGame", "live_game",
            "games", "events", "items", "data", "result", "response", "body",
        ]:
            candidate = value.get(key)
            if candidate != None:
                found = scoretracker_game_in(candidate, depth + 1)
                if found != None:
                    return found
    elif type(value) == "list":
        for item in value:
            found = scoretracker_game_in(item, depth + 1)
            if found != None:
                return found
    return None

def scoretracker_game(resp):
    if resp == None or resp.get("status_code") != 200:
        return None
    return scoretracker_game_in(resp.get("json"))

def quarter_scores(side):
    if type(side) != "dict":
        return ["-", "-", "-", "-"]
    raw = side.get("quarter_scores", side.get("period_scores", side.get("scores_by_period", side.get("line_score", side.get("periods")))))
    scores = []
    if type(raw) == "list":
        for item in raw[:4]:
            if type(item) == "dict":
                scores.append(str(item.get("score", item.get("points", item.get("value", "-")))))
            else:
                scores.append(str(item))
    elif type(raw) == "dict":
        quarter_keys = [["Q1", "q1", "1", "first"], ["Q2", "q2", "2", "second"], ["Q3", "q3", "3", "third"], ["Q4", "q4", "4", "fourth"]]
        for keys in quarter_keys:
            value = None
            for key in keys:
                if raw.get(key) != None:
                    value = raw.get(key)
                    break
            scores.append(str(value) if value != None else "-")
    for unused in range(4 - len(scores)):
        scores.append("-")
    return scores[:4]

def valid_football_quarters(scores, final_score):
    if type(scores) != "list" or final_score == None:
        return False
    total = 0
    found = False
    for value in scores:
        text = str(value).strip()
        if text == "-" or text == "":
            continue
        if not text.isdigit():
            return False
        total += int(text)
        found = True
    return found and str(final_score).strip().isdigit() and total == int(str(final_score).strip())

def football_period_scores(side):
    if type(side) != "dict":
        return []
    raw = side.get("quarter_scores", side.get("period_scores", side.get("scores_by_period", side.get("line_score", side.get("periods")))))
    scores = []
    if type(raw) == "list":
        for item in raw:
            if type(item) == "dict":
                scores.append(str(item.get("score", item.get("points", item.get("value", "-")))))
            else:
                scores.append(str(item))
    return scores

def malformed_overtime_correction(scores, final_score):
    # Qwix has returned OT finals as signed scoring corrections instead of a
    # real quarter row (for example 34, 0, -6 for a 28-point final). The
    # signed values still total the final score, which lets us identify this
    # feed shape without ever drawing the impossible negative cell.
    if type(scores) != "list" or final_score == None or not str(final_score).strip().isdigit():
        return False
    total = 0
    has_negative = False
    has_value = False
    for value in scores:
        text = str(value).strip()
        if text == "-" or text == "":
            continue
        unsigned = text[1:] if text.startswith("-") else text
        if not unsigned.isdigit():
            return False
        number = int(text)
        total += number
        has_negative = has_negative or number < 0
        has_value = True
    return has_value and has_negative and total == int(str(final_score).strip())

def period_scores_count(side, count):
    if type(side) != "dict":
        return ["-" for unused in range(count)]
    raw = side.get("period_scores", side.get("quarter_scores", side.get("scores_by_period", side.get("line_score", side.get("periods")))))
    scores = []
    if type(raw) == "list":
        for item in raw[:count]:
            if type(item) == "dict":
                scores.append(str(item.get("score", item.get("points", item.get("runs", item.get("value", "-"))))))
            else:
                scores.append(str(item))
    elif type(raw) == "dict":
        for index in range(count):
            value = raw.get(str(index + 1), raw.get("Q" + str(index + 1), raw.get("S" + str(index + 1))))
            scores.append(str(value) if value != None else "-")
    for unused in range(count - len(scores)):
        scores.append("-")
    return scores[:count]

def merge_live_game(base, live_game, ctx, display_timezone):
    away_side = live_game.get("away_team", {})
    home_side = live_game.get("home_team", {})
    away_name = side_school_name(away_side, base.get("awayName", "TBD"))
    home_name = side_school_name(home_side, base.get("homeName", "TBD"))
    # Scoretracker occasionally orders the two schools opposite the schedule
    # response. Move the complete scheduled identity with the matching name
    # before applying live fields; otherwise the new names inherit the other
    # school's ID, logo, colors, mascot, and record.
    scheduled_away_name = str(base.get("awayName", "")).strip().upper()
    scheduled_home_name = str(base.get("homeName", "")).strip().upper()
    live_away_name = str(away_name).strip().upper()
    live_home_name = str(home_name).strip().upper()
    if live_away_name == scheduled_home_name and live_home_name == scheduled_away_name and live_away_name != live_home_name:
        for suffix in [
            "Name", "SchoolId", "Color", "Color2", "Color3", "Mascot",
            "Record", "PF", "PA", "Streak", "GF", "GA", "SW", "SL",
            "Quarters", "Halves", "Sets", "SetsWon", "Hits", "Errors",
        ]:
            away_value = base.get("away" + suffix)
            home_value = base.get("home" + suffix)
            base["away" + suffix] = home_value
            base["home" + suffix] = away_value

    school_id_keys = ["school_id", "schoolId", "team_id", "teamId", "school_uuid", "schoolUuid"]
    away_school_id = team_stat(away_side, school_id_keys)
    home_school_id = team_stat(home_side, school_id_keys)
    if away_school_id != None:
        base["awaySchoolId"] = away_school_id
    if home_school_id != None:
        base["homeSchoolId"] = home_school_id
    away_score = away_side.get("score")
    home_score = home_side.get("score")
    has_score = away_score != None and home_score != None
    status = str(live_game.get("status", "live")).lower()

    base["awayName"] = away_name
    base["homeName"] = home_name
    base["away"] = team_abbreviation(away_name)
    base["home"] = team_abbreviation(home_name)
    away_mascot = mascot_from_side(away_side, away_name)
    home_mascot = mascot_from_side(home_side, home_name)
    base["awayMascot"] = away_mascot if away_mascot != None else base.get("awayMascot", SCHOOL_MASCOTS.get(away_name.upper()))
    base["homeMascot"] = home_mascot if home_mascot != None else base.get("homeMascot", SCHOOL_MASCOTS.get(home_name.upper()))
    for side_name, side_data in [["away", away_side], ["home", home_side]]:
        for suffix, aliases in [
            ["Color", ["schoolColor1", "school_color1", "primaryColor", "primary_color", "color1", "color"]],
            ["Color2", ["schoolColor2", "school_color2", "secondaryColor", "secondary_color", "color2"]],
            ["Color3", ["schoolColor3", "school_color3", "tertiaryColor", "tertiary_color", "color3"]],
        ]:
            live_color = normalized_school_color(team_stat(side_data, aliases))
            if live_color != None:
                base[side_name + suffix] = live_color
    base["awayRecord"] = team_record(away_side, base.get("awayRecord", "0-0"))
    base["homeRecord"] = team_record(home_side, base.get("homeRecord", "0-0"))
    # Never erase a previously usable schedule/live score because a later
    # Scoretracker payload contains status/clock but omits its score fields.
    if has_score:
        base["awayRec"] = str(away_score)
        base["homeRec"] = str(home_score)
        base["hasLiveScore"] = True
    else:
        base["awayRec"] = base.get("awayRec", "-")
        base["homeRec"] = base.get("homeRec", "-")
        base["hasLiveScore"] = base.get("hasLiveScore", False)
    raw_period = live_game.get("period")
    raw_clock = live_game.get("clock")
    base["livePeriod"] = str(raw_period).upper() if raw_period != None else ""
    base["liveClock"] = normalized_live_clock(raw_clock)
    away_periods = football_period_scores(away_side)
    home_periods = football_period_scores(home_side)
    away_quarters = quarter_scores(away_side)
    home_quarters = quarter_scores(home_side)
    # Some completed MaxPreps games briefly expose malformed period values
    # while the final total is already correct (for example 34, 0, -6 for a
    # 28-point team). Never put impossible arithmetic on the display. Quarter
    # Keep each valid row independently. One malformed team must not erase a
    # sound row supplied for its opponent.
    if status == "final":
        away_correction = malformed_overtime_correction(away_periods, away_score)
        home_correction = malformed_overtime_correction(home_periods, home_score)
        if not valid_football_quarters(away_periods, away_score):
            away_quarters = ["-", "-", "-", "-"]
        if not valid_football_quarters(home_periods, home_score):
            home_quarters = ["-", "-", "-", "-"]
        if away_correction or home_correction:
            base["overtime"] = "OT"
        else:
            overtime_count = max(len(away_periods), len(home_periods)) - 4
            if overtime_count > 0:
                base["overtime"] = "OT" if overtime_count == 1 else "OT" + str(overtime_count)
    base["awayQuarters"] = away_quarters
    base["homeQuarters"] = home_quarters
    base["awayHalves"] = period_scores_count(away_side, 2)
    base["homeHalves"] = period_scores_count(home_side, 2)
    base["awaySets"] = period_scores_count(away_side, 5)
    base["homeSets"] = period_scores_count(home_side, 5)
    base["awaySetsWon"] = away_side.get("sets_won", away_side.get("setsWon", base.get("awaySetsWon", "0")))
    base["homeSetsWon"] = home_side.get("sets_won", home_side.get("setsWon", base.get("homeSetsWon", "0")))
    base["awayHits"] = away_side.get("hits", base.get("awayHits", "-"))
    base["homeHits"] = home_side.get("hits", base.get("homeHits", "-"))
    base["awayErrors"] = away_side.get("errors", base.get("awayErrors", "-"))
    base["homeErrors"] = home_side.get("errors", base.get("homeErrors", "-"))
    base["inning"] = live_game.get("inning", live_game.get("period", base.get("inning", "1")))
    base["inningHalf"] = live_game.get("inning_half", live_game.get("inningHalf", live_game.get("half", base.get("inningHalf", "TOP"))))
    base["outs"] = live_game.get("outs", base.get("outs", "0"))
    base["bases"] = live_game.get("bases", live_game.get("base_occupancy", base.get("bases", [False, False, False])))
    # Parse/MaxPreps versions have used several names for the scorekeeper's
    # update timestamp. Preserve the first real value so the panel never
    # shows a bare, misleading UPDATED label.
    update_value = None
    for update_key in ["updatedAt", "updated_at", "lastUpdated", "last_updated", "scoreUpdatedAt", "score_updated_at", "timestamp"]:
        candidate = live_game.get(update_key)
        if candidate != None and str(candidate).strip().upper() not in ["", "NONE", "NULL"]:
            update_value = candidate
            break
    if update_value == None:
        metadata = live_game.get("metadata")
        if type(metadata) == "dict":
            for update_key in ["updatedAt", "updated_at", "lastUpdated", "last_updated", "timestamp"]:
                candidate = metadata.get(update_key)
                if candidate != None and str(candidate).strip().upper() not in ["", "NONE", "NULL"]:
                    update_value = candidate
                    break
    base["updatedAt"] = compact_update_time(update_value, display_timezone)

    if status == "final" and has_score:
        base["type"] = "final"
        base["status"] = "final"
        base["awayScore"] = away_score
        base["homeScore"] = home_score
        if int(away_score) > int(home_score):
            base["winner"] = "away"
        elif int(home_score) > int(away_score):
            base["winner"] = "home"
        else:
            base["winner"] = "tie"
    elif status in ["postponed", "pp", "ppd"]:
        base["type"] = "next"
        base["status"] = "postponed"
    elif status in ["delayed", "delay", "suspended"]:
        base["type"] = "next"
        base["status"] = "delayed"
    else:
        base["type"] = "next"
        base["status"] = "live"
    return base

def fetch_game_adaptive(ctx, kind, slot):
    api_key = ctx.inputs.get("parsekey", "")
    # Published installs always use live data once a Parse key is present.
    # With no key, Studio retains the safe local sample automatically.
    data_mode = ctx.inputs.get("datamode", "Live Parse")

    sport = selected_sport(ctx)
    schools = school_settings(ctx)
    source_timezone = schools["timezone"]
    display_timezone = ctx.inputs.get("displaytimezone", "Eastern")
    gamechanger_team_id = ctx.inputs.get("gamechangerteamid", "")
    gamechanger_live_enabled = live_pulls_enabled(ctx) and sport["code"] in ["BSB", "SB"] and str(gamechanger_team_id).strip() != "" and str(schools.get("maxpreps_url", "")).strip() != "" and kind in ["dynamic", "live"]
    if not sport_is_active(ctx, source_timezone):
        return None

    if data_mode == "Sample Preview" or api_key == None or api_key == "":
        # Keep a useful sample preview until the user enters a key.
        sample_kind = "next" if kind == "dynamic" else kind
        sample = find_game(SAMPLE_GAMES, sport["code"], sample_kind, slot)
        if sample != None:
            sample_copy = {}
            for key in sample:
                sample_copy[key] = sample[key]
            sample_date = parse_game_date(sample_copy.get("date"))
            if sample_date != None:
                sample_copy["when"] = display_game_time(
                    sample_date,
                    source_timezone,
                    display_timezone,
                )
                # Sample data has no live feed to provide a final, so keep
                # its illustrative LIVE window to six hours.
                sample_start = game_unix(sample_date, source_timezone)
                if kind == "next" and ctx.now.unix >= sample_start and ctx.now.unix < sample_start + 21600:
                    sample_copy["status"] = "live"
            return sample_copy
        return {"displayState": "key_error"}

    # Baseball and softball can read the team's public GameChanger widget
    # directly. This path needs no GameChanger login and spends no Parse
    # credits. MaxPreps remains responsible for schedules, records, matchup
    # stats, and final-game history.
    gc_live = None
    if gamechanger_live_enabled:
        gc_response = gamechanger_live_request(
            gamechanger_team_id,
            "gc-live-" + str(ctx.now.unix // live_refresh_seconds(ctx)),
        )
        gc_live = gamechanger_live_game(gc_response, schools["school"])

    # An exact game URL can use MaxPreps' embedded Qwix ID directly. All
    # The dynamic page shares one half-hour cache bucket across its
    # NEXT/LIVE/FINAL states without an extra schedule call.
    exact_game_url = maxpreps_game_url(schools.get("maxpreps_url", ""))
    if exact_game_url != None and live_pulls_enabled(ctx):
        live_response = scoretracker_request_adaptive(
            api_key,
            None,
            exact_game_url,
            "exact-url-v5-" + str(ctx.now.unix // 300),
        )
        live_game = scoretracker_game(live_response)
        # A stale or incomplete Scoretracker payload should not blank the
        # entire app. Fall through to the team's cached schedule instead.
        if live_game != None:
            exact_base = {
                "slot": slot,
                "sport": sport["code"],
                "type": "next",
                "away": "AWY",
                "home": "HME",
                "awayName": "AWAY",
                "homeName": "HOME",
                "awayRec": "0",
                "homeRec": "0",
                "when": "",
            }
            exact_game = merge_live_game(exact_base, live_game, ctx, display_timezone)
            if exact_game.get("type") != "final" and exact_game.get("status") != "final":
                exact_game = overlay_gamechanger_live(exact_game, gc_live, display_timezone)
            if kind == "dynamic":
                return exact_game
            if kind == "final":
                return exact_game if exact_game.get("type") == "final" else {"displayState": "no_final"}
            if kind == "live":
                return exact_game if exact_game.get("status") == "live" else {"displayState": "no_live"}
            if exact_game.get("status") == "live":
                return exact_game

    season = current_season(ctx, source_timezone)
    school_name = schools["school"]
    # The required school URL is already the stable MaxPreps identifier.
    school_path = maxpreps_school_path(schools.get("maxpreps_url", ""))
    if school_path == None:
        fallback = gamechanger_fallback_game(gc_live, sport["code"], slot, ctx, display_timezone)
        if fallback != None:
            return fallback
        return {"displayState": "url_error"}

    schedule = event_schedule(
        ctx,
        api_key,
        school_path,
        sport["path"],
        season,
        slot,
        source_timezone,
        sport["check_minutes"],
    )
    if response_auth_error(schedule):
        return {"displayState": "key_error"}
    if response_credit_error(schedule):
        return {"displayState": "no_credits"}
    if not valid_schedule(schedule):
        fallback = gamechanger_fallback_game(gc_live, sport["code"], slot, ctx, display_timezone)
        if fallback != None:
            return fallback
        # Parse can briefly return HTTP 200 before its successful result has
        # been decoded into the documented schedule shape.  That is not a
        # feed failure and must not become a separate red error page while
        # Studio (or a device) is settling on the usable cached response.
        if schedule != None and schedule.get("status_code") == 200:
            return {"displayState": "no_game"}
        return {"displayState": "feed_error"}

    schedule_data = parsed_schedule_data(schedule)
    if len(schedule_data.get("contests", [])) == 0 and len(schedule_data.get("tournaments", [])) == 0:
        return {"displayState": "no_game"}

    games = games_from_schedule(
        schedule,
        sport["code"],
        slot,
        school_name,
        source_timezone,
        display_timezone,
        ctx.now.unix,
    )
    lookup_kind = "next" if kind == "live" else kind
    if kind == "dynamic":
        next_game = find_game(games, sport["code"], "next", slot)
        final_game = find_game(games, sport["code"], "final", slot)
        if next_game != None and next_game.get("startUnix") != None and ctx.now.unix >= next_game.get("startUnix"):
            game = next_game
        elif final_game != None and final_game.get("startUnix") != None:
            final_is_current = ctx.now.unix - final_game.get("startUnix") <= 64800
            if sport["code"] == "FB":
                # Football normally plays once a week. Keep the completed
                # matchup on the main page through Sunday, then switch to the
                # next game at Monday midnight in the school's timezone.
                final_is_current = local_week_for_unix(final_game.get("startUnix"), source_timezone) == local_now(ctx, source_timezone)["week"]
            game = final_game if final_is_current or next_game == None else next_game
        elif next_game != None:
            game = next_game
        else:
            game = final_game
    else:
        game = find_game(games, sport["code"], lookup_kind, slot)
    if game == None:
        return {
            "displayState": "no_final" if kind == "final" else ("no_live" if kind == "live" else "no_upcoming"),
        }

    # One pregame Matchup response is shared by every page. Once Scoretracker
    # reports Final, a separate final cache key refreshes both teams' records
    # and season averages exactly once.
    matchup_was_final = game.get("type") == "final" or game.get("status") == "final"
    game = enrich_game_with_matchup(api_key, game, matchup_was_final)
    if game.get("type") != "final" and game.get("status") != "final":
        game = overlay_gamechanger_live(game, gc_live, display_timezone)

    # The schedule supplies matchup and final-score data, but football's
    # quarter breakdown lives in Scoretracker. Use the Qwix ID extracted by
    # the schedule scraper for started/final games only. A completed game's
    # response is immutable and cached permanently; an active game keeps the
    # existing half-hour live bucket.
    if sport["code"] == "FB":
        start_unix = game.get("startUnix")
        is_started = start_unix != None and ctx.now.unix >= start_unix
        # "No live pulls" suppresses recurring in-game checks while still
        # allowing one immutable post-final request for quarter scores.
        if game.get("type") == "final" or (is_started and live_pulls_enabled(ctx)):
            scoretracker_id = game_scoretracker_id(game)
            # Schedule responses may expose either a full URL or a relative
            # MaxPreps game path. The URL Scoretracker endpoint requires the
            # complete public URL including its contest query parameter.
            game_url = maxpreps_game_url(game.get("gameUrl"))
            # The public scraper's URL endpoint returns the usable live game
            # object. Its ID endpoint can return HTTP 200 with an empty or
            # incompatible payload, so prefer the discovered game URL and
            # retain the Qwix ID only when no URL is available.
            if game_url != None and str(game_url).strip() != "":
                scoretracker_id = None
            if scoretracker_id != None or game_url != None:
                tracker_key = scoretracker_id if scoretracker_id != None else str(game.get("contestId", "game"))
                # v5 refreshes finals that were cached during the brief window
                # after the result posted but before MaxPreps published the
                # completed quarter-by-quarter box score.
                # Live refresh labels must also be game-specific. Without the
                # contest identity, two schools rendered in the same five-
                # minute window can collide and one appears to lose its feed.
                refresh_seconds = live_refresh_seconds(ctx)
                live_bucket_number = ctx.now.unix // refresh_seconds
                tracker_bucket = "tracker-final-v5-" + tracker_key if game.get("type") == "final" else "tracker-live-v17-" + tracker_key + "-" + str(refresh_seconds) + "-" + str(live_bucket_number)
                tracker_response = scoretracker_request_adaptive(api_key, scoretracker_id, game_url, tracker_bucket)
                # Record the actual successful/attempted Scoretracker check in
                # the display's local time. This is shown only when the game
                # has started but the response contains no usable live state.
                game["checkedAt"] = compact_unix_time(ctx.now.unix, display_timezone)
                tracker_game = scoretracker_game(tracker_response)
                if tracker_game != None:
                    game = merge_live_game(game, tracker_game, ctx, display_timezone)
                    if not matchup_was_final and (game.get("type") == "final" or game.get("status") == "final"):
                        game = enrich_game_with_matchup(api_key, game, True)

    # Do not perform opponent profile/color requests during scoreboard
    # refreshes. Saved logo colors and safe fallbacks are used instead.
    if game != None and (kind == "next" or kind == "live" or kind == "dynamic"):
        start_unix = game.get("startUnix")
        if start_unix != None and ctx.now.unix >= start_unix and game.get("type") != "final" and game.get("status") != "final":
            # The schedule endpoint does not expose a reliable live flag.
            # Treat a started, not-yet-final contest as live until a final
            # result moves it onto the final page.
            game["status"] = "live"
        if kind == "live" and game.get("status") != "live":
            return {"displayState": "no_live"}
    return game

# ---- layout: draws an unfilled box outline given (x, y, w, h) ----
def draw_box(c, x, y, w, h, color = BOX_COLOR):
    c.round_rect(x, y, x + w, y + h, 0, outline = color)

