# True if a color is white or close enough to it that it'd wash out or
# blend into a light background. Checks the named "white" and any hex
# whose average channel brightness is above the threshold.
def is_hex_color(color):
    if color == None or not color.startswith("#") or len(color) != 7:
        return False
    for index in range(1, 7):
        char = color[index]
        if char.lower() not in "0123456789abcdef":
            return False
    return True

def is_whiteish(color):
    if color == None:
        return False
    if color.lower() == "white":
        return True
    if is_hex_color(color):
        r = int(color[1:3], 16)
        g = int(color[3:5], 16)
        b = int(color[5:7], 16)
        return (r + g + b) / 3 > 235
    return False

def is_darkish(color):
    if color == None:
        return False
    if color.lower() == "black":
        return True
    if is_hex_color(color):
        r = int(color[1:3], 16)
        g = int(color[3:5], 16)
        b = int(color[5:7], 16)
        return (r + g + b) / 3 < 55
    return False


