STATE_75_LOGO_MAPS = [STATE_75_LOGOS_BY_ID_1, STATE_75_LOGOS_BY_ID_2, STATE_75_LOGOS_BY_ID_3, STATE_75_LOGOS_BY_ID_4, STATE_75_LOGOS_BY_ID_5, STATE_75_LOGOS_BY_ID_6, STATE_75_LOGOS_BY_ID_7, STATE_75_LOGOS_BY_ID_8, STATE_75_LOGOS_BY_ID_9, STATE_75_LOGOS_BY_ID_10, STATE_75_LOGOS_BY_ID_11, STATE_75_LOGOS_BY_ID_12, STATE_75_LOGOS_BY_ID_13, STATE_75_LOGOS_BY_ID_14, STATE_75_LOGOS_BY_ID_15]

def team_logo(code, game, side):
    name = str(code).upper()
    if game != None:
        live_name = game.get(side + "Name")
        if live_name != None:
            name = str(live_name).upper()
        # Hand-finished primary logos must win over automatically rebuilt
        # catalog copies of the same school.
        preferred_logo = finished_logo(name)
        if preferred_logo != None:
            return preferred_logo
        # Preserve every previously reviewed legacy collection before the
        # automated national/state catalog lookup.
        for reviewed_logos in [SHG_OTHER_SPORT_LOGOS_BY_NAME, MP_OTHER_SPORT_LOGOS_BY_NAME, MP_BASKETBALL_LOGOS_BY_NAME, TOP25_LOGOS_BY_NAME]:
            reviewed_logo = reviewed_logos.get(name)
            if reviewed_logo != None:
                return reviewed_logo
        school_id = game.get(side + "SchoolId")
        if school_id != None:
            for state_logo_map in STATE_75_LOGO_MAPS:
                state_logo = state_logo_map.get(str(school_id).lower())
                if state_logo != None:
                    return state_logo
            il_logo = IL_COMPLETE_LOGOS_BY_ID_1.get(str(school_id).lower())
            if il_logo == None:
                il_logo = IL_COMPLETE_LOGOS_BY_ID_2.get(str(school_id).lower())
            if il_logo == None:
                il_logo = IL_COMPLETE_LOGOS_BY_ID_3.get(str(school_id).lower())
            if il_logo == None:
                il_logo = IL_COMPLETE_LOGOS_BY_ID_4.get(str(school_id).lower())
            if il_logo != None:
                return il_logo
            nc_logo = NC_COMPLETE_LOGOS_BY_ID_1.get(str(school_id).lower())
            if nc_logo == None:
                nc_logo = NC_COMPLETE_LOGOS_BY_ID_2.get(str(school_id).lower())
            if nc_logo == None:
                nc_logo = NC_COMPLETE_LOGOS_BY_ID_3.get(str(school_id).lower())
            if nc_logo == None:
                nc_logo = NC_COMPLETE_LOGOS_BY_ID_4.get(str(school_id).lower())
            if nc_logo != None:
                return nc_logo
            remaining_logo = REMAINING_STATE_LOGOS_BY_ID_1.get(str(school_id).lower())
            if remaining_logo == None:
                remaining_logo = REMAINING_STATE_LOGOS_BY_ID_2.get(str(school_id).lower())
            if remaining_logo == None:
                remaining_logo = REMAINING_STATE_LOGOS_BY_ID_3.get(str(school_id).lower())
            if remaining_logo == None:
                remaining_logo = REMAINING_STATE_LOGOS_BY_ID_4.get(str(school_id).lower())
            if remaining_logo == None:
                remaining_logo = REMAINING_STATE_LOGOS_BY_ID_5.get(str(school_id).lower())
            if remaining_logo != None:
                return remaining_logo
            football_ranked_logo = FOOTBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if football_ranked_logo != None:
                return football_ranked_logo
            ms_ranked_logo = MS_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if ms_ranked_logo != None:
                return ms_ranked_logo
            oh_ranked_logo = OH_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if oh_ranked_logo != None:
                return oh_ranked_logo
            pa_ranked_logo = PA_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if pa_ranked_logo != None:
                return pa_ranked_logo
            nj_ranked_logo = NJ_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if nj_ranked_logo != None:
                return nj_ranked_logo
            ny_ranked_logo = NY_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if ny_ranked_logo != None:
                return ny_ranked_logo
            mo_ranked_logo = MO_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if mo_ranked_logo != None:
                return mo_ranked_logo
            va_ranked_logo = VA_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if va_ranked_logo != None:
                return va_ranked_logo
            sc_ranked_logo = SC_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if sc_ranked_logo != None:
                return sc_ranked_logo
            in_ranked_logo = IN_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if in_ranked_logo != None:
                return in_ranked_logo
            ga_ranked_logo = GA_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if ga_ranked_logo != None:
                return ga_ranked_logo
            fl_ranked_logo = FL_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if fl_ranked_logo != None:
                return fl_ranked_logo
            ca_dc_ranked_logo = CA_DC_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if ca_dc_ranked_logo != None:
                return ca_dc_ranked_logo
            az_ranked_logo = AZ_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if az_ranked_logo != None:
                return az_ranked_logo
            al_ranked_logo = AL_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if al_ranked_logo != None:
                return al_ranked_logo
            national_ranked_logo = NATIONAL_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if national_ranked_logo != None:
                return national_ranked_logo
            nc_ranked_logo = NC_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if nc_ranked_logo != None:
                return nc_ranked_logo
            il_ranked_logo = IL_BASKETBALL_RANKED_LOGOS_BY_ID.get(str(school_id).lower())
            if il_ranked_logo != None:
                return il_ranked_logo
            shg_other_sport_logo = SHG_OTHER_SPORT_LOGOS_BY_ID.get(str(school_id).lower())
            if shg_other_sport_logo != None:
                return shg_other_sport_logo
            other_sport_logo = MP_OTHER_SPORT_LOGOS_BY_ID.get(str(school_id).lower())
            if other_sport_logo != None:
                return other_sport_logo
            basketball_logo = MP_BASKETBALL_LOGOS_BY_ID.get(str(school_id).lower())
            if basketball_logo != None:
                return basketball_logo
            top25_logo = TOP25_LOGOS_BY_ID.get(str(school_id).lower())
            if top25_logo != None:
                return top25_logo
    ca_dc_ranked_name_logo = CA_DC_BASKETBALL_RANKED_LOGOS_BY_NAME.get(name)
    if ca_dc_ranked_name_logo != None:
        return ca_dc_ranked_name_logo
    az_ranked_name_logo = AZ_BASKETBALL_RANKED_LOGOS_BY_NAME.get(name)
    if az_ranked_name_logo != None:
        return az_ranked_name_logo
    al_ranked_name_logo = AL_BASKETBALL_RANKED_LOGOS_BY_NAME.get(name)
    if al_ranked_name_logo != None:
        return al_ranked_name_logo
    national_ranked_name_logo = NATIONAL_BASKETBALL_RANKED_LOGOS_BY_NAME.get(name)
    if national_ranked_name_logo != None:
        return national_ranked_name_logo
    nc_ranked_name_logo = NC_BASKETBALL_RANKED_LOGOS_BY_NAME.get(name)
    if nc_ranked_name_logo != None:
        return nc_ranked_name_logo
    il_ranked_name_logo = IL_BASKETBALL_RANKED_LOGOS_BY_NAME.get(name)
    if il_ranked_name_logo != None:
        return il_ranked_name_logo
    shg_other_sport_name_logo = SHG_OTHER_SPORT_LOGOS_BY_NAME.get(name)
    if shg_other_sport_name_logo != None:
        return shg_other_sport_name_logo
    other_sport_name_logo = MP_OTHER_SPORT_LOGOS_BY_NAME.get(name)
    if other_sport_name_logo != None:
        return other_sport_name_logo
    basketball_name_logo = MP_BASKETBALL_LOGOS_BY_NAME.get(name)
    if basketball_name_logo != None:
        return basketball_name_logo
    top25_name_logo = TOP25_LOGOS_BY_NAME.get(name)
    if top25_name_logo != None:
        return top25_name_logo
    # The header-free layout gives the selected school's mascot enough height.
    if name == "MYERS PARK" or name.startswith("MYERS PARK "):
        return "myers-park-maxpreps-led.png"
    if name == "SACRED HEART-GRIFFIN" or name.startswith("SACRED HEART-GRIFFIN "):
        # Use the preserved high-contrast MaxPreps artwork. The unprocessed
        # official file has black SHG lettering that disappears on this panel.
        return "shg-maxpreps-led-v5.png"
    if name == "LINCOLN-WAY CENTRAL" or name.startswith("LINCOLN-WAY CENTRAL "):
        return "lwc-maxpreps-led.png"
    if name == "PROVIDENCE DAY" or name.startswith("PROVIDENCE DAY "):
        return "providence-day-maxpreps-led.png"
    if name == "JOLIET CATHOLIC" or name.startswith("JOLIET CATHOLIC "):
        return "joliet-catholic-maxpreps-led.png"
    if name == "SPRINGFIELD SOUTHEAST" or name.startswith("SPRINGFIELD SOUTHEAST "):
        return "springfield-southeast-maxpreps-led.png"
    if name == "SPRINGFIELD" or name.startswith("SPRINGFIELD HIGH"):
        return "springfield-maxpreps-led.png"
    if name == "JACKSONVILLE" or name.startswith("JACKSONVILLE "):
        return "jacksonville-maxpreps-led.png"
    if name == "QUINCY NOTRE DAME" or name.startswith("QUINCY NOTRE DAME "):
        return "quincy-notre-dame-maxpreps-led.png"
    if name == "LANPHIER" or name.startswith("LANPHIER "):
        return "lanphier-maxpreps-led.png"
    if name == "ROCHESTER" or name.startswith("ROCHESTER "):
        return "rochester-maxpreps-led.png"
    # GHS is ambiguous (Glenwood, Guilford, and other one-word schools all
    # produce it), so only the verified school name may select this logo.
    if name == "GLENWOOD" or name.startswith("GLENWOOD "):
        return "glenwood-maxpreps-led.png"
    if name == "WEDDINGTON" or name.startswith("WEDDINGTON "):
        return "weddington-maxpreps-led.png"
    if name == "PROVIDENCE" or name.startswith("PROVIDENCE HIGH"):
        return "providence-maxpreps-led.png"
    if name == "MALLARD CREEK" or name.startswith("MALLARD CREEK "):
        return "mallard-creek-maxpreps-led.png"
    if name == "CHARLOTTE COUNTRY DAY" or name.startswith("CHARLOTTE COUNTRY DAY "):
        return "charlotte-country-day-maxpreps-led.png"
    if name == "GARINGER" or name.startswith("GARINGER "):
        return "garinger-maxpreps-led.png"
    if name == "HOPEWELL" or name.startswith("HOPEWELL "):
        return "hopewell-maxpreps-led.png"
    if name == "WEST MECKLENBURG" or name.startswith("WEST MECKLENBURG "):
        return "west-mecklenburg-maxpreps-led.png"
    if name == "HOUGH" or name.startswith("HOUGH "):
        return "hough-maxpreps-led.png"
    if name == "SOUTH MECKLENBURG" or name.startswith("SOUTH MECKLENBURG "):
        return "south-mecklenburg-maxpreps-led.png"
    return None

def team_logo_size(logo, large = False):
    # Every logo asset is normalized onto the same transparent canvas after
    # being cropped to its visible artwork. Rendering the complete canvas
    # preserves each mascot's natural proportions while giving wide, square,
    # and narrow marks the same available identity area.
    if logo == "shg-maxpreps-led-v5.png":
        return [29, 22] if large else [16, 12]
    return [40, 22] if large else [20, 11]

def badge_letters(code):
    value = str(code).upper()
    if len(value) >= 3:
        return value[:3]
    if len(value) == 2:
        return value
    return value

def badge_text_color(color):
    if is_hex_color(color):
        r = int(color[1:3], 16)
        g = int(color[3:5], 16)
        b = int(color[5:7], 16)
        if (r + g + b) / 3 < 150:
            return "white"
    return "black"

def color_distance(first, second):
    if first == None or second == None:
        return 0
    if not is_hex_color(first) or not is_hex_color(second):
        return 0
    total = 0
    for start in [1, 3, 5]:
        difference = int(first[start:start + 2], 16) - int(second[start:start + 2], 16)
        if difference < 0:
            difference = -difference
        total += difference
    return total

def identity_text_color(team):
    background = team["color"]
    for accent in [team.get("color2"), team.get("color3")]:
        if accent != None and accent != background and color_distance(background, accent) >= 180:
            return accent
    return badge_text_color(background)

def scoreboard_school(c, ctx):
    schools = school_settings(ctx)
    if not sport_is_active(ctx, schools["timezone"]):
        draw_empty(c, "OFFSEASON", "#d8b04a")
        return
    g = fetch_game_adaptive(ctx, "dynamic", "school")
    state = g.get("displayState")
    if state == "key_error":
        draw_empty(c, "KEY ERROR", "#ff3b30")
    elif state == "no_credits":
        draw_empty(c, "NO CREDITS", "#ff3b30")
    elif state == "url_error":
        draw_empty(c, "URL ERROR", "#ff3b30")
    elif state == "school_error":
        draw_empty(c, "SCHOOL ERROR", "#ff3b30")
    elif state == "feed_error" or state == "error":
        draw_empty(c, "FEED ERROR", "#ff3b30")
    elif state == "no_game" or state == "no_upcoming" or state == "no_final":
        draw_empty(c, "NO GAME")
    elif g.get("type") == "final" or g.get("status") == "final":
        draw_final(c, g)
    else:
        draw_next(c, g)
    # Logos are intentionally allowed to use their full natural footprint, but
    # they must never paint over the scoreboard's outside frame. Restore the
    # far-left edge last so it remains visible from the identity/logo area to
    # the bottom in Next, Live, and Final.
    c.line(0, 8, 0, 31, BOX_COLOR)

# ---------------------------------------------------------------------------
# Restored logo-matchup presentation (v0.13.6)
#
# These definitions intentionally come last so the data layer above remains
# isolated from presentation changes. The layout is reconstructed from the
# preserved Next/Live/Final 192x32 previews.

HEADER_BOX = {"x": 0, "y": 1, "w": 95, "h": 7}
IDENTITY_BOX = {"x": 0, "y": 8, "w": 95, "h": 23}
DETAIL_BOX = {"x": 95, "y": 0, "w": 46, "h": 31}
RESTORED_AWAY_ABBR = {"x": 141, "y": 0, "w": 24, "h": 15}
RESTORED_AWAY_VALUE = {"x": 165, "y": 0, "w": 26, "h": 15}
RESTORED_HOME_ABBR = {"x": 141, "y": 16, "w": 24, "h": 15}
RESTORED_HOME_VALUE = {"x": 165, "y": 16, "w": 26, "h": 15}
NEXT_AWAY_ABBR = {"x": 95, "y": 0, "w": 24, "h": 15}
NEXT_HOME_ABBR = {"x": 95, "y": 16, "w": 24, "h": 15}
NEXT_AWAY_STATS = {"x": 119, "y": 0, "w": 72, "h": 15}
NEXT_HOME_STATS = {"x": 119, "y": 16, "w": 72, "h": 15}
FINAL_AWAY_ABBR = {"x": 95, "y": 0, "w": 24, "h": 15}
FINAL_HOME_ABBR = {"x": 95, "y": 16, "w": 24, "h": 15}
FINAL_AWAY_VALUE = {"x": 171, "y": 0, "w": 20, "h": 15}
FINAL_HOME_VALUE = {"x": 171, "y": 16, "w": 20, "h": 15}

SPORT_HEADER = {
    "FB": "FB",
    "BB": "MBB",
    "WBB": "WBB",
    "BSB": "BSBL",
    "SB": "SFTB",
    "GVB": "VB",
    "SOC": "MSOC",
    "GSC": "WSOC",
}

def restored_center_text(c, text, x, y, w, font, color):
    c.text(str(text), x + w // 2, y, font = font, color = color, align = "center")

def restored_header(c, g):
    c.rect(1, 2, 94, 7, fill = STATUS_BAR_FILL)
    c.rect(1, 8, 94, 8, fill = "white")
    sport_text = SPORT_HEADER.get(g.get("sport", "FB"), g.get("sport", "FB"))
    c.text(sport_text, 2, 2, font = "4x5", color = STATUS_BAR_TEXT)
    when = str(g.get("when", ""))
    parts = when.split(" ")
    day_text = ""
    calendar_text = ""
    if len(parts) > 1:
        day_text = parts[0]
        calendar_text = parts[1]
    date_width = len(day_text) * 5 - 1
    calendar_width = len(calendar_text) * 5 - 1
    date_gap = 3
    status_text = ""
    status_color = STATUS_BAR_TEXT
    raw_status = str(g.get("status", "")).strip().lower()
    period_text = restored_period(g.get("livePeriod"))
    if raw_status in ["forfeit", "ff"] or g.get("forfeit", False):
        status_text = "FF"
        status_color = "red"
    elif g.get("type") == "final" or raw_status == "final":
        status_text = final_label(g)
        status_color = "red"
    elif raw_status in ["postponed", "pp", "ppd"]:
        status_text = "PP"
        status_color = "#d8b04a"
    elif raw_status in ["delayed", "delay", "suspended"]:
        status_text = "DELAY"
        status_color = "#d8b04a"
    elif raw_status == "live":
        status_text = period_text if period_text.startswith("OT") else "LIVE"
        status_color = "green" if g.get("hasLiveScore", False) else STATUS_BAR_TEXT
    else:
        time_parts = str(g.get("when", "")).split(" ")
        game_time = time_parts[2] if len(time_parts) > 2 else ""
        suffix = game_time[-1:] if len(game_time) > 0 else ""
        # Keep the scheduled minutes. Dropping ":30" made a 7:30 Central
        # kickoff appear as 8 PM instead of 8:30 on an Eastern display.
        status_text = game_time[:-1] if suffix in ["A", "P"] else game_time
        status_color = STATUS_BAR_TEXT
    status_width = len(status_text) * 5 - 1
    status_start = 95 - status_width
    sport_width = len(sport_text) * 5 - 1
    open_left = 2 + sport_width + 2
    open_right = status_start - 2
    date_group_width = date_width + date_gap + calendar_width
    date_start = open_left + (open_right - open_left + 1 - date_group_width) // 2
    c.text(day_text, date_start, 2, font = "4x5", color = STATUS_BAR_TEXT)
    c.text(calendar_text, date_start + date_width + date_gap, 2, font = "4x5", color = STATUS_BAR_TEXT)
    if status_text != "":
        c.text(status_text, 94, 2, font = "4x5", color = status_color, align = "right")

def final_label(g):
    sport = g.get("sport", "FB")
    period = restored_period(g.get("livePeriod"))
    overtime = str(g.get("overtime", "")).strip().upper()
    if overtime == "":
        overtime = period if period.startswith("OT") else ""
    if sport == "BSB" or sport == "SB":
        innings = g.get("innings", g.get("inning"))
        if innings != None and str(innings).isdigit() and int(innings) > 7:
            return "F" + str(innings)
        return "FINAL"
    if overtime != "":
        number = overtime.replace("OT", "")
        if number == "" or number == "1":
            return "F OT"
        return "F OT" + number
    return "FINAL"

def restored_mascot_line(mascot):
    if mascot == None:
        return ""
    value = str(mascot).strip().upper().replace("GOLDEN ", "GOLD ")
    value = value.replace("FIGHTING ", "FTG ")
    value = value.replace("PURPLE ", "PURP ")
    value = value.replace("CRIMSON ", "CRIM ")
    value = value.replace("YELLOW ", "YEL ")
    value = value.replace("FLYING ", "FLY ")
    value = value.replace("THUNDERBOLTS", "T-BOLTS")
    value = value.replace("MOUNTAINEERS", "MTNEERS")
    return value

def restored_mascot_style(mascot):
    value = restored_mascot_line(mascot)
    # Use the largest font that safely fits the 48px identity half. Step down
    # only when necessary so short names stay clear and two-word names stay in
    # their own panel without touching the center divider.
    if len(value) <= 8:
        return {"text": value, "font": "4x5", "y": 26}
    if len(value) <= 11:
        return {"text": value, "font": "3x4", "y": 27}
    words = value.split(" ")
    if len(words) == 2 and len(words[0]) <= 11 and len(words[1]) <= 11:
        return {
            "text": words[0],
            "line2": words[1],
            "font": "3x4",
            "y": 22,
            "line2_y": 27,
            "abbr_font": "10x10",
            "abbr_y": 10,
            "abbr_bold": True,
            "abbr_spaced": True,
        }
    if len(value) > 12:
        value = value[:12]
    return {"text": value, "font": "picopixel", "y": 26}

def restored_stacked_abbr(c, text, x, y, w, color, x_offset = 0):
    value = str(text).upper()[:3]
    advance = 12
    glyph_width = 10
    total = (len(value) - 1) * advance + glyph_width
    start = x + (w - total) // 2 + x_offset
    for index in range(len(value)):
        c.text(value[index], start + index * advance, y, font = "10x10", color = color)

def restored_identity(c, team, code, g, side, x, w):
    logo = team_logo(code, g, side)
    if logo != None:
        # Keep real logo artwork on the neutral panel background. Text-only
        # identities retain the school-color fill below.
        c.rect(x, 9, x + w - 1, 30, fill = FILL_COLOR)
        logo_size = team_logo_size(logo, True)
        logo_w = logo_size[0]
        logo_h = logo_size[1]
        logo_y = 9
        c.image(logo, x + (w - logo_w) // 2, logo_y, w = logo_w, h = logo_h)
        return
    c.rect(x, 9, x + w - 1, 30, fill = team["color"])
    mascot = g.get(side + "Mascot")
    mascot_style = restored_mascot_style(mascot)
    text_color = identity_text_color(team)
    letters = badge_letters(code)[:3]
    if mascot_style.get("abbr_spaced", False):
        restored_stacked_abbr(c, letters, x, mascot_style.get("abbr_y", 9), w, text_color)
        if mascot_style.get("abbr_bold", False):
            restored_stacked_abbr(c, letters, x, mascot_style.get("abbr_y", 9), w, text_color, 1)
    else:
        restored_center_text(
            c,
            letters,
            x,
            mascot_style.get("abbr_y", 9),
            w,
            mascot_style.get("abbr_font", "10x16"),
            text_color,
        )
        if mascot_style.get("abbr_bold", False):
            restored_center_text(
                c,
                letters,
                x + 1,
                mascot_style.get("abbr_y", 9),
                w,
                mascot_style.get("abbr_font", "10x16"),
                text_color,
            )
    if mascot_style["text"] != "":
        restored_center_text(c, mascot_style["text"], x, mascot_style["y"], w, mascot_style["font"], text_color)
    if mascot_style.get("line2", "") != "":
        restored_center_text(c, mascot_style["line2"], x, mascot_style["line2_y"], w, mascot_style["font"], text_color)

def restored_matchup(c, g):
    away = team_info(g["away"], g, "away")
    home = team_info(g["home"], g, "home")
    away_logo = team_logo(g["away"], g, "away")
    home_logo = team_logo(g["home"], g, "home")
    restored_identity(c, away, g["away"], g, "away", 0, 48)
    restored_identity(c, home, g["home"], g, "home", 48, 48)
    # Text-only identities can share the same fallback color, so only those
    # matchups receive a visible center divider. Distinct real logos do not.
    if away_logo == None or home_logo == None:
        c.vline(47, 9, 16, BOX_COLOR)
        c.vline(47, 25, 30, BOX_COLOR)
    restored_center_text(c, "VS", 44, 19, 8, "3x4", "white")
    # Draw the header last so the full-size artwork runs underneath it and is
    # cleanly covered rather than rescaled or allowed to overlap header text.
    restored_header(c, g)
    # Restore the outer bottom edge after drawing full-size logos so artwork
    # is clipped behind the frame instead of covering its outline.
    c.hline(31, 0, 95, BOX_COLOR)

def restored_abbreviation(c, team, code, record, box):
    letters = badge_letters(code)[:3]
    draw_box(c, box["x"], box["y"], box["w"], box["h"])
    color = team["color"]
    if is_whiteish(color) or is_darkish(color):
        color = TEAM_COLOR_FALLBACK
    restored_center_text(c, letters, box["x"], box["y"] + 1, box["w"], "6x8", color)
    restored_center_text(c, record, box["x"], box["y"] + 10, box["w"], "4x5", "white")

def restored_value(c, value, box, color = "white"):
    draw_box(c, box["x"], box["y"], box["w"], box["h"])
    restored_center_text(c, value, box["x"], box["y"] + 4, box["w"], "7x12", color)

def restored_period(period):
    if period == None:
        return ""
    value = str(period).strip().upper()
    if value == "" or value == "NONE" or value == "NULL":
        return ""
    if value in ["HT", "HALF", "HALFTIME", "HALF TIME", "INTERMISSION"]:
        return "HT"
    if value.isdigit():
        return value + "Q"
    if value.startswith("Q") and len(value) > 1:
        return value[1:] + "Q"
    if value == "OT":
        return "OT1"
    return value[:6]

def restored_live_period(g):
    period = restored_period(g.get("livePeriod"))
    sport = g.get("sport", "FB")
    if sport == "SOC" or sport == "GSC":
        if period.endswith("Q"):
            return period[:-1] + "H"
        if period.startswith("H") and len(period) > 1:
            return period[1:] + "H"
    return period

def compact_update_time(value, display_timezone = None):
    if value == None:
        return ""
    raw = str(value).strip().upper()
    if raw in ["", "NONE", "NULL"]:
        return ""
    # Parse timestamps are normally UTC ISO strings. Convert them to the
    # user's selected display time zone instead of displaying the UTC hour.
    # Explicit non-zero ISO offsets are handled as well.
    if len(raw) >= 16 and raw[4:5] == "-" and raw[10:11] in ["T", " "]:
        year = int(raw[0:4])
        month = int(raw[5:7])
        day = int(raw[8:10])
        hour = int(raw[11:13])
        minute_number = int(raw[14:16])
        # Parse currently omits the trailing Z on some UTC timestamps.
        # Treat a timezone-less ISO value from this endpoint as UTC rather
        # than displaying its hour as if it were already local.
        offset_minutes = 0
        if raw.endswith("Z"):
            offset_minutes = 0
        elif len(raw) >= 25 and raw[19:20] in ["+", "-"]:
            offset_sign = 1 if raw[19:20] == "+" else -1
            offset_minutes = offset_sign * (int(raw[20:22]) * 60 + int(raw[23:25]))
        if offset_minutes != None and display_timezone != None:
            utc_unix = days_from_civil(year, month, day) * 86400
            utc_unix += hour * 3600 + minute_number * 60
            utc_unix -= offset_minutes * 60
            local_time = date_info_in_timezone(utc_unix, display_timezone)
            hour = local_time["hour"]
            minute_number = local_time["minute"]
        minute = pad2(minute_number)
        suffix = "A" if hour < 12 else "P"
        display_hour = hour % 12
        if display_hour == 0:
            display_hour = 12
        return str(display_hour) + ":" + minute + suffix
    if len(raw) > 7:
        return raw[:7]
    return raw

def compact_unix_time(unix, display_timezone):
    local_time = date_info_in_timezone(unix, display_timezone)
    hour = local_time["hour"]
    suffix = "A" if hour < 12 else "P"
    display_hour = hour % 12
    if display_hour == 0:
        display_hour = 12
    return str(display_hour) + ":" + pad2(local_time["minute"]) + suffix

def restored_detail(c, g):
    draw_box(c, DETAIL_BOX["x"], DETAIL_BOX["y"], DETAIL_BOX["w"], DETAIL_BOX["h"])
    center = DETAIL_BOX["x"] + DETAIL_BOX["w"] // 2
    if g.get("type") == "final" or g.get("status") == "final":
        return
    if g.get("status") in ["delayed", "postponed", "delay", "pp"]:
        return
    if g.get("status") == "live":
        if g.get("sport") == "BSB" or g.get("sport") == "SB":
            restored_baseball_diamond(c, g)
            return
        period = restored_live_period(g)
        clock = str(g.get("liveClock", "")).strip().upper()
        if clock == "NONE" or clock == "NULL":
            clock = ""
        if period.startswith("OT"):
            period = ""
        if period != "":
            c.text(period, center, 7, font = "4x5", color = "white", align = "center")
        if clock != "":
            c.text(clock, center, 18 if period != "" else 13, font = "4x5", color = "white", align = "center")
        # Once Parse has returned an actual live score or period, the detail
        # box should stay focused on game state instead of showing a redundant
        # scorekeeper update timestamp. Keep UPDATED only as a fallback when
        # the game is marked live but no usable live details have arrived.
        elif period == "" and not g.get("hasLiveScore", False):
            updated = compact_update_time(g.get("updatedAt"))
            if updated == "":
                updated = str(g.get("checkedAt", ""))
            if updated != "":
                c.text("UPDATED", center, 13, font = "4x5", color = "white", align = "center")
                c.text(updated, center, 22, font = "4x5", color = "white", align = "center")
        return
    when = str(g.get("when", "")).split(" ")
    day = when[0] if len(when) > 0 else ""
    date = when[1] if len(when) > 1 else ""
    time = when[2] if len(when) > 2 else ""
    c.text(day, center, 4, font = "4x5", color = "white", align = "center")
    c.text(date, center, 13, font = "4x5", color = "white", align = "center")
    c.text(time, center, 22, font = "4x5", color = "white", align = "center")

def restored_baseball_diamond(c, g):
    # Glance-style baseball state: three bases, inning arrow/number, two outs.
    center = DETAIL_BOX["x"] + DETAIL_BOX["w"] // 2
    bases = g.get("bases", [False, False, False])
    # Every base uses identical 9x9 diamond geometry. Only its position in
    # the infield changes; occupied and empty bases retain the same shape.
    positions = [[center + 7, 11], [center, 5], [center - 7, 11]]
    half = str(g.get("inningHalf", "TOP")).upper()
    batting_side = "away" if half.startswith("T") else "home"
    batting_team = team_info(g.get(batting_side, "TBD"), g, batting_side)
    base_color = batting_team["color"]
    if is_whiteish(base_color) or is_darkish(base_color):
        base_color = TEAM_COLOR_FALLBACK
    for index in range(3):
        occupied = index < len(bases) and bases[index]
        x = positions[index][0]
        y = positions[index][1]
        # Draw every base from the same nine explicit rows. This avoids
        # diagonal-line rounding differences and guarantees identical shapes.
        for row_index in range(9):
            width = row_index if row_index <= 4 else 8 - row_index
            row_y = y - 4 + row_index
            if occupied:
                c.line(x - width, row_y, x + width, row_y, base_color)
            elif width == 0:
                c.pixel(x, row_y, "#aeb8c4")
            else:
                c.pixel(x - width, row_y, "#aeb8c4")
                c.pixel(x + width, row_y, "#aeb8c4")
    inning = str(g.get("inning", "1"))
    outs = str(g.get("outs", "0"))
    # Up triangle = top half; down triangle = bottom half.
    arrow_x = center - 4
    if half.startswith("T"):
        c.pixel(arrow_x, 18, "white")
        c.line(arrow_x - 1, 19, arrow_x + 1, 19, "white")
        c.line(arrow_x - 2, 20, arrow_x + 2, 20, "white")
        c.line(arrow_x - 3, 21, arrow_x + 3, 21, "white")
    else:
        c.line(arrow_x - 3, 18, arrow_x + 3, 18, "white")
        c.line(arrow_x - 2, 19, arrow_x + 2, 19, "white")
        c.line(arrow_x - 1, 20, arrow_x + 1, 20, "white")
        c.pixel(arrow_x, 21, "white")
    c.text(inning, center + 4, 17, font = "5x7", color = "white", align = "center")
    out_count = int(outs) if outs.isdigit() else 0
    for index in range(2):
        x = center - 5 + index * 7
        c.rect(x, 25, x + 4, 29, outline = "#aeb8c4")
        if index < out_count:
            c.rect(x + 1, 26, x + 3, 28, fill = "white")

def restored_frame(c, g):
    c.fill(FILL_COLOR)
    draw_box(c, 0, 0, 191, 31)
    restored_matchup(c, g)
    restored_detail(c, g)

def draw_final(c, g):
    c.fill(FILL_COLOR)
    draw_box(c, 0, 0, 191, 31)
    restored_matchup(c, g)
    away = team_info(g["away"], g, "away")
    home = team_info(g["home"], g, "home")
    restored_abbreviation(c, away, g["away"], g.get("awayRecord", "0-0"), FINAL_AWAY_ABBR)
    restored_abbreviation(c, home, g["home"], g.get("homeRecord", "0-0"), FINAL_HOME_ABBR)
    sport = g.get("sport", "FB")
    if sport == "BSB" or sport == "SB":
        restored_three_stat_final(c, g, ["Score", "Hits", "Errors"])
    elif sport == "GVB":
        restored_volleyball_final(c, g)
    elif sport == "SOC" or sport == "GSC":
        restored_soccer_final(c, g)
    else:
        restored_quarter_row(c, g.get("awayQuarters", ["-", "-", "-", "-"]), 0)
        restored_quarter_row(c, g.get("homeQuarters", ["-", "-", "-", "-"]), 16)
        restored_value(c, str(g.get("awayScore", "-")), FINAL_AWAY_VALUE, "green" if g.get("winner") == "away" else "white")
        restored_value(c, str(g.get("homeScore", "-")), FINAL_HOME_VALUE, "green" if g.get("winner") == "home" else "white")

def restored_three_stat_final(c, g, suffixes):
    for row in range(2):
        side = "away" if row == 0 else "home"
        y = 0 if row == 0 else 16
        values = [g.get(side + suffixes[0], g.get(side + "Score", "-")), g.get(side + suffixes[1], "-"), g.get(side + suffixes[2], "-")]
        for index in range(3):
            box = {"x": 119 + index * 24, "y": y, "w": 24, "h": 15}
            draw_box(c, box["x"], box["y"], box["w"], box["h"])
            color = "green" if index == 0 and g.get("winner") == side else "white"
            restored_center_text(c, values[index], box["x"] + 5, box["y"] + 4, box["w"] - 5, "5x7", color)
    labels = ["R", "H", "E"]
    for index in range(3):
        c.text(labels[index], 120 + index * 24, 13, font = "4x5", color = "#aeb8c4")

def restored_volleyball_final(c, g):
    for row in range(2):
        side = "away" if row == 0 else "home"
        y = 0 if row == 0 else 16
        sets = g.get(side + "Sets", ["-", "-", "-", "-", "-"])
        for index in range(5):
            box = {"x": 119 + index * 10, "y": y, "w": 10, "h": 15}
            draw_box(c, box["x"], box["y"], box["w"], box["h"])
            restored_center_text(c, sets[index] if index < len(sets) else "-", box["x"], box["y"] + 5, box["w"], "3x7", "white")
        total_box = {"x": 169, "y": y, "w": 22, "h": 15}
        draw_box(c, total_box["x"], total_box["y"], total_box["w"], total_box["h"])
        total = g.get(side + "SetsWon", g.get(side + "Score", "-"))
        restored_center_text(c, total, total_box["x"], total_box["y"] + 4, total_box["w"], "7x12", "green" if g.get("winner") == side else "white")

def restored_soccer_final(c, g):
    for row in range(2):
        side = "away" if row == 0 else "home"
        y = 0 if row == 0 else 16
        halves = g.get(side + "Halves", ["-", "-"])
        values = [halves[0] if len(halves) > 0 else "-", halves[1] if len(halves) > 1 else "-", g.get(side + "Score", "-")]
        for index in range(3):
            box = {"x": 119 + index * 24, "y": y, "w": 24, "h": 15}
            draw_box(c, box["x"], box["y"], box["w"], box["h"])
            color = "green" if index == 2 and g.get("winner") == side else "white"
            restored_center_text(c, str(values[index]), box["x"], box["y"] + 4, box["w"], "5x7" if index < 2 else "7x12", color)

def restored_quarter_row(c, scores, y):
    for index in range(4):
        box = {"x": 119 + index * 13, "y": y, "w": 13, "h": 15}
        draw_box(c, box["x"], box["y"], box["w"], box["h"])
        score = scores[index] if index < len(scores) else "-"
        restored_center_text(c, score, box["x"], box["y"] + 5, box["w"], "3x7", "white")

def draw_next(c, g):
    if g.get("status") != "live":
        c.fill(FILL_COLOR)
        draw_box(c, 0, 0, 191, 31)
        restored_matchup(c, g)
        away = team_info(g["away"], g, "away")
        home = team_info(g["home"], g, "home")
        restored_abbreviation(c, away, g["away"], g.get("awayRecord", "0-0"), NEXT_AWAY_ABBR)
        restored_abbreviation(c, home, g["home"], g.get("homeRecord", "0-0"), NEXT_HOME_ABBR)
        restored_stats_grid(c, g)
        return
    if g.get("sport") == "GVB":
        restored_volleyball_live(c, g)
        return
    restored_frame(c, g)
    away = team_info(g["away"], g, "away")
    home = team_info(g["home"], g, "home")
    restored_abbreviation(c, away, g["away"], g.get("awayRecord", "0-0"), RESTORED_AWAY_ABBR)
    restored_abbreviation(c, home, g["home"], g.get("homeRecord", "0-0"), RESTORED_HOME_ABBR)
    away_value = g.get("awayRec", "-")
    home_value = g.get("homeRec", "-")
    restored_value(c, str(away_value), RESTORED_AWAY_VALUE)
    restored_value(c, str(home_value), RESTORED_HOME_VALUE)

def restored_volleyball_live(c, g):
    c.fill(FILL_COLOR)
    draw_box(c, 0, 0, 191, 31)
    restored_matchup(c, g)
    away = team_info(g["away"], g, "away")
    home = team_info(g["home"], g, "home")
    detail = {"x": 95, "y": 0, "w": 34, "h": 31}
    draw_box(c, detail["x"], detail["y"], detail["w"], detail["h"])
    set_number = restored_period(g.get("livePeriod")).replace("Q", "")
    c.text("SET", 112, 5, font = "5x7", color = "white", align = "center")
    c.text(set_number if set_number != "" else "1", 112, 16, font = "7x12", color = "white", align = "center")
    away_abbr = {"x": 129, "y": 0, "w": 24, "h": 15}
    home_abbr = {"x": 129, "y": 16, "w": 24, "h": 15}
    away_running = {"x": 153, "y": 0, "w": 14, "h": 15}
    home_running = {"x": 153, "y": 16, "w": 14, "h": 15}
    away_sets = {"x": 167, "y": 0, "w": 24, "h": 15}
    home_sets = {"x": 167, "y": 16, "w": 24, "h": 15}
    restored_abbreviation(c, away, g["away"], g.get("awayRecord", "0-0"), away_abbr)
    restored_abbreviation(c, home, g["home"], g.get("homeRecord", "0-0"), home_abbr)
    restored_small_value(c, str(g.get("awayRec", "0")), away_running)
    restored_small_value(c, str(g.get("homeRec", "0")), home_running)
    restored_value(c, str(g.get("awaySetsWon", "0")), away_sets)
    restored_value(c, str(g.get("homeSetsWon", "0")), home_sets)

def restored_small_value(c, value, box):
    draw_box(c, box["x"], box["y"], box["w"], box["h"])
    restored_center_text(c, value, box["x"], box["y"] + 5, box["w"], "5x7", "white")

def restored_stats_grid(c, g):
    stat_config = next_stat_config(g.get("sport", "FB"))
    labels = stat_config[0]
    keys = stat_config[1]
    for row in range(2):
        side = "away" if row == 0 else "home"
        y = 0 if row == 0 else 16
        values = [g.get(side + keys[0], "-"), g.get(side + keys[1], "-"), g.get(side + keys[2], "-")]
        for index in range(3):
            box = {"x": 119 + index * 24, "y": y, "w": 24, "h": 15}
            draw_box(c, box["x"], box["y"], box["w"], box["h"])
            value_color = "green" if stat_leader(g, side, index) else "white"
            value_y = box["y"] + 4
            restored_tight_stat_value(c, values[index] if values[index] != None else "-", box["x"] + 4, value_y, 20, value_color, index == 2, index < 2)
    for index in range(3):
        border_x = 119 + index * 24
        label = labels[index]
        font = "3x4"
        advance = 5
        x = border_x + 1
        label_height = len(label) * advance
        y = (32 - label_height) // 2
        for char_index in range(len(label)):
            c.text(label[char_index], x, y + char_index * advance, font = font, color = "#aeb8c4")

def restored_tight_stat_value(c, value, x, y, width, color, streak_spacing = False, small_font = False):
    text = str(value)
    advances = []
    total = 0
    for char_index in range(len(text)):
        char = text[char_index]
        advance = 4 if char == "." else 5
        if char.isdigit() and char_index + 1 < len(text) and text[char_index + 1].isdigit():
            advance += 1
        if small_font and char.isdigit() and char_index + 1 < len(text) and text[char_index + 1] == ".":
            advance -= 1
        if streak_spacing and char_index + 1 < len(text):
            advance += 1
        advances.append(advance)
        total += advance
    start = x + (width - total) // 2
    if small_font:
        start += 1
    cursor = start
    font = "4x7" if small_font else "5x7"
    decimal_index = -1
    for index in range(len(text)):
        if text[index] == ".":
            decimal_index = index
            break
    for index in range(len(text)):
        draw_x = cursor + (1 if small_font and decimal_index >= 0 and index < decimal_index else 0)
        c.text(text[index], draw_x, y, font = font, color = color)
        cursor += advances[index]

def next_stat_config(sport):
    if sport == "BSB" or sport == "SB":
        return ["RPG", "RAPG", "STRK"], ["PF", "PA", "Streak"]
    if sport == "GVB":
        return ["SW", "SL", "STRK"], ["SW", "SL", "Streak"]
    if sport == "SOC" or sport == "GSC":
        return ["GPG", "GAPG", "STRK"], ["GF", "GA", "Streak"]
    return ["PPG", "PAPG", "STRK"], ["PF", "PA", "Streak"]

def stat_number(value):
    if value == None:
        return None
    text = str(value).strip().upper()
    if text.startswith("W") or text.startswith("L"):
        number = text[1:]
        return int(number) if number.isdigit() and text.startswith("W") else 0
    whole = text.split(".")[0]
    return int(whole) if whole.isdigit() else None

def average_stat(value, record):
    if value == None:
        return None
    text = str(value).strip()
    if text == "" or text == "-":
        return value
    # Preserve a source-provided average while enforcing one decimal place.
    if "." in text:
        pieces = text.split(".")
        if pieces[0].isdigit():
            decimal = pieces[1][:1] if len(pieces) > 1 and pieces[1] != "" else "0"
            return pieces[0] + "." + decimal
        return value
    if not text.isdigit():
        return value
    games = 0
    for piece in str(record).split("-"):
        if piece.isdigit():
            games += int(piece)
    if games < 1:
        return text + ".0"
    tenths = (int(text) * 10 + games // 2) // games
    return str(tenths // 10) + "." + str(tenths % 10)

def stat_leader(g, side, index):
    other = "home" if side == "away" else "away"
    stat_config = next_stat_config(g.get("sport", "FB"))
    keys = stat_config[1]
    mine = stat_number(g.get(side + keys[index]))
    theirs = stat_number(g.get(other + keys[index]))
    if mine == None or theirs == None or mine == theirs:
        return False
    return mine < theirs if index == 1 else mine > theirs

def draw_empty(c, message, color = "white"):
    c.fill(FILL_COLOR)
    draw_box(c, 0, 0, 191, 31)
    c.text_center(message, 14, font = VALUE_FONT, color = color)
