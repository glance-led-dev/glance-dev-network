def finished_logo(name):
    exact = FINISHED_LOGOS_BY_NAME.get(name)
    if exact != None:
        return exact
    for school_name in FINISHED_LOGOS_BY_NAME:
        if name.startswith(school_name + " "):
            return FINISHED_LOGOS_BY_NAME[school_name]
    return None



# Official MaxPreps ranked-school catalog: at least 75 identity-safe logos
