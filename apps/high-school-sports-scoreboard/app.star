LOGO_COLOR_MAPS = [LOGO_COLORS_BY_ID_1, LOGO_COLORS_BY_ID_2, LOGO_COLORS_BY_ID_3, LOGO_COLORS_BY_ID_4, LOGO_COLORS_BY_ID_5, LOGO_COLORS_BY_ID_6, LOGO_COLORS_BY_ID_7, LOGO_COLORS_BY_ID_8, LOGO_COLORS_BY_ID_9, LOGO_COLORS_BY_ID_10, LOGO_COLORS_BY_ID_11, LOGO_COLORS_BY_ID_12, LOGO_COLORS_BY_ID_13, LOGO_COLORS_BY_ID_14, LOGO_COLORS_BY_ID_15, LOGO_COLORS_BY_ID_16, LOGO_COLORS_BY_ID_17, LOGO_COLORS_BY_ID_18, LOGO_COLORS_BY_ID_19, LOGO_COLORS_BY_ID_20, LOGO_COLORS_BY_ID_21, LOGO_COLORS_BY_ID_22]

def team_info(code, game = None, side = None):
    fallback = TEAMS.get(code, {"label": code, "color": "white", "color2": None})
    label = fallback["label"]
    color = fallback["color"]
    color2 = fallback.get("color2")
    color3 = fallback.get("color3")

    if game != None and side != None:
        live_name = game.get(side + "Name")
        if live_name != None:
            label = live_name.upper()
            # Abbreviations are not stable school identifiers (many unrelated
            # schools become GHS/NHS/OHS/etc.). Do not inherit a bundled
            # school's colors when the feed's full name identifies another
            # school with the same letters.
            if label != str(fallback["label"]).upper():
                color = "white"
                color2 = None
                color3 = None
        live_color = game.get(side + "Color")
        if live_color != None:
            color = live_color
        live_color2 = game.get(side + "Color2")
        if live_color2 != None:
            color2 = live_color2
        live_color3 = game.get(side + "Color3")
        if live_color3 != None:
            color3 = live_color3

    identity_colors = SCHOOL_COLORS.get(label.upper())
    if identity_colors != None:
        color = identity_colors[0]
        color2 = identity_colors[1]

    # MaxPreps color metadata is often stale or assigned to the wrong side.
    # Once a school has an identity-safe bundled logo, use that artwork as
    # the source of truth for its scoreboard abbreviation color.
    if game != None and side != None:
        school_id = game.get(side + "SchoolId")
        if school_id != None:
            for logo_color_map in LOGO_COLOR_MAPS:
                logo_color = logo_color_map.get(str(school_id).lower())
                if logo_color != None:
                    color = logo_color
                    break

    # MaxPreps sometimes reports black as SHG's primary and an inconsistent
    # yellow as its alternate. Keep the LED abbreviation on SHG's brand gold.
    if label == "SACRED HEART-GRIFFIN" or label.startswith("SACRED HEART-GRIFFIN "):
        color = "#d4b64f"
        color2 = "#000000"

    # Keep Myers Park's badge matched to the established green in its bundled
    # logo instead of accepting MaxPreps' changing live-feed color value.
    if label == "MYERS PARK" or label.startswith("MYERS PARK "):
        color = "#679a34"
        color2 = "#000000"

    if is_whiteish(color) or is_darkish(color):
        if color2 != None and not is_whiteish(color2) and not is_darkish(color2):
            color = color2
        elif color3 != None and not is_whiteish(color3) and not is_darkish(color3):
            color = color3
        else:
            color = TEAM_COLOR_FALLBACK

    return {"label": label, "color": color, "color2": color2, "color3": color3}

def team_abbreviation(name):
    if name == None or str(name).strip().upper() in ["", "NONE", "NULL", "TBD"]:
        return "TBD"
    value = str(name).strip().upper().replace("-", " ")
    words = []
    for word in value.split(" "):
        if word != "" and word not in ["HIGH", "SCHOOL"]:
            words.append(word)
    if len(words) >= 2:
        result = ""
        for word in words:
            result += word[0]
            if len(result) == 3:
                break
        return result
    if len(words) == 1:
        return words[0][0] + "HS"
    return "TBD"

def side_school_name(side, fallback = "TBD"):
    if type(side) != "dict":
        return fallback
    for key in ["school_name", "schoolName", "team_name", "teamName", "name", "display_name", "displayName"]:
        value = side.get(key)
        if value != None and str(value).strip().upper() not in ["", "NONE", "NULL"]:
            return str(value).strip()
    return fallback

def team_record(side, fallback = "0-0"):
    if type(side) != "dict":
        return fallback
    sources = [side]
    for container_key in ["stats", "statistics", "season_stats", "seasonStats", "team_stats", "teamStats", "summary"]:
        nested = side.get(container_key)
        if type(nested) == "dict":
            sources.append(nested)
    value = None
    for source in sources:
        for key in ["record", "overall_record", "overallRecord", "overall", "season_record", "seasonRecord"]:
            candidate = source.get(key)
            if candidate != None and str(candidate).strip() != "":
                value = candidate
                break
        if value != None:
            break
    if type(value) == "dict":
        wins = value.get("wins")
        losses = value.get("losses")
        ties = value.get("ties")
        if wins != None and losses != None:
            text = str(wins) + "-" + str(losses)
            if ties != None and int(ties) > 0:
                text += "-" + str(ties)
            return text
    if value != None and str(value).strip() != "":
        return str(value).strip()
    for source in sources:
        wins = source.get("wins", source.get("overall_wins", source.get("overallWins")))
        losses = source.get("losses", source.get("overall_losses", source.get("overallLosses")))
        ties = source.get("ties", source.get("overall_ties", source.get("overallTies")))
        if wins != None and losses != None:
            text = str(wins) + "-" + str(losses)
            if ties != None and int(ties) > 0:
                text += "-" + str(ties)
            return text
    return fallback

def team_stat(side, keys):
    if type(side) != "dict":
        return None
    sources = [side]
    for container_key in ["stats", "statistics", "season_stats", "seasonStats", "team_stats", "teamStats", "totals", "summary"]:
        nested = side.get(container_key)
        if type(nested) == "dict":
            sources.append(nested)
    for source in sources:
        for key in keys:
            value = source.get(key)
            if value != None and str(value).strip() != "":
                return str(value).strip()
    return None

def mascot_from_side(side, school_name = None):
    mascot = team_stat(side, ["mascot", "mascot_name", "mascotName", "nickname", "team_mascot", "teamMascot"])
    if mascot != None:
        return mascot
    if school_name != None:
        known = SCHOOL_MASCOTS.get(str(school_name).strip().upper())
        if known != None:
            return known
    # MaxPreps school paths end with the mascot (for example,
    # /rockford/guilford-vikings/). This keeps new schools useful even when
    # Parse omits its dedicated mascot field.
    path = team_stat(side, ["school_url", "schoolUrl", "team_url", "teamUrl", "profile_url", "profileUrl", "url", "path"])
    if path != None:
        pieces = []
        for piece in str(path).strip("/").split("/"):
            if piece != "":
                pieces.append(piece)
        if len(pieces) > 0:
            slug_parts = pieces[-1].split("-")
            if len(slug_parts) > 1:
                candidate = slug_parts[-1].strip().upper()
                if candidate not in ["FOOTBALL", "BASKETBALL", "BASEBALL", "SOFTBALL", "VOLLEYBALL", "SOCCER"]:
                    return candidate
    return None

