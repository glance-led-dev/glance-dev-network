# league -> feed path, team table, period letter and regulation periods
LEAGUES = {
    "mlb": {"path": "baseball/mlb", "teams": MLB_TEAMS, "per": "", "reg": 9},
}

# slot -> [league, input key, default team]; mirrors manifest.yaml
SLOTS = {
    "mlb1": ["mlb", "mlb1", "Los Angeles Dodgers"],
    "mlb2": ["mlb", "mlb2", NONE],
}


# ---- date and time plumbing ----------------------------------------------

def days_from_civil(y, m, d):
    """Days since the Unix epoch (Howard Hinnant's algorithm)."""
    yy = y - 1 if m <= 2 else y
    era = (yy if yy >= 0 else yy - 399) // 400
    yoe = yy - era * 400
    mp = m - 3 if m > 2 else m + 9
    doy = (153 * mp + 2) // 5 + d - 1
    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    return era * 146097 + doe - 719468


def civil_from_days(z):
    """[y, m, d] for a day count since the epoch (Hinnant, inverted)."""
    z = z + 719468
    era = (z if z >= 0 else z - 146096) // 146097
    doe = z - era * 146097
    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    y = yoe + era * 400
    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    mp = (5 * doy + 2) // 153
    d = doy - (153 * mp + 2) // 5 + 1
    m = mp + 3 if mp < 10 else mp - 9
    return [y + (1 if m <= 2 else 0), m, d]


def dst_start_unix(y):
    """Second Sunday of March, 07:00 UTC (US daylight time begins)."""
    d1 = days_from_civil(y, 3, 1)
    first_sun = 1 + (7 - (d1 + 4) % 7) % 7
    return days_from_civil(y, 3, first_sun + 7) * 86400 + 7 * 3600


def dst_end_unix(y):
    """First Sunday of November, 06:00 UTC (US daylight time ends)."""
    d1 = days_from_civil(y, 11, 1)
    first_sun = 1 + (7 - (d1 + 4) % 7) % 7
    return days_from_civil(y, 11, first_sun) * 86400 + 6 * 3600


def et_offset(unix):
    y = civil_from_days(unix // 86400)[0]
    if dst_start_unix(y) <= unix and unix < dst_end_unix(y):
        return -4
    return -5


def et_day(unix):
    """The Eastern-Time calendar day containing unix, as a day count."""
    return (unix + et_offset(unix) * 3600) // 86400


def parse_iso(s):
    """'2026-10-18T17:00Z' (UTC, seconds optional) -> unix, or None."""
    if s == None or len(s) < 16:
        return None
    ss = 0
    if len(s) >= 19 and s[16] == ":":
        ss = int(s[17:19])
    return (days_from_civil(int(s[0:4]), int(s[5:7]), int(s[8:10])) * 86400
            + int(s[11:13]) * 3600 + int(s[14:16]) * 60 + ss)


def short_date(unix):
    """'10/26' for the Eastern day containing unix."""
    cd = civil_from_days(et_day(unix))
    return "%d/%d" % (cd[1], cd[2])


def weekday(unix):
    return WEEKDAYS[(et_day(unix) + 4) % 7]


def time_label(unix):
    """'1 PM' / '1:05 PM' in Eastern time."""
    secs = (unix + et_offset(unix) * 3600) % 86400
    hh = secs // 3600
    mm = (secs % 3600) // 60
    ap = "AM" if hh < 12 else "PM"
    h12 = hh % 12
    if h12 == 0:
        h12 = 12
    if mm == 0:
        return "%d %s" % (h12, ap)
    ms = str(mm) if mm >= 10 else "0" + str(mm)
    return "%d:%s %s" % (h12, ms, ap)


def when_label(ev, now):
    """Kickoff line for a NEXT page: 'TODAY 7 PM', 'SUN 1 PM', 'SAT 11/1'."""
    diff = et_day(ev["unix"]) - et_day(now)
    if not ev["timeValid"]:
        return "%s %s" % (weekday(ev["unix"]), short_date(ev["unix"]))
    if diff <= 0:
        return "TODAY " + time_label(ev["unix"])
    if diff == 1:
        return "TMRW " + time_label(ev["unix"])
    if diff < 7:
        return "%s %s" % (weekday(ev["unix"]), time_label(ev["unix"]))
    return "%s %s" % (weekday(ev["unix"]), short_date(ev["unix"]))


# ---- the feed --------------------------------------------------------------

def score_of(t):
    sc = t.get("score")
    if type(sc) == "dict":
        sc = sc.get("displayValue")
    if sc == None:
        return None
    s = str(sc)
    return s if s.isdigit() else None


def shape(e, my_id):
    """One schedule event -> the bits the page draws, or None if unusable."""
    comp = (e.get("competitions") or [{}])[0]
    status = comp.get("status") or {}
    st = status.get("type") or {}
    mine = None
    opp = None
    for t in comp.get("competitors") or []:
        team = t.get("team") or {}
        ent = {"id": str(team.get("id")),
               "abbr": str(team.get("abbreviation") or "?").upper(),
               "home": t.get("homeAway") == "home",
               "score": score_of(t)}
        if ent["id"] == str(my_id):
            mine = ent
        else:
            opp = ent
    if mine == None or opp == None:
        return None
    return {"unix": parse_iso(e.get("date")),
            "state": st.get("state"),
            "status": str(st.get("name") or ""),
            "period": status.get("period") or 0,
            "clock": str(status.get("displayClock") or ""),
            "timeValid": e.get("timeValid", True),
            "mine": mine, "opp": opp}


def scan(events, my_id):
    """[live, finals newest first, upcoming soonest first]."""
    live = None
    done = []
    ahead = []
    for e in events:
        ev = shape(e, my_id)
        if ev == None or ev["unix"] == None:
            continue
        if ev["state"] == "in":
            live = ev
        elif ev["state"] == "post":
            done.append(ev)
        elif ev["state"] == "pre":
            ahead.append(ev)
    done = sorted(done, key = when_of, reverse = True)
    ahead = sorted(ahead, key = when_of)
    return [live, done, ahead]


def when_of(ev):
    return ev["unix"]


def pick(sc, now):
    """[kind, event] — kind is LIVE, FINAL, NEXT, DONE or NONE.

    Live first; a final less than 18h old; a game today or tomorrow; a final
    less than 3 days old; the next game; the last final standing."""
    live = sc[0]
    last = sc[1][0] if sc[1] else None
    nxt = sc[2][0] if sc[2] else None
    if live != None:
        return ["LIVE", live]
    if last != None and now - last["unix"] < 18 * 3600:
        return ["FINAL", last]
    if nxt != None and et_day(nxt["unix"]) - et_day(now) <= 1:
        return ["NEXT", nxt]
    if last != None and now - last["unix"] < 3 * 86400:
        return ["FINAL", last]
    if nxt != None:
        return ["NEXT", nxt]
    if last != None:
        return ["DONE", last]
    return ["NONE", None]


def fetch(lg, tid):
    url = ("https://site.api.espn.com/apis/site/v2/sports/%s/teams/%s/schedule"
           % (LEAGUES[lg]["path"], tid))
    r = http.get(url, ttl_seconds = 300)
    if r["status_code"] != 200 or not r["json"]:
        return None
    return r["json"]


# ---- drawing -----------------------------------------------------------------

def mid(c, text, y, fonts, color, x = 32, maxw = 22):
    c.text_fit(text, x, y, fonts, color = color, align = "center", maxw = maxw)


def logo(c, lg, tid, abbr, x, y, small = False):
    """Team logo in a 20px (or 10px) box; a framed abbreviation if unknown."""
    key = lg + str(tid)
    if key in LOGOS:
        c.image(LOGOS[key][1 if small else 0], x, y)
        return
    n = 10 if small else 20
    if small:
        c.text_fit(abbr, x + 5, y + 3, ["3x4"], color = GRAY, align = "center",
                   maxw = 10)
        return
    c.round_rect(x, y, x + n - 1, y + n - 1, 3, outline = DIM)
    c.text_fit(abbr, x + n // 2, y + 8, ["4x5", "3x4"], color = WHITE,
               align = "center", maxw = n - 2)


def record_of(data):
    team = data.get("team") or {}
    return str(team.get("recordSummary") or "").upper()


def live_clock(lg, ev):
    """['Q3', '4:12'] style labels for a game in progress."""
    per = ev["period"]
    lgc = LEAGUES[lg]
    if "HALFTIME" in ev["status"]:
        return ["HALF", ""]
    if per > lgc["reg"]:
        p = "OT" if per == lgc["reg"] + 1 else "%dOT" % (per - lgc["reg"])
    elif per > 0:
        p = "%s%d" % (lgc["per"], per)
    else:
        p = "LIVE"
    if "END_PERIOD" in ev["status"]:
        return ["END", p]
    return [p, ev["clock"]]


def matchup(c, lg, my_id, ev):
    """The two logos: my team left, opponent right."""
    logo(c, lg, my_id, ev["mine"]["abbr"], 1, 1)
    logo(c, lg, ev["opp"]["id"], ev["opp"]["abbr"], 43, 1)


def draw_next(c, lg, my_id, ev, rec, now):
    matchup(c, lg, my_id, ev)
    mid(c, "NEXT", 2, ["4x5"], GOLD)
    mid(c, "VS" if ev["mine"]["home"] else "AT", 9, ["5x7"], WHITE)
    if rec != "":
        mid(c, rec, 18, ["4x5", "3x4"], DIM)
    c.text_fit(when_label(ev, now).upper(), 32, 24, ["5x7", "4x5"],
               color = GOLD, align = "center", maxw = 62)


def draw_scores(c, lg, my_id, ev, kind):
    matchup(c, lg, my_id, ev)
    ms = ev["mine"]["score"]
    os = ev["opp"]["score"]
    mc = WHITE
    oc = WHITE
    if kind != "LIVE" and ms != None and os != None:
        if int(ms) > int(os):
            oc = GRAY
        elif int(ms) < int(os):
            mc = GRAY
    if ms != None:
        mid(c, ms, 23, ["6x8", "5x7"], mc, x = 11, maxw = 21)
    if os != None:
        mid(c, os, 23, ["6x8", "5x7"], oc, x = 53, maxw = 21)
    if kind == "LIVE":
        mid(c, "LIVE", 2, ["4x5", "3x4"], RED)
        lab = live_clock(lg, ev)
        mid(c, lab[0], 10, ["5x7", "4x5"], WHITE)
        if lab[1] != "":
            mid(c, lab[1], 19, ["4x5", "3x4"], GOLD)
        return
    mid(c, "FINAL" if kind == "FINAL" else "LAST", 2, ["4x5", "3x4"], GRAY)
    if ms != None and os != None:
        res = "W" if int(ms) > int(os) else ("L" if int(ms) < int(os) else "T")
        col = GREEN if res == "W" else (RED if res == "L" else WHITE)
        mid(c, res, 9, ["7x12", "6x8"], col)
    foot = short_date(ev["unix"]) if kind == "FINAL" else "DONE"
    mid(c, foot, 25, ["3x4"], DIM, maxw = 20)


def notice(c, lg, tid, big, small):
    logo(c, lg, tid, "?", 1, 6)
    c.text_fit(big, 43, 8, ["6x8", "5x7", "4x5"], color = GOLD,
               align = "center", maxw = 40)
    c.text_fit(small, 43, 19, ["4x5", "3x4"], color = DIM, align = "center",
               maxw = 40)


def draw_schedule(c, lg, tid, data, now):
    """Slot 2 is NONE: team 1's next three games (or last three results)."""
    sc = scan(data.get("events") or [], tid)
    logo(c, lg, tid, "?", 1, 1)
    rec = record_of(data)
    if rec != "":
        c.text_fit(rec, 11, 25, ["4x5", "3x4"], color = DIM, align = "center",
                   maxw = 22)
    rows = []
    if sc[0] != None:
        rows.append(["LIVE", sc[0]])
    for ev in sc[2]:
        rows.append(["NEXT", ev])
    if not rows:
        for ev in sc[1]:
            rows.append(["DONE", ev])
    if not rows:
        c.text_fit("NO GAMES", 43, 13, ["4x5", "3x4"], color = GOLD,
                   align = "center", maxw = 40)
        return
    c.vline(23, 1, 30, "#1C2030")
    for i in range(min(3, len(rows))):
        kind = rows[i][0]
        ev = rows[i][1]
        y = 1 + i * 11
        logo(c, lg, ev["opp"]["id"], ev["opp"]["abbr"], 26, y, small = True)
        if kind == "LIVE":
            lab = "LIVE"
            col = RED
        elif kind == "NEXT":
            days = et_day(ev["unix"]) - et_day(now)
            lab = weekday(ev["unix"]) if days < 7 else short_date(ev["unix"])
            if days <= 0:
                lab = "TODAY"
            col = WHITE
        else:
            ms = ev["mine"]["score"] or "0"
            os = ev["opp"]["score"] or "0"
            w = int(ms) > int(os)
            lab = ("W " if w else "L ") + ms + "-" + os
            col = GREEN if w else RED
        c.text_fit(lab, 50, y + 3, ["4x5", "3x4"], color = col,
                   align = "center", maxw = 26)


def chosen(ctx, slot):
    """The ESPN id for a slot's dropdown value, or None for NONE."""
    s = SLOTS[slot]
    table = LEAGUES[s[0]]["teams"]
    v = str(ctx.inputs.get(s[1], s[2])).strip()
    if v == NONE:
        return None
    if v not in table:
        v = s[2]
        if v == NONE:
            return None
    return table[v]


def on_teams(ctx):
    """[league, team id] for every slot holding a real team, in page order.

    A slot set to NONE contributes nothing: slot 2 NONE is just slot 1's
    schedule page, and slot 1 NONE takes the whole league off."""
    out = []
    for slot in ["mlb1", "mlb2"]:
        lg = SLOTS[slot][0]
        if chosen(ctx, lg + "1") == None:
            continue  # the league is off; slot 2's pick is ignored too
        tid = chosen(ctx, slot)
        if tid != None and [lg, tid] not in out:
            out.append([lg, tid])
    return out


def result_text(ev):
    """['W 24-17', colour] for a finished game."""
    ms = ev["mine"]["score"] or "0"
    os = ev["opp"]["score"] or "0"
    res = "W" if int(ms) > int(os) else ("L" if int(ms) < int(os) else "T")
    col = GREEN if res == "W" else (RED if res == "L" else WHITE)
    return ["%s %s-%s" % (res, ms, os), col]


def index_rows(ctx, mode):
    """One row per team still on: [abbr, text, colour].

    Mode NEXT takes each team's headline game (live beats a fresh final
    beats the next game, the same order pick() uses); mode LAST takes its
    most recent final."""
    rows = []
    for lg, tid in on_teams(ctx):
        data = fetch(lg, tid)
        if data == None:
            continue
        team = data.get("team") or {}
        abbr = str(team.get("abbreviation") or "?").upper()
        sc = scan(data.get("events") or [], tid)
        if mode == "LAST":
            if sc[1]:
                t = result_text(sc[1][0])
                rows.append([abbr, t[0], t[1]])
            elif sc[0] != None:
                ev = sc[0]
                rows.append([abbr, "LIVE %s-%s" % (ev["mine"]["score"] or "0",
                                                   ev["opp"]["score"] or "0"), RED])
            else:
                rows.append([abbr, "NO GAMES", DIM])
            continue
        got = pick(sc, ctx.now.unix)
        kind = got[0]
        ev = got[1]
        if ev == None:
            rows.append([abbr, "NO GAMES", DIM])
        elif kind == "LIVE":
            rows.append([abbr, "LIVE %s-%s" % (ev["mine"]["score"] or "0",
                                               ev["opp"]["score"] or "0"), RED])
        elif kind == "NEXT":
            rows.append([abbr, when_label(ev, ctx.now.unix).upper(), WHITE])
        else:
            t = result_text(ev)
            rows.append([abbr, t[0], t[1]])
    return rows


def draw_index(c, ctx, mode):
    """An off league's page: the teams still on, one line each.

    The first off page shows what is next (UP NEXT), the second the latest
    finals (LATEST); with more pages off they alternate."""
    mid(c, "UP NEXT" if mode == "NEXT" else "LATEST", 2, ["4x5"], GOLD,
        maxw = 40)
    rows = index_rows(ctx, mode)
    if not rows:
        mid(c, "NO TEAM ON", 13, ["4x5", "3x4"], GRAY, maxw = 50)
        mid(c, "PICK A TEAM", 21, ["3x4"], DIM, maxw = 50)
        return
    for i in range(min(4, len(rows))):
        y = 8 + i * 6
        c.text(rows[i][0], 1, y, "4x5", color = WHITE)
        c.text_fit(rows[i][1], 17, y, ["4x5", "3x4"], color = rows[i][2],
                   align = "left", maxw = 46)


def board(c, ctx, slot):
    c.fill(BG)
    lg = SLOTS[slot][0]
    if chosen(ctx, lg + "1") == None:
        # the league is off: this page becomes a board index page. Pages
        # before this one whose league is also off decide which index it
        # shows, so the two pages of an off league are NEXT then LATEST.
        n = 0
        for s in ["mlb1", "mlb2"]:
            if s == slot:
                break
            if chosen(ctx, SLOTS[s][0] + "1") == None:
                n += 1
        draw_index(c, ctx, "NEXT" if n % 2 == 0 else "LAST")
        return
    tid = chosen(ctx, slot)
    sched = False
    if tid == None:
        # slot 2 left empty: show slot 1's schedule instead
        tid = chosen(ctx, lg + "1")
        sched = True
    data = fetch(lg, tid)
    if data == None:
        notice(c, lg, tid, "NO FEED", "WILL RETRY")
        return
    if sched:
        draw_schedule(c, lg, tid, data, ctx.now.unix)
        return
    got = pick(scan(data.get("events") or [], tid), ctx.now.unix)
    kind = got[0]
    ev = got[1]
    if kind == "NONE" or ev == None:
        notice(c, lg, tid, "NO GAMES", "NONE POSTED")
    elif kind == "NEXT":
        draw_next(c, lg, tid, ev, record_of(data), ctx.now.unix)
    else:
        draw_scores(c, lg, tid, ev, kind)


def mlb1(c, ctx):
    board(c, ctx, "mlb1")


def mlb2(c, ctx):
    board(c, ctx, "mlb2")
