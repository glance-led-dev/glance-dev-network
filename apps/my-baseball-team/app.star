# My Baseball Team — your ball club, logo against logo.
#
# Two pages for one league: pick two MLB teams from the dropdowns. Slot 2
# can be NONE, and then that page turns into slot 1's upcoming schedule
# (next three games) so no page ever repeats. Slot 1 can be NONE too:
# that switches the app off, and both pages say so until a team is picked.
#
# Each matchup page answers one question: are they playing right now, did
# they just play, or when is the next one? Live score beats a fresh final
# (18h), a fresh final beats a game today or tomorrow, and after that the
# page looks ahead. A team with no next game keeps its last final up with
# a SEASON DONE tag instead of going blank. (Companion to My Teams Board:
# a display holds at most 8 pages per app, so baseball gets its own app.)
#
# DATA. ESPN's public team-schedule endpoint, no key:
#   site.api.espn.com/apis/site/v2/sports/<path>/teams/<id>/schedule
# One fetch per page per render, cached 300s. First-pitch times are
# converted from ESPN's UTC stamps to US Eastern by hand (fixed DST
# rules; there is no tz database here).
#
# ART. assets/mlb/<espn id>.png is a 20px logo, s<id>.png a 10px one,
# for every MLB team, so the opponent gets a logo too.

GOLD = "#E8B33A"
WHITE = "#FFFFFF"
GRAY = "#8A8AA8"
DIM = "#6A7090"
RED = "#FF5347"
GREEN = "#3EE07A"
BG = "#08090D"

NONE = "None"

MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
          "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
WEEKDAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]

