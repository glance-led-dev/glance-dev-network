FONTH = {"16x20": 20, "10x16": 16, "7x12": 12, "6x8": 8, "5x7": 7, "4x5": 5}

# ------------------------------------------------------------- text plumbing
def clip(c, text, font, maxw):
    """Longest prefix that fits. Nothing in the API clips on its own."""
    t = str(text)
    if c.text_width(t, font) <= maxw:
        return t
    for k in range(len(t), 0, -1):
        if c.text_width(t[:k], font) <= maxw:
            return t[:k]
    return ""

def fit(c, text, fonts, maxw):
    t = str(text)
    pick = fonts[len(fonts) - 1]
    for f in fonts:
        if c.text_width(t, f) <= maxw:
            pick = f
            break
    return [pick, clip(c, t, pick, maxw)]

def between(s, a, b, start):
    """Slice between two markers, or '' - the whole feed parse rests on this."""
    i = s.find(a, start)
    if i < 0:
        return ""
    i += len(a)
    j = s.find(b, i)
    if j < 0:
        return ""
    return s[i:j].strip()

def rating10(s):
    """Letterboxd hands back "4.0" / "4.5" as a string. Starlark's int() will
    not take either, and the naive strip-the-dot reading turns 4.0 into 40,
    which then clamps to a full five stars - every film looks like a favorite."""
    t = str(s).strip()
    if t == "":
        return 0
    parts = t.split(".")
    v = num(parts[0], 0) * 2
    if len(parts) > 1 and parts[1].startswith("5"):
        v += 1
    if v > 10:
        v = 10
    return v

def num(s, fallback):
    t = str(s).strip()
    d = ""
    for ch in t.elems():
        if ch >= "0" and ch <= "9":
            d += ch
    if d == "":
        return fallback
    return int(d)

# ------------------------------------------------------------------- chrome
def bulbs(c, y, x0, x1):
    """The marquee light row. Alternating lit and dim, 8px pitch."""
    i = 0
    for x in range(x0, x1, 8):
        col = GOLD if i % 2 == 0 else WARM
        c.pixel(x, y, col)
        c.pixel(x + 1, y, col)
        i += 1

def stars(c, x, y, rating10):
    """Gold star art for a 0-10 half-star scale. Returns width drawn."""
    full = rating10 // 2
    half = rating10 - full * 2
    dx = 0
    for i in range(full):
        c.sprite(STAR_ART, x + dx, y, color = GOLD)
        dx += 6
    if half > 0:
        c.sprite(HALF_ART, x + dx, y, color = GOLD)
        dx += 6
    for i in range(5 - full - half):
        c.sprite(STAR_ART, x + dx, y, color = STRUCT)
        dx += 6
    return dx

# Deep, saturated backdrops for the drawn-poster stand-in. A film with no
# bundled art gets a stable colour hashed from its title, so a stranger's list
# reads as a designed set rather than a row of identical blanks.
PHOLD = ["#1E3A5F", "#5B1A2B", "#2E4A2E", "#3A2A5A", "#5A3A00",
         "#1A4A4A", "#4A1A3A", "#264653", "#3D315B", "#523A28"]
_HASHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

def _titlehash(s):
    h = 7
    for ch in s.elems():
        i = _HASHA.find(ch.upper())
        h = (h * 31 + (i if i >= 0 else 5)) % 100003
    return h

def drawn_poster(c, title, x, y, frame):
    """A designed stand-in for a film with no bundled poster -- a stranger's list
    or a brand-new watch. GDN draws only bundled PNGs (no render-time image
    fetch), so a live feed's posters can't be pulled at draw time; rather than a
    blank slot, we render a per-film coloured panel with the title's monogram and
    reel-perforated edges, so any un-baked list still looks finished."""
    base = PHOLD[_titlehash(title) % len(PHOLD)]
    c.rect(x - 4, y - 1, x + 24, y + 31, fill = "#0A0E16")
    c.rect(x - 1, y - 1, x + 19, y + 30, fill = base)
    # film-strip perforations down each edge, like a frame lifted from a reel
    for sy in range(y + 1, y + 29, 4):
        c.pixel(x, sy, INK)
        c.pixel(x + 18, sy, INK)
    letter = title[0:1].upper() if title != "" else "?"
    c.text(letter, x + 9, y + 6, font = "16x20", color = CREAM, align = "center")
    c.rect(x - 2, y - 2, x + 20, y + 30, outline = frame)

def poster(c, file, title, x, y, frame = STRUCT):
    """The poster module. A bundled 21x32 PNG when one is present, otherwise a
    drawn monogram poster keyed to the title. `frame` sets the border colour
    (GOLD for the marquee-lit showcase tiles, dim STRUCT for the big card)."""
    if file != "" and file in POSTERS:
        c.rect(x - 4, y - 1, x + 24, y + 31, fill = "#0A0E16")
        c.image(file, x - 1, y - 1, w = 21, h = 32)
        c.rect(x - 2, y - 2, x + 20, y + 30, outline = frame)
        return
    drawn_poster(c, title, x, y, frame)

# --------------------------------------------------------------------- data
# Every page draws the same shape: a "film" is
#   [title, year, runtime, director, art, poster_file, rating10, cert].
# `cert` is the MPAA certificate, read defensively everywhere -- a pack row
# written before certs existed is only six long.
# Two builders produce it -- one from a canon slug, one from a live feed entry
# -- so the card renderer never has to know where a film came from.
def film_slug(slug, r):
    """A film built from a canon slug. r overrides the stored rating when >= 0
    (a diary entry carries its own), else the pack's rating stands."""
    f = CANON[slug]
    rr = r if r >= 0 else (f[5] if len(f) > 5 else 0)
    return [f[0], f[1], f[2], f[3], art_for(slug), f[4], rr,
            f[6] if len(f) > 6 else ""]

def film_live(slug, title, year, r10):
    """A film from a feed entry. If it is in the pack it brings the bundled
    poster + runtime/director; otherwise it rides the reel tile with the live
    title/year, so an off-canon watch still shows. A canon rating fills in when
    the feed carried none."""
    key = slug if slug in CANON else BY_TITLE.get(title.upper(), "")
    if key != "":
        f = CANON[key]
        rr = r10 if r10 > 0 else (f[5] if len(f) > 5 else 0)
        return [f[0], f[1], f[2], f[3], art_for(key), f[4], rr,
                f[6] if len(f) > 6 else ""]
    return [title.upper(), year, "", "", ART_REEL, "", r10, ""]

def _isyear(t):
    if len(t) != 4:
        return False
    for ch in t.elems():
        if ch < "0" or ch > "9":
            return False
    return True

def slug_parts(slug):
    """A display [title, year] guessed from a Letterboxd slug, for a listed film
    that is not in the pack (so there is no stored metadata to draw on)."""
    toks = slug.split("-")
    year = ""
    last = toks[len(toks) - 1]
    if _isyear(last):
        year = last
        toks = toks[:len(toks) - 1]
    return [" ".join(toks).upper(), year]

def list_slugs(user, list_slug):
    """Ordered film slugs from a public Letterboxd list. Lists have no RSS, so
    this reads the list page HTML (each poster carries data-film-slug). Empty on
    any failure, so the caller falls back to the canon."""
    resp = http.get("https://letterboxd.com/" + user + "/list/" + list_slug + "/", ttl_seconds = 900)
    if resp["status_code"] != 200:
        return []
    body = resp["body"]
    marker = "data-item-slug=\""  # list poster rows carry the film slug here
    slugs = []
    i = body.find(marker)
    for _n in range(300):
        if i < 0:
            break
        j = i + len(marker)
        k = body.find("\"", j)
        if k < 0:
            break
        s = body[j:k].strip("/").split("/")[-1]
        if s != "" and s not in slugs:
            slugs.append(s)
        i = body.find(marker, k)
    return slugs

def diary_films(user, n):
    """Up to n newest diary films as [slug, TITLE, year, rating10], live from the
    RSS. Empty on any failure so the caller can fall back to the pack."""
    if user == "":
        return []
    resp = http.get("https://letterboxd.com/" + user + "/rss/", ttl_seconds = 900)
    if resp["status_code"] != 200:
        return []
    body = resp["body"]
    out = []
    pos = 0
    for _n in range(n):
        s = body.find("<item>", pos)
        if s < 0:
            break
        title = between(body, "<letterboxd:filmTitle>", "</letterboxd:filmTitle>", s)
        year = between(body, "<letterboxd:filmYear>", "</letterboxd:filmYear>", s)
        rating = between(body, "<letterboxd:memberRating>", "</letterboxd:memberRating>", s)
        link = between(body, "<link>", "</link>", s)
        slug = ""
        i = link.find("/film/")
        if i >= 0:
            slug = link[i + 6:].strip("/")
        if title != "":
            out.append([slug, title.upper(), year, rating10(rating)])
        pos = s + 6
    return out

def profile_favorites(user):
    """The films pinned as favorites on a public Letterboxd profile
    (letterboxd.com/<user>/), in profile order -- the section#favourites poster
    grid, each poster carrying data-item-slug. Up to four. Empty on any
    failure, so the caller falls back to the pack."""
    if user == "":
        return []
    resp = http.get("https://letterboxd.com/" + user + "/", ttl_seconds = 900)
    if resp["status_code"] != 200:
        return []
    body = resp["body"]
    s = body.find("id=\"favourites\"")
    if s < 0:
        return []
    end = body.find("</section>", s)
    region = body[s:end] if end >= 0 else body[s:]
    marker = "data-item-slug=\""
    slugs = []
    i = region.find(marker)
    for _n in range(20):
        if i < 0:
            break
        j = i + len(marker)
        k = region.find("\"", j)
        if k < 0:
            break
        sl = region[j:k].strip("/").split("/")[-1]
        if sl != "" and sl not in slugs:
            slugs.append(sl)
        i = region.find(marker, k)
    return slugs

def latest(ctx):
    """The most-recent diary watch as [film, live, state]. Falls back to a canon
    pick (live=False, dim rail) when there is no user or the feed is down, so the
    board never goes dark; BADUSER is the one failure a viewer can fix, so it
    gets its own message screen."""
    user = str(ctx.inputs.get("lbuser", "")).strip()
    fb = film_slug(CANON_ORDER[ctx.now.yday % len(CANON_ORDER)], -1)
    if user == "":
        return [fb, False, ""]

    resp = http.get("https://letterboxd.com/" + user + "/rss/", ttl_seconds = 900)
    if resp["status_code"] == 404:
        return [fb, False, "BADUSER"]
    if resp["status_code"] != 200:
        return [fb, False, ""]

    body = resp["body"]
    start = body.find("<item>")
    if start < 0:
        return [fb, False, ""]

    title = between(body, "<letterboxd:filmTitle>", "</letterboxd:filmTitle>", start)
    year = between(body, "<letterboxd:filmYear>", "</letterboxd:filmYear>", start)
    rating = between(body, "<letterboxd:memberRating>", "</letterboxd:memberRating>", start)
    link = between(body, "<link>", "</link>", start)
    if title == "":
        return [fb, False, ""]

    slug = ""
    i = link.find("/film/")
    if i >= 0:
        slug = link[i + 6:].strip("/")
    return [film_live(slug, title, year, rating10(rating)), True, ""]

def _live_films(slugs):
    """A slug list -> film rows, matching the pack for poster + runtime/director
    where possible (a favorite or listed film is often a canon film too)."""
    out = []
    for s in slugs:
        parts = slug_parts(s)
        out.append(film_live(s, parts[0], parts[1], 0))
    return out

def showcase_set(ctx):
    """The mode's scrolling set as [films, label, live]. FAVORITES = the four
    films pinned on the owner's Letterboxd profile; LIST = a public list, in rank
    order, shown under its own name; RECENT = the diary, newest first. Any
    empty/offline path falls back to the pack so the strip is never blank."""
    user = str(ctx.inputs.get("lbuser", "")).strip()
    mode = str(ctx.inputs.get("mode", "recent watches"))

    if mode == "custom list" and user != "":
        list_slug = str(ctx.inputs.get("lblist", "")).strip().strip("/")
        slugs = list_slugs(user, list_slug) if list_slug != "" else []
        label = list_slug.replace("-", " ").upper() if list_slug != "" else "THE LIST"
        films = _live_films(slugs)
        if len(films) > 0:
            return [films, label, True]
    elif mode == "recent watches" and user != "":
        films = []
        for row in diary_films(user, 24):
            films.append(film_live(row[0], row[1], row[2], row[3]))
        if len(films) > 0:
            return [films, "RECENTLY WATCHED", True]
    elif mode == "favorites" and user != "":
        films = _live_films(profile_favorites(user))
        if len(films) > 0:
            return [films, "FAVORITES", True]

    # fallback when a live source is empty/offline: the pack's first four
    films = []
    for i in range(4):
        films.append(film_slug(CANON_ORDER[i], -1))
    return [films, "FAVORITES", False]

# -------------------------------------------------------------------- pages
def marquee(c, ctx):
    """Splash: the house marquee sign, so the panel context-switches into the
    app. A lit bulb frame, a popcorn tub in each wing, and a red banner whose
    name the owner sets."""
    name = str(ctx.inputs.get("cinema", "THE BASEMENT CINEMA")).strip().upper()
    if name == "":
        name = "THE BASEMENT CINEMA"

    c.fill("black")

    # the lit frame: bulb rows top and bottom, a popcorn tub in each wing,
    # framing the banner like a marquee
    bulbs(c, 0, 4, 380)
    bulbs(c, 31, 4, 380)
    c.sprite(POPCORN, 2, 1, legend = LEG)
    c.sprite(POPCORN, 362, 1, legend = LEG)

    # the marquee sign itself: a red banner with a gold rule
    bx0, bx1 = 26, 358
    c.rect(bx0, 2, bx1, 29, fill = RED)
    c.rect(bx0, 2, bx1, 29, outline = GOLD)

    # the name scales to fit and sits centered in the banner; a long name drops
    # to a smaller cut so it still reads, and only then gets clipped.
    cx = (bx0 + bx1) // 2
    cy = 15
    fnt, t = fit(c, name, ["16x20", "10x16", "7x12"], bx1 - bx0 - 16)
    h = FONTH[fnt]
    c.text(t, cx, cy - h // 2, font = fnt, color = CREAM, align = "center")

def message(c, head, sub):
    """The one card every unrecoverable state shares: what, and what to do."""
    c.fill("black")
    bulbs(c, 0, 6, 378)
    bulbs(c, 31, 6, 378)
    c.text(head, c.width // 2, 8, font = "10x16", color = GOLD, align = "center")
    c.text(sub, c.width // 2, 25, font = "4x5", color = DIM, align = "center")

def _meta(year, runtime, director):
    """The one-line credits strip. Only the fields we actually have show, so a
    keyless diary watch (year only) and a TMDB-enriched canon film (year +
    runtime + director) read as the same layout, just fuller."""
    parts = []
    if year != "":
        parts.append(year)
    if runtime != "":
        parts.append(runtime + " MIN")
    if director != "":
        parts.append("DIR " + director)
    return "   ".join(parts)

def card(c, film, label, caption, live):
    """The single film card. Poster module at the left, the title as the hero,
    and beneath it the certificate box with the credits set against it. The
    right block carries runtime over the owner's star rating.

    The certificate sits under the title rather than beside it: inline, it
    pushes the hero off its left margin and costs the title the width it needs
    to stay at 16x20."""
    title, year, runtime, director = film[0], film[1], film[2], film[3]
    art, pfile, r10 = film[4], film[5], film[6]
    cert = film[7] if len(film) > 7 else ""

    c.fill("black")
    poster(c, pfile, title, 10, 1)
    # the rail carries live/offline state, so the bands never spend a row on it
    c.rect(37, 0, 38, 31, fill = GOLD if live else DIM)

    # lit bulb runs top and bottom of the stage: the card reads like a marquee
    bulbs(c, 0, 44, 378)
    bulbs(c, 31, 44, 378)

    rx = 300
    c.vline(rx - 6, 3, 28, STRUCT)

    # left: title hero, then the certificate and credits on the line below
    tw = rx - 6 - 44
    fnt, t = fit(c, title, ["16x20", "10x16", "7x12"], tw)
    c.text(t, 44, 1, font = fnt, color = INK)
    bx = 44
    if cert != "":
        bx += cert_box(c, 44, 22, cert) + 8
    fields = []
    if director != "":
        fields.append("DIR " + director)
    if year != "":
        fields.append(year)
    pipe_meta(c, bx, 24, fields, rx - 6 - bx)

    # right: runtime over the rating, both labelled so neither is a bare number
    if runtime != "":
        c.text("RUNTIME", rx, 2, font = "4x5", color = DIM)
        c.text(runtime + " MIN", rx, 8, font = "6x8", color = CREAM)
    else:
        c.text(clip(c, label, "4x5", 76), rx, 2, font = "4x5",
               color = GOLD if live else DIM)
    c.text("MY RATING", rx, 19, font = "4x5", color = DIM)
    if r10 > 0:
        stars(c, rx, 25, r10)
    else:
        c.text("NOT RATED", rx, 25, font = "4x5", color = STRUCT)

def now_showing(c, ctx):
    """The headliner: the most recently logged film, always. This is the "what's
    on right now" of the board."""
    film, live, state = latest(ctx)
    if state == "BADUSER":
        message(c, "NO LETTERBOXD USER", "CHECK THE USERNAME IN SETTINGS")
        return
    card(c, film, "NOW SHOWING", "", live)

def cert_box(c, x, y, cert):
    """The classification box, drawn the way a poster carries it: a ruled
    rectangle around the certificate. Returns its width so the credits that
    follow can be placed against it."""
    w = c.text_width(cert, "4x5") + 5
    c.rect(x, y, x + w, y + 8, outline = CREAM)
    c.text(cert, x + 3, y + 2, font = "4x5", color = CREAM)
    return w

def pipe_meta(c, x, y, fields, tw):
    """A `2014 | 169M | R` credits row: fields in cream, gold rules between,
    laid out left to right and stopped before it overruns the tile.

    The rule is DRAWN, not typed. None of the bundled bitmap fonts carry a `|`
    glyph -- the set stops at ! # $ % & ( ) * + , - . / : ? @ -- and a missing
    glyph draws nothing at all rather than erroring, so a typed pipe silently
    collapsed the row back to bare spaces."""
    cx = x
    first = True
    for f in fields:
        if f == "":
            continue
        seg = c.text_width(f, "4x5")
        if not first:
            if cx + 7 + seg > x + tw:
                break
            c.vline(cx + 1, y - 1, 7, GOLD)
            cx += 5
        elif cx + seg > x + tw:
            break
        c.text(f, cx, y, font = "4x5", color = CREAM)
        cx += seg + 3
        first = False

def tile(c, film, px, tw):
    """A rich film tile for the scroll strip: a gold-framed poster, the title
    over up to two rows, a year | runtime | director rule, and the owner's star
    rating -- the same content as the big card, packed into a third of the
    panel."""
    title, year, runtime, director = film[0], film[1], film[2], film[3]
    art, pfile, r10 = film[4], film[5], film[6]
    cert = film[7] if len(film) > 7 else ""

    poster(c, pfile, title, px, 1, frame = GOLD)
    tx = px + 26
    # a title over two rows beats a mid-word clip; step the font down when even
    # two 5x7 rows will not hold it (text_wrapped drops the overflow silently).
    tf = "5x7" if c.text_width(title, "5x7") <= tw * 2 else "4x5"
    c.text_wrapped(title, tx, 1, tw, font = tf, color = INK, line_gap = 1,
                   max_lines = 2)
    fields = [year]
    if runtime != "":
        fields.append(runtime + "M")
    if cert != "":
        fields.append(cert)
    pipe_meta(c, tx, 18, fields, tw)
    # the rating owns the bottom-left; the director rides beside it in the
    # smallest face, being the field a viewer needs least from across a room
    if r10 > 0:
        stars(c, tx, 25, r10)
    if director != "":
        c.text(clip(c, director, "3x4", tw - 34), tx + 34, 26, font = "3x4",
               color = DIM)

def showcase(c, ctx):
    """The compressed scroll: three rich film tiles from the chosen source --
    FAVORITES, a LIST, or the RECENT diary -- fenced by gold rules in the style
    of the house marquee. The window advances one film per minute, so the whole
    set scrolls past however long it is.

    The index comes off a monotonic minute count rather than ctx.now.minute,
    which wraps at 60 -- unless the set size divides 60 the window jumps
    backwards on the hour. It only advances at all because refresh is 60; at
    900 the panel re-rendered every fifteen minutes and the window leapt
    fifteen films at a time, which is why the strip looked static."""
    films, _label, live = showcase_set(ctx)
    c.fill("black")
    bulbs(c, 0, 4, 380)
    bulbs(c, 31, 4, 380)

    n = len(films)
    if n == 0:
        return
    win = 3 if n >= 3 else n
    start = (ctx.now.unix // 60) % n

    # three tiles, wrapping the window so every film comes around no matter how
    # long the list; gold rules fence them
    frame = GOLD if live else DIM
    pxs = [6, 124, 242]
    tws = [84, 84, 88]
    for k in range(win):
        idx = (start + k) % n
        tile(c, films[idx], pxs[k], tws[k])
        if k > 0:
            c.vline(pxs[k] - 8, 3, 28, frame)
