# Drawn poster art, keyed by slug. Hand-maintained (the tool never touches this
# map). A film with bespoke pixel art gets it as its offline/absent-poster
# fallback; everything else falls back to the filmstrip reel. Kept OUT of the
# generated block below so refreshing the pack never clobbers original art.
ART_BY_SLUG = {
    "interstellar":       ART_INTERSTELLAR,
    "ratatouille":        ART_RATATOUILLE,
    "sideways":           ART_SIDEWAYS,
    "do-the-right-thing": ART_DO_THE_RIGHT_THING,
}

def art_for(slug):
    return ART_BY_SLUG.get(slug, ART_REEL)

# The canon: slug -> [title, year, runtime, director, poster, rating10].
#
# Keyed by Letterboxd slug (the last segment of a film's
# letterboxd.com/<user>/film/<slug>/ URL). `rating10` is the owner's Letterboxd
# star rating on a 0-10 half-star scale (0 = unrated). `poster` is a bundled
# 21x32 PNG -
# the pattern the official now-playing app uses, since GDN draws bundled files
# and never fetches an image at render time. The drawn fallback is resolved
# separately via art_for(slug), so a missing poster still renders.
#
# CANON / CANON_ORDER / BY_TITLE / POSTERS between the PACK markers are
# maintained by tools/refresh_pack.py -- edit by hand freely, but know the tool
# rewrites everything between the markers when it runs.
# >>> PACK:BEGIN (generated by tools/refresh_pack.py -- safe to hand-edit)
