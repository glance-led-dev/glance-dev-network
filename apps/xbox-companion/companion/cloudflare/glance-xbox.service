[Unit]
Description=Glance xbox
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5
[Service]
Type=simple
User=glance-xbox
Group=glance-xbox
WorkingDirectory=/var/lib/glance-xbox
ExecStart=/opt/glance/xbox/venv/bin/python /opt/glance/xbox/collector.py
LoadCredentialEncrypted=secrets:/etc/glance/xbox.cred
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/glance-xbox
RestrictSUIDSGID=true
Restart=on-failure
RestartSec=30
[Install]
WantedBy=multi-user.target
