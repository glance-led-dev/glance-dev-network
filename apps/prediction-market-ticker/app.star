def team_icon(row, league_hint):
    # A new feed explicitly uses null for non-football / unidentified markets.
    if "team" in row and row.get("team") == None:
        return None
    team = row.get("team") or {}
    league = str(team.get("league") or row.get("league") or "").upper()
    if league in ["NCAAF", "NCAA"]:
        league = "CFB"
    if not league and league_hint in ["NFL", "CFB"]:
        league = league_hint
    code = str(team.get("code") or row.get("team_code") or "").upper()
    if not code:
        words = str(row.get("label") or "").upper().split()
        if words and words[0] == "NOT":
            words = words[1:]
        if words:
            code = words[0]
    # An explicit unsupported league must not fall back to a football logo.
    if not league:
        return TEAM_ICONS.get(LEGACY_TEAMS.get(code, ""))
    key = league + ":" + code
    return TEAM_ICONS.get(TEAM_ALIASES.get(key, key))

def fit_label(c, label, x, color):
    available = c.width - x
    for font in ["6x8", "5x7", "4x7", "3x7"]:
        if c.text_width(label, font=font) <= available:
            c.text(label, x, 0, font=font, color=color)
            return
    # Preserve the end of a long custom label (often the strike) when eliding.
    for n in range(len(label), 0, -1):
        clipped = label[:n // 2] + ".." + label[-max(1, n // 2):]
        if c.text_width(clipped, font="3x7") <= available:
            c.text(clipped, x, 0, font="3x7", color=color)
            return

DIM = "#6E6E6E"

def color_for(delta):
    if delta == None or delta == 0:
        return "white"
    if delta > 0:
        return "green"
    return "red"

def message(c, top, bottom, color):
    c.text(top, c.width // 2, 5, font="6x8", color=color, align="center")
    c.text(bottom, c.width // 2, 17, font="6x8", color=color, align="center")

def choose_rows(rows, inputs):
    selected = [s.strip().upper() for s in str(inputs.get("positions", "")).split(",") if s.strip()]
    group = inputs.get("show", "All positions")
    result = []
    for row in sorted(rows, key=lambda r: str(r.get("ticker", ""))):
        if selected and str(row.get("ticker", "")).upper() not in selected:
            continue
        matchup = row.get("matchup") or []
        league = (matchup[0] if matchup else row.get("team") or {}).get("league")
        if group in ["NFL", "CFB"] and league != group:
            continue
        if group == "Live games" and (row.get("game") or {}).get("state") != "in":
            continue
        result.append(row)
    return result

def compact_view(c, row, index, count, now, fetched_at, show_scores):
    delta = row.get("delta")
    color = color_for(delta)
    value = row.get("pct")
    pct = max(0, min(100, int(value))) if value != None else None
    label = str(row.get("label") or "MARKET").upper()
    if row.get("market_kind") == "total" and row.get("line") != None:
        label = ("O " if row.get("side") == "YES" else "U ") + str(row["line"])
    counter = str(index + 1) + "/" + str(count)
    available = 63 - c.text_width(counter, font="3x4") - 2
    font = "5x7" if c.text_width(label, font="5x7") <= available else "4x5"
    if c.text_width(label, font=font) > available:
        label = label[:max(1, available // 4 - 2)] + ".."
    c.text(label, 0, 0, font=font, color="white")
    c.text(counter, 64, 1, font="3x4", color=DIM, align="right")
    c.text(str(pct) + "%" if pct != None else "--%", 0, 8, font="7x12", color=color)
    matchup = row.get("matchup") or []
    game = row.get("game") or {}
    if len(matchup) == 2:
        for i in range(2):
            x = 33 if i == 0 else 52
            icon = team_icon({"team":matchup[i]}, "Auto")
            if icon:
                c.image(icon["asset"], x, 7, w=12, h=12)
            else:
                code = str(matchup[i].get("code") or "?")
                c.text(code[:3], x + 6, 11, font="3x4", color=DIM, align="center")
            scores = game.get("scores") or []
            if show_scores and len(scores) == 2 and scores[i] != None:
                c.text(str(int(scores[i])), x + 6, 20, font="3x4", color="white", align="center")
        c.text("VS", 45, 11, font="3x4", color=DIM)
    else:
        icon = team_icon(row, "Auto")
        if icon:
            c.image(icon["asset"], 44, 8, w=16, h=16)
    stale = game.get("stale") or (game.get("fetched_at") != None and now - game["fetched_at"] > 120)
    feed_stale = fetched_at != None and now - fetched_at > 120
    status = str(row.get("status_label") or ("SETTLED" if row.get("settled") else "")).upper()
    footer = "STALE FEED" if feed_stale else status or ("STALE SCORE" if stale and show_scores else game.get("phase") if show_scores else None)
    footer = footer or ("SCORE N/A" if matchup and show_scores else str(row.get("side_label") or row.get("side") or ""))
    footer_color = "amber" if feed_stale or stale or status else DIM
    if status == "WON":
        footer_color = "green"
    if status == "LOST":
        footer_color = "red"
    c.text(footer[:16], 0, 26, font="4x5", color=footer_color)
    change = ("+" if delta > 0 else "-") + str(abs(delta)) + "PP" if delta != None and delta != 0 else ""
    if change and c.text_width(footer[:16], font="4x5") + c.text_width(change, font="3x4") + 2 <= 64:
        c.text(change, 64, 27, font="3x4", color=color, align="right")

def main(c, ctx):
    c.fill("black")

    url = ctx.inputs.get("feedurl", "") or ctx.inputs.get("feed_url", "")
    if not url:
        message(c, "SET FEED", "URL", DIM)
        return

    # GDN otherwise caches HTTP for five minutes, longer than our panel cadence.
    res = http.get(url, ttl_seconds=0)

    if res["status_code"] != 200:
        message(c, "FEED", "ERROR", "red")
        return

    data = res["json"]
    if type(data) != "dict" or data.get("ok") == False:
        message(c, "FEED", "ERROR", "red")
        return
    rows = data.get("rows", [])

    if not rows:
        message(c, "NO OPEN", "MARKETS", DIM)
        return

    if data.get("version", 1) >= 2:
        rows = choose_rows(rows, ctx.inputs)
        if not rows:
            message(c, "NO MATCH", "FILTERS", DIM)
            return
        hold = str(ctx.inputs.get("hold", "1"))
        minutes = int(hold) if hold in ["1", "2", "3", "5"] else 1
        pick = str(ctx.inputs.get("pin", "1"))
        valid_pick = pick and len(pick) < 7 and all([pick[i] in "0123456789" for i in range(len(pick))])
        fixed = ctx.inputs.get("mode", "Rotate") == "Pin one"
        if fixed and (not valid_pick or int(pick) < 1 or int(pick) > len(rows)):
            message(c, "BAD PICK", "CHECK PIN", "amber")
            return
        index = int(pick) - 1 if fixed else (ctx.now.unix // (60 * minutes)) % len(rows)
        compact_view(c, rows[index], index, len(rows), ctx.now.unix, data.get("fetched_at"), ctx.inputs.get("scores", "Show") == "Show")
        return

    row = rows[0]
    delta = row.get("delta")
    color = color_for(delta)

    raw_pct = row.get("pct")
    pct = max(0, min(100, int(raw_pct))) if raw_pct != None else None
    icon = team_icon(row, ctx.inputs.get("league", "Auto"))
    left = 18 if icon else 0
    spread_view = icon != None and row.get("market_kind") == "spread" and row.get("line") != None
    if spread_view:
        c.image(icon["asset"], 0, 0, w=16, h=16)
        # The logo and short code identify the held team; make the actual line big.
        c.text(icon["code"], 8, 18, font="3x4", color=icon["color"], align="center")
        line = row["line"]
        line_text = ("+" if line >= 0 else "-") + str(abs(line))
        line_font = "6x8" if c.text_width(line_text, font="6x8") <= c.width - left else "5x7"
        c.text(line_text, left, 0, font=line_font, color="white")
    else:
        if icon:
            c.image(icon["asset"], 0, 2, w=16, h=16)
        fit_label(c, str(row.get("label") or "").upper(), left, icon["color"] if icon else DIM)

    c.text(str(pct) + "%" if pct != None else "--%", left, 11 if spread_view else 9, font="7x12", color=color)
    status = str(row.get("status_label") or "").upper()
    side = status or ("SETTLED" if row.get("settled") else str(row.get("side_label") or row.get("side") or "").upper())
    status_color = "green" if status == "WON" else "red" if status == "LOST" else "amber" if status or row.get("settled") else DIM
    change = ""
    if delta != None and delta != 0:
        change = ("+" if delta > 0 else "-") + str(abs(delta)) + "PP"
    side_font = "4x5"
    if change and c.text_width(side, font=side_font) + c.text_width(change, font="4x5") + 2 > c.width:
        side_font = "3x4"
    c.text(side, 0, 24, font=side_font, color=status_color)
    if change:
        c.text(change, c.width, 24, font="4x5", color=color, align="right")
    if pct != None:
        c.progress_bar(0, 30, c.width, 2, pct, color=color)
