# My Teams Board — your teams, one page each, logo against logo.
#
# Eight pages: two NFL, two NBA, two NHL and two college football slots,
# each picked from a dropdown. Slot 1 of every league is always a team; slot
# 2 can be NONE, and then that page turns into slot 1's upcoming schedule
# (next three games) so no page ever repeats.
#
# Each matchup page answers one question: are they playing right now, did
# they just play, or when is the next one? Live score beats a fresh final
# (18h), a fresh final beats a game today or tomorrow, and after that the
# page looks ahead. A team with no next game keeps its last final up with a
# SEASON DONE tag instead of going blank.
#
# DATA. ESPN's public team-schedule endpoint, no key:
#   site.api.espn.com/apis/site/v2/sports/<path>/teams/<id>/schedule
# One fetch per page per render, cached 300s. Kickoff times are converted
# from ESPN's UTC stamps to US Eastern by hand (fixed DST rules; there is no
# tz database here).
#
# ART. assets/<league>/<espn id>.png is a 20px logo, s<id>.png a 10px one,
# for every NFL, NBA, NHL and FBS team, so the opponent gets a logo too. An
# opponent outside that set (an FCS school) gets a framed abbreviation.

GOLD = "#E8B33A"
WHITE = "#FFFFFF"
GRAY = "#8A8AA8"
DIM = "#6A7090"
RED = "#FF5347"
GREEN = "#3EE07A"
BG = "#08090D"

NONE = "None"

MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN",
          "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]
WEEKDAYS = ["SUN", "MON", "TUE", "WED", "THU", "FRI", "SAT"]

