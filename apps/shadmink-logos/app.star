def draw_art(c, rows, width, x0, y0):
    """Paint pixel-data rows at (x0, y0), skipping transparent pixels."""
    for y in range(len(rows)):
        row = rows[y]
        for x in range(width):
            h = row[x * 6:x * 6 + 6]
            if h != "......":
                c.pixel(x0 + x, y0 + y, "#" + h)


def spaced(c, s, x, y, width, font, color):
    """Spread the letters of s evenly across width, like the logo's tracking."""
    n = len(s)
    widths = [c.text_width(s[i], font) for i in range(n)]
    total = 0
    for w in widths:
        total += w
    gap = (width - total) // (n - 1) if n > 1 else 0
    cx = x
    for i in range(n):
        c.text(s[i], cx, y, font = font, color = color)
        cx += widths[i] + gap


def brand(c, x, rows, mark_w, sub, sub_color):
    draw_art(c, rows, mark_w, x, 2)
    tx = x + mark_w + 3
    name_w = c.text_width("SHADMINK", NAME_FONT)
    c.text("SHADMINK", tx, 6, font = NAME_FONT, color = NAME)
    spaced(c, sub, tx + 1, 19, name_w - 1, SUB_FONT, sub_color)


def logos(c, ctx):
    c.fill(BG)
    brand(c, 10, CRAFTS_ROWS, CRAFTS_W, "CRAFTS", "#FF5A8A")
    brand(c, 96, TRAVEL_ROWS, TRAVEL_W, "TRAVEL", "#2FD0B8")
    c.line(93, 6, 93, 25, DIVIDER)
