# ---------------------------------------------------------------- basics ----

GOLD = "#FFC43D"
GRAY = "#8A8F98"
FEAT = "#A9B0BA"
RED = "#FF5A5A"
GREEN = "#4ADE80"

# Era colors by season: (first season, bright, dark).
ERAS = [
    (1, "#FF6A3D", "#4A1608"),
    (6, "#B8B8C8", "#34343E"),
    (7, "#3FA7FF", "#0B2A4A"),
    (11, "#C77DFF", "#35104E"),
    (21, "#FFC43D", "#4A3200"),
    (31, "#35D07F", "#08361E"),
    (41, "#FF4FA3", "#4A0A2A"),
    (51, "#4DE1FF", "#073A48"),
]

def era_colors(season):
    best = ERAS[0]
    for e in ERAS:
        if season >= e[0]:
            best = e
    return best[1], best[2]

# Integer hash of the current minute, so every page agrees on the pick
# within a minute but the picks don't cycle visibly.
def scramble(x):
    x = x & 0xFFFFFFFF
    x = ((x ^ 61) ^ (x >> 16)) & 0xFFFFFFFF
    x = (x + (x << 3)) & 0xFFFFFFFF
    x = (x ^ (x >> 4)) & 0xFFFFFFFF
    x = (x * 0x27d4eb2d) & 0xFFFFFFFF
    x = (x ^ (x >> 15)) & 0xFFFFFFFF
    return x

def rotation_index(ctx, n, salt = 0):
    bucket = ctx.now.unix // 60 + salt * 7919
    return (scramble(bucket) * n) // 4294967296

def days_from_civil(y, m, d):
    yy = y - 1 if m <= 2 else y
    era = (yy if yy >= 0 else yy - 399) // 400
    yoe = yy - era * 400
    doy = (153 * (m + (-3 if m > 2 else 9)) + 2) // 5 + d - 1
    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    return era * 146097 + doe - 719468

def civil_from_days(z):
    z += 719468
    era = (z if z >= 0 else z - 146096) // 146097
    doe = z - era * 146097
    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    y = yoe + era * 400
    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    mp = (5 * doy + 2) // 153
    d = doy - (153 * mp + 2) // 5 + 1
    m = mp + (3 if mp < 10 else -9)
    return (y + 1 if m <= 2 else y), m, d

# Day-of-month of the first Sunday on or after day d.
def sunday_on_or_after(y, m, d):
    z = days_from_civil(y, m, d)
    return d + (3 - z) % 7

# Today's date in US Eastern time. ctx.now is UTC, so without this the
# day would roll over at 8 PM EDT / 7 PM EST. DST: 2 AM local on the 2nd
# Sunday of March to 2 AM local on the 1st Sunday of November.
def today(ctx):
    y = ctx.now.year
    start = days_from_civil(y, 3, sunday_on_or_after(y, 3, 8)) * 86400 + 7 * 3600
    end = days_from_civil(y, 11, sunday_on_or_after(y, 11, 1)) * 86400 + 6 * 3600
    offset = 4 if start <= ctx.now.unix and ctx.now.unix < end else 5
    return civil_from_days((ctx.now.unix - offset * 3600) // 86400)

def ordinal(n):
    if n % 100 >= 11 and n % 100 <= 13:
        return str(n) + "TH"
    last = n % 10
    if last == 1:
        return str(n) + "ST"
    if last == 2:
        return str(n) + "ND"
    if last == 3:
        return str(n) + "RD"
    return str(n) + "TH"

# ----------------------------------------------------------------- text ----

# Punctuation each font can draw (letters/digits are in all of these).
# An apostrophe is always OK: fonts without one get a hand-drawn tick.
FONT_PUNCT = {
    "4x5": " !#$%&'()+,-./:|",
    "4x7": " !#$%&'()+,-./:|",
    "5x7": " !$%&'()*+,-./:^|",
    "6x8": " #$%()+,-./:@_",
    "3x7": " !$%&+-./:=>",
    "picopixel": " !#$%&+-./:=>",
    "8x12": " !#$%&()+,./:?@",  # the SDK's 8x12 "-" is a solid block
    "10x14": " :",
    "5x5": " $%+-.:",
}
ALNUM = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"

def font_ok(text, font):
    punct = FONT_PUNCT.get(font, " ")
    for i in range(len(text)):
        ch = text[i]
        if ch == "'" or ch == "?" or ALNUM.find(ch) >= 0:
            continue
        if punct.find(ch) < 0:
            return False
    return True

def has_apos(font):
    return FONT_PUNCT.get(font, "").find("'") >= 0

def has_q(font):
    return FONT_PUNCT.get(font, "").find("?") >= 0

# Question marks for fonts that lack one: 3 wide for the 5-row faces, 4 wide
# for the taller ones.
QMARK_5 = ["###", "..#", ".#.", "...", ".#."]
QMARK_7 = [".##.", "#..#", "...#", "..#.", ".#..", "....", ".#.."]

def qmark(font):
    return QMARK_7 if FONT_H.get(font, 5) >= 7 else QMARK_5

# Text split into runs of plain text and the characters drawn by hand.
def text_runs(text, font):
    special = ""
    if not has_apos(font):
        special += "'"
    if not has_q(font):
        special += "?"
    runs = []
    cur = ""
    for i in range(len(text)):
        ch = text[i]
        if special.find(ch) >= 0:
            if cur != "":
                runs.append(cur)
            runs.append(ch)
            cur = ""
        else:
            cur += ch
    if cur != "":
        runs.append(cur)
    return runs, special

def run_width(c, run, font, special):
    if run == "'" and special.find("'") >= 0:
        return 3
    if run == "?" and special.find("?") >= 0:
        return len(qmark(font)[0]) + 1
    return c.text_width(run, font = font)

def tw(c, text, font):
    if text == "":
        return 0
    runs, special = text_runs(text, font)
    if len(runs) == 1 and special.find(runs[0]) < 0:
        return c.text_width(text, font = font)
    total = 0
    for r in runs:
        total += run_width(c, r, font, special)
    return total

# Text with any alignment; hand-draws apostrophes and question marks when the
# font lacks them.
def txt(c, text, x, y, font, color, align = "left"):
    if text == "":
        return
    runs, special = text_runs(text, font)
    if len(runs) == 1 and special.find(runs[0]) < 0:
        c.text(text, x, y, font = font, color = color, align = align)
        return
    w = tw(c, text, font)
    if align == "center":
        x = x - w // 2
    elif align == "right":
        x = x - w
    for r in runs:
        if r == "'" and special.find("'") >= 0:
            c.rect(x + 1, y, x + 1, y + 1, fill = color)
        elif r == "?" and special.find("?") >= 0:
            rows = qmark(font)
            for ry in range(len(rows)):
                for rx in range(len(rows[ry])):
                    if rows[ry][rx:rx + 1] == "#":
                        c.pixel(x + rx, y + ry, color)
        else:
            c.text(r, x, y, font = font, color = color, align = "left")
        x += run_width(c, r, font, special)

def outlined(c, text, x, y, font, color, align = "left", shadow = "#000000"):
    for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
        txt(c, text, x + dx, y + dy, font, shadow, align)
    txt(c, text, x, y, font, color, align)

# The wider 5x5 (same 5px letters as 4x5, regular weight) goes ahead of 4x5.
def wider(fonts):
    out = []
    for f in fonts:
        if f == "4x5" and "5x5" not in out:
            out.append("5x5")
        out.append(f)
    return out

# Biggest usable font in the ladder that fits maxw (wider faces first).
def fit(c, text, fonts, maxw):
    return fit_exact(c, text, wider(fonts), maxw)

# One font for a whole list: the wide 5x5 when every row fits it.
def list_ladder(c, texts, maxw):
    for t in texts:
        if not font_ok(t, "5x5") or tw(c, t, "5x5") > maxw:
            return ["4x5", "picopixel"]
    return ["5x5", "4x5", "picopixel"]

# Biggest usable font in exactly this ladder that fits maxw; else the last
# usable font, truncated with "..".
def fit_exact(c, text, fonts, maxw):
    usable = [f for f in fonts if font_ok(text, f)]
    if len(usable) == 0:
        usable = ["4x5"]
    for f in usable:
        if tw(c, text, f) <= maxw:
            return text, f
    f = usable[len(usable) - 1]
    for i in range(len(text), 0, -1):
        t = text[:i].strip() + ".."
        if tw(c, t, f) <= maxw:
            return t, f
    return "", f

FONT_H = {"4x5": 5, "4x7": 7, "5x7": 7, "6x8": 8, "3x7": 7, "picopixel": 5, "8x12": 12, "10x14": 14, "5x5": 5}

# Greedy word wrap; returns lines.
def wrap(c, text, font, w):
    words = text.split(" ")
    lines = []
    cur = ""
    for word in words:
        cand = word if cur == "" else cur + " " + word
        if cur == "" or tw(c, cand, font) <= w:
            cur = cand
        else:
            lines.append(cur)
            cur = word
    if cur != "":
        lines.append(cur)
    return lines

# Wrap into at most max_lines, trying the ladder biggest-first.
def wrap_fit(c, text, fonts, w, max_lines):
    fonts = wider(fonts)
    for f in fonts:
        if not font_ok(text, f):
            continue
        ls = wrap(c, text, f, w)
        ok = len(ls) <= max_lines
        for l in ls:
            if tw(c, l, f) > w:
                ok = False
        if ok:
            return ls, f
    f = fonts[len(fonts) - 1]
    ls = wrap(c, text, f, w)
    if len(ls) > max_lines:
        ls = ls[:max_lines]
        last, _ = fit_exact(c, ls[max_lines - 1] + " ...", [f], w)
        ls[max_lines - 1] = last
    return ls, f

# ------------------------------------------------------------- lookups ----

def todays_episodes(m, d):
    out = []
    for e in EPISODES:
        if e[1] == m and e[2] == d:
            out.append(e)
    return out

def pick_episode(ctx):
    evs = todays_items(today(ctx)[1], today(ctx)[2])
    if len(evs) == 0:
        return None
    return evs[rotation_index(ctx, len(evs))]

# Credited names that are the same person as a later billing.
HOST_ALIAS = {"THE ROCK": "DWAYNE JOHNSON"}

# Years in air order with repeats folded: "1976 1977 (2) 1978 (2)".
def year_list(years):
    out = []
    for i in range(len(years)):
        if i > 0 and years[i] == years[i - 1]:
            continue
        n = 0
        for j in range(i, len(years)):
            if years[j] != years[i]:
                break
            n += 1
        out.append(str(years[i]) + (" (" + str(n) + ")" if n > 1 else ""))
    return " ".join(out)

# Episodes that aired without a host.
HOSTLESS = ["(NONE)", "NONE CREDITED"]

def host_name(e):
    return "NO HOST" if e[6] in HOSTLESS else e[6]

HOST_SHORT = {"MARY-KATE AND ASHLEY OLSEN": "THE OLSEN TWINS"}

# Shorter host credit for tight spots: "A. HUSTON", "WENDT & COPPOLA",
# "CRYSTAL + 4 MORE".
def short_host(e):
    h = host_name(e)
    if HOST_SHORT.get(h) != None:
        return HOST_SHORT[h]
    hs = split_hosts(e[6])
    if len(hs) == 1:
        return initial_form(hs[0])
    if len(hs) == 2:
        return " & ".join([last_name(x) for x in hs])
    if len(hs) > 2:
        return last_name(hs[0]) + " + " + str(len(hs) - 1) + " MORE"
    return h

# The full host credit if it fits, else the short one.
def fit_host(c, e, fonts, maxw):
    t, f = fit_exact(c, host_name(e), fonts, maxw)
    if t.endswith(".."):
        t, f = fit_exact(c, short_host(e), fonts, maxw)
    return t, f

def host_line(e):
    return "NO HOST THAT NIGHT" if e[6] in HOSTLESS else "HOST: " + e[6]

def split_hosts(h):
    if h in HOSTLESS:
        return []
    h = h.replace(" AND ", " & ").replace(", ", " & ")
    out = []
    for p in h.split(" & "):
        p = p.strip()
        if p != "":
            out.append(HOST_ALIAS.get(p, p))
    return out

def impressions_of(name):
    return [t for t in TOP_IMPRESSIONS if t[2] == name]

def cast_rank(name):
    for i in range(len(TOP_CAST)):
        if TOP_CAST[i] == name:
            return i + 1
    return 0

def host_rank(name):
    for i in range(len(TOP_HOSTS)):
        if TOP_HOSTS[i] == name:
            return i + 1
    return 0

# Every episode (year list) a person hosted, in air order.
def hosted_years(name):
    ys = []
    for e in EPISODES:
        if name in split_hosts(e[6]):
            ys.append(e)
    return ys

def top_sketches_for(e):
    out = []
    for t in TOP_SKETCHES:
        if t[0] == e[0] and t[1] == e[1] and t[2] == e[2]:
            out.append(t)
    return sorted(out, key = lambda t: t[3])

def episode_rank(e):
    for t in TOP_EPISODES:
        if t[0] == e[0] and t[1] == e[1] and t[2] == e[2]:
            return t[3]
    return 0

def cast_list(season):
    out = []
    for item in SEASON_CAST.get(season, []):
        name, flags = item.split("|")
        out.append((name, flags))
    return out

def last_name(n):
    parts = n.split(" ")
    ln = parts[len(parts) - 1]
    if (ln == "JR." or ln == "JR") and len(parts) > 1:
        ln = parts[len(parts) - 2]
    return ln

# --------------------------------------------------------------- chrome ----

# Episode-page header: era-colored band, season/episode left, numeric
# date right, and a short page label in the middle.
def header(c, e, label = "", alt = ""):
    bright, dark = era_colors(e[3])
    c.fill("#000000")
    draw_season_bg(c, e[3])
    c.rect(0, 0, 191, 6, fill = dark)
    c.line(0, 7, 191, 7, bright)
    left = "S" + str(e[3]) + " E" + str(e[4])
    right = str(e[1]) + "/" + str(e[2]) + "/" + str(e[0])
    txt(c, left, 2, 1, "4x5", "#FFFFFF")
    txt(c, right, 190, 1, "4x5", "#FFFFFF", "right")
    if label != "":
        lw = tw(c, left, "4x5")
        rw = tw(c, right, "4x5")
        room = 188 - lw - rw - 8
        for lab in [label, alt]:
            if lab != "" and tw(c, lab, "4x5") <= room:
                cx = 2 + lw + 4 + room // 2
                txt(c, lab, cx, 1, "4x5", bright, "center")
                break

# Header for empty-day profile cards.
def profile_header(c, label, color, name = ""):
    c.fill("#000000")
    if name != "":
        draw_cast_bg(c, name)
    txt(c, label, 96, 1, "4x5", color, "center")

# --------------------------------------------------------------- skyline ----

# NYC skyline silhouette: (x0, x1, top y) blocks, drawn to the bottom edge.
SKYLINE = [
    (1, 6, 24), (7, 10, 21), (11, 16, 25), (17, 20, 19), (21, 25, 23), (26, 28, 17),
    (29, 33, 22), (34, 38, 26), (39, 42, 20), (43, 47, 24), (48, 50, 18), (51, 55, 23),
    (56, 60, 25), (61, 63, 16), (96, 66, 13), (67, 69, 16), (70, 74, 22), (75, 118, 19),
    (79, 83, 24), (84, 86, 18), (131, 91, 21), (92, 96, 25), (97, 99, 17), (100, 104, 22),
    (105, 108, 20), (109, 113, 24), (114, 117, 21), (118, 121, 25), (186, 190, 23),
]


# --------------------------------------------------------- episode cards ----

STAR = ["..#..", ".###.", "#####", ".###.", "#.#.#"]

def draw_star(c, x, y, color):
    for r in range(5):
        row = STAR[r]
        for k in range(5):
            if row[k:k + 1] == "#":
                c.pixel(x + k, y + r, color)

def card_episode(c, e):
    rank = episode_rank(e)
    header(c, e)
    if rank > 0:
        label = "#" + str(rank)
        w = tw(c, label, "4x5")
        left_w = tw(c, "S" + str(e[3]) + " E" + str(e[4]), "4x5")
        right_w = tw(c, str(e[1]) + "/" + str(e[2]) + "/" + str(e[0]), "4x5")
        cx = 2 + left_w + (188 - left_w - right_w) // 2
        draw_star(c, cx - (w + 7) // 2, 1, GOLD)
        txt(c, label, cx - (w + 7) // 2 + 7, 1, "4x5", GOLD)
    host = host_name(e)
    mg = e[7]
    lines, f = wrap_fit(c, host, ["6x8", "5x7", "4x5"], 188, 1)
    hs = split_hosts(e[6])
    if len(lines) == 1 and lines[0].endswith("..") and len(hs) > 2:
        lines, f = wrap_fit(c, hs[0] + " + " + str(len(hs) - 1) + " MORE", ["6x8", "5x7", "4x5"], 188, 1)
    if len(lines) == 1:
        txt(c, lines[0], 96, 10, f, "#FFFFFF", "center")
    txt(c, "MUSICAL GUEST", 96, 19, "4x5", GRAY, "center")
    if mg == "" or mg == host:
        label = "HOST PULLED DOUBLE DUTY" if mg == host else "NO MUSICAL GUEST"
        txt(c, label, 96, 26, "4x5", GOLD, "center")
    else:
        t, f2 = fit_mg(c, e, ["5x7", "4x5", "picopixel"], 188)
        txt(c, t, 96, 25 if FONT_H[f2] >= 7 else 26, f2, GOLD, "center")

# Was this host in the cast during this season (any stint)?
def active_cast_host(name, season):
    p = CAST.get(name)
    if p == None:
        return False
    for st in p[9].split("|"):
        ab = st.split("-")
        if int(ab[0]) <= season and season <= int(ab[1]):
            return True
    return False

# The earliest episode hosted by an active cast member.
def first_active_cast_host():
    for o in EPISODES:
        for h in split_hosts(o[6]):
            if active_cast_host(h, o[3]):
                return o
    return None

# Season -> how many of its hosts hosted only that once.
def one_time_hosts_by_season():
    counts = {}
    for o in EPISODES:
        for h in split_hosts(o[6]):
            counts[h] = counts.get(h, 0) + 1
    out = {}
    for o in EPISODES:
        for h in split_hosts(o[6]):
            if counts[h] == 1:
                out[o[3]] = out.get(o[3], 0) + 1
    return out

ONE_TIME_HOSTS = one_time_hosts_by_season()

def card_host(c, e):
    header(c, e, "HOST")
    hosts = split_hosts(e[6])
    if len(hosts) == 0:
        # One of the few shows with no host at all.
        years = [str(o[0]) for o in EPISODES if o[6] in HOSTLESS]
        txt(c, "NO HOST", 96, 10, "6x8", "#FFFFFF", "center")
        txt(c, "ONE OF " + str(len(years)) + " HOSTLESS SHOWS", 96, 19, "4x5", GRAY, "center")
        t, f = fit(c, year_list(years), ["4x5", "picopixel"], 188)
        txt(c, t, 96, 26, f, GOLD, "center")
        return
    if len(hosts) > 1:
        for i in range(min(3, len(hosts))):
            h = hosts[i]
            all_eps = hosted_years(h)
            n = 0
            for k in range(len(all_eps)):
                if all_eps[k][5] == e[5]:
                    n = k + 1
            y = 10 + i * 7
            hr = host_rank(h)
            t, f = fit_exact(c, h, ["4x5"], 70 if hr > 0 else 80)
            txt(c, t, 2, y, f, "#FFFFFF")
            if hr > 0:
                txt(c, "#" + str(hr), 2 + tw(c, t, f) + 4, y, "4x5", GOLD)
            txt(c, ordinal(n) + " TIME", 190, y, "4x5", GRAY, "right")
        ranked = [h for h in hosts[:3] if host_rank(h) > 0]
        if len(ranked) > 0 and len(hosts) < 3:
            txt(c, "# = SNN GREATEST HOSTS", 96, 26, "4x5", GOLD, "center")
        return
    h = hosts[0] if len(hosts) == 1 else e[6]
    all_eps = hosted_years(h)
    total = len(all_eps)
    n = 1
    for k in range(total):
        if all_eps[k][5] == e[5]:
            n = k + 1
    main = "HOSTING DEBUT" if n == 1 else ordinal(n) + " TIME HOSTING"
    if total == 1:
        # Debut and only time are the same fact: say it once.
        main = "ONLY TIME HOSTING"
    cast = CAST.get(h)
    if n == 5:
        sub, col = "JOINS THE FIVE-TIMERS CLUB", GOLD
    elif n > 5:
        sub, col = "FIVE-TIMERS CLUB MEMBER", GOLD
    elif cast != None and active_cast_host(h, e[3]):
        # Hosting while still in the cast (Eddie Murphy, 12/11/1982).
        first = first_active_cast_host()
        if first != None and first[5] == e[5]:
            # Too wide for one line: the headline takes the first half.
            main = "FIRST ACTIVE CAST"
            sub = "MEMBER TO HOST"
        else:
            sub = "HOSTING AS AN ACTIVE CAST MEMBER"
        col = GOLD
    elif cast != None:
        end = "NOW" if cast[3] == 0 else str(cast[3])
        sub, col = "FORMER CAST MEMBER " + str(cast[2]) + "-" + end, era_colors(cast[0])[0]
    elif len(impressions_of(h)) > 0:
        im = impressions_of(h)[0]
        sub, col = im[1] + ": SNN #" + str(im[0]) + " IMPRESSION", GOLD
        if tw(c, sub, "4x5") > 188:
            sub = im[1] + ": SNN #" + str(im[0])
    elif total == 1:
        sub, col = "1 OF " + str(ONE_TIME_HOSTS.get(e[3], 1)) + " ONE-TIME HOSTS IN SEASON " + str(e[3]), "#FFFFFF"
    else:
        sub, col = "HOSTED " + str(total) + " TIMES IN ALL", GRAY
        with_years = "HOSTED " + str(total) + " TIMES: " + year_list([a[0] for a in all_eps])
        # Only if it fits whole (the smallest face has no parentheses).
        if host_rank(h) > 0 and fit(c, with_years, ["4x5", "picopixel"], 188)[0] != with_years:
            with_years = "HOSTED " + str(total) + "X: " + year_list([a[0] for a in all_eps])
        if host_rank(h) > 0 and fit(c, with_years, ["4x5", "picopixel"], 188)[0] == with_years:
            sub = with_years
    if cast != None and n >= 5:
        sub = sub + " + ALUM"
    rank = host_rank(h)
    # With nothing else to say, the headline sits centered on its own.
    main_y = 10 if sub != "" else (13 if rank > 0 else 15)
    t, f = fit(c, main, ["6x8", "5x7", "4x5"], 188)
    txt(c, t, 96, main_y, f, "#FFFFFF", "center")
    if sub != "":
        # With the bottom row free (no rank, no year list), the sub line
        # gets the bigger face and sits lower.
        if rank == 0 and total == 1:
            t, f = fit(c, sub, ["5x7", "4x5", "picopixel"], 188)
            txt(c, t, 96, 21 if FONT_H[f] >= 7 else 22, f, col, "center")
        else:
            t, f = fit(c, sub, ["4x5", "picopixel"], 188)
            txt(c, t, 96, 19, f, col, "center")
    if rank > 0:
        line = "SNN GREATEST HOSTS: #" + str(rank)
        draw_star(c, 96 - (tw(c, line, "4x5") + 7) // 2, 26, GOLD)
        txt(c, line, 96 - (tw(c, line, "4x5") + 7) // 2 + 7, 26, "4x5", GOLD)
        return
    if total > 1:
        ys = []
        for k in range(total):
            ys.append(str(all_eps[k][0]))
        line = year_list(ys)
        t2, f2 = fit(c, line, ["4x5", "picopixel"], 188)
        if t2.endswith(".."):
            # Too many: first, this one, latest.
            line = ys[0] + " ... " + str(e[0]) + " ... " + ys[total - 1] if (n != 1 and n != total) else ys[0] + " ... " + ys[total - 1]
            t2, f2 = fit(c, "(" + str(total) + ") " + line, ["4x5", "picopixel"], 188)
        txt(c, t2, 96, 26, f2, GRAY, "center")

def card_season(c, e):
    header(c, e, "SEASON", "S" + str(e[3]))
    slen = SEASON_LEN[e[3]] if e[3] < len(SEASON_LEN) else 0
    if e[5] == 1:
        main = "THE VERY FIRST EPISODE"
    elif e[4] == 1:
        main = "SEASON PREMIERE"
    elif e[4] == slen and e[3] < 52:
        main = "SEASON FINALE"
    else:
        main = "EPISODE " + str(e[4]) + " OF " + str(slen) if slen > 0 else "EPISODE " + str(e[4])
    t, f = fit(c, main, ["6x8", "5x7", "4x5"], 188)
    txt(c, t, 96, 10, f, "#FFFFFF", "center")
    if e[5] == 1:
        sub = "AS NBC'S SATURDAY NIGHT"
        col = GOLD
    elif e[5] % 100 == 0:
        sub = "MILESTONE: THE " + ordinal(e[5]) + " EPISODE"
        col = GOLD
    else:
        sub = ordinal(e[5]) + " OVERALL EPISODE"
        col = GRAY
    t, f = fit(c, sub, ["4x5", "picopixel"], 188)
    txt(c, t, 96, 19, f, col, "center")
    anchors = [last_name(n) for n, fl in cast_list(e[3]) if fl.find("A") >= 0]
    if len(anchors) > 0:
        line = "WEEKEND UPDATE: " + " & ".join(anchors)
        if tw(c, line, "4x5") > 188:
            line = "UPDATE: " + " & ".join(anchors)
        t, f = fit(c, line, ["4x5", "picopixel"], 188)
        txt(c, t, 96, 26, f, era_colors(e[3])[0], "center")

def card_sketch(c, e, t):
    gold_banner(c, "SNN TOP 100 SKETCHES", e[3])
    rank = "#" + str(t[3])
    txt(c, rank, 18, 12, "8x12", "#5A3A00", "center")
    txt(c, rank, 17, 11, "8x12", GOLD, "center")
    lines, f = wrap_fit(c, t[4], ["5x7", "4x5", "picopixel"], 150, 2)
    lh = FONT_H[f] + 1
    y = 9 + (17 - len(lines) * lh) // 2
    for k in range(len(lines)):
        txt(c, lines[k], 113, y + k * lh, f, "#FFFFFF", "center")
    snn_credit(c, 113, 150)

# Credit line for the Saturday Night Network fan-vote lists.
def snn_credit(c, cx, maxw):
    for line in ["SATURDAY NIGHT NETWORK FAN VOTE", "SATURDAY NIGHT NETWORK", "SNN FAN VOTE"]:
        for f in ["4x5", "picopixel"]:
            if tw(c, line, f) <= maxw:
                txt(c, line, cx, 27, f, GRAY, "center")
                return

# Dark-gold banner used by the fan-vote cards.
def gold_banner(c, label, season = 0, name = ""):
    c.fill("#000000")
    if season > 0:
        draw_season_bg(c, season)
    elif name != "":
        draw_cast_bg(c, name)
    for i in range(8):
        c.rect(0, i, 191, i, fill = ["#3A2600", "#322100", "#2A1C00", "#231700", "#1C1200", "#150D00", "#0E0900", "#070400"][i])
    txt(c, label, 96, 1, "4x5", GOLD, "center")

# Two or more top-100 sketches from one night: a ranked list.
def card_sketch_list(c, e, items):
    gold_banner(c, "SNN TOP 100 SKETCHES", e[3])
    rows = items[:4]
    pitch = 6
    y0 = 9 + (23 - len(rows) * pitch) // 2
    lad = list_ladder(c, [t[4] for t in rows], 166)
    for k in range(len(rows)):
        t = rows[k]
        r = "#" + str(t[3])
        y = y0 + k * pitch
        txt(c, r, 20, y, "4x5", GOLD, "right")
        tt, f = fit_exact(c, t[4], lad, 166)
        txt(c, tt, 24, y, f, "#FFFFFF")

CAST_ROWS = 4

def initial_form(name):
    parts = name.split(" ")
    return parts[0][:1] + ". " + last_name(name)

# One naming style for a whole page: full names in 4x5, else full names in
# picopixel, else "F. LAST" in 4x5 (last resort: truncated).
def cast_style(c, names, maxw, compact):
    ok = True
    for n in names:
        if not font_ok(n, "5x5") or tw(c, n, "5x5") > maxw:
            ok = False
    if ok:
        return "wide"
    ok = True
    for n in names:
        if tw(c, n, "4x5") > maxw:
            ok = False
    if ok:
        return "full"
    ok = True
    for n in names:
        if not font_ok(n, "picopixel") or tw(c, n, "picopixel") > maxw:
            ok = False
    if ok:
        return "pico"
    return "mixed"

def cast_name(c, name, maxw, style):
    if style == "last":
        return fit_exact(c, last_name(name), ["4x5", "picopixel"], maxw)
    if style == "wide":
        return name, "5x5"
    if style == "full":
        return name, "4x5"
    if style == "pico":
        return name, "picopixel"
    if style == "mixed":
        if font_ok(name, "picopixel") and tw(c, name, "picopixel") <= maxw:
            return name, "picopixel"
        t, f = fit(c, initial_form(name), ["picopixel", "4x5"], maxw)
        if t.endswith(".."):
            t, f = fit(c, last_name(name), ["picopixel", "4x5"], maxw)
        return t, f
    t, f = fit_exact(c, initial_form(name), ["4x5", "picopixel"], maxw)
    if t.endswith(".."):
        t, f = fit_exact(c, last_name(name), ["4x5", "picopixel"], maxw)
    return t, f

def card_cast(c, e, page, pages, compact):
    header(c, e, "CAST " + str(page + 1) + "/" + str(pages), "CAST" if pages == 1 else str(page + 1) + "/" + str(pages))
    people = cast_list(e[3])
    # Balanced pages: split as evenly as possible.
    per = (len(people) + pages - 1) // pages
    chunk = people[page * per:(page + 1) * per]
    cols = 2 if len(chunk) <= 8 else 3
    colw = 188 // cols
    rows = (len(chunk) + cols - 1) // cols
    style = cast_style(c, [n for n, _ in chunk], colw - 1, compact)
    # Anyone whose final episode this is shows in red.
    news = CAST_NEWS.get(e[5])
    leaving = news[1] if news != None else []
    y0 = 9 + (23 - rows * 6) // 2 if rows < CAST_ROWS else 9
    for i in range(len(chunk)):
        name, fl = chunk[i]
        col = i // rows
        row = i % rows
        x = 2 + col * (colw + 1)
        y = y0 + row * 6
        color = GOLD if fl.find("A") >= 0 else (FEAT if fl.find("F") >= 0 else "#FFFFFF")
        if name in leaving:
            color = RED
        t, f = cast_name(c, name, colw - 1, style)
        txt(c, t, x, y, f, color)

# Other billings of the same lead artist (band names, duets, "featuring"),
# so appearances count across all of them.
MG_ALIAS = {
    "TOM PETTY AND THE HEARTBREAKERS": "TOM PETTY",
    "TOM PETTY & THE HEARTBREAKERS": "TOM PETTY",
    "BRUCE SPRINGSTEEN & THE E STREET BAND": "BRUCE SPRINGSTEEN",
    "DAVE MATTHEWS BAND": "DAVE MATTHEWS",
    "EDIE BRICKELL AND NEW BOHEMIANS": "EDIE BRICKELL",
    "EDIE BRICKELL & NEW BOHEMIANS": "EDIE BRICKELL",
    "LEON REDBONE & THE IDLERS": "LEON REDBONE",
    "LEON REDBONE, HARLAN COLLINS & JOYCE EVERSON": "LEON REDBONE",
    "FRANK ZAPPA WITH DON PARDO AS THE SLIME": "FRANK ZAPPA",
    "GARTH BROOKS AS CHRIS GAINES": "GARTH BROOKS",
    "THE BLACK EYED PEAS": "BLACK EYED PEAS",
    "THE NEW JOE JACKSON BAND": "JOE JACKSON",
    "ARETHA FRANKLIN & KEITH SYKES": "ARETHA FRANKLIN",
    "DEBORAH HARRY & FUNKY FOUR PLUS ONE": "DEBORAH HARRY",
    "ELTON JOHN & BRANDI CARLILE": "ELTON JOHN",
    "GWEN STEFANI & AKON": "GWEN STEFANI",
    "LINDA RONSTADT & PHOEBE SNOW": "LINDA RONSTADT",
    "LINDA RONSTADT & THE CAST OF THE PIRATES OF PENZANCE": "LINDA RONSTADT",
    "LINDA RONSTADT & AARON NEVILLE": "LINDA RONSTADT",
    "MARK RONSON & BRUNO MARS": "MARK RONSON",
    "MARK RONSON & MILEY CYRUS": "MARK RONSON",
    "MICK JAGGER & (WITH ARCADE FIRE, FOO FIGHTERS, JEFF BECK)": "MICK JAGGER",
    "PAUL SIMON & GEORGE HARRISON": "PAUL SIMON",
    "PAUL SIMON & JAMES TAYLOR & DAVID SANBORN": "PAUL SIMON",
    "PAUL SIMON & LADYSMITH BLACK MAMBAZO": "PAUL SIMON",
    "RANDY NEWMAN, PHOEBE SNOW, ART GARFUNKEL & JESSY DIXON SINGERS": "RANDY NEWMAN",
    "RANDY NEWMAN, THE NITTY GRITTY DIRT BAND": "RANDY NEWMAN",
    "RANDY NEWMAN & MARK KNOPFLER": "RANDY NEWMAN",
    "WILLIE NELSON & PAUL SIMON": "WILLIE NELSON",
    "DR. DRE FEATURING & SNOOP DOGG & EMINEM": "DR. DRE",
    "LUDACRIS FEATURING SUM 41": "LUDACRIS",
    "LUDACRIS & T-PAIN": "LUDACRIS",
    "JOE COCKER & STUFF": "JOE COCKER",
    "JOE COCKER & JENNIFER WARNES": "JOE COCKER",
}

def mg_key(name):
    return MG_ALIAS.get(name, name)

# The separate acts in a billing: "TOM PETTY & THE HEARTBREAKERS" ->
# ["TOM PETTY", "THE HEARTBREAKERS"].
def mg_segments(name):
    for sep in [" FEATURING ", " WITH ", " AND ", ", ", " & "]:
        name = name.replace(sep, "|")
    return [x.strip() for x in name.split("|") if x.strip() != ""]

# Only appearance: one billing, and none of its acts shows up in any other
# billing (solo vs with a band, duets). Unsure cases stay "debut".
def mg_only_once(mg, apps):
    if len(apps) != 1:
        return False
    mine = mg_segments(mg)
    for o in EPISODES:
        if o[7] == "" or mg_key(o[7]) == mg_key(mg):
            continue
        for seg in mg_segments(o[7]):
            if seg in mine:
                return False
    return True

# Ways to split a billing into acts, cleanest first: the episode's act
# list, then separators that keep "X & THE Y" band names whole, then every "&".
def mg_act_lists(e):
    out = []
    acts = MG_ACTS.get(e[5], [])
    if len(acts) > 1:
        out.append(acts)
    mg = e[7].replace("(", "").replace(")", "")
    whole = mg.replace(" & THE ", " &THE ")
    for sep in [" FEATURING ", " WITH ", " AND ", ", ", " & "]:
        whole = whole.replace(sep, "|")
    out.append([x.strip(" &").replace(" &THE ", " & THE ") for x in whole.split("|") if x.strip(" &") != ""])
    out.append([x.strip(" &") for x in mg_segments(mg) if x.strip(" &") != ""])
    return out

# The full billing if it fits, else lead act + "N MORE".
def fit_mg(c, e, fonts, maxw):
    t, f = fit(c, e[7], fonts, maxw)
    if not t.endswith(".."):
        return t, f
    for acts in mg_act_lists(e):
        if len(acts) > 1:
            t2, f2 = fit(c, acts[0] + " + " + str(len(acts) - 1) + " MORE", fonts, maxw)
            if not t2.endswith(".."):
                return t2, f2
    return t, f

def card_music(c, e):
    mg = e[7]
    apps = []
    for o in EPISODES:
        if mg_key(o[7]) == mg_key(mg):
            apps.append(o)
    n = 1
    for k in range(len(apps)):
        if apps[k][5] == e[5]:
            n = k + 1
    only = mg_only_once(mg, apps)
    if only:
        header(c, e, "ONLY SNL APPEARANCE", "ONLY TIME")
    elif n == 1:
        header(c, e, "MUSIC DEBUT", "DEBUT")
    else:
        header(c, e, ordinal(n) + " TIME", ordinal(n))
    songs = SONGS.get(e[5], [])
    if len(songs) == 0:
        t, f = fit_mg(c, e, ["6x8", "5x7", "4x5", "picopixel"], 188)
        txt(c, t, 96, 9 if FONT_H[f] >= 7 else 10, f, GOLD, "center")
        main = "ONLY TIME AS MUSICAL GUEST" if only else ("SNL DEBUT AS MUSICAL GUEST" if n == 1 else ordinal(n) + " TIME AS MUSICAL GUEST")
        t, f = fit(c, main, ["4x5", "picopixel"], 188)
        txt(c, t, 96, 19, f, "#FFFFFF", "center")
        if len(apps) > 1:
            ys = year_list([a[0] for a in apps])
            t, f = fit(c, ys, ["4x5", "picopixel"], 188)
            txt(c, t, 96, 26, f, GRAY, "center")
        return
    # Songs: whole titles only. The fewer and shorter they are, the bigger
    # the act and the songs get (short sets used to leave the page half empty).
    lines, _ = pack_songs(c, songs, "4x5", 2)
    one = " / ".join(songs)
    if font_ok(one, "5x7") and tw(c, one, "5x7") <= 188:
        lines, sf = [one], "5x7"
    else:
        sf = "4x5"
    if len(lines) == 1:
        t, f = fit_mg(c, e, ["8x12", "6x8", "5x7", "4x5", "picopixel"], 188)
        block = FONT_H[f] + 3 + FONT_H[sf]
        y = 9 + (23 - block) // 2
        txt(c, t, 96, y, f, GOLD, "center")
        txt(c, lines[0], 96, y + FONT_H[f] + 3, sf, "#FFFFFF", "center")
        return
    t, f = fit_mg(c, e, ["6x8", "5x7", "4x5", "picopixel"], 188)
    txt(c, t, 96, 9 if FONT_H[f] >= 7 else 10, f, GOLD, "center")
    for k in range(len(lines)):
        txt(c, lines[k], 96, 19 + k * 7, "4x5", "#FFFFFF", "center")

def news_line(c, label, names, maxw, max_lines):
    for form in ["full", "last"]:
        parts = names if form == "full" else [last_name(n) for n in names]
        lines, f = wrap_fit(c, label + " " + " / ".join(parts), ["4x5", "picopixel"], maxw, max_lines)
        if not lines[len(lines) - 1].endswith(".."):
            return lines, f
    return lines, f

def card_cast_news(c, e, data):
    _, finals = data
    header(c, e, "FAREWELLS", "GOODBYE")
    lines, f = news_line(c, "FINAL EPISODE FOR:", finals, 188, 4)
    lead = "FINAL EPISODE FOR:"
    y = 9 + (23 - (len(lines) * 6 - 1)) // 2
    for k in range(len(lines)):
        line = lines[k]
        if k == 0 and line.startswith(lead):
            lw = tw(c, lead + " ", f)
            txt(c, lead, 2, y, f, RED)
            txt(c, line[len(lead) + 1:], 2 + lw, y, f, "#FFFFFF")
        else:
            txt(c, line, 2, y, f, "#FFFFFF")
        y += 6

# Cast spotlight: someone from that night's cast, with their famous roles.
def spotlight_people(e):
    out = []
    for name, fl in cast_list(e[3]):
        if len(ROLES.get(name, [])) > 0 or len(impressions_of(name)) > 0:
            out.append(name)
    return out

def night_roles(e, name):
    for n, rs in NIGHT_ROLES.get(e[5], []):
        if n == name:
            return rs
    return []

# Spotlight: roles they're named doing THAT night if the episode summary
# says so, otherwise their best-known roles labelled "KNOWN FOR".
def card_spotlight(c, e, name):
    header(c, e, "IN THE CAST", "CAST")
    t, f = fit(c, name, ["6x8", "5x7", "4x5"], 188)
    p = CAST.get(name)
    col = era_colors(p[0])[0] if p != None else "#FFFFFF"
    txt(c, t, 96, 10 if FONT_H[f] >= 7 else 11, f, col, "center")
    tonight = night_roles(e, name)
    if len(tonight) > 0:
        label, lcol, roles = "THAT NIGHT:", GOLD, tonight
    else:
        roles = [who for _, who, _ in impressions_of(name)]
        for r in ROLES.get(name, []):
            if r not in roles:
                roles.append(r)
        label, lcol = "KNOWN FOR:", GRAY
    # Line 1: label + whole roles that fit after it; line 2: the rest.
    font = "4x5"
    lw = tw(c, label + " ", font)
    first = ""
    second = ""
    for r in roles:
        if tw(c, r, font) > 188:
            continue
        cand = r if first == "" else first + " / " + r
        if second == "" and tw(c, cand, font) <= 188 - lw:
            first = cand
            continue
        cand2 = r if second == "" else second + " / " + r
        if tw(c, cand2, font) <= 188:
            second = cand2
    w1 = lw + tw(c, first, font)
    x = 96 - w1 // 2
    y = 20 if second != "" else 23
    txt(c, label, x, y, font, lcol)
    txt(c, first, x + lw, y, font, "#FFFFFF")
    if second != "":
        txt(c, second, 96, y + 7, font, "#FFFFFF", "center")

# A note on this show, wrapped to fit.
def card_notes(c, e, note):
    header(c, e, "SHOW NOTES", "NOTES")
    lines, f = wrap_fit(c, note, ["4x5", "picopixel"], 188, 4)
    y0 = 9 + (23 - (len(lines) * 6 - 1)) // 2
    for k in range(len(lines)):
        txt(c, lines[k], 96, y0 + k * 6, f, "#FFFFFF", "center")

def pack_songs(c, songs, font, n):
    lines = []
    cur = ""
    used = 0
    for sg in songs:
        if tw(c, sg, font) > 188:
            used += 1
            continue
        cand = sg if cur == "" else cur + " / " + sg
        if tw(c, cand, font) <= 188:
            cur = cand
            used += 1
        elif len(lines) < n - 1:
            lines.append(cur)
            cur = sg
            used += 1
        else:
            break
    if cur != "":
        lines.append(cur)
    return lines[:n], used

# Does this night's music need two pages?
def music_two_pages(e):
    if len(MG_ACTS.get(e[5], [])) > 1:
        return True
    total = 0
    for sg in SONGS.get(e[5], []):
        total += len(sg) + 3
    return total > 80

# Page 7 of a two-page music night: the acts (or the guest + first songs).
def card_music_1(c, e):
    acts = MG_ACTS.get(e[5], [])
    header(c, e, "MUSIC 1/2", "1/2")
    if len(acts) > 1:
        rows = acts[:4]
        big = len(rows) <= 2
        pitch = 10 if big else 6
        fonts = ["5x7", "4x5", "picopixel"] if big else ["4x5", "picopixel"]
        h = 7 if big else 5
        y0 = 9 + (23 - ((len(rows) - 1) * pitch + h)) // 2
        for k in range(len(rows)):
            t, f = fit(c, rows[k], fonts, 188)
            txt(c, t, 96, y0 + k * pitch, f, GOLD, "center")
        return
    t, f = fit_mg(c, e, ["5x7", "4x5", "picopixel"], 188)
    txt(c, t, 96, 9 if FONT_H[f] >= 7 else 10, f, GOLD, "center")
    lines, _ = pack_songs(c, SONGS.get(e[5], []), "4x5", 2)
    for k in range(len(lines)):
        txt(c, lines[k], 96, 19 + k * 7, "4x5", "#FFFFFF", "center")

# Page 8 of a two-page music night: the songs.
def card_music_2(c, e):
    header(c, e, "SONGS", "SONGS")
    songs = SONGS.get(e[5], [])
    if len(MG_ACTS.get(e[5], [])) <= 1:
        _, used = pack_songs(c, songs, "4x5", 2)
        songs = songs[used:]
    if len(songs) == 0:
        txt(c, "NO SONG LIST ON RECORD", 96, 17, "4x5", GRAY, "center")
        return
    lines, _ = pack_songs(c, songs, "4x5", 4)
    y0 = 9 + (23 - (len(lines) * 6 - 1)) // 2
    for k in range(len(lines)):
        txt(c, lines[k], 96, y0 + k * 6, "4x5", "#FFFFFF", "center")

# Sketches that night: whole titles packed into 4 lines, starting at a
# different sketch each refresh so the whole lineup comes around.
def card_lineup(c, e, ctx):
    header(c, e, "SKETCHES", "SKITS")
    titles = [t for t in LINEUP.get(e[5], []) if tw(c, t, "4x5") <= 188]
    if len(titles) == 0:
        return
    start = rotation_index(ctx, len(titles), 11)
    order = titles[start:] + titles[:start]
    lines = []
    cur = ""
    for t in order:
        cand = t if cur == "" else cur + " / " + t
        if tw(c, cand, "4x5") <= 188:
            cur = cand
        elif len(lines) < 3:
            lines.append(cur)
            cur = t
    if cur != "" and len(lines) < 4:
        lines.append(cur)
    y0 = 9 + (23 - (len(lines) * 6 - 1)) // 2
    for k in range(len(lines)):
        txt(c, lines[k], 96, y0 + k * 6, "4x5", "#FFFFFF", "center")

def card_live(c, e):
    c.fill("#000000")
    bright, dark = era_colors(e[3])
    for i in range(32):
        if i % 4 == 0:
            c.line(0, i, 191, i, "#0A0A12")
    # spotlight cone
    for i in range(12):
        c.line(96, 0, 40 + i * 4, 31, "#141020")
    outlined(c, "LIVE FROM NEW YORK,", 96, 7, "5x7", "#FFFFFF", "center")
    outlined(c, "IT'S SATURDAY NIGHT!", 96, 18, "5x7", bright, "center")

# The episode's dynamic cards for pages 5-8: fan-vote cards and the cast
# on pages 5-7, the music card always on page 8.
def episode_cards(ctx, e):
    pre = []
    # The episode's SNN rank shows as the star in the page-2 header, so it
    # gets no card of its own.
    sk = top_sketches_for(e)
    if len(sk) == 1:
        pre.append(("sketch", sk[0]))
    elif len(sk) > 1:
        pre.append(("sketches", sk))
    note = EP_NOTES.get((e[0], e[1], e[2]))
    if note != None:
        pre.append(("notes", note))
    people = cast_list(e[3])
    n = len(people)
    # Farewells get a reserved slot ahead of the cast (the cast goes
    # compact to make room) as long as the cast still fits.
    # A farewell page only for the really remembered (FAREWELLS); anyone
    # else leaving just shows in red on the cast page.
    fw = FAREWELLS.get(e[5], [])
    news = ([], fw)
    farewell = len(fw) > 0
    if farewell:
        pre.append(("news", news))
    # When the cast can't fit, drop the sketch card(s) first, and only
    # then the farewell.
    if farewell and (n + 11) // 12 > 3 - len(pre):
        pre = [x for x in pre if x[0] != "sketch" and x[0] != "sketches"]
    if farewell and (n + 11) // 12 > 3 - len(pre):
        pre = [x for x in pre if x[0] != "news"]
        farewell = False
    if note != None and (n + 11) // 12 > 3 - len(pre):
        pre = [x for x in pre if x[0] != "notes"]
    slots = 3 - len(pre)
    # The night's sketch lineup outranks roomy cast pages: squeeze the cast
    # (last names, 3 columns) if that's what it takes to leave it a page.
    has_lineup = len(LINEUP.get(e[5], [])) > 0
    cast_slots = slots
    if has_lineup and slots >= 2 and (n + 11) // 12 <= slots - 1:
        cast_slots = slots - 1
    full_pages = (n + 11) // 12
    compact = full_pages > cast_slots
    per = 12
    pages = min((n + per - 1) // per, max(1, cast_slots))
    cards = []
    for x in pre:
        if x[0] != "news":
            cards.append(x)
    if farewell:
        cards.append(("news", news))
    for p in range(pages):
        cards.append(("cast", (p, pages, compact)))
    # Fill any room left with cast spotlights from that night's cast;
    # "Live from New York" only as a last resort.
    fillers = []
    spot = spotlight_people(e)
    order = []
    named = [n for n, _ in NIGHT_ROLES.get(e[5], [])]
    for n in named:
        order.append(n)
    rest = [n for n in spot if n not in named]
    if len(rest) > 0:
        start = rotation_index(ctx, len(rest), 5)
        for k in range(len(rest)):
            order.append(rest[(start + k) % len(rest)])
    used = 0
    # The night's sketch lineup comes next when there's room.
    if len(cards) < 3 and len(LINEUP.get(e[5], [])) > 0:
        cards.append(("lineup", None))
    # Two-page music takes page 7 when it would only have been a filler.
    two_music = e[7] != "" and len(cards) < 3 and music_two_pages(e)
    if two_music:
        order = []
        fillers = []
    for fcard in fillers:
        if len(cards) < 3:
            cards.append(fcard)
    for name in order:
        if len(cards) < 3:
            cards.append(("spotlight", name))
            used += 1
    if two_music:
        for _ in range(2 - len(cards)):
            cards.append(("spotlight", spotlight_people(e)[0]) if len(spotlight_people(e)) > 0 else ("live", None))
        cards = cards[:2]
        cards.append(("music1", None))
        cards.append(("music2", None))
        return cards
    for _ in range(3 - len(cards)):
        cards.append(("live", None))
    cards = cards[:3]
    if e[7] != "":
        cards.append(("music", None))
    elif used < len(order):
        # No musical guest: page 8 spotlights someone not shown above.
        cards.append(("spotlight", order[used]))
    else:
        cards.append(("live", None))
    return cards

def draw_episode_card(c, ctx, e, card):
    kind, data = card
    if kind == "sketches":
        card_sketch_list(c, e, data)
    elif kind == "sketch":
        card_sketch(c, e, data)
    elif kind == "cast":
        card_cast(c, e, data[0], data[1], data[2])
    elif kind == "news":
        card_cast_news(c, e, data)
    elif kind == "spotlight":
        card_spotlight(c, e, data)
    elif kind == "lineup":
        card_lineup(c, e, ctx)
    elif kind == "notes":
        card_notes(c, e, data)
    elif kind == "music1":
        card_music_1(c, e)
    elif kind == "music2":
        card_music_2(c, e)
    elif kind == "music":
        card_music(c, e)
    else:
        card_live(c, e)

# ------------------------------------------------------ empty-day cards ----

CAST_NAMES = sorted(CAST.keys())

def pick_member(ctx):
    return CAST_NAMES[rotation_index(ctx, len(CAST_NAMES), 1)]

def member_hosted(name):
    return hosted_years(name)


# The episode where this person's final stint ended (from CAST_NEWS).
def last_episode_as_cast(name):
    best = None
    for ov in CAST_NEWS:
        if name in CAST_NEWS[ov][1]:
            if best == None or ov > best:
                best = ov
    if best == None:
        return None
    for e in EPISODES:
        if e[5] == best:
            return e
    return None


# Episodes someone was in the cast for (their stints, first to last).
def run_episodes(name):
    p = CAST[name]
    first = p[10]
    last = last_episode_as_cast(name)
    ranges = []
    for st in p[9].split("|"):
        ab = st.split("-")
        ranges.append((int(ab[0]), int(ab[1])))
    out = []
    for e in EPISODES:
        inside = False
        for a, b in ranges:
            if a <= e[3] and e[3] <= b:
                inside = True
        if not inside or (e[0], e[1], e[2]) < first:
            continue
        if last != None and e[5] > last[5]:
            continue
        out.append(e)
    return out

# The biggest names who hosted during their run (SNN greatest hosts first).
def card_hosted_by(c, name):
    p = CAST[name]
    bright, _ = era_colors(p[0])
    profile_header(c, "HOSTED DURING THEIR RUN", bright, name)
    seen = {}
    for e in run_episodes(name):
        for h in split_hosts(e[6]):
            seen[h] = seen.get(h, 0) + 1
    ranked = []
    for h in seen:
        r = host_rank(h)
        if r > 0:
            ranked.append((r, h))
    ranked = sorted(ranked)
    rows = []
    for r, h in ranked[:4]:
        rows.append(("#" + str(r), h))
    if len(rows) < 4:
        rest = sorted([(-seen[h], h) for h in seen if host_rank(h) == 0])
        for n, h in rest[:4 - len(rows)]:
            rows.append(("", h))
    lad = list_ladder(c, [h for _, h in rows], 104)
    pitch = 6 if len(rows) >= 4 else 7
    y0 = 9 + (23 - (len(rows) * pitch - 1)) // 2
    for k in range(len(rows)):
        tag, h = rows[k]
        y = y0 + k * pitch
        if tag != "":
            tagw = tw(c, tag, "4x5")
            t, f = fit_exact(c, h, lad, 184 - tagw)
            w = tagw + 4 + tw(c, t, f)
            x = 96 - w // 2
            txt(c, tag, x, y, "4x5", GOLD)
            txt(c, t, x + tagw + 4, y, f, "#FFFFFF")
        else:
            t, f = fit_exact(c, h, lad, 188)
            txt(c, t, 96, y, f, "#FFFFFF", "center")


def on_show_empty(name):
    p = CAST[name]
    fl = p[5]
    return (cast_rank(name) == 0 and fl.find("A") < 0 and len(member_hosted(name)) == 0 and
            host_rank(name) == 0 and fl.find("W") < 0 and fl.find("B") < 0 and fl.find("M") < 0)

# Which fallback cards a profile uses, so no page repeats another:
# (roles page kind, sketches page kind).
def profile_plan(name):
    if len(run_episodes(name)) == 1:
        # One night only: its music and its sketches, not three copies of it.
        return "music", "lineup"
    used = []
    if on_show_empty(name) and CAST[name][3] == 0:
        used.append("debut")
    if len(ROLES.get(name, [])) > 0 or len(impressions_of(name)) > 0:
        roles_kind = "famous"
    elif len(PLAYED.get(name, [])) >= 2:
        roles_kind = "played"
    else:
        roles_kind = "hosted"
        used.append("hosted")
    if len(CAST_TOP.get(name, [])) > 0:
        sk_kind = "sketches"
    else:
        sk_kind = "music"
        for k in ["debut", "hosted"]:
            if k not in used:
                sk_kind = k
                break
    return roles_kind, sk_kind

# The musical acts who played during their run (most appearances first).
def card_music_run(c, name):
    p = CAST[name]
    bright, _ = era_colors(p[0])
    profile_header(c, "MUSIC THAT NIGHT" if len(run_episodes(name)) == 1 else "MUSIC DURING THEIR RUN", bright, name)
    seen = {}
    order = []
    for e in run_episodes(name):
        acts = MG_ACTS.get(e[5], [e[7]] if e[7] != "" else [])
        for a in acts:
            if a not in seen:
                order.append(a)
            seen[a] = seen.get(a, 0) + 1
    ranked = sorted([(-seen[a], order.index(a), a) for a in order])
    rows = [a for _, _, a in ranked[:4]]
    pitch = 6 if len(rows) >= 4 else 7
    y0 = 9 + (23 - (len(rows) * pitch - 1)) // 2
    lad = list_ladder(c, rows, 188)
    for k in range(len(rows)):
        t, f = fit_exact(c, rows[k], lad, 188)
        txt(c, t, 96, y0 + k * pitch, f, GOLD if k == 0 else "#FFFFFF", "center")

def card_legacy(c, name, ctx):
    p = CAST[name]
    bright, _ = era_colors(p[0])
    ranks = CAST_TOP.get(name, [])
    if len(ranks) > 0:
        # Left: how many they're in. Right: their best two, rank + title.
        profile_header(c, "SNN TOP 100 SKETCHES", GOLD, name)
        n = str(len(ranks))
        txt(c, n, 22, 9, "10x14", GOLD, "center")
        txt(c, "SKETCH" if len(ranks) == 1 else "SKETCHES", 22, 25, "4x5", "#FFFFFF", "center")
        c.line(45, 10, 45, 30, GOLD)
        # Their best one: rank + title, then when it aired.
        # A different one of their sketches each refresh, not always the best.
        r = ranks[rotation_index(ctx, len(ranks), 9)]
        sk = None
        for t in TOP_SKETCHES:
            if t[3] == r:
                sk = t
        main = sk[4].split(" / ")[0]
        tag = "#" + str(r)
        tagw = tw(c, tag, "4x5")
        lines, f = wrap_fit(c, main, ["4x5", "picopixel"], 188 - 53 - tagw, 2)
        ep = None
        for e in EPISODES:
            if e[0] == sk[0] and e[1] == sk[1] and e[2] == sk[2]:
                ep = e
        info = []
        # A two-line title leaves room for just the date.
        if ep != None and len(lines) < 2:
            info.append("S" + str(ep[3]) + " E" + str(ep[4]))
        info.append(str(sk[1]) + "/" + str(sk[2]) + "/" + str(sk[0]))
        total = (len(lines) + len(info)) * 6
        y = 9 + (23 - total) // 2 + 1
        txt(c, tag, 49, y, "4x5", GOLD)
        for k in range(len(lines)):
            txt(c, lines[k], 53 + tagw, y, f, "#FFFFFF")
            y += 6
        for line in info:
            txt(c, line, 53 + tagw, y, "4x5", GRAY)
            y += 6
        return
    # No top-100 credit: whatever the plan leaves unused.
    kind = profile_plan(name)[1]
    if kind == "lineup":
        eps = run_episodes(name)
        profile_header(c, "SKETCHES THAT NIGHT", bright, name)
        titles = [t for t in LINEUP.get(eps[0][5], []) if tw(c, t, "4x5") <= 188]
        lines = []
        cur = ""
        for t in titles:
            cand = t if cur == "" else cur + " / " + t
            if tw(c, cand, "4x5") <= 188:
                cur = cand
            elif len(lines) < 3:
                lines.append(cur)
                cur = t
        if cur != "" and len(lines) < 4:
            lines.append(cur)
        y0 = 9 + (23 - (len(lines) * 6 - 1)) // 2
        for k in range(len(lines)):
            txt(c, lines[k], 96, y0 + k * 6, "4x5", "#FFFFFF", "center")
        return
    if kind == "hosted":
        card_hosted_by(c, name)
    elif kind == "music":
        card_music_run(c, name)
    else:
        profile_header(c, "FIRST EPISODE AS CAST", bright, name)
        fy, fm, fd = p[10]
        txt(c, str(fm) + "/" + str(fd) + "/" + str(fy), 96, 10, "6x8", "#FFFFFF", "center")
        for e in EPISODES:
            if e[0] == fy and e[1] == fm and e[2] == fd:
                t, f = fit(c, host_line(e), ["4x5", "picopixel"], 188)
                txt(c, t, 96, 21, f, GRAY, "center")

def born_str(b):
    if b[0] == 0:
        return ""
    if b[1] == 0:
        return str(b[0])
    if b[2] == 0:
        return str(b[1]) + "/" + str(b[0])
    return str(b[1]) + "/" + str(b[2]) + "/" + str(b[0])

def age_on(b, y, m, d):
    if b[0] == 0 or b[1] == 0 or (b[2] == 0 and m == b[1]):
        return -1
    if b[2] == 0:
        return y - b[0] - (1 if m < b[1] else 0)
    return y - b[0] - (1 if (m, d) < (b[1], b[2]) else 0)


# ------------------------------------------------------ backgrounds ----
# Original, procedurally drawn backdrops (no copyrighted art): a dim
# era-colored gradient, an era motif, and the season number huge and faint.

def hexc(r, g, b):
    h = "0123456789ABCDEF"
    out = "#"
    for v in [r, g, b]:
        v = max(0, min(255, v))
        out += h[v // 16] + h[v % 16]
    return out

def hex_rgb(col):
    h = "0123456789ABCDEF"
    s = col.upper()
    return [h.find(s[1]) * 16 + h.find(s[2]), h.find(s[3]) * 16 + h.find(s[4]), h.find(s[5]) * 16 + h.find(s[6])]

# The era's bright color scaled to a fraction (0-100) of full brightness.
def dim(col, pct):
    pct = pct * 19 // 10    # brightened: LEDs swallow very dim colors
    r, g, b = hex_rgb(col)
    return hexc(r * pct // 100, g * pct // 100, b * pct // 100)

def era_motif(c, season, bright, top):
    if season <= 5:
        # 70s: sunburst rays fanning up from the bottom center
        for k in range(-9, 10):
            c.line(96, 34, 96 + k * 16, top, dim(bright, 14 if k % 2 == 0 else 8))
    elif season == 6:
        # the Doumanian season: plain static
        for k in range(60):
            h = scramble(k * 97 + season)
            c.pixel(h % 192, top + (h >> 8) % (32 - top), dim(bright, 18))
    elif season <= 10:
        # 80s: neon perspective grid floor
        for x in range(-96, 192, 16):
            c.line(96 + (x - 96) // 5, 18, x, 31, dim(bright, 16))
        for y in [19, 21, 24, 28]:
            c.line(0, y, 191, y, dim(bright, 18))
    elif season <= 20:
        # late 80s / early 90s: diagonal stripes
        for x in range(-32, 160, 10):
            c.line(x, top, x + 24, 31, dim(bright, 12))
    elif season <= 30:
        # 90s: confetti squiggles
        for k in range(26):
            h = scramble(k * 131 + season * 7)
            x = h % 188
            y = top + (h >> 8) % (30 - top)
            col = dim(bright if k % 3 else "#FF4FA3", 24)
            c.line(x, y, x + 2, y + 1, col)
            c.line(x + 2, y + 1, x + 4, y, col)
    elif season <= 40:
        # 2000s: equalizer bars along the bottom
        for k in range(0, 192, 4):
            h = scramble(k * 17 + season)
            ht = 3 + h % 11
            c.rect(k, 31 - ht, k + 2, 31, fill = dim(bright, 12))
    elif season <= 50:
        # late 2010s-2020s: halftone dots, bigger toward the bottom
        for y in range(top + 2, 32, 4):
            for x in range(1 + (y // 4) % 2 * 2, 192, 4):
                c.pixel(x, y, dim(bright, 10 + (y - top) // 2))
                if y > 22:
                    c.pixel(x + 1, y, dim(bright, 10 + (y - top) // 2))
    else:
        # now: fine scanlines
        for y in range(top, 32, 2):
            c.line(0, y, 191, y, dim(bright, 10))

def draw_season_bg(c, season, top = 8):
    bright, dark = era_colors(season)
    # vertical gradient: dark era tone fading to near-black
    for y in range(top, 32):
        pct = 16 - (y - top) * 10 // (32 - top)
        c.line(0, y, 191, y, dim(bright, pct))
    era_motif(c, season, bright, top)
    # the season number, huge and faint, tucked to the right
    n = str(season)
    c.text(n, 190, 7, font = "19x28", color = dim(bright, 22), align = "right")
    if season == 50:
        for k in range(12):
            h = scramble(k * 211 + 5)
            c.pixel(80 + h % 46, top + 1 + (h >> 8) % 20, "#8A7A3A")

# Cast-card backdrop: their era, their initials huge and faint.
def draw_cast_bg(c, name, top = 0):
    p = CAST.get(name)
    season = p[0] if p != None else 1
    bright, _ = era_colors(season)
    for y in range(top, 32):
        pct = 14 - (y - top) * 10 // (32 - top)
        c.line(0, y, 191, y, dim(bright, pct))
    era_motif(c, season, bright, top)
    parts = name.split(" ")
    ini = parts[0][:1] + last_name(name)[:1]
    c.text(ini, 190, 3, font = "19x28", color = dim(bright, 20), align = "right")

# ------------------------------------------------------------ specials ----

# Prime-time anniversary specials (Wikipedia). Each is
# (y, m, d, season, 0, tag, title, host, facts, cards): facts rotate on the
# special's own card; cards fill pages 3-8 (moments, then music two acts per page).
SPECIALS = [
    (1989, 9, 24, 15, 0, "SNL15", "15TH ANNIVERSARY", "TOM HANKS",
     ["TWO AND A HALF HOURS ON NBC", "PRIME TIME - SUNDAY NIGHT"],
     [("moment", "COLD OPEN", "CHEVY'S PRATFALLS", "IN A FOOTBALL HELMET CHEVY TUMBLES DOWN THE STAIRS"),
      ("moment", "TRIBUTES", "GILDA AND JOHN", "GILDA RADNER AND JOHN BELUSHI REMEMBERED BY THEIR CASTMATES"),
      ("moment", "HIGHLIGHT", "ROBIN WILLIAMS", "SENT OUT TO STALL - AND ROASTS THE CROWD"),
      ("moment", "GOODNIGHTS", "BRUCE WILLIS", "CLOSES THE SHOW - AND PLUGS HIS OWN HOSTING GIG NEXT WEEK"),
      ("music", [("PRINCE", "ELECTRIC CHAIR", "INTRODUCED BY JERRY HALL")]),
      ("music", [("PAUL SIMON", "STILL CRAZY AFTER ALL THESE YEARS")])]),
    (1999, 9, 26, 25, 0, "SNL25", "25TH ANNIVERSARY", "CHRIS ROCK",
     ["THREE HOURS ON NBC", "EMMY WINNER: BEST SPECIAL"],
     [("moment", "COLD OPEN", "NICK THE LOUNGE SINGER", "BILL MURRAY AND PAUL SHAFFER OPEN THE SHOW"),
      ("moment", "REUNION", "THE THREE AMIGOS", "MARTIN - SHORT - CHASE SALUTE THE FIRST FIVE YEARS"),
      ("moment", "TRIBUTES", "REMEMBERED", "BELUSHI - RADNER - HARTMAN - FARLEY"),
      ("moment", "SKETCH", "DR. EVIL MEETS LORNE", "MYERS COMPARES DR. EVIL TO LORNE MICHAELS"),
      ("music", [("EURYTHMICS", "HERE COMES THE RAIN AGAIN"), ("AL GREEN", "LET'S STAY TOGETHER")]),
      ("music", [("BEASTIE BOYS + ELVIS COSTELLO", "SABOTAGE INTO RADIO RADIO", "HIS 1977 STUNT - AGAIN")])]),
    (2015, 2, 15, 40, 0, "SNL40", "40TH ANNIVERSARY", "STEVE MARTIN",
     ["THREE AND A HALF HOURS ON NBC", "23.1 MILLION VIEWERS", "EMMY WINNER: BEST SPECIAL"],
     [("moment", "SKETCH", "CELEBRITY JEOPARDY!", "FERRELL'S TREBEK VS HAMMOND'S CONNERY ONE MORE TIME"),
      ("moment", "HIGHLIGHT", "EDDIE MURPHY RETURNS", "BACK ON THE SHOW FOR THE FIRST TIME SINCE 1984"),
      ("moment", "SKETCH", "WAYNE'S WORLD", "MIKE MYERS AND DANA CARVEY - PARTY ON WAYNE"),
      ("music", [("PAUL MCCARTNEY", "MAYBE I'M AMAZED"), ("MILEY CYRUS", "50 WAYS TO LEAVE YOUR LOVER")]),
      ("music", [("KANYE WEST", "JESUS WALKS MEDLEY", "WITH SIA AND VIC MENSA")]),
      ("music", [("PAUL SIMON", "STILL CRAZY AFTER ALL THESE YEARS")])]),
    (2025, 2, 16, 50, 0, "SNL50", "50TH ANNIVERSARY", "STEVE MARTIN",
     ["THREE HOURS ON NBC AND PEACOCK", "NEARLY 15 MILLION VIEWERS", "EMMY WINNER: LIVE SPECIAL"],
     [("moment", "SKETCH", "BLACK JEOPARDY!", "EDDIE MURPHY AS TRACY MORGAN - AND TOM HANKS BACK AS DOUG"),
      ("moment", "SKETCH", "DOMINGO: VOW RENEWAL", "MARCELLO HERNANDEZ WITH BAD BUNNY AND PEDRO PASCAL"),
      ("moment", "SKETCH", "DEBBIE DOWNER", "RACHEL DRATCH TENDS BAR FOR FALLON - BARRYMORE - DE NIRO"),
      ("music", [("PAUL SIMON + SABRINA CARPENTER", "HOMEWARD BOUND - THE COLD OPEN"), ("ADAM SANDLER", "50 YEARS - HIS SNL TRIBUTE SONG")]),
      ("music", [("MILEY CYRUS + BRITTANY HOWARD", "NOTHING COMPARES 2 U"), ("LIL WAYNE + THE ROOTS", "UPROAR - LOLLIPOP - A MILLI")]),
      ("music", [("PAUL MCCARTNEY", "GOLDEN SLUMBERS - CARRY THAT WEIGHT - THE END")])]),
]

def is_special(e):
    return len(e) == 10

# Episodes and specials that aired on this month/day.
def todays_items(m, d):
    out = todays_episodes(m, d)
    for s in SPECIALS:
        if s[1] == m and s[2] == d:
            out.append(s)
    return out

def special_header(c, e, label):
    bright, dark = era_colors(e[3])
    c.fill("#000000")
    draw_season_bg(c, e[3])
    c.rect(0, 0, 191, 6, fill = dark)
    c.line(0, 7, 191, 7, GOLD)
    right = str(e[1]) + "/" + str(e[2]) + "/" + str(e[0])
    txt(c, e[5], 2, 1, "4x5", GOLD)
    txt(c, right, 190, 1, "4x5", "#FFFFFF", "right")
    lw = tw(c, e[5], "4x5")
    room = 188 - lw - tw(c, right, "4x5") - 8
    t, f = fit(c, label, ["4x5", "picopixel"], room)
    txt(c, t, 2 + lw + 4 + room // 2, 1, f, bright, "center")

# Page 2: the special itself.
def card_special(c, ctx, e):
    special_header(c, e, "SPECIAL")
    txt(c, e[6], 96, 10, "5x7", GOLD, "center")
    t, f = fit(c, "HOSTED BY " + e[7], ["4x5", "picopixel"], 188)
    txt(c, t, 96, 19, f, "#FFFFFF", "center")
    facts = e[8]
    t, f = fit(c, facts[rotation_index(ctx, len(facts), 23)], ["4x5", "picopixel"], 188)
    txt(c, t, 96, 26, f, GRAY, "center")

def card_special_moment(c, e, card):
    _, kicker, name, detail = card
    special_header(c, e, kicker)
    t, f = fit(c, name, ["5x7", "4x5"], 188)
    txt(c, t, 96, 10, f, GOLD, "center")
    lines, f = wrap_fit(c, detail, ["4x5", "picopixel"], 188, 2)
    for k in range(len(lines)):
        txt(c, lines[k], 96, 19 + k * 7, f, "#FFFFFF", "center")

def card_special_music(c, e, card, part, parts):
    special_header(c, e, "MUSIC" if parts == 1 else "MUSIC " + str(part) + "/" + str(parts))
    rows = card[1]
    if len(rows) == 1:
        # One act: room for a long song (two lines) or a note.
        row = rows[0]
        t, f = fit(c, row[0], ["5x7", "4x5", "picopixel"], 188)
        txt(c, t, 96, 10, f, GOLD, "center")
        lines, f = wrap_fit(c, row[1], ["4x5", "picopixel"], 188, 1 if len(row) > 2 else 2)
        for k in range(len(lines)):
            txt(c, lines[k], 96, 19 + k * 7, f, "#FFFFFF", "center")
        if len(row) > 2:
            t, f = fit(c, row[2], ["4x5", "picopixel"], 188)
            txt(c, t, 96, 26, f, GRAY, "center")
        return
    for k in range(len(rows)):
        t, f = fit(c, rows[k][0], ["4x5", "picopixel"], 188)
        txt(c, t, 96, 9 + k * 12, f, GOLD, "center")
        t, f = fit(c, rows[k][1], ["4x5", "picopixel"], 188)
        txt(c, t, 96, 15 + k * 12, f, "#FFFFFF", "center")

# Pages 2-8 of a special night (k = 0..6).
def special_page(c, ctx, e, k):
    if k == 0:
        card_special(c, ctx, e)
        return
    cards = e[9]
    card = cards[k - 1]
    if card[0] == "moment":
        card_special_moment(c, e, card)
        return
    music = [x for x in cards if x[0] == "music"]
    card_special_music(c, e, card, music.index(card) + 1, len(music))

# ----------------------------------------------------------------- pages ----

def episode(c, ctx):
    e = pick_episode(ctx)
    if e == None:
        empty_card(c, ctx, 0)
        return
    if is_special(e):
        special_page(c, ctx, e, 0)
        return
    card_episode(c, e)

def host(c, ctx):
    e = pick_episode(ctx)
    if e == None:
        empty_card(c, ctx, 1)
        return
    if is_special(e):
        special_page(c, ctx, e, 1)
        return
    card_host(c, e)

def season(c, ctx):
    e = pick_episode(ctx)
    if e == None:
        empty_card(c, ctx, 2)
        return
    if is_special(e):
        special_page(c, ctx, e, 2)
        return
    card_season(c, e)

def more_page(c, ctx, k):
    e = pick_episode(ctx)
    if e == None:
        empty_card(c, ctx, 3 + k)
        return
    if is_special(e):
        special_page(c, ctx, e, 3 + k)
        return
    draw_episode_card(c, ctx, e, episode_cards(ctx, e)[k])

def more1(c, ctx):
    more_page(c, ctx, 0)

def more2(c, ctx):
    more_page(c, ctx, 1)

def more3(c, ctx):
    more_page(c, ctx, 2)

def more4(c, ctx):
    more_page(c, ctx, 3)


# ------------------------------------------------------------ title page ----

# Studio-marquee title card: the skyline repeats to both edges, the logo and TODAY IN / HISTORY sit centered, and the kicker
# row carries today's date.
def title(c, ctx):
    phase = (ctx.now.unix // 60) % 3
    sky = ["#05020F", "#070314", "#090419", "#0B051E", "#0E0624", "#11072A", "#140830", "#170936",
           "#1A0A3B", "#1D0B40", "#200C45", "#230D49", "#260E4D", "#290F50", "#2C1053", "#2F1155"]
    for i in range(16):
        c.rect(0, i * 2, 191, i * 2 + 1, fill = sky[i])
    for k in range(27):
        h = scramble(k * 131 + 7)
        c.pixel(3 + h % 186, 3 + (h >> 8) % 12, "#6E6A9A" if (k + phase) % 3 else "#D8D4FF")
    for i in range(10):
        c.line(26 + i, 30, 60 + i * 3, 2, "#241A4A")
        c.line(165 - i, 30, 131 - i * 3, 2, "#241A4A")
    # skyline: the 128-wide strip, repeated out to both edges
    blocks = []
    for shift in [-96, 32, 160]:
        for x0, x1, top in SKYLINE:
            a = x0 + shift
            b = x1 + shift
            if b >= 0 and a <= 191:
                blocks.append((max(a, 0), min(b, 191), top))
    for x0, x1, top in blocks:
        c.rect(x0, top, x1, 30, fill = "#0A0612")
        c.line(x0, top, x1, top, "#2A2046")
    c.line(97, 9, 97, 12, "#2A2046")  # spire
    for k in range(60):
        h = scramble(k * 977 + phase * 13 + ctx.now.unix // 3600)
        bl = blocks[h % len(blocks)]
        wx = bl[0] + (h >> 5) % (bl[1] - bl[0] + 1)
        wy = bl[2] + 2 + (h >> 11) % max(1, 28 - bl[2])
        if wy <= 29:
            c.pixel(wx, wy, "#FFD66B" if k % 4 else "#FFF3C4")
    # marquee bulb border (chase)
    for x in range(0, 192, 3):
        col = "#FFE9A6" if (x // 3 + phase) % 3 == 0 else "#8A5A00"
        c.pixel(x, 0, col)
        c.pixel(191 - x, 31, col)
    for y in range(0, 32, 3):
        col = "#FFE9A6" if (y // 3 + phase) % 3 == 0 else "#8A5A00"
        c.pixel(0, 31 - y, col)
        c.pixel(191, y, col)
    # kicker row: "LIVE FROM NEW YORK... OCTOBER 1" (white + gold), or the
    # date and the no-show alert on an empty day
    months = ["JANUARY", "FEBRUARY", "MARCH", "APRIL", "MAY", "JUNE", "JULY", "AUGUST", "SEPTEMBER", "OCTOBER", "NOVEMBER", "DECEMBER"]
    ty, tm, td = today(ctx)
    date = months[tm - 1] + " " + str(td)
    if len(todays_items(tm, td)) == 0:
        outlined(c, date + " - NO SHOWS ON THIS DATE", 96, 3, "4x5", "#FFD66B", "center", "#120A28")
    else:
        lead = "LIVE FROM NEW YORK..."
        lw = tw(c, lead, "4x5") + 5
        x = 96 - (lw + tw(c, date, "4x5")) // 2
        outlined(c, lead, x, 3, "4x5", "#FFFFFF", "left", "#120A28")
        outlined(c, date, x + lw, 3, "4x5", GOLD, "left", "#120A28")
    # big 3D "SNL": extrusion then face
    for k in range(3, 0, -1):
        txt(c, "SNL", 58 + k, 10 + k, "10x14", "#5A1A8A" if k > 1 else "#9B2FD6")
    txt(c, "SNL", 58, 10, "10x14", GOLD)
    for x in range(58, 91):
        if x % 2 == 0:
            c.pixel(x, 10, "#FFF3C4")
    outlined(c, "TODAY IN", 124, 12, "5x7", "#FFFFFF", "center", "#120A28")
    outlined(c, "HISTORY", 124, 21, "5x7", GOLD, "center", "#120A28")


# ---------------------------------------------------- cast profile cards ----

W2 = 96

def fmt_date(y, m, d):
    return str(m) + "/" + str(d) + "/" + str(y)

# Career strip: seasons 1-51 as 2px cells, theirs lit in the era color.
def draw_timeline(c, name, y):
    p = CAST[name]
    bright, _ = era_colors(p[0])
    ranges = []
    for st in p[9].split("|"):
        ab = st.split("-")
        ranges.append((int(ab[0]), int(ab[1])))
    txt(c, "1975", 1, y - 1, "picopixel", GRAY)
    txt(c, "2026", 190, y - 1, "picopixel", GRAY, "right")
    for s in range(1, 52):
        x = 20 + (s - 1) * 3
        lit = False
        for a, b in ranges:
            if a <= s and s <= b:
                lit = True
        c.rect(x, y, x + 1, y + 2, fill = bright if lit else "#2A2E36")

def card192_profile(c, name):
    p = CAST[name]
    bright, _ = era_colors(p[0])
    c.fill("#000000")
    draw_cast_bg(c, name)
    txt(c, "CAST PROFILE", 1, 1, "4x5", GRAY)
    cr = cast_rank(name)
    if cr > 0:
        tag = "SNN GREATEST CAST #" + str(cr)
        draw_star(c, 190 - tw(c, tag, "4x5") - 7, 1, GOLD)
        txt(c, tag, 190, 1, "4x5", GOLD, "right")
    t, f = fit(c, name, ["6x8", "5x7", "4x5"], 188)
    txt(c, t, W2, 8, f, "#FFFFFF", "center")
    seas = "SEASON " + str(p[0]) if p[0] == p[1] else "SEASONS " + str(p[0]) + "-" + str(p[1])
    if p[3] == 0:
        seas = seas + " (ACTIVE)"
    kind = "REPERTORY"
    if p[11] != "" and p[12] != "":
        kind = "PROMOTED " + p[12][:4]
    elif p[11] != "":
        kind = "FEATURED"
    for cand in ["CLASS OF " + str(p[2]) + "  -  " + seas + "  -  " + kind, "CLASS OF " + str(p[2]) + " - " + seas + " - " + kind, seas + " - " + kind]:
        line, f = fit(c, cand, ["4x5", "picopixel"], 188)
        if not line.endswith(".."):
            break
    txt(c, line, W2, 18, f, bright, "center")
    draw_timeline(c, name, 26)

# Page 3: all-time marks (top 20) when they have any, otherwise who joined
# and left alongside them.
def card192_tenure(c, name):
    rows = record_rows(name)
    if len(rows) > 0:
        card192_records(c, name, rows)
    else:
        card192_classmates(c, name)

# Age on their first show, or -1 when the birth date is too vague.
def join_age(n):
    b = CAST[n][6]
    d = CAST[n][10]
    if b[0] == 0 or b[1] == 0:
        return -1
    return age_on(b, d[0], d[1], d[2])

def record_rows(name):
    p = CAST[name]
    rows = []
    more = len([n for n in CAST if CAST[n][4] > p[4]])
    ties = len([n for n in CAST if CAST[n][4] == p[4]])
    if more < 20:
        if more == 0 and ties == 1:
            rank = "MOST EVER"
        else:
            rank = ("TIED " if ties > 1 else "") + ordinal(more + 1) + " MOST EVER"
        rows.append(str(p[4]) + (" SEASON: " if p[4] == 1 else " SEASONS: ") + rank)
    a = join_age(name)
    if a > 0:
        younger = len([n for n in CAST if join_age(n) > 0 and join_age(n) < a])
        older = len([n for n in CAST if join_age(n) > a])
        if younger < 20:
            rows.append("JOINED AT " + str(a) + ": " + ("YOUNGEST EVER" if younger == 0 else ordinal(younger + 1) + " YOUNGEST EVER"))
        elif older < 20:
            rows.append("JOINED AT " + str(a) + ": " + ("OLDEST EVER" if older == 0 else ordinal(older + 1) + " OLDEST EVER"))
    return rows

def card192_records(c, name, rows):
    bright, _ = era_colors(CAST[name][0])
    profile_header(c, "RECORD BOOK", bright, name)
    y = 15 if len(rows) == 1 else 10
    for r in rows:
        t, f = fit(c, r, ["5x7", "4x5", "picopixel"], 188)
        txt(c, t, 96, y, f, "#FFFFFF", "center")
        y += 11

# Names joined with commas, then "+N" for the ones that don't fit.
def names_line(c, names, maxw):
    shown = []
    for k in range(len(names)):
        rest = len(names) - k - 1
        cand = ", ".join(shown + [names[k]]) + ((" +" + str(rest)) if rest > 0 else "")
        if tw(c, cand, "4x5") > maxw and len(shown) > 0:
            return ", ".join(shown) + " +" + str(len(names) - len(shown))
        shown.append(names[k])
    return ", ".join(shown)

# SNN-ranked names first, then alphabetical.
def by_rank(names):
    return sorted(names, key = lambda n: (cast_rank(n) if cast_rank(n) > 0 else 999, n))

def card192_classmates(c, name):
    p = CAST[name]
    bright, _ = era_colors(p[0])
    profile_header(c, "CAME AND WENT", bright, name)
    joined = by_rank([n for n in CAST if n != name and CAST[n][0] == p[0]])
    rows = [("ARRIVED WITH", joined, "NO ONE - THE ONLY NEWCOMER")]
    if p[3] == 0:
        rows.append(("STILL ON", [], "THE SHOW TODAY"))
    else:
        left = by_rank([n for n in CAST if n != name and CAST[n][3] != 0 and CAST[n][1] == p[1]])
        rows.append(("LEFT WITH", left, "NO ONE ELSE THAT YEAR"))
    for k in range(2):
        label, names, alt = rows[k]
        y = 10 + k * 11
        txt(c, label, 58, y + 1, "4x5", GRAY, "right")
        if len(names) == 0:
            line, f = fit(c, alt, ["5x7", "4x5", "picopixel"], 126)
        else:
            line, f = fit(c, ", ".join(names), ["5x7", "4x5"], 126)
            if line.endswith(".."):
                line = names_line(c, [last_name(n) for n in names], 126)
                f = "4x5"
        txt(c, line, 64, y if FONT_H[f] >= 7 else y + 1, f, "#FFFFFF")

def card192_roles(c, name):
    p = CAST[name]
    bright, _ = era_colors(p[0])
    profile_header(c, "ON THE SHOW", bright, name)
    fl = p[5]
    items = []
    cr = cast_rank(name)
    if cr > 0:
        items.append(("SNN GREATEST CAST: #" + str(cr), GOLD))
    if fl.find("A") >= 0:
        items.append(("WEEKEND UPDATE ANCHOR", GOLD))
    hosted = member_hosted(name)
    if len(hosted) > 0:
        ys = [str(h[0]) for h in hosted]
        if len(hosted) == 1:
            items.append(("RETURNED TO HOST " + ys[0], "#FFFFFF"))
        else:
            line = "HOSTED " + str(len(hosted)) + "X: " + year_list(ys)
            if tw(c, line, "4x5") > 106:
                line = "HOSTED " + str(len(hosted)) + "X: " + ys[0] + "-" + ys[len(ys) - 1]
            items.append((line, "#FFFFFF"))
        if len(hosted) >= 5:
            items.append(("FIVE-TIMERS CLUB", GOLD))
    hr = host_rank(name)
    if hr > 0:
        items.append(("SNN GREATEST HOSTS: #" + str(hr), GOLD))
    if fl.find("W") >= 0:
        items.append(("ALSO A WRITER", FEAT))
    if fl.find("B") >= 0:
        items.append(("GOT A BEST-OF SPECIAL", FEAT))
    if fl.find("M") >= 0:
        items.append(("MIDDLE GROUP 1990-93", FEAT))
    # Right panel: first and last night as cast.
    c.line(112, 10, 112, 30, bright)
    fy, fm, fd = p[10]
    one_night = len(run_episodes(name)) == 1
    if one_night:
        txt(c, "THEIR ONLY SHOW", 151, 12, "picopixel", GRAY, "center")
        txt(c, fmt_date(fy, fm, fd), 151, 19, "4x5", "#FFFFFF", "center")
    else:
        txt(c, "DEBUT", 116, 13, "picopixel", GRAY)
        txt(c, fmt_date(fy, fm, fd), 190, 13, "4x5", "#FFFFFF", "right")
    last = last_episode_as_cast(name)
    if one_night:
        pass
    elif p[3] == 0 or last == None:
        txt(c, "NOW", 116, 22, "picopixel", GRAY)
        txt(c, "IN THE CAST", 190, 22, "4x5", GREEN, "right")
    else:
        txt(c, "FINALE", 116, 22, "picopixel", GRAY)
        txt(c, fmt_date(last[0], last[1], last[2]), 190, 22, "4x5", "#FFFFFF", "right")
    if len(items) == 0:
        eps = run_episodes(name)
        if len(eps) == 1:
            items.append(("ONE NIGHT ONLY", GOLD))
        else:
            hosts = {}
            acts = {}
            for e in eps:
                for h in split_hosts(e[6]):
                    hosts[h] = 1
                for a in MG_ACTS.get(e[5], [e[7]] if e[7] != "" else []):
                    acts[a] = 1
            items.append(("WORKED WITH " + str(len(hosts)) + " HOSTS", "#FFFFFF"))
            items.append(("AND " + str(len(acts)) + " MUSICAL ACTS", GRAY))
    items = items[:4]
    pitch = 6 if len(items) >= 4 else 7
    y0 = 9 + (23 - len(items) * pitch) // 2
    lad = list_ladder(c, [it[0] for it in items], 106)
    for k in range(len(items)):
        t, f = fit_exact(c, items[k][0], lad, 106)
        txt(c, t, 56, y0 + k * pitch, f, items[k][1], "center")

def card192_castmates(c, name, ctx):
    p = CAST[name]
    bright, _ = era_colors(p[0])
    imps = impressions_of(name)
    rows = []
    for r, who, _ in imps:
        rows.append(("#" + str(r), who))
    have = [w for _, w in rows]
    for role in ROLES.get(name, []):
        if role not in have:
            rows.append(("", role))
    if len(rows) == 0:
        rows = [("", r) for r in PLAYED.get(name, [])]
    if len(rows) == 0:
        if roles_kind192(name) == "music":
            card_music_run(c, name)
        elif len(ranked_hosts_in_run(name)) > 0:
            card192_big_hosts(c, name)
        else:
            card_hosted_by(c, name)
        return
    if len(imps) > 0:
        gold_banner(c, "FAMOUS ROLES  (#: SNN TOP 20 IMPRESSIONS)", 0, name)
    else:
        profile_header(c, "FAMOUS ROLES", bright, name)
    counts = ROLE_COUNTS.get(name, {})
    def suffix(who):
        n = counts.get(who, 0)
        return ("  " + str(n) + "X") if n > 0 else ""
    # Two columns (up to six roles) when every role fits whole beside its
    # count; otherwise one full-width column of up to four. Either way SNN
    # impressions stay pinned and the rest rotate each refresh.
    def rotated(limit):
        if len(rows) <= limit:
            return rows
        pinned = [r for r in rows if r[0] != ""]
        rest = [r for r in rows if r[0] == ""]
        start = rotation_index(ctx, len(rest), 13)
        rest = rest[start:] + rest[:start]
        return (pinned + rest)[:limit]
    two = rotated(6)
    fits_two = True
    if len(two) > 3:
        for tag, who in two:
            room = 92 - ((tw(c, tag, "4x5") + 4) if tag != "" else 0) - tw(c, suffix(who), "4x5")
            if tw(c, who, "picopixel") > room:
                fits_two = False
    rows = two if fits_two else rotated(4)
    cols = [rows]
    if len(rows) > 3 and fits_two:
        per = (len(rows) + 1) // 2
        cols = [rows[:per], rows[per:]]
    # One to three roles: the fewer there are, the bigger they get, so a short
    # list still fills the page (one shared size, dropping when a name won't fit).
    if len(rows) <= 3:
        ladders = {1: ["8x12", "6x8", "5x7"], 2: ["6x8", "5x7"], 3: ["5x7"]}
        big = ""
        for f in ladders[len(rows)] + ["5x5", "4x5"]:
            ok = True
            for tag, who in rows:
                if not font_ok(who, f) or (tag != "" and not font_ok(tag, f)):
                    ok = False
                    break
                w = tw(c, who, f) + tw(c, suffix(who), "4x5") + ((tw(c, tag, f) + 4) if tag != "" else 0)
                if w > 188:
                    ok = False
                    break
            if ok:
                big = f
                break
        if big != "":
            h = FONT_H.get(big, 5)
            gap = {1: 0, 2: 4, 3: 1}[len(rows)]
            block = len(rows) * h + (len(rows) - 1) * gap
            y = 9 + (23 - block) // 2
            for tag, who in rows:
                sfx = suffix(who)
                tagw = (tw(c, tag, big) + 4) if tag != "" else 0
                w = tagw + tw(c, who, big) + tw(c, sfx, "4x5")
                x = W2 - w // 2
                if tag != "":
                    txt(c, tag, x, y, big, GOLD)
                txt(c, who, x + tagw, y, big, "#FFFFFF")
                if sfx != "":
                    # the count sits on the name's baseline in the small face
                    txt(c, sfx, x + tagw + tw(c, who, big), y + h - 5, "4x5", GRAY)
                y += h + gap
            return
    widest_suffix = 0
    for _, who in rows:
        widest_suffix = max(widest_suffix, tw(c, suffix(who), "4x5"))
    lad = list_ladder(c, [w for _, w in rows], (72 if len(cols) > 1 else 168) - widest_suffix)
    for ci in range(len(cols)):
        cx = W2 if len(cols) == 1 else (48 if ci == 0 else 144)
        maxw = 188 if len(cols) == 1 else 92
        col = cols[ci]
        pitch = 6 if len(col) >= 4 else 7
        y0 = 9 + (23 - (len(col) * pitch - 1)) // 2
        for k in range(len(col)):
            tag, who = col[k]
            y = y0 + k * pitch
            sfx = suffix(who)
            sw = tw(c, sfx, "4x5") if sfx != "" else 0
            tagw = (tw(c, tag, "4x5") + 4) if tag != "" else 0
            t, f = fit_exact(c, who, lad, maxw - tagw - sw)
            w = tagw + tw(c, t, f) + sw
            x = cx - w // 2
            if tag != "":
                txt(c, tag, x, y, "4x5", GOLD)
            txt(c, t, x + tagw, y, f, "#FFFFFF")
            if sfx != "":
                txt(c, sfx, x + tagw + tw(c, t, f), y, "4x5", GRAY)
    if len(cols) > 1:
        c.line(96, 11, 96, 29, bright)

def card192_legacy(c, name, ctx):
    p = CAST[name]
    ranks = sorted(CAST_TOP.get(name, []))
    if len(ranks) == 0:
        eps = top_episodes_in_run(name)
        if len(eps) > 0:
            card192_top_episodes(c, name, ctx, eps)
        elif roles_kind192(name) != "hosts" and len(ranked_hosts_in_run(name)) > 0:
            card192_big_hosts(c, name)
        elif roles_kind192(name) != "music":
            card_music_run(c, name)
        else:
            card_legacy(c, name, ctx)
        return
    profile_header(c, "SNN TOP 100 SKETCHES", GOLD, name)
    txt(c, str(len(ranks)), 22, 9, "10x14", GOLD, "center")
    txt(c, "SKETCH" if len(ranks) == 1 else "SKETCHES", 22, 25, "4x5", "#FFFFFF", "center")
    c.line(45, 10, 45, 30, GOLD)
    # Two at a time, rotating through all of them.
    start = rotation_index(ctx, len(ranks), 9) if len(ranks) > 2 else 0
    show = sorted([ranks[(start + k) % len(ranks)] for k in range(min(2, len(ranks)))])
    y = 9 if len(show) == 2 else 15
    for r in show:
        sk = None
        for t in TOP_SKETCHES:
            if t[3] == r:
                sk = t
        ep = None
        for e in EPISODES:
            if e[0] == sk[0] and e[1] == sk[1] and e[2] == sk[2]:
                ep = e
        tag = "#" + str(r)
        tagw = tw(c, tag, "4x5")
        title = sk[4].split(" / ")[0]
        maxw = 190 - 51 - tagw - 4
        t, f = fit(c, title, ["4x5", "picopixel"], maxw)
        txt(c, tag, 51, y, "4x5", GOLD)
        if t.endswith(".."):
            # Too long for one line: the title takes the date line too.
            wf = "picopixel" if font_ok(title, "picopixel") else "4x5"
            lines = wrap(c, title, wf, maxw)
            for k in range(min(2, len(lines))):
                lt, lf = fit_exact(c, lines[k], [wf], maxw)
                txt(c, lt, 51 + tagw + 4, y + k * 6, lf, "#FFFFFF")
            y += 12
            continue
        txt(c, t, 51 + tagw + 4, y, f, "#FFFFFF")
        info = fmt_date(sk[0], sk[1], sk[2])
        if ep != None:
            info = "S" + str(ep[3]) + " E" + str(ep[4]) + "  -  " + info
        t, f = fit(c, info, ["picopixel"], 190 - 51 - tagw - 4)
        txt(c, t, 51 + tagw + 4, y + 6, f, GRAY)
        y += 11

# What the roles page (page 5) shows for this person.
def roles_kind192(name):
    if len(impressions_of(name)) > 0 or len(ROLES.get(name, [])) > 0 or len(PLAYED.get(name, [])) > 0:
        return "roles"
    if len(run_episodes(name)) == 1:
        return "music"
    return "hosts"

# SNN top-50 episodes from their run: (rank, episode), best first.
def top_episodes_in_run(name):
    out = []
    for e in run_episodes(name):
        r = episode_rank(e)
        if r > 0:
            out.append((r, e))
    return sorted(out)

# SNN-ranked hosts who hosted during their run: (rank, host), best first.
def ranked_hosts_in_run(name):
    seen = {}
    for e in run_episodes(name):
        for h in split_hosts(e[6]):
            r = host_rank(h)
            if r > 0:
                seen[h] = r
    return sorted([(seen[h], h) for h in seen])

def card192_top_episodes(c, name, ctx, eps):
    profile_header(c, "SNN TOP 50 EPISODES THEY WERE IN", GOLD, name)
    txt(c, str(len(eps)), 22, 9, "10x14", GOLD, "center")
    txt(c, "EPISODE" if len(eps) == 1 else "EPISODES", 22, 25, "4x5", "#FFFFFF", "center")
    c.line(45, 10, 45, 30, GOLD)
    start = rotation_index(ctx, len(eps), 9) if len(eps) > 2 else 0
    show = sorted([eps[(start + k) % len(eps)] for k in range(min(2, len(eps)))])
    y = 9 if len(show) == 2 else 15
    for r, e in show:
        tag = "#" + str(r)
        tagw = tw(c, tag, "4x5")
        t, f = fit_host(c, e, wider(["4x5", "picopixel"]), 190 - 51 - tagw - 4)
        txt(c, tag, 51, y, "4x5", GOLD)
        txt(c, t, 51 + tagw + 4, y, f, "#FFFFFF")
        info = "S" + str(e[3]) + " E" + str(e[4]) + "  -  " + fmt_date(e[0], e[1], e[2])
        txt(c, info, 51 + tagw + 4, y + 6, "picopixel", GRAY)
        y += 11

def card192_big_hosts(c, name):
    p = CAST[name]
    bright, _ = era_colors(p[0])
    profile_header(c, "BIG-NAME HOSTS DURING THEIR RUN", bright, name)
    rows = ranked_hosts_in_run(name)[:6]
    cols = [rows]
    if len(rows) > 3:
        per = (len(rows) + 1) // 2
        cols = [rows[:per], rows[per:]]
    lad = list_ladder(c, [h for _, h in rows], 72 if len(cols) > 1 else 168)
    for ci in range(len(cols)):
        cx = W2 if len(cols) == 1 else (48 if ci == 0 else 144)
        maxw = 188 if len(cols) == 1 else 92
        col = cols[ci]
        y0 = 10 + (22 - (len(col) * 7 - 2)) // 2
        for k in range(len(col)):
            r, h = col[k]
            tag = "#" + str(r)
            tagw = tw(c, tag, "4x5")
            t, f = fit_exact(c, h, lad, maxw - tagw - 4)
            w = tagw + 4 + tw(c, t, f)
            x = cx - w // 2
            txt(c, tag, x, y0 + k * 7, "4x5", GOLD)
            txt(c, t, x + tagw + 4, y0 + k * 7, f, "#FFFFFF")
    if len(cols) > 1:
        c.line(96, 11, 96, 29, bright)

# "LABEL 25": gray label, gold number, centered as one line.
def label_num(c, label, num, cx, y):
    w = tw(c, label, "4x5") + 3 + tw(c, num, "5x7")
    x = cx - w // 2
    txt(c, label, x, y + 1, "4x5", GRAY)
    txt(c, num, x + tw(c, label, "4x5") + 3, y, "5x7", GOLD)

def card192_their_run(c, name):
    p = CAST[name]
    bright, _ = era_colors(p[0])
    profile_header(c, "THEIR RUN", bright, name)
    eps = run_episodes(name)
    txt(c, str(len(eps)), 22, 9, "10x14", GOLD, "center")
    txt(c, "EPISODE" if len(eps) == 1 else "EPISODES", 22, 25, "4x5", "#FFFFFF", "center")
    c.line(45, 10, 45, 30, bright)
    c.line(118, 10, 118, 30, bright)
    # Middle: how old they were when they joined, and when they left.
    b = p[6]
    first = eps[0]
    last = eps[len(eps) - 1]
    a1 = age_on(b, first[0], first[1], first[2])
    if len(eps) == 1:
        label_num(c, "AGE", str(a1), 82, 16)
    else:
        label_num(c, "JOINED AT", str(a1), 82, 11)
        if p[3] == 0:
            label_num(c, "YEARS IN", str(2026 - p[2]), 82, 21)
        else:
            label_num(c, "LEFT AT", str(age_on(b, last[0], last[1], last[2])), 82, 21)
    # Right: the host of their first and last shows.
    if len(eps) == 1:
        txt(c, "THEIR ONLY SHOW", 155, 12, "picopixel", GRAY, "center")
        t, f = fit_host(c, first, wider(["4x5", "picopixel"]), 70)
        txt(c, t, 155, 19, f, "#FFFFFF", "center")
        return
    lad = list_ladder(c, [host_name(first), host_name(last)], 70)
    rows = [("FIRST SHOW HOST", first), ("LATEST SHOW HOST" if p[3] == 0 else "LAST SHOW HOST", last)]
    for k in range(2):
        label, e = rows[k]
        txt(c, label, 155, 9 + k * 12, "picopixel", GRAY, "center")
        t, f = fit_host(c, e, lad, 70)
        txt(c, t, 155, 15 + k * 12, f, "#FFFFFF", "center")

def card192_status(c, name, ctx):
    p = CAST[name]
    bright, _ = era_colors(p[0])
    profile_header(c, "STATUS", bright, name)
    b = p[6]
    age = age_on(b, today(ctx)[0], today(ctx)[1], today(ctx)[2])
    if p[7] != "":
        big, cap = str(p[8]), "DIED AT"
    elif age >= 0:
        big, cap = str(age), "AGE"
    else:
        big, cap = "-", "AGE"
    txt(c, cap, 22, 9, "4x5", GRAY, "center")
    txt(c, big, 22, 16, "10x14", GOLD, "center")
    c.line(45, 10, 45, 30, bright)
    if p[7] != "":
        lines = [("IN MEMORIAM", "#FFFFFF", "6x8"), ("BORN " + born_str(b), bright, "4x5"), ("DIED " + p[7], GRAY, "4x5")]
    elif p[3] == 0:
        lines = [("CURRENT CAST", GREEN, "6x8"), ("SEASON " + str(p[4]) + " WITH THE SHOW", GRAY, "4x5")]
    else:
        gap = today(ctx)[0] - p[3]
        lines = [("SNL ALUM", "#FFFFFF", "6x8"), ("LEFT IN " + str(p[3]) + " (" + str(gap) + " YEARS AGO)", GRAY, "4x5")]
    if b[0] > 0 and p[7] == "":
        lines.append(("BORN " + born_str(b), bright, "4x5"))
    y = 9
    for text, col, f in lines:
        t, f2 = fit(c, text, [f, "4x5", "picopixel"], 140)
        txt(c, t, 118, y, f2, col, "center")
        y += FONT_H[f2] + 1

def empty_card(c, ctx, slot):
    name = pick_member(ctx)
    if slot == 0:
        card192_profile(c, name)
    elif slot == 1:
        card192_tenure(c, name)
    elif slot == 2:
        card192_roles(c, name)
    elif slot == 3:
        card192_castmates(c, name, ctx)
    elif slot == 4:
        card192_legacy(c, name, ctx)
    elif slot == 5:
        card192_their_run(c, name)
    else:
        card192_status(c, name, ctx)
