#centennial-lions
# Centennial Lion pixel art, sampled to the panel's native 64x32 resolution.
# B background blue, C cyan, N navy, D deep navy, W warm white.
_PIXELS = [
"BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBBBBBBBBBBBBBBDDDDDDDDDDBBBBBBBBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBBBBBBBDDDNNDDDDDDDDDDDDDDDBBBBBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBBBBBDDDDDDDBBBBBBBBBBBDDDNNDBBBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBBDDDNDBBBBBBBBBBBBBBBBBBBDDDDDBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBDDDDDBBBBBBDBBDDBBBBBBBBBBBBDDDDBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBDDBBBBBBBBDDDDNNNDDDDDDDDBBBBBBDDDBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBDDBBBDBBBDDNNNNNDWWBNDDDDDDDDBBBBDDDBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBDDBBDNDDDDNNDDDWWWBWDDDDDDDBBBBBBBBDDBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBDDBBDDBBBDDDBWWWBDDWDNDDDDDDDBBBBBBBDDDBBBBBBBBBB",
"BBBBBBBBBBBBBBBDDBBBWWBBCBDNDDNNNDWDDDBBBBDDDDDDBBBBBDDBBBBBBBBB",
"BBBBBBBBBBBBBBDDBBWWWWWWCCBDBBDDDDBNDDDDDBBBBBBBDDDBBBDDBBBBBBBB",
"BBBBBBBBBBBBBBDWBWWWWWWWWWCBBBBDDDNDDDBBBBBBBBBBBBBDDBDDDBBBBBBB",
"BBBBBBBBBBBBBDDDDWWWWWWWWWCBBBBBDNDDDDDDBBBBBBBBBBBBBDDDDDBBBBBB",
"BBBBBBBBBBBBDDBDDDDDWWWWWWWWBBBBBDNDDBBBBBBBBBDDDDBBBBDDDDBBBBBB",
"BBBBBBBBBBBDDWWDBWBWWWWWWWWCBBBBBBNDDBBBBBBBBBBBDDDDDDDDDDDBBBBB",
"BBBBBBBBBBDDWWDWWDBWWWWWWWWWBDNDDDNDBBBBBBBDDDDDDDDDDDDDDDDBBBBB",
"BBBBBBBBBBDWBBWWWDDWWWWWWWWBBBDNNNNDBBBBBBBDDDDDDDDDDDDDDDDDBBBB",
"BBBBBBBBBDDDDWWWDDDDDBBWWWWWBDDNNNDBBBBBDDDDDDDDDDDDBBBBBBBBBBBB",
"BBBBBBBBBBDDDDWDNDWBBBBWWBDWCDNNNDBBBBBBBBDDDBBDDDDDBBBBBBBBBBBB",
"BBBBBBBBBBNDWDDNBBDBBDDDBDDWBNNNNBBBBBBBBBBBBBDDDDDBBBBBBBBBBBBB",
"BBBBBBBBBBBDWWBDBBBBBDDNDDBBDNDDNDBBBDDDDDDDDNNDDBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBDDDBBBBBDNDDDNWDNNBBBDDBBDNNNNNDDDBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBBBBDDDBDNDDNNBDBBBBDNNNNNDBBBBBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBBBDDDWBDDWDNNNDDDDDDNDDBBBBBBBBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBBBDNDDDWWWDNNBDDNNNBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBBBDDBWWWBDDDNBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBBBBDDDBBNNDBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBBBBBBBDDDDBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
"BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB",
]
_COLORS = {
    "B": "#026FB6",
    "C": "#0099DA",
    "N": "#0E112A",
    "D": "#262848",
    "W": "#F5F1E9",
    "K": "#000000",
}
def _draw_lion(c):
    for y, row in enumerate(_PIXELS):
        for x in range(64):
            c.pixel(x, y, _COLORS[row[x]])
def live(c, ctx):
    _draw_lion(c)
def error(c, ctx):
    c.fill("black")
    c.text("IMAGE ERROR", 2, 7, font="5x7", color="red")
    c.text("CHECK APP FILE", 2, 18, font="4x5", color="white")
def empty(c, ctx):
    c.fill("black")
    c.text_center("ALL CLEAR", 16, font="5x7", color="green")
def demo(c, ctx):
    _draw_lion(c)
    c.rect(1, 1, 26, 10, fill="black")
    c.text("DEMO", 3, 2, font="5x7", color="white")
