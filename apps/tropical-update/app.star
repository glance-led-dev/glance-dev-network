# ---------- small helpers ----------

def _s(ctx, key, fallback):
    v = ctx.inputs.get(key, fallback)
    if v == None:
        return fallback
    v = str(v).strip()
    return v if v != "" else fallback

def _h2(n):
    s = "0123456789ABCDEF"
    n = max(0, min(255, int(n)))
    return s[n // 16] + s[n % 16]

def _rgb(h):
    return int(h[1:3], 16), int(h[3:5], 16), int(h[5:7], 16)

def mix(a, b, t):
    ar, ag, ab = _rgb(a)
    br, bg, bb = _rgb(b)
    return "#" + _h2(ar + (br - ar) * t) + _h2(ag + (bg - ag) * t) + _h2(ab + (bb - ab) * t)

def luma(h):
    r, g, b = _rgb(h)
    return (r * 299 + g * 587 + b * 114) // 1000

def to_float(t):
    t = t.strip()
    ok = len(t) > 0
    for ch in t.elems():
        if not (ch.isdigit() or ch in ".-+"):
            ok = False
    return float(t) if ok and t not in ["-", ".", "+"] else None

def digits_in(t):
    out = ""
    for ch in t.elems():
        if ch.isdigit():
            out += ch
    return out

def first_fit(c, options, font, maxw):
    # The first wording that fits; the last one if none do. Text is never
    # cut off - pages offer shorter wordings instead.
    for t in options:
        if c.text_width(t, font) <= maxw:
            return t
    return options[-1]

def fit_font(c, text, fonts, maxw):
    for f in fonts:
        if c.text_width(text, f) <= maxw:
            return f, text
    return fonts[-1], text

def cat_index(kt):
    for i in range(len(CAT_KT)):
        if kt < CAT_KT[i]:
            return i
    return 6

def kt_to_mph(kt):
    # NHC rounds mph to the nearest 5.
    return int(kt * 1.15078 / 5.0 + 0.5) * 5

# ---------- time ----------

DOW = ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"]
MON = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"]

def days_from_civil(y, m, d):
    yy = (y - 1) if m <= 2 else y
    era = (yy // 400) if yy >= 0 else ((yy - 399) // 400)
    yoe = yy - era * 400
    mm = (m + 9) if m <= 2 else (m - 3)
    doy = (153 * mm + 2) // 5 + d - 1
    doe = yoe * 365 + yoe // 4 - yoe // 100 + doy
    return era * 146097 + doe - 719468

def civil(days):
    z = days + 719468
    era = (z if z >= 0 else z - 146096) // 146097
    doe = z - era * 146097
    yoe = (doe - doe // 1460 + doe // 36524 - doe // 146096) // 365
    y = yoe + era * 400
    doy = doe - (365 * yoe + yoe // 4 - yoe // 100)
    mp = (5 * doy + 2) // 153
    d = doy - (153 * mp + 2) // 5 + 1
    m = mp + 3 if mp < 10 else mp - 9
    return (y + 1 if m <= 2 else y), m, d

def iso_epoch(iso):
    if iso == None or len(iso) < 16:
        return None
    return days_from_civil(int(iso[0:4]), int(iso[5:7]), int(iso[8:10])) * 86400 + int(iso[11:13]) * 3600 + int(iso[14:16]) * 60

def us_dst(unix):
    # US rule: second Sunday of March to first Sunday of November, 2 AM.
    y, _, _ = civil(unix // 86400)
    mar1 = days_from_civil(y, 3, 1)
    start = mar1 + (6 - (mar1 + 3) % 7) % 7 + 7
    nov1 = days_from_civil(y, 11, 1)
    end = nov1 + (6 - (nov1 + 3) % 7) % 7
    d = unix // 86400
    return d >= start and d < end

def zone_for(lat, lon, basin):
    # Clock for forecast labels: the location's zone by longitude, or
    # Eastern for the Atlantic and Pacific for the East Pacific. South of
    # the US there's no daylight time (Mexico dropped it in 2022), and
    # Puerto Rico and the Virgin Islands keep Atlantic time.
    if lon == None:
        lat, lon = (26.0, -80.0) if basin == "al" else (34.0, -118.0)
    if lat < 24.4 and lon > -68.5:
        return -4, "AST", "AST"
    if lat < 24.4 and lon > -154:
        z = zone_for(30.0, lon, basin)
        return z[0], z[1], z[1]
    if lon < -154:
        return -10, "HST", "HST"
    if lon < -114.5:
        return -8, "PST", "PDT"
    if lon < -101:
        return -7, "MST", "MDT"
    if lon < -85.5:
        return -6, "CST", "CDT"
    return -5, "EST", "EDT"

EASTERN = (-5, "EST", "EDT")

def zone_abbr(unix, zone):
    off, std, dst = zone
    return dst if us_dst(unix) and std != dst else std

def local_offset(unix, zone):
    # Seconds to add to UTC for the zone's local time at that moment.
    off, std, dst = zone
    d = us_dst(unix) and std != dst
    return (off + (1 if d else 0)) * 3600

def local_label(unix, zone, with_time = True):
    off, std, dst = zone
    d = us_dst(unix) and std != dst
    t = unix + (off + (1 if d else 0)) * 3600
    days = t // 86400
    secs = t % 86400
    h = secs // 3600
    dow = DOW[(days + 3) % 7]
    if not with_time:
        return dow
    ampm = "AM" if h < 12 else "PM"
    h12 = h % 12
    if h12 == 0:
        h12 = 12
    return dow + " " + str(h12) + ampm

# ---------- geography ----------

def rad(d):
    return d * 3.141592653589793 / 180.0

def dist_nm(lat1, lon1, lat2, lon2):
    p1 = rad(lat1)
    p2 = rad(lat2)
    a = math.sin((p2 - p1) / 2) * math.sin((p2 - p1) / 2) + math.cos(p1) * math.cos(p2) * math.sin(rad(lon2 - lon1) / 2) * math.sin(rad(lon2 - lon1) / 2)
    return 3440.065 * 2 * math.atan2(math.sqrt(a), math.sqrt(max(0.0, 1 - a)))

def bearing(lat1, lon1, lat2, lon2):
    p1 = rad(lat1)
    p2 = rad(lat2)
    dl = rad(lon2 - lon1)
    y = math.sin(dl) * math.cos(p2)
    x = math.cos(p1) * math.sin(p2) - math.sin(p1) * math.cos(p2) * math.cos(dl)
    return (math.atan2(y, x) * 180.0 / 3.141592653589793 + 360.0) % 360.0

COMPASS = ["N", "NNE", "NE", "ENE", "E", "ESE", "SE", "SSE", "S", "SSW", "SW", "WSW", "W", "WNW", "NW", "NNW"]

def compass(deg):
    return COMPASS[int((deg + 11.25) / 22.5) % 16]

LONG_WORDS = {"N": "NORTH", "NNE": "NORTH-NORTHEAST", "NE": "NORTHEAST", "ENE": "EAST-NORTHEAST", "E": "EAST",
              "ESE": "EAST-SOUTHEAST", "SE": "SOUTHEAST", "SSE": "SOUTH-SOUTHEAST", "S": "SOUTH",
              "SSW": "SOUTH-SOUTHWEST", "SW": "SOUTHWEST", "WSW": "WEST-SOUTHWEST", "W": "WEST",
              "WNW": "WEST-NORTHWEST", "NW": "NORTHWEST", "NNW": "NORTH-NORTHWEST",
              "MON": "MONDAY", "TUE": "TUESDAY", "WED": "WEDNESDAY", "THU": "THURSDAY", "FRI": "FRIDAY",
              "SAT": "SATURDAY", "SUN": "SUNDAY", "MI": "MILES", "TS": "TROPICAL STORM", "HURR": "HURRICANE"}

def spell_out(t):
    # Directions, days, miles and storm words in full, "8PM" as "8 PM".
    out = []
    for wd in t.split(" "):
        if wd.endswith("AM") or wd.endswith("PM"):
            if wd[:-2].isdigit():
                wd = wd[:-2] + " " + wd[-2:]
        out.append(LONG_WORDS.get(wd, wd))
    return " ".join(out)

def spelled(c, t, font, maxw):
    # The spelled-out wording when it fits, else as written.
    return first_fit(c, [spell_out(t), t], font, maxw)

def parse_coord(tok):
    # "23.7N" / "90.2W" -> signed degrees.
    tok = tok.strip()
    if len(tok) < 2:
        return None
    v = to_float(tok[:-1])
    if v == None:
        return None
    h = tok[-1]
    if h in "SW":
        return -v
    if h in "NE":
        return v
    return None

# ---------- text from NHC pages ----------

def strip_tags(t):
    out = ""
    i = 0
    for _ in range(len(t)):
        if i >= len(t):
            break
        j = t.find("<", i)
        if j < 0:
            out += t[i:]
            break
        out += t[i:j]
        k = t.find(">", j)
        if k < 0:
            break
        i = k + 1
    return out.replace("&amp;", "&").replace("&lt;", "<").replace("&gt;", ">").replace("&#39;", "'").replace("&quot;", "\"")

def pre_text(body):
    i = body.find("<pre>")
    j = body.find("</pre>", i)
    if i < 0 or j < 0:
        return ""
    return strip_tags(body[i + 5:j])

def get(url, ttl, params = None, headers = None):
    h = {"User-Agent": USER_AGENT}
    if headers != None:
        h.update(headers)
    if params != None:
        return http.get(url, params = params, headers = h, ttl_seconds = ttl)
    return http.get(url, headers = h, ttl_seconds = ttl)

# ---------- active storms ----------

def basin_of(storm_id):
    b = storm_id[:2].lower()
    return "al" if b == "al" else "ep"

def fetch_storms():
    r = get(NHC + "CurrentStorms.json", 600)
    if r["status_code"] != 200 or r["json"] == None:
        return None
    out = []
    for s in r["json"].get("activeStorms", []):
        lat = s.get("latitudeNumeric")
        lon = s.get("longitudeNumeric")
        if lat == None or lon == None:
            continue
        kt = to_float(str(s.get("intensity", "0"))) or 0.0
        out.append({
            "id": str(s.get("id", "")),
            "basin": basin_of(str(s.get("id", "al"))),
            "name": str(s.get("name", "")).upper(),
            "cls": str(s.get("classification", "")).upper(),
            "kt": int(kt),
            "mb": str(s.get("pressure", "")),
            "lat": float(lat),
            "lon": float(lon),
            "dir": s.get("movementDir"),
            "speed_kt": s.get("movementSpeed"),
            "updated": s.get("lastUpdate"),
            "tcm": (s.get("forecastAdvisory") or {}).get("url"),
            "tcm_time": (s.get("forecastAdvisory") or {}).get("issuance"),
            "tcp": (s.get("publicAdvisory") or {}).get("url"),
            "adv": (s.get("publicAdvisory") or {}).get("advNum", ""),
            "tcp_time": (s.get("publicAdvisory") or {}).get("issuance"),
        })
    return out

def storm_title(s):
    cls = CLASS_NAMES.get(s["cls"], "STORM")
    if s["cls"] == "PTC":
        return "POTENTIAL TC " + s["name"]
    return cls + " " + s["name"]

# ---------- forecast advisory (track) ----------

def zulu_epoch(tok, ref_unix):
    # "09/1200Z" -> epoch, in the month of ref_unix (or the next one).
    tok = tok.strip()
    if len(tok) < 8 or tok[2] != "/":
        return None
    day = int(tok[0:2])
    hh = int(tok[3:5])
    mm = int(tok[5:7])
    y, m, d = civil(ref_unix // 86400)
    if day < d - 15:
        m += 1
        if m > 12:
            m = 1
            y += 1
    elif day > d + 15:
        m -= 1
        if m < 1:
            m = 12
            y -= 1
    return days_from_civil(y, m, day) * 86400 + hh * 3600 + mm * 60

def parse_track(text, ref_unix):
    # Current position, then each FORECAST/OUTLOOK VALID point with its max
    # wind and any INLAND/POST-TROP flag. Stops at DISSIPATED.
    pts = []
    synoptic = None
    gust = None
    radius34 = 0
    for line in text.split("\n"):
        u = line.strip().upper()
        if "CENTER LOCATED NEAR" in u and " AT " in u and not pts and "REPEAT" not in u:
            parts = u.split("NEAR")[1].split()
            if len(parts) >= 4:
                la = parse_coord(parts[0])
                lo = parse_coord(parts[1])
                t = zulu_epoch(parts[3], ref_unix)
                if la != None and lo != None and t != None:
                    pts.append({"lat": la, "lon": lo, "t": t, "kt": None, "flag": ""})
        elif u.startswith("AT ") and "CENTER WAS LOCATED NEAR" in u:
            synoptic = zulu_epoch(u.split()[1], ref_unix)
        elif u.startswith("MAX SUSTAINED WINDS") and pts and pts[0]["kt"] == None:
            nums = u.replace("KT", " ").split()
            vals = [int(n) for n in nums if n.isdigit()]
            if vals:
                pts[0]["kt"] = vals[0]
            if len(vals) > 1:
                gust = vals[1]
        elif u.startswith("34 KT") and len(pts) == 1 and radius34 == 0:
            for tok in u[5:].replace(".", " ").split():
                n = digits_in(tok)
                if n != "" and int(n) > radius34:
                    radius34 = int(n)
        elif u.startswith("FORECAST VALID") or u.startswith("OUTLOOK VALID"):
            parts = u.split()
            if "DISSIPATED" in u and len(parts) < 5:
                break
            if len(parts) >= 5:
                la = parse_coord(parts[3])
                lo_tok = parts[4].split("...")[0]
                lo = parse_coord(lo_tok)
                t = zulu_epoch(parts[2], ref_unix)
                flag = ""
                if "..." in u:
                    flag = u.split("...", 1)[1].strip()
                if la != None and lo != None and t != None:
                    pts.append({"lat": la, "lon": lo, "t": t, "kt": None, "flag": flag})
        elif u.startswith("MAX WIND") and len(pts) > 1 and pts[-1]["kt"] == None:
            nums = [int(n) for n in u.replace("KT", " ").replace(".", " ").split() if n.isdigit()]
            if nums:
                pts[-1]["kt"] = nums[0]
    if not pts:
        return None
    base = synoptic if synoptic != None else pts[0]["t"]
    for i in range(len(pts)):
        p = pts[i]
        p["hr"] = (p["t"] - base) // 3600 if i > 0 else 0
        if p["kt"] == None:
            p["kt"] = 0
    return {"pts": pts, "gust": gust, "r34": radius34}

def fetch_track(s):
    if s["tcm"] == None:
        return None
    # Keyed by the advisory's issue time, so a new advisory is fetched as
    # soon as the storm list shows it.
    r = get(s["tcm"], 1800, params = {"issued": str(s["tcm_time"])})
    if r["status_code"] != 200:
        return None
    ref = iso_epoch(s["tcm_time"]) or iso_epoch(s["updated"])
    if ref == None:
        return None
    return parse_track(pre_text(r["body"]), ref)

# ---------- public advisory ----------

def parse_public(text):
    out = {"headlines": [], "about": [], "mph": None, "move": "", "mb": "", "inches": "", "warnings": [], "none": False}
    lines = [l.rstrip() for l in text.split("\n")]
    # Headlines: "...TEXT..." blocks before the SUMMARY section.
    buf = ""
    for l in lines:
        u = l.strip().upper()
        if u.startswith("SUMMARY OF"):
            break
        if u.startswith("...") or buf != "":
            buf = (buf + " " + u).strip()
            if buf.endswith("...") and len(buf) > 6:
                out["headlines"].append(buf.strip(".").strip())
                buf = ""
    cur = None
    for l in lines:
        u = l.strip().upper()
        if u.startswith("ABOUT ") and " MI" in u:
            # "ABOUT 185 MI...300 KM N OF PROGRESO MEXICO"
            mi = u[6:].split(" MI")[0].strip()
            rest = u.split("KM ", 1)[1] if "KM " in u else ""
            if mi.isdigit() and rest != "":
                out["about"].append(mi + " MI " + rest.strip())
        elif u.startswith("MAXIMUM SUSTAINED WINDS..."):
            n = u.split("...")[1].split(" MPH")[0].strip()
            if n.isdigit():
                out["mph"] = int(n)
        elif u.startswith("PRESENT MOVEMENT..."):
            m = u.split("...")[1]
            if "STATIONARY" in m:
                out["move"] = "STATIONARY"
            elif " OR " in m and " AT " in m:
                out["move"] = m.split(" OR ")[0].strip() + " AT " + m.split(" AT ")[1].strip()
        elif u.startswith("MINIMUM CENTRAL PRESSURE..."):
            parts = u.split("...")
            out["mb"] = parts[1].replace("MB", "").strip() if len(parts) > 1 else ""
            out["inches"] = parts[2].replace("INCHES", "").strip() if len(parts) > 2 else ""
        elif "NO COASTAL WATCHES OR WARNINGS IN EFFECT" in u:
            out["none"] = True
        if u.endswith("IS IN EFFECT FOR...") or u.endswith("ARE IN EFFECT FOR..."):
            cur = None
            for rank in range(len(ADVISORY_WARNINGS)):
                key, label, col = ADVISORY_WARNINGS[rank]
                if u.startswith(key):
                    cur = {"label": label, "color": col, "areas": [], "rank": rank}
                    out["warnings"].append(cur)
        elif cur != None and u.startswith("*"):
            cur["areas"].append(u[1:].strip())
        elif cur != None and u == "":
            cur = None
    out["warnings"] = sorted(out["warnings"], key = lambda w: w["rank"])
    # Hazards and wind field, from the running text (joined into one line
    # so phrases split across lines still match).
    flat = " ".join([l.strip().upper() for l in lines])
    out["hu_miles"] = number_after(flat, "HURRICANE-FORCE WINDS EXTEND OUTWARD UP TO ")
    out["ts_miles"] = number_after(flat, "TROPICAL-STORM-FORCE WINDS EXTEND OUTWARD UP TO ")
    out["surge_ft"] = None
    out["surge"] = []
    for l in lines:
        u = l.strip().upper()
        if u.endswith(" FT") and "..." in u:
            top = digits_in(u.split("...")[-1].split("-")[-1])
            if top != "" and (out["surge_ft"] == None or int(top) > out["surge_ft"]):
                out["surge_ft"] = int(top)
            out["surge"].append((u.rsplit("...", 1)[0].strip(), u.rsplit("...", 1)[1].strip()))
    out["rain_in"] = None
    k = flat.find("RAINFALL:")
    if k >= 0:
        seg = flat[k:k + 1500]
        for marker in ["UP TO ", " TO "]:
            i = 0
            for _ in range(40):
                i = seg.find(marker, i)
                if i < 0:
                    break
                n = number_after(seg[i:], marker)
                if n != None and seg[i + len(marker) + len(str(n)):].startswith(" INCHES") and (out["rain_in"] == None or n > out["rain_in"]):
                    out["rain_in"] = n
                i += len(marker)
    return out

def number_after(text, marker):
    i = text.find(marker)
    if i < 0:
        return None
    n = ""
    for ch in text[i + len(marker):i + len(marker) + 6].elems():
        if ch.isdigit():
            n += ch
        elif n != "":
            break
    return int(n) if n != "" else None

def fetch_public(s):
    if s["tcp"] == None:
        return None
    r = get(s["tcp"], 1800, params = {"issued": str(s["tcp_time"])})
    if r["status_code"] != 200:
        return None
    pub = parse_public(pre_text(r["body"]))
    pub["time"] = iso_epoch(s["tcp_time"])
    pub["update"] = None
    if s.get("tcu_ok"):
        upd = fetch_update(s)
        if upd != None and (pub["time"] == None or upd["time"] > pub["time"]):
            merge_update(pub, upd)
    return pub

# ---------- tropical cyclone update ----------

def needs_update(s):
    # The storm list moved on since the public advisory: NHC has posted an
    # hourly Tropical Cyclone Update (position, winds, headlines) in between.
    u = iso_epoch(s.get("updated") or "")
    t = iso_epoch(s.get("tcp_time") or "")
    return s.get("tcp") != None and u != None and t != None and u > t

def fetch_update(s):
    # The TCU sits next to the public advisory (TCP -> TCU). NHC leaves the
    # last one up after the next advisory, so its own time decides whether
    # it's newer.
    r = get(s["tcp"].replace("TCP", "TCU"), 1800, params = {"issued": str(s["updated"])})
    if r["status_code"] != 200:
        return None
    text = pre_text(r["body"])
    if s["id"].upper() not in text.upper():
        return None
    t = None
    for l in text.split("\n")[:6]:
        p = l.strip().split(" ")
        if len(p) == 3 and p[1] == "KNHC" and len(p[2]) == 6 and p[2].isdigit():
            t = zulu_epoch(p[2][0:2] + "/" + p[2][2:6] + "Z", iso_epoch(s["updated"]))
    if t == None:
        return None
    # The summary's "...1700 UTC..." is the time NHC labels it with (the
    # header stamp is a few minutes earlier).
    for l in text.split("\n"):
        u = l.strip().upper()
        if u.startswith("SUMMARY OF") and " UTC" in u:
            hhmm = u.split(" UTC")[0].split("...")[-1].strip()
            if len(hhmm) == 4 and hhmm.isdigit():
                day = civil(t // 86400)
                st = days_from_civil(day[0], day[1], day[2]) * 86400 + int(hhmm[0:2]) * 3600 + int(hhmm[2:4]) * 60
                if st < t - 43200:
                    st += 86400
                t = st
    upd = parse_public(text)
    upd["time"] = t
    return upd

def merge_update(pub, upd):
    # Newer headlines, distances, winds, movement and pressure; the
    # watches, warnings, surge and rain stay from the advisory.
    hl = [h for h in upd["headlines"] if not h.endswith("POSITION UPDATE") and not h.endswith("INFORMATION")]
    if hl:
        pub["headlines"] = hl
    for k in ["about", "mph", "move", "mb", "inches"]:
        if upd[k]:
            pub[k] = upd[k]
    pub["time"] = upd["time"]
    pub["update"] = upd["time"]

# ---------- wind speed probabilities ----------

def fetch_odds(s):
    # Each listed place's 5-day chance of tropical-storm-force (34 kt) and
    # hurricane-force (64 kt) winds, from NHC's wind speed probabilities.
    if s["tcp"] == None:
        return None
    r = get(s["tcp"].replace("TCP", "PWS"), 1800, params = {"issued": str(s["tcp_time"])})
    if r["status_code"] != 200:
        return None
    rows = {}
    order = []
    for l in pre_text(r["body"]).split("\n"):
        if len(l) < 20 or l[15:17] not in ["34", "64"]:
            continue
        name = l[:15].strip()
        if name == "" or len([ch for ch in name.elems() if ch.isdigit()]) > 0:
            continue
        cum = l.rstrip().split("(")[-1].replace(")", "").strip()
        pct = int(cum) if cum.isdigit() else 0
        if name not in rows:
            rows[name] = [0, 0]
            order.append(name)
        rows[name][0 if l[15:17] == "34" else 1] = pct
    return [(n, rows[n][0], rows[n][1]) for n in order]

# ---------- best track (the storm so far) ----------

def fetch_history(s):
    # NHC's working best track: every 6-hour position since the system
    # was first tracked, with its wind and stage.
    r = get("https://ftp.nhc.noaa.gov/atcf/btk/b" + s["id"].lower() + ".dat", 3600)
    if r["status_code"] != 200:
        return None
    pts = []
    first = {}
    for l in r["body"].split("\n"):
        p = [x.strip() for x in l.split(",")]
        if len(p) < 11 or p[4] != "BEST" or len(p[2]) < 10:
            continue
        t = days_from_civil(int(p[2][0:4]), int(p[2][4:6]), int(p[2][6:8])) * 86400 + int(p[2][8:10]) * 3600
        la = int(p[6][:-1]) / 10.0 * (1 if p[6].endswith("N") else -1)
        lo = int(p[7][:-1]) / 10.0 * (-1 if p[7].endswith("W") else 1)
        kt = int(p[8]) if p[8].isdigit() else 0
        if not pts or pts[-1][0] != t:
            pts.append((t, la, lo, kt, p[10]))
        for st in ["TD", "TS", "HU"]:
            if p[10] == st and st not in first:
                first[st] = t
    return {"pts": pts, "first": first} if pts else None

# ---------- outlook ----------

def parse_outlook(body):
    i = body.find("<![CDATA[")
    j = body.find("]]>", i)
    if i < 0 or j < 0:
        return []
    lines = [l.strip() for l in body[i + 9:j].replace("<br />", "\n").replace("<br/>", "\n").split("\n")]
    areas = []
    cur = None
    for k in range(len(lines)):
        l = lines[k]
        u = l.upper()
        prev_blank = k == 0 or lines[k - 1] == ""
        if prev_blank and l.endswith(":") and len(l) < 60 and not u.startswith("ACTIVE SYSTEMS") and not u.startswith("FOR THE "):
            cur = {"name": u[:-1].strip(), "d2": None, "d7": None, "l2": "", "l7": ""}
            areas.append(cur)
        elif cur != None and u.startswith("* FORMATION CHANCE THROUGH"):
            pct = digits_in(u.split("...")[-1])
            lvl = u.split("...")[1].strip() if len(u.split("...")) > 2 else ""
            if "48 HOURS" in u:
                cur["d2"] = int(pct) if pct != "" else None
                cur["l2"] = lvl
            elif "7 DAYS" in u:
                cur["d7"] = int(pct) if pct != "" else None
                cur["l7"] = lvl
    return [a for a in areas if a["d7"] != None]

def fetch_outlook(basin):
    r = get(NHC + "xml/TWO" + ("AT" if basin == "al" else "EP") + ".xml", 1800)
    if r["status_code"] != 200:
        return None
    return parse_outlook(r["body"])

# ---------- season (Wikipedia summary) ----------

def fetch_season(basin, year):
    title = str(year) + ("_Atlantic_hurricane_season" if basin == "al" else "_Pacific_hurricane_season")
    r = get("https://en.wikipedia.org/w/index.php", 21600, params = {"title": title, "action": "raw"})
    if r["status_code"] != 200:
        return None
    out = {}
    # The names section marks each name active or unused, so the first
    # unused one is the next name (the storm count includes Central
    # Pacific storms, which use a separate list).
    k = r["body"].find("tcname unused|")
    if k >= 0:
        nm = r["body"][k + 14:k + 60].split("}")[0].split("]")[0]
        out["next"] = nm.split("|")[-1].replace("[", "").strip().upper()
    for line in r["body"].split("\n")[:80]:
        l = line.strip()
        if not l.startswith("|") or "=" not in l:
            continue
        k = l[1:].split("=", 1)[0].strip()
        v = l.split("=", 1)[1].strip()
        if k in ["Total storms", "Total hurricanes", "Total intense", "Total depressions"]:
            n = digits_in(v.split("<")[0].split("(")[0])
            if n != "":
                out[k] = int(n)
        elif k == "Strongest storm name":
            v = v.split("<")[0]
            if "|" in v:
                v = v.split("|")[-1]
            out[k] = v.replace("[", "").replace("]", "").strip().upper()
    return out

# ---------- location ----------

def geocode(text):
    # A 5-digit US zip code (a ZIP+4 uses its first five), Puerto Rico and
    # the Virgin Islands included. OpenStreetMap answers even an unknown zip
    # with a cacheable empty list, so a typo can't refetch on every page.
    t = text.strip()[:5]
    if len(t) != 5 or not t.isdigit():
        return None
    r = get("https://nominatim.openstreetmap.org/search", 2592000,
            params = {"postalcode": t, "countrycodes": "us,pr,vi", "format": "json", "limit": "1", "addressdetails": "1"})
    if r["status_code"] != 200 or r["json"] == None or len(r["json"]) == 0:
        return None
    p = r["json"][0]
    a = p.get("address", {})
    place = a.get("city") or a.get("town") or a.get("village") or a.get("hamlet") or a.get("county") or t
    state = str(a.get("ISO3166-2-lvl4", "")).split("-")[-1]
    return {"lat": float(p["lat"]), "lon": float(p["lon"]), "label": (str(place) + " " + state).strip().upper()}

def fetch_alerts(loc):
    r = get("https://api.weather.gov/alerts/active", 900, params = {"point": str(int(loc["lat"] * 10000) / 10000.0) + "," + str(int(loc["lon"] * 10000) / 10000.0)},
            headers = {"Accept": "application/geo+json"})
    if r["status_code"] != 200 or r["json"] == None:
        return None
    seen = {}
    for f in r["json"].get("features", []):
        seen[str(f.get("properties", {}).get("event", ""))] = True
    return [(label, col) for ev, label, col in ALERTS if seen.get(ev)]


# ---------- the shared picture: storms, featured storm, location ----------

def basin_setting(ctx):
    b = _s(ctx, "basin", "Atlantic")
    if b == "East Pacific":
        return ["ep"]
    if b == "Both":
        return ["al", "ep"]
    return ["al"]

def world(ctx):
    # Everything the pages share. Each piece is cached by http.get, so
    # pages rendered one at a time don't refetch.
    basins = basin_setting(ctx)
    loc_text = _s(ctx, "zip", "")
    loc = geocode(loc_text) if loc_text != "" else None
    storms = fetch_storms()
    mine = [s for s in (storms or []) if s["basin"] in basins]
    featured = None
    # Featured storm: closest to the location, else to the chosen region,
    # else the strongest.
    ref = loc
    region = REGIONS.get(_s(ctx, "region", "Follow the storm"))
    if ref == None and region != None:
        ref = {"lat": region[0], "lon": region[1]}
    if mine:
        if ref != None:
            best = None
            for s in mine:
                d = dist_nm(ref["lat"], ref["lon"], s["lat"], s["lon"])
                if best == None or d < best:
                    best = d
                    featured = s
        else:
            featured = mine[0]
            for s in mine:
                if s["kt"] > featured["kt"]:
                    featured = s
    w = {"basins": basins, "loc_text": loc_text, "loc": loc, "storms": storms, "mine": mine, "featured": featured}
    if featured != None and needs_update(featured) and budget_used(w) < REQUEST_LIMIT:
        featured["tcu_ok"] = True
    return w

def season_basin(ctx, w):
    if w["featured"] != None:
        return w["featured"]["basin"]
    if len(w["basins"]) == 1:
        return w["basins"][0]
    return w["basins"][(ctx.now.unix // 3600) % 2]

def basin_name(b):
    return "ATLANTIC" if b == "al" else "EAST PACIFIC"

# ---------- cone ----------

def cone_radius(hr, basin):
    table = CONE_ATL if basin == "al" else CONE_EP
    if hr <= 0:
        return 0.0
    for i in range(1, len(CONE_HOURS)):
        if hr <= CONE_HOURS[i]:
            h0 = CONE_HOURS[i - 1]
            h1 = CONE_HOURS[i]
            return table[i - 1] + (table[i] - table[i - 1]) * (hr - h0) / float(h1 - h0)
    return float(table[-1])

def track_samples(track, steps = 8):
    # Points along the forecast track (center, hour, cone radius) used for
    # the cone and closest-approach checks.
    out = []
    pts = track["pts"]
    for i in range(len(pts) - 1):
        a = pts[i]
        b = pts[i + 1]
        for k in range(steps):
            f = k / float(steps)
            out.append((a["lat"] + (b["lat"] - a["lat"]) * f, a["lon"] + (b["lon"] - a["lon"]) * f,
                        a["hr"] + (b["hr"] - a["hr"]) * f, a["t"] + int((b["t"] - a["t"]) * f)))
    last = pts[-1]
    out.append((last["lat"], last["lon"], last["hr"], last["t"]))
    return out

def cone_check(track, basin, loc):
    # First forecast hour the location falls inside the cone, and the
    # closest approach of the center.
    first_in = None
    best = None
    for lat, lon, hr, t in track_samples(track):
        d = dist_nm(loc["lat"], loc["lon"], lat, lon)
        if first_in == None and d <= cone_radius(hr, basin):
            first_in = t
        if best == None or d < best[0]:
            best = (d, t, lat, lon)
    return first_in, best

# ---------- map ----------

OCEAN_TOP = "#03122E"
OCEAN_BOT = "#0A2A5A"
LAND_COL = "#2F5A2A"
LAND_EDGE = "#4E8A3C"
BORDER = "#000000"
CONE3 = "#F4F4F4"
CONE5 = "#BBBBBB"

def is_land(lon, lat):
    row = int((LAND_LAT1 - lat) / LAND_RES)
    col = int((lon - LAND_LON0) / LAND_RES)
    if row < 0 or row >= LAND_H or col < 0 or col >= LAND_W:
        return False
    r = LAND[row]
    for i in range(0, len(r), 2):
        if col < r[i]:
            return False
        if col <= r[i + 1]:
            return True
    return False

def make_view(x0, x1, lat_c, lon_c, deg_per_px):
    # Equal-distance pixels: longitude stretched by 1/cos(latitude).
    k = math.cos(rad(lat_c))
    return {"x0": x0, "x1": x1, "lat_top": lat_c + 16 * deg_per_px, "lat_s": deg_per_px,
            "lon_left": lon_c - (x1 - x0 + 1) / 2.0 * deg_per_px / k, "lon_s": deg_per_px / k}

def px(v, lat, lon):
    return int(v["x0"] + (lon - v["lon_left"]) / v["lon_s"]), int((v["lat_top"] - lat) / v["lat_s"])

def fit_view(x0, x1, points, pad_deg):
    lats = [p[0] for p in points]
    lons = [p[1] for p in points]
    lat_c = (max(lats) + min(lats)) / 2.0
    lon_c = (max(lons) + min(lons)) / 2.0
    k = math.cos(rad(lat_c))
    span_lat = max(lats) - min(lats) + 2 * pad_deg
    span_lon = (max(lons) - min(lons)) * k + 2 * pad_deg
    s = max(span_lat / 31.0, span_lon / float(x1 - x0), 0.08)
    return make_view(x0, x1, lat_c, lon_c, s)

def cone_spans(v, track, basin):
    # Per screen row, the x spans covered by the cone, split into the
    # first 72 hours and days 4-5.
    rows3 = [[] for _ in range(32)]
    rows5 = [[] for _ in range(32)]
    for lat, lon, hr, t in track_samples(track, 6):
        r = cone_radius(hr, basin) / 60.0
        if r <= 0:
            continue
        cx, cy = px(v, lat, lon)
        ry = r / v["lat_s"]
        rx = r / (v["lon_s"] * math.cos(rad(lat)))
        rows = rows3 if hr <= 72 else rows5
        for y in range(max(0, int(cy - ry)), min(31, int(cy + ry)) + 1):
            dy = (y - cy) / ry if ry > 0 else 0
            if dy * dy > 1:
                continue
            w = rx * math.sqrt(1 - dy * dy)
            rows[y].append((int(cx - w), int(cx + w)))
    return rows3, rows5

def in_spans(spans, x):
    for a, b in spans:
        if x >= a and x <= b:
            return True
    return False

def draw_map(c, v, cone = None):
    # Ocean gradient, then one rect per run of same-colored pixels in each
    # row: land, or ocean/land tinted where the cone covers it.
    x0 = v["x0"]
    x1 = v["x1"]
    c.gradient_rect(x0, 0, x1, 31, OCEAN_TOP, OCEAN_BOT, horizontal = False)
    for y in range(32):
        lat = v["lat_top"] - (y + 0.5) * v["lat_s"]
        ocean = mix(OCEAN_TOP, OCEAN_BOT, y / 31.0)
        run_col = None
        run_start = x0
        for x in range(x0, x1 + 2):
            col = None
            if x <= x1:
                land = is_land(v["lon_left"] + (x - x0 + 0.5) * v["lon_s"], lat)
                base = LAND_COL if land else None
                if cone != None:
                    if in_spans(cone[0][y], x):
                        col = mix(LAND_COL if land else ocean, CONE3, 0.42)
                    elif in_spans(cone[1][y], x):
                        col = mix(LAND_COL if land else ocean, CONE5, 0.24)
                if col == None:
                    col = base
            if col != run_col:
                if run_col != None:
                    c.rect(run_start, y, x - 1, y, fill = run_col)
                run_col = col
                run_start = x
    if v["lat_s"] <= 0.65:
        draw_borders(c, v)
    return v

def draw_borders(c, v):
    # State, province and country lines, only the pieces inside the view.
    lat_bot = v["lat_top"] - 32 * v["lat_s"]
    lon_right = v["lon_left"] + (v["x1"] - v["x0"] + 1) * v["lon_s"]
    for line in BORDERS:
        prev = None
        for la100, lo100 in line:
            la = la100 / 100.0
            lo = lo100 / 100.0
            inside = la >= lat_bot - 1 and la <= v["lat_top"] + 1 and lo >= v["lon_left"] - 1 and lo <= lon_right + 1
            cur = px(v, la, lo) if inside else None
            if prev != None and cur != None:
                c.line(max(v["x0"], min(v["x1"], prev[0])), prev[1], max(v["x0"], min(v["x1"], cur[0])), cur[1], BORDER)
            prev = cur

# ---------- storm art ----------

# Radar reflectivity, light to heavy: greens, yellow, orange, red.
RADAR = ["#0E7A2A", "#1FA637", "#5FD94A", "#F5E829", "#F7A21B", "#E8191E", "#B0102E"]
RADAR_AT = [0.10, 0.22, 0.36, 0.52, 0.66, 0.80, 0.94]

def draw_spiral(c, cx, cy, radius, x0, x1, bg_at, tint = "#F4F7FF", radar = False):
    # Two cloud bands winding out of a clear eye, fading with distance,
    # blended over whatever is underneath. The bands curl the way a
    # Northern Hemisphere storm's do (counterclockwise rotation). As radar:
    # a clear eye, the eyewall heaviest, the bands lighter outward.
    for y in range(max(0, cy - radius), min(31, cy + radius) + 1):
        for x in range(max(x0, cx - radius), min(x1, cx + radius) + 1):
            dx = float(x - cx)
            dy = float(y - cy)
            r = math.sqrt(dx * dx + dy * dy)
            if r > radius or r < (max(1.2, radius * 0.12) if radar else 1.2):
                continue
            th = math.atan2(dy, dx)
            band = (math.sin(2.0 * th - r * (5.5 / radius)) + 1.0) / 2.0
            a = band * (1.0 - r / radius) * 1.3
            if radar:
                # Speckle like radar returns; the eyewall heavy, peaking
                # where the bands leave it.
                a = band * (1.0 - r / radius) * 1.5 + ((x * 73 + y * 151) % 9 - 4) * 0.025
                if r < radius * 0.3 + 1:
                    a = max(a, 0.72 + band * 0.28)
                lvl = -1
                for i in range(len(RADAR_AT)):
                    if a >= RADAR_AT[i]:
                        lvl = i
                if lvl >= 0:
                    c.pixel(x, y, mix(bg_at(x, y), RADAR[lvl], 0.6 if lvl == 0 else 0.92))
                continue
            if r < radius * 0.22 + 1:
                a = max(a, 0.95)
            if a < 0.12:
                continue
            a = int(min(1.0, a) * 5.0 + 0.5) / 5.0
            c.pixel(x, y, mix(bg_at(x, y), tint, a))

def map_bg(v):
    def bg(x, y):
        lat = v["lat_top"] - (y + 0.5) * v["lat_s"]
        lon = v["lon_left"] + (x - v["x0"] + 0.5) * v["lon_s"]
        return LAND_COL if is_land(lon, lat) else mix(OCEAN_TOP, OCEAN_BOT, y / 31.0)
    return bg

def black_bg(x, y):
    return "#000000"

def spiral_size(s, track):
    r34 = track["r34"] if track != None else 0
    if r34 > 0:
        return r34
    return 60 + s["kt"]

def draw_marker(c, x, y, col):
    # A small 5-point star for "you".
    c.pixel(x, y - 2, col)
    c.rect(x - 2, y - 1, x + 2, y - 1, fill = col)
    c.rect(x - 1, y, x + 1, y, fill = col)
    c.pixel(x - 1, y + 1, col)
    c.pixel(x + 1, y + 1, col)

def draw_arrow(c, x, y, deg, col, n = 4):
    # Line from (x,y) toward the heading with a two-pixel head.
    dx = math.sin(rad(deg))
    dy = -math.cos(rad(deg))
    ex = int(x + dx * n + 0.5)
    ey = int(y + dy * n + 0.5)
    c.line(x, y, ex, ey, col)
    for a in [145, -145]:
        hx = int(ex + math.sin(rad(deg + a)) * 3 + 0.5)
        hy = int(ey - math.cos(rad(deg + a)) * 3 + 0.5)
        c.line(ex, ey, hx, hy, col)


# ---------- page furniture ----------

TITLE = "#FFFFFF"
GOLD = "#FFC140"
SKY = "#9FD3FF"
DIM = "#8A8F99"
YOU = "#FF4FD8"

def header(c, left, right, bg = "#0A2A5A", fg = "#FFFFFF", rfg = GOLD):
    c.rect(0, 0, 191, 7, fill = bg)
    rw = c.text_width(right, "4x5") if right else 0
    # Narrower faces before anything is cut.
    font = "5x7"
    for f in ["5x7", "4x7", "4x5"]:
        if c.text_width(left, f) <= 186 - rw - 4:
            font = f
            break
    c.text(left, 2, 1 if font != "4x5" else 2, font = font, color = fg)
    if right:
        c.text(right, 189, 2, font = "4x5", color = rfg, align = "right")

def chip(c, x, y, text, bg, font = "4x5"):
    w = c.text_width(text, font) + 4
    h = 7 if font == "4x5" else 9
    c.rect(x, y, x + w - 1, y + h - 1, fill = bg)
    c.text(text, x + 2, y + 1, font = font, color = "#000000" if luma(bg) > 120 else "#FFFFFF")
    return w

PLACE_SHORT = [(" TO ", "-"), ("COUNTY", "CO"), ("PARISH", "PAR"), (" RIVER", " RIV"), ("MOUTH OF THE ", "MOUTH OF "), (", ", " "), ("WEST OF ", "W OF "), ("EAST OF ", "E OF "), ("NORTH OF ", "N OF "), ("SOUTH OF ", "S OF ")]

def shorten_place(t):
    for a, b in PLACE_SHORT:
        t = t.replace(a, b)
    return t

def commas(n):
    t = str(n)
    out = ""
    for i in range(len(t)):
        if i > 0 and (len(t) - i) % 3 == 0:
            out += ","
        out += t[i]
    return out

def list_newer(f, pub):
    # The storm list was updated after the advisory or update in hand.
    u = iso_epoch(f.get("updated") or "")
    return pub == None or pub.get("time") == None or (u != None and u > pub["time"])

def wind_mph(f, pub):
    if pub != None and pub["mph"] != None and not list_newer(f, pub):
        return pub["mph"]
    return kt_to_mph(f["kt"])

def zone(w, f):
    loc = w["loc"]
    return zone_for(loc["lat"] if loc != None else None, loc["lon"] if loc != None else None, f["basin"] if f != None else w["basins"][0])

def quiet_lines(w):
    # Wordings for the quiet-day outlook line, longest first.
    areas = []
    for b in w["basins"]:
        areas += fetch_outlook(b) or []
    if not areas:
        return ["NOTHING EXPECTED IN 7 DAYS", "NOTHING EXPECTED"]
    top = areas[0]
    for a in areas:
        if a["d7"] > top["d7"]:
            top = a
    n = len(areas)
    what = str(n) + (" AREA" if n == 1 else " AREAS")
    return ["WATCHING " + what + " - " + str(top["d7"]) + "% IN 7 DAYS", "WATCHING " + what + " - " + str(top["d7"]) + "%",
            what + " - UP TO " + str(top["d7"]) + "%"]

# ---------- 1. intro ----------

def intro(c, ctx):
    w = world(ctx)
    f = w["featured"]
    c.fill("#000000")
    if f != None:
        s = 0.30
        lon_c = f["lon"] + 52 / math.cos(rad(f["lat"])) * s
        v = make_view(0, 191, f["lat"], lon_c, s)
    elif "al" in w["basins"]:
        v = make_view(0, 191, 26, -72, 0.55)
    else:
        v = make_view(0, 191, 18, -112, 0.55)
    draw_map(c, v)
    bg = map_bg(v)
    for s in (w["storms"] or []):
        x, y = px(v, s["lat"], s["lon"])
        if x < -16 or x > 207:
            continue
        if f != None and s["id"] == f["id"]:
            track = fetch_track(s)
            # Drawn at twice the tropical-storm-wind radius so the bands
            # read on the panel.
            r = int(min(16, max(13, 2 * spiral_size(s, track) / 60.0 / v["lat_s"])))
        else:
            r = 5 if s["kt"] < 64 else 7
        draw_spiral(c, x, y, r, 0, 191, bg, radar = True)
    tw = c.text_width("TROPICAL", "10x16_bold")
    c.text_stroke("TROPICAL", 189 - tw, 2, font = "10x16_bold", color = TITLE, stroke = OCEAN_TOP)
    # A broadcast-style UPDATE tag under the title.
    lw = c.text_width("UPDATE", "5x7") + 6
    lx = 189 - lw
    c.rect(lx, 20, 189, 28, fill = "#D7263D")
    c.text("UPDATE", lx + 3, 21, font = "5x7", color = "#FFFFFF")
    if f == None:
        c.text_stroke("ALL QUIET", 4, 24, font = "4x5", color = SKY, stroke = "#000000")
    elif len(w["mine"]) > 1:
        c.text_stroke(str(len(w["mine"])) + " ACTIVE", 4, 24, font = "4x5", color = SKY, stroke = "#000000")

# ---------- 2. featured storm ----------

def storm(c, ctx):
    w = world(ctx)
    f = w["featured"]
    c.fill("#000000")
    if f == None:
        names = " / ".join([basin_name(b) for b in w["basins"]])
        draw_spiral(c, 16, 16, 15, 0, 33, black_bg, "#3A4A66")
        c.rect(36, 0, 37, 31, fill = "#3A4A66")
        c.text("NO ACTIVE STORMS", 41, 2, font = "6x8", color = TITLE)
        c.text(first_fit(c, [names, "BOTH BASINS"], "5x7", 148), 41, 13, font = "5x7", color = SKY)
        c.text(first_fit(c, quiet_lines(w), "4x5", 148), 41, 24, font = "4x5", color = DIM)
        return
    far = None
    if w["loc"] != None and not loc_matters(w):
        loc = w["loc"]
        d = dist_nm(loc["lat"], loc["lon"], f["lat"], f["lon"]) * 1.15078
        far = commas(int(d / 50.0 + 0.5) * 50) + " MI " + compass(bearing(loc["lat"], loc["lon"], f["lat"], f["lon"]))
    draw_storm_card(c, f, fetch_public(f), fetch_track(f), far)

def row_width(c, r):
    # Width of a storm-card line: text with 6-px gaps, the marker, and room
    # for the movement arrow.
    x = 0
    for t, cl in r:
        if t == "*":
            x += 7
            continue
        x += c.text_width(t, "4x5") + 6
        if t.startswith("MOVING"):
            x += 11
    return x - 6

def coord_text(f):
    # "28.7N 87.1W" from the storm list's position (updated with each
    # advisory and hourly update).
    def one(v, pos, neg):
        n = int(abs(v) * 10 + 0.5)
        return str(n // 10) + "." + str(n % 10) + (pos if v >= 0 else neg)
    return one(f["lat"], "N", "S") + " " + one(f["lon"], "E", "W")

def draw_storm_card(c, f, pub, tr, far = None):
    # The wind speed big on the left in its category color; on the right
    # the name and three lines: movement and pressure, surge and rain, and
    # how far the winds reach (gusts fill in when a line is missing).
    ci = cat_index(f["kt"])
    col = CAT_COLORS[ci]
    mph = wind_mph(f, pub)
    c.text(str(mph), 20, 2, font = "10x16_bold", color = col, align = "center")
    c.text("MPH", 20, 19, font = "4x5", color = col, align = "center")
    c.text(CAT_SHORT[ci], 20, 26, font = "4x5", color = col, align = "center")
    c.rect(41, 0, 42, 31, fill = col)
    # The center's position, right-aligned on the name line; the name
    # steps down a size (or to the bare name) to make room.
    pos = coord_text(f)
    room = 140 - c.text_width(pos, "4x5")
    font, title = fit_font(c, storm_title(f), ["6x8", "5x7", "4x5"], room)
    if c.text_width(title, font) > room:
        # The category tag already says what it is.
        font, title = fit_font(c, f["name"], ["6x8", "5x7", "4x5"], room)
    c.text(title, 46, 1, font = font, color = TITLE)
    c.text(pos, 189, 2, font = "4x5", color = "#8FA3B8", align = "right")
    rows = []
    move = pub["move"] if pub != None else ""
    seg = []
    if move == "STATIONARY":
        seg.append(("STATIONARY", "#C8C8C8"))
    elif move:
        seg.append(("MOVING " + move.replace(" AT ", " "), "#C8C8C8"))
    mb = pub["mb"] if pub != None and pub["mb"] and not list_newer(f, pub) else f["mb"]
    seg.append((mb + " MB", SKY))
    rows.append(seg)
    seg = []
    if pub != None and pub["surge_ft"]:
        seg.append(("SURGE " + str(pub["surge_ft"]) + " FT", "#C77DFF"))
    if pub != None and pub["rain_in"]:
        seg.append(("RAIN " + str(pub["rain_in"]) + " IN", "#3DDC84"))
    if seg:
        rows.append(seg)
    seg = []
    if pub != None and pub["ts_miles"]:
        seg.append(("TS WINDS " + str(pub["ts_miles"]) + " MI", "#6FC3E0"))
    if pub != None and pub["hu_miles"]:
        seg.append(("HURR " + str(pub["hu_miles"]) + " MI", col))
    if seg:
        rows.append(seg)
    if tr != None and tr["gust"] and len(rows) < 3:
        rows.append([("GUSTS " + str(kt_to_mph(tr["gust"])) + " MPH", "#C8C8C8")])
    if far != None:
        # The viewer is far from this storm: say so on the last line.
        rows = rows[:2] + [[("*", YOU), (far, YOU), ("OUTSIDE CONE", "#3DDC84")]]
    y = 11
    for r in rows[:3]:
        # The whole line spelled out when it fits.
        long = [(t if t == "*" else spell_out(t), cl) for t, cl in r]
        if row_width(c, long) <= 145:
            r = long
        x = 46
        for i in range(len(r)):
            txt, cl = r[i]
            if txt == "*":
                draw_marker(c, x + 2, y + 2, cl)
                x += 7
                continue
            if x + c.text_width(txt, "4x5") > 191:
                break
            c.text(txt, x, y, font = "4x5", color = cl)
            x += c.text_width(txt, "4x5") + 6
            if i == 0 and txt.startswith("MOVING") and f["dir"] != None:
                # Start the arrow so it lies entirely right of the text,
                # whichever way it points.
                d = float(f["dir"])
                dx = math.sin(rad(d)) * 4
                dy = -math.cos(rad(d)) * 4
                ax = x + 2 + int(max(0.0, -dx) + 1)
                draw_arrow(c, ax, y + 2 - int(dy / 2), d, TITLE, 4)
                x = ax + int(max(0.0, dx)) + 7
        y += 7

# ---------- 3. track + cone ----------

def track_page(c, ctx, w):
    f = w["featured"]
    c.fill("#000000")
    tr = fetch_track(f) if f != None else None
    if f == None or tr == None or len(tr["pts"]) < 2:
        draw_history(c, ctx, w)
        return
    pts = tr["pts"]
    z = zone(w, f)
    focus = [(p["lat"], p["lon"]) for p in pts]
    loc = w["loc"]
    show_loc = False
    if loc != None:
        near = min([dist_nm(loc["lat"], loc["lon"], p["lat"], p["lon"]) for p in pts])
        if near < 600:
            focus.append((loc["lat"], loc["lon"]))
            show_loc = True
    region = REGIONS.get(_s(ctx, "region", "Follow the storm"))
    if region != None:
        v = make_view(MAP_X0, 191, region[0], region[1], region[2])
    else:
        v = fit_view(MAP_X0, 191, focus, 0.9)
    cone = cone_spans(v, tr, f["basin"])
    draw_map(c, v, cone)
    xy = [px(v, p["lat"], p["lon"]) for p in pts]
    for i in range(len(xy) - 1):
        late = pts[i + 1]["hr"] > 72
        x0, y0 = xy[i]
        x1, y1 = xy[i + 1]
        if not late:
            c.line(x0, y0, x1, y1, "#DDDDDD")
        else:
            n = max(abs(x1 - x0), abs(y1 - y0))
            for k in range(0, n + 1, 2):
                c.pixel(x0 + (x1 - x0) * k // max(1, n), y0 + (y1 - y0) * k // max(1, n), "#888888")
    last_lbl = None
    taken = []
    for i in range(len(pts)):
        x, y = xy[i]
        p = pts[i]
        col = CAT_COLORS[cat_index(p["kt"])]
        if i == 0:
            continue
        if p["hr"] <= 72:
            c.rect(x - 1, y - 1, x + 1, y + 1, fill = col)
        else:
            c.rect(x - 1, y - 1, x + 1, y + 1, outline = mix(col, "#000000", 0.35))
        on_map = x >= MAP_X0 + 1 and x <= 191 and y >= 0 and y <= 31
        if p["hr"] % 24 == 0 and p["hr"] > 0 and on_map:
            lbl = local_label(p["t"], z, False)
            if x + 3 + c.text_width(lbl, "4x5") > 191:
                x = 191 - 3 - c.text_width(lbl, "4x5") - 3
            if last_lbl == None or abs(y - last_lbl[1]) > 6 or abs(x - last_lbl[0]) > 24:
                ly0 = max(1, min(26, y - 2))
                c.text_stroke(lbl, x + 3, ly0, font = "4x5", color = TITLE if p["hr"] <= 72 else DIM, stroke = "#000000")
                taken.append((x + 2, ly0 - 1, x + 3 + c.text_width(lbl, "4x5"), ly0 + 5))
                last_lbl = (x, y)
    shown = [1 for x, y in xy if x >= MAP_X0 and x <= 191 and y >= 0 and y <= 31]
    if region != None and not shown:
        # The storm is outside the chosen region: say where it is.
        d = dist_nm(region[0], region[1], f["lat"], f["lon"]) * 1.15078
        far = f["name"] + " " + commas(int(d / 50.0 + 0.5) * 50) + " MI " + compass(bearing(region[0], region[1], f["lat"], f["lon"]))
        c.text_stroke(far, 189 - c.text_width(far, "4x5"), 26, font = "4x5", color = GOLD, stroke = "#000000")
        taken.append((188 - c.text_width(far, "4x5"), 25, 191, 31))
    draw_other_storms(c, v, w, f, taken)
    sx, sy = xy[0]
    draw_spiral(c, sx, sy, 4, MAP_X0, 191, map_bg(v))
    c.pixel(sx, sy, CAT_COLORS[cat_index(f["kt"])])
    if show_loc:
        lx, ly = px(v, loc["lat"], loc["lon"])
        if lx >= MAP_X0 + 2 and lx <= 189 and ly >= 2 and ly <= 29:
            draw_marker(c, lx, ly, YOU)
    lf = forecast_landfall(tr)
    if lf != None and not lf["now"]:
        lx, ly = px(v, lf["lat"], lf["lon"])
        if lx >= MAP_X0 + 2 and lx <= 189 and ly >= 1 and ly <= 30:
            # Where the forecast center first crosses the coast.
            c.rect(lx - 2, ly - 2, lx + 2, ly + 2, outline = "#000000")
            c.rect(lx - 1, ly - 1, lx + 1, ly + 1, outline = LANDFALL_COL)
            c.pixel(lx, ly, "#FFFFFF")
    if show_loc:
        # "You" stays on top of the landfall mark.
        mx, my = px(v, loc["lat"], loc["lon"])
        if mx >= MAP_X0 + 2 and mx <= 189 and my >= 2 and my <= 29:
            draw_marker(c, mx, my, YOU)
    c.rect(0, 0, MAP_X0 - 1, 31, fill = "#000000")
    draw_landfall_panel(c, lf, z)

# The track map starts here; the landfall panel fills the left.
MAP_X0 = 57
# Panel text runs from x=1 to one pixel short of the map.
PANEL_W = MAP_X0 - 2
LANDFALL_COL = "#FF5A5A"

def free_at(taken, x0, y0, x1, y1):
    # True when the box is on the map and clear of every box in taken.
    if x0 < MAP_X0 or x1 > 191 or y0 < 0 or y1 > 31:
        return False
    for a in taken:
        if x0 <= a[2] and a[0] <= x1 and y0 <= a[3] and a[1] <= y1:
            return False
    return True

def place_label(c, taken, text, spots, col, x_min = 0):
    # Draws text at the first (x, y) spot that's free, stroke included;
    # nothing if none is.
    w = c.text_width(text, "4x5")
    for x, y in spots:
        if x >= x_min and free_at(taken, x - 1, y - 1, x + w, y + 5):
            c.text_stroke(text, x, y, font = "4x5", color = col, stroke = "#000000")
            taken.append((x - 1, y - 1, x + w, y + 5))
            return True
    return False

def forecast_landfall(tr):
    # Where and when the forecast center first crosses from water onto
    # land: each 12-24 h leg is stepped every ~0.05 deg against the land
    # mask. "now" means the storm is already over land.
    pts = tr["pts"]
    if is_land(pts[0]["lon"], pts[0]["lat"]):
        return {"now": True}
    for i in range(1, len(pts)):
        a = pts[i - 1]
        b = pts[i]
        n = max(2, int(max(abs(b["lat"] - a["lat"]), abs(b["lon"] - a["lon"])) / 0.05))
        for k in range(1, n + 1):
            f = k / float(n)
            la = a["lat"] + (b["lat"] - a["lat"]) * f
            lo = a["lon"] + (b["lon"] - a["lon"]) * f
            if is_land(lo, la):
                t = int(a["t"] + (b["t"] - a["t"]) * f)
                return {"now": False, "lat": la, "lon": lo, "t": t, "i": i, "hr": a["hr"] + (b["hr"] - a["hr"]) * f}
    return None

def nearest_towns(lat, lon, n = 4):
    # The n closest coastal towns: (name, state or country, miles, compass
    # direction from the town), closest first.
    k = math.cos(rad(lat))
    best = []
    for name, region, tla, tlo in COAST_TOWNS:
        dla = lat - tla / 100.0
        dlo = (lon - tlo / 100.0) * k
        best.append((dla * dla + dlo * dlo, name, region, tla / 100.0, tlo / 100.0))
    best = sorted(best)[:n]
    return [(t[1], t[2], dist_nm(t[3], t[4], lat, lon) * 1.15078, compass(bearing(t[3], t[4], lat, lon))) for t in best]

def wrap_words(c, text, font, maxw):
    lines = []
    cur = ""
    for wd in text.split(" "):
        cand = (cur + " " + wd).strip()
        if cur == "" or c.text_width(cand, font) <= maxw:
            cur = cand
        else:
            lines.append(cur)
            cur = wd
    if cur:
        lines.append(cur)
    return lines

def landfall_lines(c, name, region, miles, d):
    # Two lines naming where: the town and its state or country, or how
    # far from the town - the distance is never dropped, the state or
    # country can be. None when nothing fits.
    if miles < 25:
        opts = [wrap_words(c, name + " " + region, "4x5", PANEL_W), wrap_words(c, name, "4x5", PANEL_W)]
    else:
        off = commas(int(miles / 5.0 + 0.5) * 5) + " MI " + d + " OF"
        if c.text_width(off, "4x5") <= PANEL_W:
            opts = [[off] + wrap_words(c, name + " " + region, "4x5", PANEL_W), [off] + wrap_words(c, name, "4x5", PANEL_W)]
        else:
            opts = [wrap_words(c, off + " " + name + " " + region, "4x5", PANEL_W), wrap_words(c, off + " " + name, "4x5", PANEL_W)]
    for o in opts:
        if len(o) <= 2 and len([t for t in o if c.text_width(t, "4x5") > PANEL_W]) == 0:
            return o
    return None

def draw_landfall_panel(c, lf, z):
    # Left of the map: the forecast landfall - when, and near (or how far
    # from) which town - or the plain 5-day track title when the forecast
    # stays at sea. A row of space between every line.
    if lf == None or lf["now"]:
        c.text("5-DAY", 2, 1, font = "5x7", color = TITLE)
        c.text("TRACK", 2, 9, font = "5x7", color = TITLE)
        if lf == None:
            c.text("NO", 2, 19, font = "4x5", color = "#3DDC84")
            c.text("LANDFALL", 2, 25, font = "4x5", color = "#3DDC84")
        else:
            c.text("OVER LAND", 2, 22, font = "4x5", color = DIM)
        return
    c.text("FORECAST", 1, 0, font = "4x5", color = DIM)
    c.text("LANDFALL", 1, 6, font = "4x5", color = LANDFALL_COL)
    when = local_label(lf["t"], z)
    c.text(first_fit(c, [spell_out(when), when], "5x7", PANEL_W), 1, 12, font = "5x7", color = TITLE)
    # The closest town whose wording fits two lines; a farther town only
    # when the closer ones' names are too long.
    lines = None
    far = False
    region = ""
    for name, region, miles, d in nearest_towns(lf["lat"], lf["lon"]):
        far = miles >= 25
        lines = landfall_lines(c, name, region, miles, d)
        if lines != None:
            break
    if lines == None:
        # Last resort: just the state or country.
        lines = [region] if region else []
    y = 20
    for i in range(len(lines)):
        c.text(lines[i], 1, y, font = "4x5", color = DIM if (far and lines[i].endswith(" OF")) else TITLE)
        y += 6

def draw_other_storms(c, v, w, f, taken):
    # The other active storms, faded: dotted forecast track, small spiral
    # and name; a storm off the map gets its direction in the corner.
    # Tracks only for the two nearest storms on or near the map, to stay
    # inside the request limit.
    off = []
    near = []
    for s in w["mine"]:
        if s["id"] == f["id"]:
            continue
        x, y = px(v, s["lat"], s["lon"])
        if x >= 8 and x <= 231 and y >= -40 and y <= 71:
            near.append(s["id"])
    near = near[:other_tracks(w)]
    for s in w["mine"]:
        if s["id"] == f["id"]:
            continue
        col = CAT_COLORS[cat_index(s["kt"])]
        t = fetch_track(s) if s["id"] in near else None
        if t != None:
            xy = [px(v, p["lat"], p["lon"]) for p in t["pts"]]
            dim = mix(col, "#000000", 0.45)
            for i in range(len(xy) - 1):
                x0, y0 = xy[i]
                x1, y1 = xy[i + 1]
                n = max(abs(x1 - x0), abs(y1 - y0))
                for k in range(0, n + 1, 2):
                    c.pixel(x0 + (x1 - x0) * k // max(1, n), y0 + (y1 - y0) * k // max(1, n), dim)
        x, y = px(v, s["lat"], s["lon"])
        if x >= MAP_X0 + 2 and x <= 189 and y >= 2 and y <= 29:
            draw_spiral(c, x, y, 3, MAP_X0, 191, map_bg(v))
            nw = c.text_width(s["name"], "4x5")
            # Beside the spiral where there's room: above right, above left,
            # below right, below left.
            place_label(c, taken, s["name"], [(x + 4, y - 7), (x - 4 - nw, y - 7), (x + 4, y + 3), (x - 4 - nw, y + 3)], col)
        elif s["basin"] == f["basin"]:
            # Off the map: noted only for storms in the same ocean.
            off.append(s["name"] + " " + compass(bearing(f["lat"], f["lon"], s["lat"], s["lon"])))
    # Corner notes, bottom right up, then top right down, where free.
    for t in off:
        t = spelled(c, t, "4x5", 70)
        x = 189 - c.text_width(t, "4x5")
        place_label(c, taken, t, [(x, 26), (x, 20), (x, 14), (x, 1), (x, 7)], DIM)

# ---------- 4. intensity ----------

def intensity_page(c, ctx, w):
    f = w["featured"]
    c.fill("#000000")
    tr = fetch_track(f) if f != None else None
    if f == None or tr == None or len(tr["pts"]) < 2:
        sb = season_basin(ctx, w)
        data = fetch_season(sb, civil(ctx.now.unix // 86400)[0]) or {}
        header(c, "STRONGEST THIS SEASON", basin_name(sb))
        name = data.get("Strongest storm name", "")
        # 10x16 bold: GDN's 8x12 draws I and - as solid blocks.
        c.text(name if name else "NONE YET", 96, 11, font = "10x16_bold" if name else "6x8", color = GOLD if name else DIM, align = "center")
        return
    pts = tr["pts"]
    z = zone(w, f)
    peak = pts[0]
    for p in pts:
        if p["kt"] > peak["kt"]:
            peak = p
    pm = kt_to_mph(peak["kt"])
    ci = cat_index(peak["kt"])
    X0, X1, Y0, Y1 = 52, 188, 1, 24
    hmax = max(24, pts[-1]["hr"])
    vmax = max(120, pm + 25)
    def gx(hr):
        return X0 + int((X1 - X0) * hr / float(hmax))
    def gy(m):
        return Y1 - int((Y1 - Y0) * min(m, vmax) / float(vmax))
    # Category bands.
    prev = 0
    for i in range(len(CAT_MPH) + 1):
        top = CAT_MPH[i] if i < len(CAT_MPH) else vmax
        if prev >= vmax:
            break
        y_top = gy(min(top, vmax))
        y_bot = gy(prev)
        if y_bot >= y_top:
            c.rect(X0, y_top, X1, y_bot, fill = mix("#000000", CAT_COLORS[i], 0.16))
        prev = top
    # A line at each local midnight, each day's name centered in its
    # column (left off a column too narrow for it), ticks at local noon.
    # The graph's hour 0 is NHC's synoptic time, which forecast hours count
    # from.
    t0 = pts[1]["t"] - pts[1]["hr"] * 3600 if len(pts) > 1 else pts[0]["t"]
    t1 = t0 + hmax * 3600
    def gxt(t):
        return gx((t - t0) / 3600.0)
    off = local_offset(t0, z)
    m = ((t0 + off) // 86400 + 1) * 86400 - off
    bounds = [t0]
    for _ in range(10):
        if m >= t1:
            break
        bounds.append(m)
        c.line(gxt(m), Y0, gxt(m), Y1, "#2A3442")
        m += 86400
        # Back onto local midnight across a daylight-saving change.
        o2 = local_offset(m, z)
        m = ((m + o2 + 43200) // 86400) * 86400 - o2
    bounds.append(t1)
    for i in range(len(bounds) - 1):
        a = bounds[i]
        b = bounds[i + 1]
        noon = a + 43200 if i > 0 else ((a + off) // 86400) * 86400 - off + 43200
        if noon > t0 and noon < t1:
            c.line(gxt(noon), Y1 + 1, gxt(noon), Y1 + 2, "#5A6678")
        xa = gxt(a)
        xb = gxt(b)
        lbl = local_label((a + b) // 2, z, False)
        lw = c.text_width(lbl, "4x5")
        if xb - xa >= lw + 2:
            c.text(lbl, max(X0, min((xa + xb) // 2 - lw // 2, X1 - lw)), 27, font = "4x5", color = TITLE if a - t0 < 72 * 3600 else DIM)
    # Landfall: where the forecast track first crosses the coast (the map
    # page's time), else midway into NHC's first inland point.
    lf = forecast_landfall(tr)
    lbox = None
    for i in range(1, len(pts)):
        if (lf != None and lf.get("i") == i) or (lf == None and "INLAND" in pts[i]["flag"] and "INLAND" not in pts[i - 1]["flag"]):
            lx = gx(lf["hr"]) if lf != None else (gx(pts[i - 1]["hr"]) + gx(pts[i]["hr"])) // 2
            for yy in range(Y0, Y1 + 1, 2):
                c.pixel(lx, yy, "#FFFFFF")
            lw = c.text_width("LANDFALL", "4x5")
            lt = lx + 2 if lx + 3 + lw <= 191 else lx - 2 - lw
            c.text_stroke("LANDFALL", lt, Y0, font = "4x5", color = TITLE, stroke = "#000000")
            lbox = (lt - 1, Y0 - 1, lt + lw, Y0 + 5)
            break
    for i in range(len(pts) - 1):
        a = pts[i]
        b = pts[i + 1]
        col = CAT_COLORS[cat_index(b["kt"])]
        if b["hr"] > 72:
            col = mix(col, "#000000", 0.45)
        c.line(gx(a["hr"]), gy(kt_to_mph(a["kt"])), gx(b["hr"]), gy(kt_to_mph(b["kt"])), col)
    # Points, with the mph labeled at the moments that matter: now, the
    # peak, the last point before landfall, and the end of the forecast.
    land = None
    for i in range(1, len(pts)):
        if (lf != None and lf.get("i") == i) or (lf == None and "INLAND" in pts[i]["flag"] and "INLAND" not in pts[i - 1]["flag"]):
            land = i - 1
            break
    # Peak first, so it always gets its label.
    keys = [pts.index(peak), 0]
    if land != None:
        keys.append(land)
    keys.append(len(pts) - 1)
    placed = [lbox] if lbox != None else []
    for i in range(len(pts)):
        p = pts[i]
        m = kt_to_mph(p["kt"])
        x = gx(p["hr"])
        y = gy(m)
        col = CAT_COLORS[cat_index(p["kt"])]
        c.rect(x - 1, y - 1, x + 1, y + 1, fill = col if p["hr"] <= 72 else mix(col, "#000000", 0.45))
    for i in keys:
        p = pts[i]
        m = kt_to_mph(p["kt"])
        x = gx(p["hr"])
        y = gy(m)
        t = str(m)
        tw = c.text_width(t, "4x5")
        tx = max(X0, min(x - tw // 2, X1 - tw))
        ty = y - 7 if y - 7 >= Y0 else y + 3
        box = (tx - 1, ty - 1, tx + tw, ty + 5)
        if len([q for q in placed if box[0] <= q[2] and q[0] <= box[2] and box[1] <= q[3] and q[1] <= box[3]]) > 0:
            continue
        c.text_stroke(t, tx, ty, font = "4x5", color = CAT_COLORS[cat_index(p["kt"])], stroke = "#000000")
        placed.append(box)
    c.text("FORECAST", 2, 1, font = "4x7", color = TITLE)
    c.text("PEAK", 2, 10, font = "4x5", color = DIM)
    c.text(str(pm) + " MPH", 2, 16, font = "5x7", color = CAT_COLORS[ci])
    c.text(CAT_SHORT[ci] + " " + local_label(peak["t"], z, False), 2, 25, font = "4x5", color = "#C8C8C8")

# ---------- 5. your location / warnings ----------

RELEVANT_MILES = 300

def loc_status(w):
    # How the featured storm relates to the viewer's location: in the cone
    # (from when), closest approach, NWS alerts, and whether any of that
    # makes the location worth its own page.
    loc = w["loc"]
    f = w["featured"]
    if loc == None or f == None:
        return None
    tr = fetch_track(f)
    first_in = None
    best = None
    if tr != None and len(tr["pts"]) > 1:
        first_in, best = cone_check(tr, f["basin"], loc)
    alerts = fetch_alerts(loc)
    closest_mi = best[0] * 1.15078 if best != None else dist_nm(loc["lat"], loc["lon"], f["lat"], f["lon"]) * 1.15078
    # Only tropical alerts count: a flood watch far from the storm isn't it.
    tropical = [a for a in (alerts or []) if "HURRICANE" in a[0] or "TROPICAL STORM" in a[0] or "STORM SURGE" in a[0] or "EXTREME WIND" in a[0]]
    relevant = first_in != None or closest_mi <= RELEVANT_MILES or len(tropical) > 0
    return {"first_in": first_in, "best": best, "alerts": alerts, "relevant": relevant}

def loc_matters(w):
    st = loc_status(w)
    return st != None and st["relevant"]

def local_page(c, ctx):
    w = world(ctx)
    f = w["featured"]
    c.fill("#000000")
    loc = w["loc"]
    # A location far from the storm - outside the cone, no close approach,
    # no alerts - gives this page back to the coastal warnings; the storm
    # card carries its distance instead.
    if loc != None and f != None and not loc_matters(w):
        loc = None
    if loc != None:
        right = ""
        if f != None:
            d = dist_nm(loc["lat"], loc["lon"], f["lat"], f["lon"]) * 1.15078
            right = f["name"] + " " + commas(int(d / 5.0 + 0.5) * 5) + " MI " + compass(bearing(loc["lat"], loc["lon"], f["lat"], f["lon"]))
        if right:
            right = spelled(c, right, "4x5", 182 - c.text_width("  " + loc["label"], "4x5"))
        header(c, "  " + loc["label"], right)
        draw_marker(c, 4, 3, YOU)
        if f == None:
            c.text("NO ACTIVE STORMS", 2, 11, font = "5x7", color = "#3DDC84")
        else:
            tr = fetch_track(f)
            if tr != None and len(tr["pts"]) > 1:
                z = zone(w, f)
                first_in, best = cone_check(tr, f["basin"], loc)
                if first_in != None:
                    c.text(spelled(c, "IN THE CONE FROM " + local_label(first_in, z), "5x7", 188), 2, 10, font = "5x7", color = "#FF5A5A")
                else:
                    c.text("OUTSIDE THE FORECAST CONE", 2, 10, font = "5x7", color = "#3DDC84")
                if best != None:
                    dmi = int(best[0] * 1.15078 / 5.0 + 0.5) * 5
                    where = "OVERHEAD" if dmi < 10 else commas(dmi) + " MI " + compass(bearing(loc["lat"], loc["lon"], best[2], best[3]))
                    when = local_label(best[1], z)
                    c.text(first_fit(c, [spell_out("CLOSEST: " + where + " " + when), "CLOSEST: " + spell_out(where) + " " + when,
                                         "CLOSEST: " + where + " " + when, "CLOSEST: " + where], "4x5", 188), 2, 18, font = "4x5", color = SKY)
        alerts = fetch_alerts(loc)
        if alerts == None:
            c.text("NWS ALERTS UNAVAILABLE", 2, 25, font = "4x5", color = DIM)
        elif not alerts:
            c.text("NO NWS ALERTS FOR THIS SPOT", 2, 25, font = "4x5", color = DIM)
        else:
            x = 2
            for label, col in alerts:
                if x + c.text_width(label, "4x5") + 4 > 191:
                    break
                x += chip(c, x, 24, label, col) + 2
        return
    # No location: the featured storm's warning areas.
    if f == None:
        header(c, "WATCHES & WARNINGS", "")
        c.text("NONE IN EFFECT", 96, 12, font = "6x8", color = "#3DDC84", align = "center")
        c.text("ADD YOUR ZIP CODE IN SETTINGS", 96, 24, font = "4x5", color = DIM, align = "center")
        return
    pub = fetch_public(f)
    rows = pub["warnings"] if pub != None else []
    if not rows:
        header(c, "WARNINGS - " + f["name"], "")
        c.text("NO COASTAL WATCHES", 96, 11, font = "5x7", color = "#3DDC84", align = "center")
        c.text("OR WARNINGS IN EFFECT", 96, 20, font = "5x7", color = "#3DDC84", align = "center")
        return
    draw_warning_page(c, warning_pages(c, rows, warn_most(w))[0])

# Warnings pages: a bar down the left - red WARN beside warnings, yellow
# WATCH beside watches - and each product in its own color code with its
# coast area, wrapping onto indented lines, five lines to a page.
KIND_LABEL = {"SURGE WARNING": "STORM SURGE", "HURRICANE WARNING": "HURRICANE", "TS WARNING": "TROPICAL STORM",
              "SURGE WATCH": "STORM SURGE", "HURRICANE WATCH": "HURRICANE", "TS WATCH": "TROPICAL STORM"}
# The bar spells its word only where the run of lines is tall enough;
# shorter runs are just the color.
WARN_BAR = ("#E8191E", ["WARN", ""])
WATCH_BAR = ("#FFE600", ["WATCH", ""])
LINES_PER_PAGE = 4
WFONT = "5x7"
WPITCH = 8

SHORT_LABEL = {"STORM SURGE": "SURGE", "TROPICAL STORM": "TROP STORM"}

def warning_groups(c, rows, short):
    # One group of lines per coast area: the product's label on its first
    # area only, the area wrapping onto indented lines.
    groups = []
    x0 = 12
    for wr in rows:
        watch = "WATCH" in wr["label"]
        label = KIND_LABEL.get(wr["label"], wr["label"])
        if short:
            label = SHORT_LABEL.get(label, label)
        areas = wr["areas"] if wr["areas"] else [""]
        for ai in range(len(areas)):
            area = shorten_place(areas[ai]) if short else areas[ai]
            lines = []
            parts = []
            x = x0 + 4
            if ai == 0:
                parts.append((x0, label, wr["color"]))
                x = x0 + c.text_width(label, WFONT) + 6
            cur = ""
            for wd in area.split(" "):
                cand = (cur + " " + wd).strip()
                if cur == "" and parts and c.text_width(wd, WFONT) > 191 - x:
                    # Too long to sit beside the label: start below it.
                    lines.append((watch, parts))
                    parts = []
                    x = x0 + 4
                    cur = wd
                elif cur == "" or c.text_width(cand, WFONT) <= 191 - x:
                    cur = cand
                else:
                    parts.append((x, cur, "#FFFFFF"))
                    lines.append((watch, parts))
                    parts = []
                    x = x0 + 4
                    cur = wd
            parts.append((x, cur, "#FFFFFF"))
            lines.append((watch, parts))
            groups.append(lines)
    return groups

def paginate(groups):
    # Five lines a page; an area that won't fit on the rest of a page
    # starts the next one instead of splitting.
    pages = [[]]
    for g in groups:
        if len(pages[-1]) + len(g) > LINES_PER_PAGE and pages[-1] and len(g) <= LINES_PER_PAGE:
            pages.append([])
        for ln in g:
            if len(pages[-1]) >= LINES_PER_PAGE:
                pages.append([])
            pages[-1].append(ln)
    return pages

def warning_pages(c, rows, most):
    # Everything spelled out when that fits in the pages available; else
    # the short forms, one area at a time - the areas that save the most
    # lines first - until it fits.
    full = warning_groups(c, rows, False)
    short = warning_groups(c, rows, True)
    groups = list(full)
    pages = paginate(groups)
    order = sorted(range(len(full)), key = lambda i: len(short[i]) - len(full[i]))
    for i in order:
        if len(pages) <= most:
            break
        if len(short[i]) < len(full[i]):
            groups[i] = short[i]
            pages = paginate(groups)
    if len(pages) > most:
        pages = paginate(short)
    if len(pages) <= most:
        return pages
    # Still too many: as many whole areas as fit, and a count of the rest
    # on its own last line.
    for k in range(len(short) - 1, 0, -1):
        pages = paginate(short[:k])
        if len(pages) < most or (len(pages) == most and len(pages[-1]) < LINES_PER_PAGE):
            more = [(pages[-1][-1][0], [(12, "+" + str(len(short) - k) + " MORE AREAS", DIM)])]
            if len(pages[-1]) < LINES_PER_PAGE:
                pages[-1] = pages[-1] + more
            else:
                pages.append(more)
            return pages
    return pages[:most]

def draw_warning_page(c, shown):
    c.fill("#000000")
    # Bar segments for each run of warning or watch lines.
    i = 0
    for _ in range(len(shown)):
        if i >= len(shown):
            break
        j = i
        for _ in range(len(shown)):
            if j + 1 < len(shown) and shown[j + 1][0] == shown[i][0]:
                j += 1
            else:
                break
        col, words = WATCH_BAR if shown[i][0] else WARN_BAR
        y0 = i * WPITCH
        y1 = 31 if j == len(shown) - 1 else (j + 1) * WPITCH - 1
        c.rect(0, y0, 8, y1, fill = col)
        word = ""
        for wd in words:
            if len(wd) * 6 - 1 <= y1 - y0 + 1:
                word = wd
                break
        ty = y0 + (y1 - y0 + 1 - (len(word) * 6 - 1)) // 2
        ink = "#000000" if luma(col) > 140 else "#FFFFFF"
        for ch in word.elems():
            c.text(ch, 4, ty, font = "4x5", color = ink, align = "center")
            ty += 6
        i = j + 1
    for k in range(len(shown)):
        for x, txt, col in shown[k][1]:
            c.text(txt, x, k * WPITCH, font = WFONT, color = col)

# ---------- 6. advisory headline ----------

def advisory(c, ctx):
    w = world(ctx)
    f = w["featured"]
    c.fill("#000000")
    if f == None:
        sb = season_basin(ctx, w)
        y, m, d = civil(ctx.now.unix // 86400)
        start = days_from_civil(y, 6 if sb == "al" else 5, 1 if sb == "al" else 15)
        end = days_from_civil(y, 11, 30)
        today = ctx.now.unix // 86400
        header(c, basin_name(sb) + " SEASON", "")
        if today < start:
            c.text(str(start - today) + " DAYS", 96, 10, font = "8x12", color = GOLD, align = "center")
            c.text("UNTIL THE SEASON STARTS " + ("JUN 1" if sb == "al" else "MAY 15"), 96, 25, font = "4x5", color = SKY, align = "center")
        elif today <= end:
            c.text(str(end - today) + " DAYS LEFT", 96, 10, font = "8x12", color = GOLD, align = "center")
            c.text("SEASON ENDS NOV 30", 96, 25, font = "4x5", color = SKY, align = "center")
        else:
            nxt = days_from_civil(y + 1, 6 if sb == "al" else 5, 1 if sb == "al" else 15)
            c.text(str(nxt - today) + " DAYS", 96, 10, font = "8x12", color = GOLD, align = "center")
            c.text("UNTIL NEXT SEASON", 96, 25, font = "4x5", color = SKY, align = "center")
        return
    pub = fetch_public(f)
    adv = str(f["adv"]).upper().lstrip("0")
    issued = iso_epoch(f["tcp_time"])
    when = "NHC"
    if pub != None and pub["update"] != None:
        # Hourly updates are labeled in Eastern time, NHC's own clock.
        when = local_label(pub["update"], EASTERN) + " " + zone_abbr(pub["update"], EASTERN)
        header(c, "UPDATE - " + f["name"], when)
    else:
        if issued != None:
            z = zone(w, f)
            when = local_label(issued, z) + " " + zone_abbr(issued, z)
        header(c, "ADVISORY " + adv + " - " + f["name"], when)
    if pub == None:
        c.text("ADVISORY UNAVAILABLE", 96, 14, font = "5x7", color = DIM, align = "center")
        return
    # Four small lines: whole headlines only (gold) - one that won't fit
    # is left out rather than cut - then the distances from land (blue),
    # spelled out where they fit.
    lines = []
    for hl in pub["headlines"]:
        wrapped = []
        cur = ""
        for wd in hl.split(" "):
            cand = (cur + " " + wd).strip()
            if c.text_width(cand, "4x5") <= 188:
                cur = cand
            else:
                wrapped.append((cur, GOLD))
                cur = wd
        if cur:
            wrapped.append((cur, GOLD))
        if len(lines) + len(wrapped) <= 4:
            lines += wrapped
    for a in pub["about"]:
        if len(lines) < 4:
            if c.text_width(a, "4x5") <= 188:
                lines.append((a, SKY))
            elif c.text_width(shorten_place(a), "4x5") <= 188:
                lines.append((shorten_place(a), SKY))
    y = 9 if len(lines) >= 4 else 11
    for txt, col in lines[:4]:
        c.text(txt, 96, y, font = "4x5", color = col, align = "center")
        y += 6

# ---------- 7. outlook ----------

LEVEL_COLORS = {"LOW": "#FFE14D", "MEDIUM": "#FF9F1C", "HIGH": "#FF3B3B"}

def level_color(pct):
    if pct == None:
        return DIM
    if pct < 40:
        return LEVEL_COLORS["LOW"]
    if pct <= 60:
        return LEVEL_COLORS["MEDIUM"]
    return LEVEL_COLORS["HIGH"]

def gauge(c, x, y, label, pct):
    c.text(label, x, y, font = "4x5", color = DIM)
    bx = x + 9
    c.rect(bx, y, bx + 31, y + 4, fill = "#1C2230")
    if pct != None and pct > 0:
        c.rect(bx, y, bx + max(1, pct * 31 // 100), y + 4, fill = level_color(pct))
    c.text(("--" if pct == None else str(pct)) + "%", bx + 34, y, font = "4x5", color = level_color(pct))

def outlook_page(c, ctx, w):
    c.fill("#000000")
    areas = []
    for b in w["basins"]:
        for a in fetch_outlook(b) or []:
            a["basin"] = b
            areas.append(a)
    header(c, "7-DAY OUTLOOK", " / ".join([basin_name(b) for b in w["basins"]]))
    others = [s for s in (w["storms"] or []) if w["featured"] == None or s["id"] != w["featured"]["id"]]
    others = [s for s in others if s["basin"] in w["basins"]]
    if not areas:
        c.text("NO NEW STORMS EXPECTED", 96, 10, font = "5x7", color = "#3DDC84", align = "center")
        c.text("IN THE NEXT 7 DAYS", 96, 18, font = "5x7", color = "#3DDC84", align = "center")
    else:
        # Each area: its name across the full width, the two gauges below.
        two = len(areas) > 1
        y = 9 if two else 11
        for a in areas[:2]:
            nf, nm = fit_font(c, a["name"], ["4x5"] if two else ["5x7", "4x7", "4x5"], 188)
            c.text(nm, 2, y, font = nf, color = TITLE)
            gy = y + (6 if two else 10)
            gauge(c, 2, gy, "2D", a["d2"])
            gauge(c, 98, gy, "7D", a["d7"])
            y += 12
    if others and len(areas) < 2:
        # Whole names only, with a count for any that don't fit.
        names = [s["name"] for s in others]
        txt = "ALSO ACTIVE: " + names[0]
        for k in range(1, len(names) + 1):
            cand = "ALSO ACTIVE: " + ", ".join(names[:k])
            rest = len(names) - k
            if rest > 0:
                cand += " +" + str(rest)
            if c.text_width(cand, "4x5") <= 188:
                txt = cand
        c.text(txt, 2, 26, font = "4x5", color = SKY)

# ---------- 8. season ----------

def season_page(c, ctx, w):
    c.fill("#000000")
    sb = season_basin(ctx, w)
    year = civil(ctx.now.unix // 86400)[0]
    data = fetch_season(sb, year) or {}
    names = (ATL_NAMES if sb == "al" else EP_NAMES).get(year, [])
    active = [s["name"] for s in (w["storms"] or []) if s["basin"] == sb]
    upper = [n.upper() for n in names]
    named = 0
    for i in range(len(names)):
        if upper[i] in active:
            named = i + 1
    if data.get("next") in upper:
        named = max(named, upper.index(data["next"]))
    nxt = names[named].upper() if named < len(names) else "SUPPLEMENTAL LIST"
    header(c, str(year) + " " + basin_name(sb), "NEXT: " + nxt)
    stats = [("NAMED", data.get("Total storms"), "#00FAF4"), ("HURRICANES", data.get("Total hurricanes"), "#FFE775"),
             ("MAJOR", data.get("Total intense"), "#FF8F20")]
    x = 2
    for label, n, col in stats:
        num = str(n) if n != None else "-"
        c.text(num, x, 9, font = "8x12", color = col)
        nx = x + c.text_width(num, "8x12") + 3
        c.text(label, nx, 15, font = "4x5", color = DIM)
        x = nx + c.text_width(label, "4x5") + 10
    # The season's names by initial: used, active, next, still to come.
    if names:
        step = 186 // len(names)
        x = (192 - step * len(names)) // 2
        for i in range(len(names)):
            letter = names[i][0].upper()
            up = names[i].upper()
            if up in active:
                col = GOLD
            elif i < named:
                col = "#C8C8C8"
            elif i == named:
                c.rect(x - 1, 23, x + 5, 31, fill = "#0A2A5A")
                col = SKY
            else:
                col = "#3A3F4A"
            c.text(letter, x, 24, font = "5x7", color = col)
            x += step

# ---------- on this date (quiet days) ----------

def history_today(ctx, basins):
    # The date in the US East, then the nearest date within a week, then
    # a pick from the archive of history's most notable storms.
    day = (ctx.now.unix - 5 * 3600) // 86400
    def evs(d):
        y, m, dd = civil(d)
        key = ("0" if m < 10 else "") + str(m) + ("0" if dd < 10 else "") + str(dd)
        return [e for e in HISTORY.get(key, []) if e[0] in basins], m, dd
    found, m, dd = evs(day)
    if found:
        return found, "ON THIS DATE", m, dd
    for k in range(1, 8):
        for d in [day - k, day + k]:
            found, m, dd = evs(d)
            if found:
                return found, "THIS WEEK", m, dd
    key = HISTORY_ARCHIVE[day % len(HISTORY_ARCHIVE)]
    found = HISTORY[key]
    return found, "FROM THE ARCHIVES", int(key[:2]), int(key[2:])

def draw_history(c, ctx, w):
    found, label, m, dd = history_today(ctx, w["basins"])
    # Prefer a storm with a stored track; rotate between basins hourly.
    with_track = [e for e in found if e[8]]
    pool = with_track if with_track else found
    e = pool[(ctx.now.unix // 3600) % len(pool)]
    basin, year, name, kind, kt, place, lat, lon, trk = e
    s = 0.26
    v = make_view(64, 191, lat, lon, s)
    draw_map(c, v)
    pts = [(t[0] / 10.0, t[1] / 10.0, t[2]) for t in trk]
    for i in range(len(pts) - 1):
        x0, y0 = px(v, pts[i][0], pts[i][1])
        x1, y1 = px(v, pts[i + 1][0], pts[i + 1][1])
        c.line(x0, y0, x1, y1, CAT_COLORS[cat_index(pts[i + 1][2])])
    sx, sy = px(v, lat, lon)
    draw_spiral(c, sx, sy, 8 + min(6, kt // 25), 64, 191, map_bg(v))
    c.rect(0, 0, 63, 31, fill = "#000000")
    ci = cat_index(kt)
    top = label if label == "ON THIS DATE" else (MON[m - 1] + " " + str(dd))
    c.text(top, 2, 1, font = "4x5", color = GOLD)
    c.text(str(year), 2, 7, font = "8x12", color = TITLE)
    shown = name if name else "UNNAMED"
    nf, nm = fit_font(c, shown, ["5x7", "4x5"], 61)
    c.text(nm, 2, 20 if nf == "5x7" else 21, font = nf, color = CAT_COLORS[ci])
    detail = (CAT_SHORT[ci] + " HIT " + place) if kind == "L" else ("PEAK " + str(kt_to_mph(kt)) + " MPH")
    if c.text_width(detail, "4x5") > 62:
        # A long place name goes on the map instead of being cut.
        detail = CAT_SHORT[ci] + " HIT"
        c.text_stroke(place, 189 - c.text_width(place, "4x5"), 26, font = "4x5", color = TITLE, stroke = "#000000")
    c.text(detail, 2, 27, font = "4x5", color = "#C8C8C8")
    if label != "ON THIS DATE":
        tag = "THIS WEEK IN HISTORY" if label == "THIS WEEK" else "FROM THE ARCHIVES"
        c.text_stroke(tag, 189 - c.text_width(tag, "4x5"), 1, font = "4x5", color = SKY, stroke = "#000000")

# ---------- pages 5-8: your location and warnings, then the rest ----------
# The map is always page 4. Pages 5-7 show your location (or the first
# warnings page) and the rest of the warnings; then the forecast graph,
# which always makes page 8 at the latest, then the outlook and the
# page-8 extra if there's room.

def warn_most(w):
    # Warnings share pages 5-7 with your location (page 8 is the forecast
    # graph): three pages without a location page, two with one.
    return 2 if loc_matters(w) else 3

def slot_plan(c, w):
    f = w["featured"]
    plan = [("local", None, 0)]
    if f == None:
        # Quiet tropics: season's strongest, the outlook, the scoreboard.
        return plan + [("intensity", None, 0), ("outlook", None, 0), ("season", None, 0)]
    pub = fetch_public(f)
    rows = pub["warnings"] if pub != None else []
    if rows:
        pages = warning_pages(c, rows, warn_most(w))
        first = 0 if loc_matters(w) else 1
        for k in range(first, len(pages)):
            plan.append(("warn", pages[k], k))
    plan = plan + [("intensity", None, 0), ("outlook", None, 0)]
    if len(plan) < 4:
        # Only looked up when page 8 has room for it.
        plan.append((extra_kind(w), None, 0))
    return plan[:4]

def draw_slot(c, ctx, n):
    w = world(ctx)
    kind, page, k = slot_plan(c, w)[n]
    if kind == "local":
        local_page(c, ctx)
    elif kind == "warn":
        draw_warning_page(c, page)
    elif kind == "intensity":
        intensity_page(c, ctx, w)
    elif kind == "season":
        season_page(c, ctx, w)
    elif kind == "summary":
        summary_page(c, w)
    elif kind == "surge":
        surge_page(c, w)
    elif kind == "odds":
        odds_page(c, w)
    elif kind == "history":
        storm_history_page(c, w)
    else:
        outlook_page(c, ctx, w)

def track(c, ctx):
    track_page(c, ctx, world(ctx))

def local(c, ctx):
    draw_slot(c, ctx, 0)

def intensity(c, ctx):
    draw_slot(c, ctx, 1)

def outlook(c, ctx):
    draw_slot(c, ctx, 2)

def season(c, ctx):
    draw_slot(c, ctx, 3)

# ---------- page 8 during a storm: surge, wind odds, the storm so far ----------

# GDN allows 8 uncached requests per render. budget_used() counts the
# most a render can need before the extras - the storm list, the featured
# storm's two advisories (plus its newer update, when one fits), the zip
# and its alerts, the outlooks, the season page - so the other storms' map
# tracks and the page-8 extra only take what's left.
REQUEST_LIMIT = 8

def budget_used(w):
    f = w["featured"]
    n = 1 + len(w["basins"])
    if w["loc_text"] != "":
        n += 1
    if w["loc"] != None:
        n += 1
    if f == None:
        return n + 1
    n += 2
    if f.get("tcu_ok"):
        n += 1
    tr = fetch_track(f)
    if tr == None or len(tr["pts"]) < 2:
        n += 1
    return n

def other_tracks(w):
    # Map tracks for up to two other storms, leaving one request for page 8.
    return max(0, min(2, len(w["mine"]) - 1, REQUEST_LIMIT - budget_used(w) - 1))

def extra_kind(w):
    # Surge by area when NHC forecasts surge (already fetched); else the
    # wind odds when any place has at least a 5% chance of tropical-storm
    # winds; else the storm's history so far; with no requests left, the
    # active storms at a glance.
    f = w["featured"]
    pub = fetch_public(f)
    if pub != None and pub["surge"]:
        return "surge"
    left = REQUEST_LIMIT - budget_used(w) - other_tracks(w)
    if left >= 2:
        odds = fetch_odds(f)
        if odds and max([o[1] for o in odds]) >= 5:
            return "odds"
    if left >= 1:
        return "history"
    return "summary"

def summary_page(c, w):
    # Every active storm in the chosen basins, strongest first: category,
    # name, wind and heading.
    c.fill("#000000")
    ss = sorted(w["mine"], key = lambda s: -s["kt"])
    n = len(ss)
    header(c, str(n) + (" ACTIVE STORM" if n == 1 else " ACTIVE STORMS"), " / ".join([basin_name(b) for b in w["basins"]]))
    y = 9
    for s in ss[:3]:
        ci = cat_index(s["kt"])
        col = CAT_COLORS[ci]
        chip(c, 2, y, CAT_SHORT[ci], col)
        c.text(s["name"], 34, y, font = "5x7", color = TITLE)
        mph = str(kt_to_mph(s["kt"])) + " MPH"
        c.text(mph, 92, y + 1, font = "4x5", color = col)
        if s["dir"] != None:
            room = 189 - (92 + c.text_width(mph, "4x5") + 6)
            c.text(spelled(c, "MOVING " + compass(float(s["dir"])), "4x5", room), 189, y + 1, font = "4x5", color = "#C8C8C8", align = "right")
        y += 8

def side_bar(c, word, col):
    c.rect(0, 0, 8, 31, fill = col)
    y = (32 - len(word) * 6 + 1) // 2
    ink = "#000000" if luma(col) > 140 else "#FFFFFF"
    for ch in word.elems():
        c.text(ch, 4, y, font = "4x5", color = ink, align = "center")
        y += 6

def surge_page(c, w):
    # Peak surge by stretch of coast, highest first: the range, then the
    # area wrapping onto indented lines; whole areas only, five lines,
    # with a count of any areas that don't fit.
    c.fill("#000000")
    pub = fetch_public(w["featured"])
    side_bar(c, "SURGE", "#B524F7")
    lines = []
    shown = 0
    for area, rng in pub["surge"]:
        x = 12 + c.text_width(rng, "4x5") + 5
        group = [[(12, rng, "#E0B0FF")]]
        cur = ""
        for wd in area.split(" "):
            cand = (cur + " " + wd).strip()
            if cur == "" or c.text_width(cand, "4x5") <= 191 - x:
                cur = cand
            else:
                group[-1].append((x, cur, "#FFFFFF"))
                group.append([])
                x = 16
                cur = wd
        group[-1].append((x, cur, "#FFFFFF"))
        left = len(pub["surge"]) - shown
        room = 5 - len(lines) - (1 if left > 1 else 0)
        if len(group) > room:
            break
        lines += group
        shown += 1
    if shown < len(pub["surge"]):
        lines.append([(12, "+" + str(len(pub["surge"]) - shown) + " MORE AREAS", DIM)])
    for k in range(len(lines)):
        for x, txt, col in lines[k]:
            c.text(txt, x, 1 + k * 6, font = "4x5", color = col)

def odds_page(c, w):
    # The places most likely to see tropical-storm winds in 5 days, with
    # the hurricane-wind chance beside it.
    c.fill("#000000")
    f = w["featured"]
    odds = sorted(fetch_odds(f) or [], key = lambda o: -o[1])[:3]
    c.text("WIND ODDS - NEXT 5 DAYS", 2, 0, font = "4x5", color = GOLD)
    c.text("TS", 146, 0, font = "4x5", color = "#6FC3E0", align = "center")
    c.text("HURR", 176, 0, font = "4x5", color = CAT_COLORS[2], align = "center")
    y = 8
    for name, ts, hu in odds:
        nf, nm = fit_font(c, name, ["5x7", "4x7", "4x5"], 128)
        c.text(nm, 2, y, font = nf, color = TITLE)
        c.text(str(ts) + "%", 146, y, font = "5x7", color = "#6FC3E0", align = "center")
        c.text(str(hu) + "%", 176, y, font = "5x7", color = CAT_COLORS[2], align = "center")
        y += 8

def storm_history_page(c, w):
    # The storm's path so far, colored by strength, with when it formed,
    # was named and became a hurricane.
    c.fill("#000000")
    f = w["featured"]
    h = fetch_history(f)
    if h == None:
        header(c, f["name"] + " SO FAR", "")
        c.text("HISTORY UNAVAILABLE", 96, 16, font = "5x7", color = DIM, align = "center")
        return
    pts = h["pts"]
    z = zone(w, f)
    v = fit_view(66, 191, [(p[1], p[2]) for p in pts], 1.5)
    draw_map(c, v)
    for i in range(len(pts) - 1):
        x0, y0 = px(v, pts[i][1], pts[i][2])
        x1, y1 = px(v, pts[i + 1][1], pts[i + 1][2])
        c.line(x0, y0, x1, y1, CAT_COLORS[cat_index(pts[i + 1][3])])
    sx, sy = px(v, pts[-1][1], pts[-1][2])
    draw_spiral(c, sx, sy, 5, 66, 191, map_bg(v))
    c.rect(0, 0, 65, 31, fill = "#000000")
    nf, nm = fit_font(c, f["name"] + " SO FAR", ["4x5"], 64)
    c.text(nm, 2, 0, font = nf, color = GOLD)
    y = 7
    for k, lbl, col in [("TD", "FORMED", CAT_COLORS[0]), ("TS", "NAMED", CAT_COLORS[1]), ("HU", "HURRICANE", CAT_COLORS[2])]:
        if k in h["first"]:
            c.text(lbl, 2, y, font = "4x5", color = col)
            c.text(local_label(h["first"][k], z, False), 63, y, font = "4x5", color = TITLE, align = "right")
            y += 6
    start = h["first"].get("TD", pts[0][0])
    days = (pts[-1][0] - start) // 86400
    if days >= 1:
        c.text(str(days) + (" DAY" if days == 1 else " DAYS") + " OLD", 2, 26, font = "4x5", color = DIM)
