# Tropical Update (192x32)
#
# The tropics at a glance, from the National Hurricane Center's own
# products: every active storm, the featured storm's 5-day forecast track
# and cone on a real map, its intensity forecast, the official headline,
# watches and warnings, the 7-day outlook for systems that haven't formed
# yet, the season so far, and on quiet days a storm from this date in
# history (NOAA HURDAT2).
#
# With a location set (zip, street address, city, county or lat/long) the
# featured storm is the one closest to you, and a page shows how far away
# it is, whether you're inside the forecast cone and from which day, its
# closest approach, and any National Weather Service alert for that spot.
# Without one, that page lists the coastal warning areas instead.
#
# Sources (no keys): NHC CurrentStorms.json, the forecast and public
# advisories it links to, NHC's Tropical Weather Outlook feeds, NWS
# alerts by point, Wikipedia's season summary for the counts, and
# zippopotam.us / OpenStreetMap to place a location. The map
# is Natural Earth land (public domain) baked in as a 0.2 degree mask.

USER_AGENT = "GDN-Tropical-Update (glance-led-panel)"
NHC = "https://www.nhc.noaa.gov/"

# NHC's 2026 cone circle radii (nm) by forecast hour - two thirds of the
# 2021-2025 official track errors fall inside them.
CONE_HOURS = [0, 12, 24, 36, 48, 60, 72, 96, 120]
CONE_ATL = [0, 25, 39, 49, 62, 77, 95, 134, 200]
CONE_EP = [0, 25, 37, 48, 56, 66, 78, 106, 138]

# Saffir-Simpson colors, the standard track-map palette:
# depression, storm, categories 1-5.
CAT_COLORS = ["#5EBAFF", "#00FAF4", "#FFFFCC", "#FFE775", "#FFC140", "#FF8F20", "#FF6060"]
CAT_NAMES = ["TROPICAL DEPRESSION", "TROPICAL STORM", "CATEGORY 1", "CATEGORY 2", "CATEGORY 3", "CATEGORY 4", "CATEGORY 5"]
CAT_SHORT = ["TD", "TS", "CAT 1", "CAT 2", "CAT 3", "CAT 4", "CAT 5"]
CAT_KT = [34, 64, 83, 96, 113, 137]
CAT_MPH = [39, 74, 96, 111, 130, 157]

CLASS_NAMES = {
    "HU": "HURRICANE", "TS": "TROPICAL STORM", "TD": "TROPICAL DEPRESSION",
    "STS": "SUBTROPICAL STORM", "STD": "SUBTROPICAL DEPRESSION",
    "PTC": "POTENTIAL TROPICAL CYCLONE", "PC": "POST-TROPICAL CYCLONE",
    "TY": "TYPHOON", "LO": "REMNANT LOW",
}

# NWS alerts in the NWS hazard-map priority order (weather.gov/help-map:
# tornado warning 2, extreme wind 3, flash flood 5, storm surge warning 17,
# hurricane warning 19, tropical storm warning 31, flood warning 39, high
# surf 43, tornado watch 45, flash flood watch 47, storm surge watch 53,
# hurricane watch 54, tropical storm watch 57, flood watch 89), in the NWS
# map colors.
ALERTS = [
    ("Tornado Warning", "TORNADO WARNING", "#FF0000"),
    ("Extreme Wind Warning", "EXTREME WIND WARNING", "#FF8C00"),
    ("Flash Flood Warning", "FLASH FLOOD WARNING", "#8B0000"),
    ("Storm Surge Warning", "STORM SURGE WARNING", "#B524F7"),
    ("Hurricane Warning", "HURRICANE WARNING", "#DC143C"),
    ("Tropical Storm Warning", "TROPICAL STORM WARNING", "#B22222"),
    ("Flood Warning", "FLOOD WARNING", "#00FF00"),
    ("High Surf Warning", "HIGH SURF WARNING", "#228B22"),
    ("Tornado Watch", "TORNADO WATCH", "#FFFF00"),
    ("Flash Flood Watch", "FLASH FLOOD WATCH", "#2E8B57"),
    ("Storm Surge Watch", "STORM SURGE WATCH", "#DB7FF7"),
    ("Hurricane Watch", "HURRICANE WATCH", "#FF00FF"),
    ("Tropical Storm Watch", "TROPICAL STORM WATCH", "#F08080"),
    ("Flood Watch", "FLOOD WATCH", "#2E8B57"),
]

# Watch/warning lines in the public advisory, sorted into the same NWS
# priority (every warning before any watch, storm surge first in each), in
# NHC's cone-graphic colors (hurricane warning red, watch pink, tropical
# storm warning blue, watch yellow); storm surge keeps the NWS purples.
ADVISORY_WARNINGS = [
    ("A STORM SURGE WARNING", "SURGE WARNING", "#B524F7"),
    ("A HURRICANE WARNING", "HURRICANE WARNING", "#E8191E"),
    ("A TROPICAL STORM WARNING", "TS WARNING", "#2F6BFF"),
    ("A STORM SURGE WATCH", "SURGE WATCH", "#DB7FF7"),
    ("A HURRICANE WATCH", "HURRICANE WATCH", "#FF9ECF"),
    ("A TROPICAL STORM WATCH", "TS WATCH", "#FFE600"),
]

